{% extends 'base.html.twig' %}

{% set header_title %}Comparaison entre années — {{ cible.displayLong }}{% endset %}

{% block breadcrumb %}
    {{ include('communs/_breadcrumb.html.twig', {liens:[
        {href: path('app_formation_show', {slug: cible.slug}), title: cible.displayLong},
        {href: '', title: 'Comparaison entre années'},
    ]}) }}
{% endblock %}

{% block content %}
<form method="post"
      action="{{ path('app_formation_comparaison_execute') }}"
      {{ stimulus_controller('formation-comparaison--diff') }}
      data-action="submit->formation-comparaison--diff#confirmSubmit">

    <input type="hidden" name="source" value="{{ source.id }}">
    <input type="hidden" name="cible" value="{{ cible.id }}">
    <input type="hidden" name="hash_source" value="{{ hashSource }}">
    <input type="hidden" name="hash_cible" value="{{ hashCible }}">
    <input type="hidden" name="_token" value="{{ csrf_token('formation_comparaison_execute') }}">

    {# ── En-têtes ── #}
    <div class="row mb-3 g-3">
        <div class="col-5">
            <div class="card border-secondary h-100">
                <div class="card-header bg-secondary text-white d-flex align-items-center gap-2">
                    <i class="fas fa-clock-rotate-left"></i>
                    Version source <span class="badge bg-white text-secondary ms-auto">{{ sourceLabel }}</span>
                </div>
                <div class="card-body">
                    {% if sourceOptions|length > 1 %}
                        <label class="form-label small text-muted mb-1">Récupérer depuis l'année :</label>
                        <select class="form-select form-select-sm"
                                data-action="change->formation-comparaison--diff#changeSource">
                            {% for option in sourceOptions %}
                                <option value="{{ option.id }}" {{ option.id == source.id ? 'selected' : '' }}>
                                    {{ option.label }}
                                </option>
                            {% endfor %}
                        </select>
                    {% else %}
                        <div class="fw-semibold">{{ source.displayLong }}</div>
                        <small class="text-muted">{{ sourceLabel }}</small>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-2 d-flex align-items-center justify-content-center">
            <div class="text-center">
                <div class="badge bg-primary fs-5 px-3 py-2 mb-2">
                    <i class="fas fa-arrow-right" style="margin-left:4px"></i>
                </div>
                <div class="small text-muted">
                    <span class="badge bg-danger">{{ differentFields|length }}</span>
                    différence{{ differentFields|length > 1 ? 's' : '' }}
                </div>
            </div>
        </div>
        <div class="col-5">
            <div class="card border-primary h-100">
                <div class="card-header bg-primary text-white d-flex align-items-center gap-2">
                    <i class="fas fa-pen-to-square"></i>
                    Version cible <span class="badge bg-white text-primary ms-auto">{{ cibleLabel }}</span>
                </div>
                <div class="card-body">
                    {% if targetOptions|length > 1 %}
                        <label class="form-label small text-muted mb-1">Appliquer sur l'année :</label>
                        <select class="form-select form-select-sm"
                                data-action="change->formation-comparaison--diff#changeTarget"
                                data-formation-comparaison--diff-target="targetSelect">
                            {% for option in targetOptions %}
                                <option value="{{ option.id }}" {{ option.id == cible.id ? 'selected' : '' }}>
                                    {{ option.label }}
                                </option>
                            {% endfor %}
                        </select>
                        <small class="text-muted d-block mt-1">Version qui sera modifiée.</small>
                    {% else %}
                        <div class="fw-semibold">{{ cible.displayLong }}</div>
                        <small class="text-muted">Version modifiée · {{ cibleLabel }}</small>
                    {% endif %}

                    {% if broadcastYears|length > 1 %}
                        <div class="form-check form-switch mt-2 pt-2 border-top">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   name="apply_following" value="1" id="applyFollowing"
                                   data-action="change->formation-comparaison--diff#toggleFollowing"
                                   data-formation-comparaison--diff-target="followingSwitch">
                            <label class="form-check-label small" for="applyFollowing">
                                <i class="fas fa-arrows-turn-right me-1"></i>
                                Appliquer à <strong>toutes les années plus récentes</strong> que {{ sourceLabel }}
                            </label>
                            <div class="small text-muted mt-1">
                                {% for option in broadcastYears %}
                                    <span class="badge bg-secondary-subtle text-secondary border">{{ option.label }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if differentFields|length == 0 %}
        <div class="alert alert-success">
            <i class="fas fa-check-circle me-2"></i>
            Aucune différence entre ces deux versions. Rien à récupérer.
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-circle-info me-2"></i>
            Cochez les champs dont vous voulez <strong>récupérer la valeur de la version source</strong>
            ({{ sourceLabel }}). Les champs non cochés conservent leur valeur actuelle.
            La version source n'est jamais modifiée.
        </div>

        <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-action="click->formation-comparaison--diff#selectAll">
                <i class="fas fa-check-double me-1"></i> Tout récupérer
            </button>
            <span class="text-muted small flex-grow-1 text-center"
                  data-formation-comparaison--diff-target="status"></span>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-action="click->formation-comparaison--diff#selectNone">
                <i class="fas fa-xmark me-1"></i> Tout décocher
            </button>
        </div>

        {% for field in differentFields %}
        <div class="row align-items-stretch mb-2 g-2 field-row" data-formation-comparaison--diff-target="row">

            <div class="col-5">
                <div class="field-box field-source h-100 p-3">
                    {% if field.displayType == 'html' %}
                        <div class="small">{{ field.displayA|raw }}</div>
                    {% else %}
                        <span>{{ field.displayA }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="col-2 d-flex flex-column align-items-center justify-content-center text-center">
                <small class="text-muted fw-semibold mb-2">{{ field.label }}</small>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="fields[{{ field.key }}]" value="1"
                           id="check_{{ field.key }}"
                           data-action="change->formation-comparaison--diff#toggle">
                    <label class="form-check-label small" for="check_{{ field.key }}">
                        Récupérer
                    </label>
                </div>
            </div>

            <div class="col-5">
                <div class="field-box field-target h-100 p-3">
                    {% if field.displayType == 'html' %}
                        <div class="small">{{ field.displayB|raw }}</div>
                    {% else %}
                        <span>{{ field.displayB }}</span>
                    {% endif %}
                </div>
            </div>

        </div>
        {% endfor %}
    {% endif %}

    {# ── Diff structurel (lecture seule) ── #}
    <div class="card mt-4 mb-5 border-info">
        <div class="card-header bg-info bg-opacity-10 border-info d-flex align-items-center gap-2">
            <i class="fas fa-sitemap"></i>
            <span>Structure des maquettes (UE / EC / heures / MCCC)</span>
        </div>
        <div class="card-body">
            {% if structureHasAnyDiff %}
                <div class="alert alert-info d-flex align-items-center gap-2">
                    <i class="fas fa-circle-info"></i>
                    <span>
                        Différences de structure entre <strong>{{ sourceLabel }}</strong>
                        et <strong>{{ cibleLabel }}</strong>. Dépliez un parcours pour voir le détail.
                        Cochez une <strong>UE</strong> pour recopier tout son contenu
                        (EC, heures, ECTS, MCCC) depuis la version source vers <strong>{{ cibleLabel }}</strong>.
                    </span>
                </div>
            {% else %}
                <div class="alert alert-success mb-0">
                    <i class="fas fa-check-circle me-2"></i>
                    Aucune différence de structure entre <strong>{{ sourceLabel }}</strong>
                    et <strong>{{ cibleLabel }}</strong>.
                </div>
            {% endif %}

            {% if structureHasAnyDiff %}
                <div class="accordion" id="structureAccordion">
                    {% for row in structureParcours %}
                        {% set itemId = 'struct' ~ row.parcours.id %}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                {% if row.status == 'identique' %}
                                    <div class="accordion-button collapsed pe-3 no-toggle" style="cursor:default">
                                        <span class="flex-grow-1">{{ row.parcours.libelle }}</span>
                                        <span class="badge bg-success-subtle text-success border me-2">Aucune différence</span>
                                    </div>
                                {% else %}
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#{{ itemId }}"
                                            aria-expanded="false" aria-controls="{{ itemId }}">
                                        <span class="flex-grow-1">{{ row.parcours.libelle }}</span>
                                        {% if row.status == 'cible_seul' %}
                                            <span class="badge bg-primary me-2"><i class="fas fa-plus me-1"></i>Ajouté ({{ cibleLabel }})</span>
                                        {% elseif row.status == 'source_seul' %}
                                            <span class="badge bg-danger me-2"><i class="fas fa-minus me-1"></i>Non répercuté ({{ sourceLabel }})</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark me-2">Différences</span>
                                        {% endif %}
                                    </button>
                                {% endif %}
                            </h2>
                            {% if row.status != 'identique' %}
                                <div id="{{ itemId }}" class="accordion-collapse collapse" data-bs-parent="#structureAccordion">
                                    <div class="accordion-body">
                                        {% if row.status == 'cible_seul' %}
                                            <p class="text-muted mb-0">
                                                <i class="fas fa-circle-info me-1"></i>
                                                Ce parcours est présent uniquement dans <strong>{{ cibleLabel }}</strong>
                                                (ajouté). Rien à récupérer depuis la source.
                                            </p>
                                        {% elseif row.status == 'source_seul' %}
                                            <p class="text-muted mb-0">
                                                <i class="fas fa-circle-info me-1"></i>
                                                Présent uniquement dans <strong>{{ sourceLabel }}</strong>, non répercuté
                                                vers <strong>{{ cibleLabel }}</strong>. (Recréation du parcours — à venir.)
                                            </p>
                                        {% else %}
                                            {% for change in row.addRemove %}
                                                <div class="d-flex align-items-center gap-2 border-bottom py-2">
                                                    <input class="form-check-input mt-0 flex-shrink-0" type="checkbox">
                                                    {% if change.kind == 'added' %}
                                                        <span class="badge bg-primary"><i class="fas fa-plus me-1"></i>{{ change.level }} ajouté{{ change.level == 'UE' ? 'e' : '' }}</span>
                                                    {% else %}
                                                        <span class="badge bg-danger"><i class="fas fa-minus me-1"></i>{{ change.level }} supprimé{{ change.level == 'UE' ? 'e' : '' }}</span>
                                                    {% endif %}
                                                    <span>{{ change.label }}</span>
                                                </div>
                                            {% endfor %}
                                            {% if row.diffStructure %}
                                                {{ include('admin/formation_comparaison/_diff_structure_parcours.html.twig', {diffStructure: row.diffStructure, parcoursCibleId: row.parcours.id}) }}
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Barre d'action ── #}
    <div class="sticky-bottom bg-white border-top shadow-sm py-3 px-4 d-flex justify-content-between align-items-center mt-4">
        <a href="{{ path('app_formation_show', {slug: cible.slug}) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Retour
        </a>
        <div class="text-center small text-muted"
             data-formation-comparaison--diff-target="status"></div>
        <button type="submit" class="btn btn-success btn-lg"
                data-formation-comparaison--diff-target="submitBtn" disabled>
            <i class="fas fa-download me-1"></i> Récupérer les éléments sélectionnés
        </button>
    </div>

</form>

<style>
.field-box {
    border: 2px solid #dee2e6;
    border-radius: 0.375rem;
    background-color: #fff;
    transition: border-color .15s, background-color .15s;
}
.field-row.is-selected .field-source {
    border-color: #198754;
    background-color: rgba(25, 135, 84, .07);
}
.field-row.is-selected .field-target {
    border-color: #fd7e14;
    background-color: rgba(253, 126, 20, .07);
}
.target-card-disabled {
    opacity: .55;
}
/* La police custom CS-Interface (glyph \e915) ne se charge pas ici : on rend
   la flèche d'accordéon avec FontAwesome (qui fonctionne sur cette page). */
#structureAccordion .accordion-button::after {
    font-family: "Font Awesome 6 Pro", "Font Awesome 6 Free", "FontAwesome" !important;
    font-weight: 900 !important;
    content: "\f078" !important; /* fa-chevron-down */
}
.accordion-button.no-toggle::after {
    display: none;
}
.accordion-button.no-toggle {
    background-color: var(--bs-success-bg-subtle, #e8f5e9);
}
.structure-detail h5 {
    font-size: .9rem;
    font-weight: 600;
}
</style>
{% endblock %}
