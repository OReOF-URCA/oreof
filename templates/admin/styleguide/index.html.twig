                </div>

                <div>
                    <h3 class="text-sm font-semibold text-secondary mb-3 pb-2 border-b">Exemple de code</h3>
                    <pre class="bg-secondary-900 text-secondary-200 p-4 rounded-md text-xs overflow-x-auto"><code>&lt;twig:Spinner size="md" variant="primary" /&gt;
&lt;twig:Spinner size="sm" variant="secondary" label="Chargement..." /&gt;
&lt;twig:Spinner size="lg" variant="success" /&gt;</code></pre>
                </div>
            </div>
        </twig:Card>

        {# Section Composant : Card #}
        <twig:Card title="Card" description="Composant carte réutilisable : titre, description.">

            <div>
                <h3 class="text-sm font-semibold text-secondary mb-3 pb-2 border-b">Propriétés</h3>
                <ul class="text-sm text-secondary space-y-1 list-disc list-inside">
                    <li><code>title</code> - Titre affiché dans l’en-tête de la carte</li>
                    <li><code>description</code> - Sous-titre ou texte d’aide sous le titre</li>
                    <li><code>actions</code> - Boutons ou actions affichés à droite de l’en-tête</li>
                    <li><code>footer</code> - Contenu HTML du pied de carte</li>
                    <li><code>variant</code> - Style visuel du conteneur : <code>default</code>, <code>elevated</code>
                        ou
                        <code>flat</code></li>
                    <li><code>extraClass</code> - Classes CSS additionnelles pour personnaliser le conteneur</li>
                </ul>
            </div>

            <div class="space-y-8">
                <div>
                    <h3 class="text-sm font-semibold text-secondary mb-3 pb-2 border-b">Exemple simple</h3>
                    <twig:Card title="Carte simple" description="Une description sommaire" variant="flat">
                        <p class="text-sm text-text">Contenu du corps de la carte. Utilisez ce composant pour encapsuler
                            des
                            blocs d'information.</p>
                    </twig:Card>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-secondary mb-3 pb-2 border-b">Avec actions</h3>
                    <twig:Card
                            variant="elevated"
                            title="Carte avec actions"
                            description="Actions disponibles à droite"
                            :actions="[
                                { label: 'Modifier', variant: 'secondary', size: 'sm', href: '#' },
                                { label: 'Supprimer', variant: 'danger', size: 'sm', outline: true, href: '#' }
                            ]"
                    >
                        <p class="text-sm text-text">La zone principale peut contenir n'importe quel contenu HTML/Twig
                            (tableau, liste, formulaire réduit...).</p>
                    </twig:Card>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-secondary mb-3 pb-2 border-b">Exemple de code</h3>
                    <pre class="bg-secondary-900 text-secondary-200 p-4 rounded-md text-xs overflow-x-auto"><code>{% verbatim %}&lt;twig:Card
    title="Formulaire"
    description="Éditer les informations"
    :actions="[
        { label: 'Supprimer', variant: 'danger', size: 'sm', outline: true, href: '#' }
    ]">

    &lt;p>Contenu et formulaire de la carte&lt;/p>

&lt;/twig:Card>{% endverbatim %}</code></pre>
                </div>
            </div>
        </twig:Card>

    </div>
{% endblock %}
