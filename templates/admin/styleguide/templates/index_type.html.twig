{% extends 'base.html.twig' %}

{# Page de type d'exemple alignée sur les conventions UI Tailwind + Twig Components #}

{% set header_title %}
    Insérer un titre d'onglet
{% endset %}

{% block header %}
    Insérer un titre de page général.
{% endblock %}

{% set header_description %}
    Insérer une description générale de la page, qui peut être utilisée pour contextualiser les composants présentés et expliquer leur usage dans l'application.
{% endset %}

{% block breadcrumb %}
    {{ include('communs/_breadcrumb.html.twig', {liens:[{ href:'', title: 'Ici le titre de la page (ex: "Gestion des Entités")' }]}) }}
{% endblock %}

{% block bouton_header %}
    <twig:Button variant="secondary" icon="icon:arrow-left" href="/administration/styleguide">Revenir sur styleguide</twig:Button>
    <twig:Button variant="primary" icon="fa-solid:plus">Ajouter un élément</twig:Button>
{% endblock %}

{% block content %}
    <div class="space-y-6">
        {# Entête de page #}
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-text">Page Type : Gestion des Éléments</h1>
                <p class="text-secondary text-sm">Template de référence pour les vues de type index, formulaires et contenus textuels.</p>
            </div>

            <div class="flex items-center gap-2">
                <twig:Button variant="primary" icon="fa-solid:plus">Créer un élément</twig:Button>
            </div>
        </div>

        {# SECTION 1 : DATATABLE EXEMPLE #}
        <section class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface shadow-sm">
            <div class="p-4 border-b border-secondary-200 dark:border-secondary-700">
                <h2 class="text-lg font-semibold text-text flex items-center gap-2">{{ ux_icon('ph:table-light', {class: 'h-5 w-5 text-primary'}) }} Liste des éléments (Exemple)</h2>
            </div>

            <div class="p-4">
                {# Filtres #}
                <form class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-4">
                    <div class="md:col-span-4">
                        <label for="search-elements" class="sr-only">Rechercher un élément</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary">{{ ux_icon('icon:search', {class: 'h-4 w-4'}) }}</span>
                            <input type="text" id="search-elements" class="w-full rounded-lg border border-secondary-200 bg-white px-10 py-2 text-sm text-text placeholder:text-secondary-400 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder:text-secondary-400 dark:focus:border-primary-400 dark:focus:ring-primary-900" placeholder="Rechercher par libellé ou code...">
                        </div>
                    </div>
                    <div class="md:col-span-3">
                        <label for="filter-state" class="sr-only">Filtrer par état</label>
                        <select id="filter-state" class="w-full rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100">
                            <option selected>Tous les états</option>
                            <option value="brouillon">Brouillon</option>
                            <option value="valide">Validé</option>
                        </select>
                    </div>
                    <div class="md:col-span-3">
                        <label for="filter-component" class="sr-only">Filtrer par composante</label>
                        <select id="filter-component" class="w-full rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100">
                            <option selected>Toutes les composantes</option>
                            <option value="IUT">IUT de Troyes</option>
                            <option value="SEN">Sciences Exactes et Naturelle</option>
                        </select>
                    </div>
                    <div class="md:col-span-2 flex items-center">
                        <twig:Button variant="secondary" :outline="true" size="sm">Réinitialiser</twig:Button>
                    </div>
                </form>

                {# Tableau #}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-secondary-200 text-sm">
                        <thead class="bg-secondary-50 text-left text-[11px] font-semibold text-secondary-600 uppercase tracking-wider dark:bg-secondary-900">
                            <tr>
                                <th class="px-4 py-3" style="width:10%">Code</th>
                                <th class="px-4 py-3" style="width:40%">Intitulé / Libellé</th>
                                <th class="px-4 py-3" style="width:15%">Composante</th>
                                <th class="px-4 py-3" style="width:15%">État</th>
                                <th class="px-4 py-3 text-right" style="width:20%">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-secondary-200 bg-white dark:bg-surface">
                            <tr class="hover:bg-secondary-50/50 dark:hover:bg-secondary-800/40">
                                <td class="px-4 py-3 font-medium text-text">INFO0301</td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-text">Développement Web Avancé</div>
                                    <div class="text-secondary text-xs">Dernière modification le 27/05/2026</div>
                                </td>
                                <td class="px-4 py-3"><twig:Badge label="IUT Troyes" variant="secondary" size="sm"/></td>
                                <td class="px-4 py-3"><twig:Badge label="Validé" variant="success" size="sm"/></td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <twig:Button variant="secondary" :outline="true" size="sm" icon="icon:edit" tooltip="Modifier"/>
                                        <twig:Button variant="danger" :outline="true" size="sm" icon="icon:delete" tooltip="Supprimer"/>
                                    </div>
                                </td>
                            </tr>
                            <tr class="hover:bg-secondary-50/50 dark:hover:bg-secondary-800/40">
                                <td class="px-4 py-3 font-medium text-text">MATH0102</td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-text">Algèbre Linéaire et Matrices</div>
                                    <div class="text-secondary text-xs">Créé le 19/05/2026</div>
                                </td>
                                <td class="px-4 py-3"><twig:Badge label="SEN Reims" variant="secondary" size="sm"/></td>
                                <td class="px-4 py-3"><twig:Badge label="En cours" variant="warning" size="sm"/></td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <twig:Button variant="secondary" :outline="true" size="sm" icon="icon:edit" tooltip="Modifier"/>
                                        <twig:Button variant="danger" :outline="true" size="sm" icon="icon:delete" tooltip="Supprimer"/>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                <div class="mt-4 flex items-center justify-between">
                    <div class="text-secondary text-sm">Affichage de 1 à 2 sur 2 éléments</div>
                    <div class="flex items-center gap-2">
                        <twig:Button variant="secondary" :outline="true" size="sm" icon="icon:chevron-left"/>
                        <div class="inline-flex items-center rounded-md border border-secondary-200 dark:border-secondary-700 bg-surface px-2 py-1 text-sm">
                            <span class="px-2 text-text">1</span>
                            <span class="px-2 text-secondary">2</span>
                        </div>
                        <twig:Button variant="secondary" :outline="true" size="sm" icon="icon:chevron-right"/>
                    </div>
                </div>
            </div>
        </section>

        {# SECTION 2 : FORMULAIRE EXEMPLE #}
        <section class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface shadow-sm p-4">
            <h3 class="text-lg font-semibold text-text mb-3">Formulaire Exemple (Design System & Alignements)</h3>
            <form class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="exemple_code" class="text-sm font-medium text-text dark:text-secondary-200">Code de la matière</label>
                        <input type="text" id="exemple_code" class="w-full rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text placeholder:text-secondary-400 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder:text-secondary-400" placeholder="Ex: INFO0301" required>
                        <div class="text-secondary text-xs mt-1 dark:text-secondary-400">Le code doit être unique et respecter la nomenclature Apogée.</div>
                    </div>
                    <div>
                        <label for="exemple_titre" class="text-sm font-medium text-text dark:text-secondary-200">Intitulé officiel</label>
                        <input type="text" id="exemple_titre" class="w-full rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text placeholder:text-secondary-400 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder:text-secondary-400" placeholder="Nom complet du module" required>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="exemple_type_enseignement" class="text-sm font-medium text-text dark:text-secondary-200">Type d'Enseignement</label>
                        <select id="exemple_type_enseignement" class="w-full rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100">
                            <option value="">Choisir un type...</option>
                            <option value="1">Tronc Commun</option>
                            <option value="2">Option / Parcours</option>
                        </select>
                    </div>
                    <div>
                        <label for="exemple_volume_cm" class="text-sm font-medium text-text dark:text-secondary-200">Volume Horaire CM</label>
                        <div class="flex items-center gap-2">
                            <input type="number" id="exemple_volume_cm" class="w-24 rounded-lg border border-secondary-200 bg-white px-3 py-2 text-sm text-text dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100" min="0" value="0">
                            <span class="text-secondary text-sm dark:text-secondary-400">heures</span>
                        </div>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-text dark:text-secondary-200">Boutons Radio En ligne</label>
                        <div class="flex gap-4 mt-2">
                            <label class="inline-flex items-center gap-2 text-sm text-text dark:text-secondary-200"><input type="radio" name="radioEx" checked class="form-radio"/> Oui</label>
                            <label class="inline-flex items-center gap-2 text-sm text-text dark:text-secondary-200"><input type="radio" name="radioEx" class="form-radio"/> Non</label>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="text-sm font-medium text-text dark:text-secondary-200">Description ou Objectifs (Éditeur)</label>
                    <div class="mt-2 rounded border border-secondary-200 bg-white p-3 dark:border-secondary-700 dark:bg-secondary-800">
                        <div class="text-secondary text-sm mb-2 dark:text-secondary-400">Editeur de démonstration</div>
                        <div class="min-h-[120px] text-text dark:text-secondary-100">Saisissez le texte de description ici...</div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-secondary-200 dark:border-secondary-700">
                    <twig:Button variant="secondary" :outline="true" size="sm">Annuler</twig:Button>
                    <twig:Button variant="primary" size="sm">Enregistrer les modifications</twig:Button>
                </div>
            </form>
        </section>

        {# SECTION 3 : CALLOUTS #}
        <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface shadow-sm p-4">
                <h4 class="text-lg font-semibold text-text mb-2">Alertes & Blocs Contextuels</h4>
                {{ component('alerte', { type: 'info', icone: 'fa-solid:info-circle', message: 'Ce bloc permet d\'attirer l\'attention de l\'utilisateur sur une règle de gestion.' }) }}
                {{ component('alerte', { type: 'danger', icone: 'fa-solid:exclamation-triangle', message: 'Le total des ECTS du semestre est inférieur à 30. Veuillez vérifier l\'arborescence.' }) }}
            </div>
            <div class="rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface shadow-sm p-4">
                <h4 class="text-lg font-semibold text-text mb-2">Typographie & Exemples</h4>
                <p class="text-text">Paragraphes, listes, et typographie standard conforme au design system.</p>
                <ul class="list-disc pl-5 mt-2 text-text">
                    <li>Premier point</li>
                    <li>Deuxième point</li>
                </ul>
            </div>
        </section>
    </div>
{% endblock %}