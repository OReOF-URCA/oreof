{% extends 'base.html.twig' %}

{% set header_title = 'tpl.admin.duplication.result.title'|trans({}, 'header') %}
{% set header_description = 'tpl.admin.duplication.result.description'|trans({}, 'header') %}

{% block bouton_header %}
    <twig:Button variant="secondary" icon="icon:arrow-left" href="{{ path('app_admin_duplication_campagne_index') }}">
        Retour à l'assistant
    </twig:Button>
{% endblock %}

{% block content %}
<div class="space-y-8 pb-12">

    {# BANNIÈRE RÉSULTAT #}
    <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="p-4 rounded-2xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                    <twig:UX:Icon name="ph:check-circle-bold" class="w-8 h-8" />
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <twig:Badge variant="success" size="sm">Bascule Réussie</twig:Badge>
                        <span class="text-xs text-slate-500 font-mono">{{ result.targetAnneeUniversitaire.libelle }}</span>
                    </div>
                    <h2 class="text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mt-1">
                        {{ result.targetCampagne.libelle }}
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        Traitement achevé avec succès en <strong>{{ result.executionTimeSeconds }} s</strong>. Total d'éléments créés : <strong>{{ result.totalCreated }}</strong>.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a href="{{ path('app_campagne_collecte_index') }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-primary-600 hover:bg-primary-700 text-white transition">
                    <twig:UX:Icon name="ph:folder-user-light" class="w-4 h-4" />
                    Voir les Campagnes
                </a>
                <a href="{{ path('app_admin_pilotage_campagne_index', {campagne_id: result.targetCampagne.id}) }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-slate-100 hover:bg-slate-200 text-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition">
                    <twig:UX:Icon name="ph:gauge-light" class="w-4 h-4" />
                    Tour de Contrôle
                </a>
            </div>
        </div>
    </div>

    {# DÉTAIL DES OBJETS CRÉÉS #}
    <div>
        <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-4 flex items-center gap-2">
            <twig:UX:Icon name="ph:stack-light" class="w-4 h-4 text-primary-500" />
            Synthèse des Objets et Données Dupliqués
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {% for key, count in result.createdCounts %}
                <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-xl p-4 shadow-sm">
                    <span class="text-xs text-slate-500 font-semibold uppercase tracking-wider block">
                        {{ key|replace({'_': ' '})|capitalize }}
                    </span>
                    <span class="text-2xl font-black text-slate-900 dark:text-slate-100 font-mono mt-1 block">
                        {{ count }}
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>

    {# JOURNAL D'EXÉCUTION #}
    <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider flex items-center gap-2">
            <twig:UX:Icon name="ph:terminal-window-light" class="w-4 h-4 text-slate-500" />
            Journal des Étapes d'Exécution
        </h3>
        <div class="bg-slate-900 text-slate-100 rounded-xl p-4 font-mono text-xs max-h-96 overflow-y-auto space-y-1.5">
            {% for log in result.logs %}
                <div class="flex items-start gap-2">
                    <span class="text-emerald-400">✓</span>
                    <span>{{ log }}</span>
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}
