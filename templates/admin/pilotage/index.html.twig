{% extends 'base.html.twig' %}

{% set header_title %}
    Tour de Contrôle
{% endset %}

{% block header %}
    Tour de Contrôle & Pilotage de Campagne
{% endblock %}

{% set header_description %}
    Tableau de bord stratégique : matrice d'avancement par composante, détection des goulets d'étranglement et alertes SLA.
{% endset %}

{% block content %}
<div class="space-y-8 pb-12">

    {# Sélecteur de Campagne & Synthèse #}
    <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl p-6 shadow-sm flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-300">
                    Campagne active
                </span>
                <span class="text-xs text-slate-400 font-mono">{{ selectedCampagne.anneeUniversitaire }}</span>
            </div>
            <h2 class="text-xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
                {{ selectedCampagne.libelle }}
            </h2>
            <p class="text-xs text-slate-500">
                Suivi de la collecte de l'offre de formation, des validations composantes, des avis de conseil et des votes CFVU.
            </p>
        </div>

        {# Sélecteur rapide de campagne #}
        <div class="flex items-center gap-3">
            <form method="get" action="{{ path('app_admin_pilotage_campagne_index') }}" class="flex items-center gap-2">
                <label for="campagne_id" class="text-xs font-bold text-slate-500 uppercase">Changer :</label>
                <select id="campagne_id"
                        name="campagne_id"
                        onchange="this.form.submit()"
                        class="text-xs rounded-xl border-secondary-200 dark:border-secondary-700 bg-surface py-2 pl-3 pr-8 font-semibold focus:ring-2 focus:ring-primary shadow-sm">
                    {% for c in allCampagnes %}
                        <option value="{{ c.id }}" {{ c.id == selectedCampagne.id ? 'selected' : '' }}>
                            {{ c.libelle }} ({{ c.anneeUniversitaire }})
                        </option>
                    {% endfor %}
                </select>
                <input type="hidden" name="threshold" value="{{ thresholdDays }}">
            </form>
        </div>
    </div>

    {# KPIs Principaux #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <twig:Kpi
            title="Avancement Global"
            :value="overview.validatedCount"
            :total="overview.totalParcours"
            :percent="overview.globalProgressPercent"
            description="Parcours validés CFVU / Publiés"
            variant="success"
            icon="ph:chart-polar" />

        <twig:Kpi
            title="Dossiers Stagnants"
            :value="slaData.stagnantCount"
            :description="'Sans évolution > ' ~ thresholdDays ~ ' jours'"
            variant="danger"
            icon="ph:warning-octagon" />

        <twig:Kpi
            title="Offre Suivie"
            :value="overview.totalParcours"
            description="Parcours sur la campagne"
            variant="primary"
            icon="ph:path" />

        <twig:Kpi
            title="Composantes Actives"
            :value="matrix|length"
            description="Structures d'enseignement"
            variant="info"
            icon="ph:buildings" />
    </div>

    {# Répartition visuelle par grande phase #}
    <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl p-6 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-secondary-200 dark:border-secondary-700 pb-3">
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <i class="ph ph-flow-arrow text-primary"></i>
                Distribution des Parcours par Phase de Validation
            </h3>
            <span class="text-xs font-semibold text-slate-500">
                {{ overview.totalParcours }} parcours au total
            </span>
        </div>

        {# Barre composite d'avancement #}
        <div class="space-y-3">
            <div class="w-full h-4 rounded-full bg-slate-100 dark:bg-slate-800 flex overflow-hidden shadow-inner">
                {% if overview.totalParcours > 0 %}
                    {% set pRedac = (overview.phaseCounts.redaction / overview.totalParcours) * 100 %}
                    {% set pLocal = (overview.phaseCounts.locale / overview.totalParcours) * 100 %}
                    {% set pCentrale = (overview.phaseCounts.centrale / overview.totalParcours) * 100 %}
                    {% set pCfvu = (overview.phaseCounts.cfvu_publie / overview.totalParcours) * 100 %}
                    {% set pReserves = (overview.phaseCounts.reserves / overview.totalParcours) * 100 %}

                    <div style="width: {{ pRedac }}%" class="bg-amber-400 h-full transition-all" title="Rédaction : {{ overview.phaseCounts.redaction }}"></div>
                    <div style="width: {{ pLocal }}%" class="bg-sky-400 h-full transition-all" title="Validation Locale : {{ overview.phaseCounts.locale }}"></div>
                    <div style="width: {{ pCentrale }}%" class="bg-indigo-500 h-full transition-all" title="Validation Centrale : {{ overview.phaseCounts.centrale }}"></div>
                    <div style="width: {{ pCfvu }}%" class="bg-emerald-500 h-full transition-all" title="CFVU & Publié : {{ overview.phaseCounts.cfvu_publie }}"></div>
                    <div style="width: {{ pReserves }}%" class="bg-rose-500 h-full transition-all" title="Réserves & Anomalies : {{ overview.phaseCounts.reserves }}"></div>
                {% endif %}
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 pt-2">
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 h-3 rounded-full bg-amber-400 shrink-0"></span>
                    <span class="text-slate-600 dark:text-slate-300 font-medium">Rédaction ({{ overview.phaseCounts.redaction }})</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 h-3 rounded-full bg-sky-400 shrink-0"></span>
                    <span class="text-slate-600 dark:text-slate-300 font-medium">Validation Locale ({{ overview.phaseCounts.locale }})</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 h-3 rounded-full bg-indigo-500 shrink-0"></span>
                    <span class="text-slate-600 dark:text-slate-300 font-medium">Validation Centrale ({{ overview.phaseCounts.centrale }})</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 h-3 rounded-full bg-emerald-500 shrink-0"></span>
                    <span class="text-slate-600 dark:text-slate-300 font-medium">CFVU / Publié ({{ overview.phaseCounts.cfvu_publie }})</span>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="w-3 h-3 rounded-full bg-rose-500 shrink-0"></span>
                    <span class="text-slate-600 dark:text-slate-300 font-medium">Réserves ({{ overview.phaseCounts.reserves }})</span>
                </div>
            </div>
        </div>
    </div>

    {# Section 1B : Matrice d'avancement par Composante #}
    {% include 'admin/pilotage/_matrix_composantes.html.twig' %}

    {# Section 1A : Dossiers Stagnants & Délais #}
    <div class="space-y-6">
        {% include 'admin/pilotage/_stagnant_dossiers.html.twig' %}
        {% include 'admin/pilotage/_sla_durations.html.twig' %}
    </div>

</div>
{% endblock %}
