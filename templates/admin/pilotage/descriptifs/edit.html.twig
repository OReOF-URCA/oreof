{% extends 'base.html.twig' %}

{% set header_title = 'Édition des descriptifs haut de page' %}
{% set header_description = parcours.display %}

{% block bouton_header %}
    <twig:Button variant="secondary" icon="icon:arrow-left" href="{{ path('app_admin_pilotage_descriptifs_index') }}">
        Retour à la liste
    </twig:Button>
{% endblock %}

{% block content %}
    <div class="max-w-4xl mx-auto space-y-6">
        <div class="rounded-2xl border border-secondary-200 bg-white p-6 shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
            {{ include('admin/pilotage/descriptifs/_modal_edit.html.twig') }}

            <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-700">
                <a href="{{ path('app_admin_pilotage_descriptifs_index') }}" class="btn btn-secondary">
                    Annuler
                </a>
                <button type="submit" form="modal_form" class="btn btn-primary">
                    Enregistrer les modifications
                </button>
            </div>
        </div>
    </div>
{% endblock %}
