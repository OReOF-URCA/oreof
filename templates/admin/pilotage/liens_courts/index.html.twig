{% extends 'base.html.twig' %}

{% set header_title = 'app_admin_pilotage_liens_courts_index.title'|trans({}, 'header') %}
{% set header_description = 'app_admin_pilotage_liens_courts_index.description'|trans({}, 'header') %}

{% block bouton_header %}
    <twig:Button variant="secondary" icon="icon:arrow-left" href="{{ path('app_section_pilotage') }}">
        Pilotage
    </twig:Button>
{% endblock %}

{% block content %}
    <div class="space-y-8 pb-12">
        {# KPIs Principaux #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <twig:Kpi
                    title="Total parcours"
                    value="{{ stats.total }}"
                    description="Parcours de la campagne"
                    variant="primary"
                    icon="ph:folder-notch-open-light"/>

            <twig:Kpi
                    title="Avec lien court"
                    value="{{ stats.count_with_link }}"
                    description="Lien permanent renseigné"
                    variant="success"
                    icon="ph:link-bold"/>

            <twig:Kpi
                    title="Sans lien court"
                    value="{{ stats.count_without_link }}"
                    description="Lien à renseigner"
                    variant="warning"
                    icon="ph:link-break-light"/>

            <twig:Kpi
                    title="Complétude"
                    value="{{ stats.percent }}%"
                    description="Taux de couverture des liens"
                    variant="info"
                    icon="ph:chart-pie-slice-light"/>
        </div>

        {# UX-DATATABLE CARD #}
        {{ include('_ui/_datatable_card.html.twig', { table: table }) }}
    </div>
{% endblock %}
