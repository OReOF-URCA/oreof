<div class="space-y-5">
    {# Contexte du parcours #}
    <div class="rounded-xl border border-secondary-200 bg-secondary-50 p-4 dark:border-secondary-700 dark:bg-secondary-800/50">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h4 class="text-sm font-bold text-text">{{ parcours.display }}</h4>
                {% if parcours.formation %}
                    <p class="text-xs text-secondary-600 dark:text-secondary-400 mt-1">
                        <span class="font-medium">{{ parcours.formation.displayLong ?: parcours.formation.display }}</span>
                        {% if parcours.formation.composantePorteuse %}
                            — <span
                                class="text-secondary-500">{{ parcours.formation.composantePorteuse.libelle }}</span>
                        {% endif %}
                    </p>
                {% endif %}
            </div>
            <span class="rounded bg-secondary-200 px-2 py-0.5 font-mono text-xs text-secondary-700 dark:bg-secondary-700 dark:text-secondary-200">
                #{{ parcours.id }}
            </span>
        </div>
    </div>

    {# Formulaire #}
    {% form_theme form 'communs/form_theme_v2.html.twig' %}
    {{ form_start(form, {'attr': {'id': 'modal_form', 'autocomplete': 'off'}}) }}

    <div class="space-y-4">
        {{ form_row(form.lienCourt) }}

        {% if parcours.lienCourt %}
            <div class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-3.5 text-xs text-secondary-700 dark:border-secondary-700 dark:bg-secondary-900/40 dark:text-secondary-300 flex items-center justify-between gap-2">
                <span class="flex items-center gap-1.5 font-semibold text-secondary-800 dark:text-secondary-200">
                    <twig:UX:Icon name="ph:link-light" class="w-4 h-4 text-primary"/>
                    Lien actuellement enregistré :
                </span>
                <a href="{{ parcours.lienCourt }}" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1 px-2 py-1 rounded text-[11px] font-semibold bg-secondary-200 hover:bg-secondary-300 text-secondary-900 dark:bg-secondary-800 dark:hover:bg-secondary-700 dark:text-secondary-100 transition">
                    Ouvrir le lien
                    <twig:UX:Icon name="ph:arrow-square-out-light" class="w-3 h-3"/>
                </a>
            </div>
        {% endif %}
    </div>

    {{ form_end(form) }}
</div>
