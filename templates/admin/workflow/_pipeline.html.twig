{# Pipeline Nominal (Happy Path) #}
<div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl p-6 shadow-sm space-y-6">
    <div class="border-b border-secondary-200 dark:border-secondary-700 pb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <span>⚡ Cycle Nominal de Validation (Happy Path)</span>
            </h3>
            <p class="text-xs text-slate-500">Déroulement standard étape par étape sans boucles de rejet ou de correction.</p>
        </div>
        <div class="flex items-center gap-2 text-xs">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-medium">
                {{ workflowData.pipeline|length }} étapes principales
            </span>
        </div>
    </div>

    {# Stepper horizontal / vertical #}
    <div class="relative py-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            {% for step in workflowData.pipeline %}
                <div class="relative p-4 rounded-xl border {{ step.tailwindBorder }} {{ step.tailwindBg }} shadow-sm flex flex-col justify-between space-y-3 transition hover:scale-[1.02]">
                    <div class="flex items-start justify-between">
                        <span class="flex items-center justify-center w-7 h-7 rounded-full bg-white dark:bg-slate-900 shadow-sm border border-secondary-200 dark:border-secondary-700 text-xs font-bold text-slate-700 dark:text-slate-300">
                            {{ loop.index }}
                        </span>
                        {% if step.count > 0 %}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-primary text-white shadow-sm">
                                {{ step.count }} en cours
                            </span>
                        {% else %}
                            <span class="text-[11px] text-slate-400 font-mono">
                                0
                            </span>
                        {% endif %}
                    </div>

                    <div>
                        <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100 mb-1">
                            {{ step.label }}
                        </h4>
                        <span class="font-mono text-[11px] text-slate-500 block">
                            {{ step.name }}
                        </span>
                    </div>

                    <div class="pt-2 border-t border-secondary-200/60 dark:border-secondary-700/60 flex items-center justify-between text-[11px] text-slate-500">
                        <span class="flex items-center">
                            <i class="ph {{ step.icon|default('ph-circle') }} mr-1"></i>
                            {{ step.color|upper }}
                        </span>
                        <span class="text-[10px] font-semibold text-slate-400">
                            {{ step.outgoingTransitions|length }} action(s) sortante(s)
                        </span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
