{# Matrice des Transitions et Droits #}
<div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-4 border-b border-secondary-200 dark:border-secondary-700 bg-slate-50/50 dark:bg-slate-900/30 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Matrice Complète des Transitions</h3>
            <p class="text-xs text-slate-500">Audit de l'ensemble des règles de passage, formulaires exigés et alertes configurées dans <span class="font-mono">workflow.yaml</span>.</p>
        </div>
        <div class="text-xs font-semibold text-slate-500 bg-surface px-3 py-1.5 rounded-lg border border-secondary-200 dark:border-secondary-700">
            {{ workflowData.transitions|length }} transition(s) définie(s)
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
            <thead>
                <tr class="bg-slate-100/70 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 font-semibold border-b border-secondary-200 dark:border-secondary-700">
                    <th class="py-3 px-4">Transition & Action</th>
                    <th class="py-3 px-4">Type</th>
                    <th class="py-3 px-4">État(s) d'origine</th>
                    <th class="py-3 px-4">État(s) de destination</th>
                    <th class="py-3 px-4">Formulaire Requis</th>
                    <th class="py-3 px-4">Destinataires Emails</th>
                    <th class="py-3 px-4">Étape Validation / Garde</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-secondary-100 dark:divide-secondary-800 text-slate-700 dark:text-slate-300">
                {% for transition in workflowData.transitions %}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                        <td class="py-3 px-4 font-medium">
                            <div class="font-semibold text-slate-900 dark:text-slate-100 text-sm">
                                {{ transition.title }}
                            </div>
                            <span class="font-mono text-[11px] text-slate-400">{{ transition.name }}</span>
                        </td>

                        <td class="py-3 px-4">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold uppercase border {{ transition.badgeClass }}">
                                <i class="ph {{ transition.buttonIcon|default('ph-arrow-right') }} mr-1"></i>
                                {{ transition.type }}
                            </span>
                        </td>

                        <td class="py-3 px-4">
                            <div class="space-y-1">
                                {% for fromState in transition.from %}
                                    {% set place = workflowData.places[fromState]|default(null) %}
                                    <span class="inline-block px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 text-[11px]">
                                        {{ place ? place.label : fromState }}
                                    </span>
                                {% endfor %}
                            </div>
                        </td>

                        <td class="py-3 px-4">
                            <div class="space-y-1">
                                {% for toState in transition.to %}
                                    {% set place = workflowData.places[toState]|default(null) %}
                                    <span class="inline-block px-2 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-[11px] font-medium">
                                        {{ place ? place.label : toState }}
                                    </span>
                                {% endfor %}
                            </div>
                        </td>

                        <td class="py-3 px-4">
                            {% if transition.formShortName %}
                                <div class="p-1.5 rounded bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 inline-block">
                                    <span class="font-mono font-bold text-amber-800 dark:text-amber-200 text-[11px]">{{ transition.formShortName }}</span>
                                    {% if transition.formFields|length > 0 %}
                                        <div class="text-[10px] text-amber-600 dark:text-amber-400">
                                            Champs: {{ transition.formFields|join(', ') }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="text-slate-400 italic text-[11px]">Aucun formulaire</span>
                            {% endif %}
                        </td>

                        <td class="py-3 px-4">
                            {% if transition.recipients|length > 0 %}
                                <div class="flex flex-wrap gap-1">
                                    {% for r in transition.recipients %}
                                        <span class="px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-900/60 text-sky-800 dark:text-sky-200 text-[10px] font-bold">
                                            {{ r }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-slate-400 italic text-[11px]">Non notifié</span>
                            {% endif %}
                        </td>

                        <td class="py-3 px-4">
                            {% if transition.validationStep %}
                                <span class="font-mono text-indigo-600 dark:text-indigo-400 font-semibold text-[11px] block">
                                    step: {{ transition.validationStep }}
                                </span>
                            {% endif %}
                            {% if transition.guard %}
                                <span class="font-mono text-slate-500 text-[10px] block truncate max-w-xs" title="{{ transition.guard }}">
                                    guard: {{ transition.guard }}
                                </span>
                            {% endif %}
                            {% if not transition.validationStep and not transition.guard %}
                                <span class="text-slate-400 italic text-[11px]">-</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
