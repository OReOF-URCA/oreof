{% extends 'base.html.twig' %}

{% set header_title = referentiel.libelle %}
{% set header_description = 'Gestion des valeurs du référentiel ' ~ referentiel.code %}

{% block content %}
    <div class="rounded-2xl border border-secondary-200 bg-white p-6 shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <caption class="sr-only">Valeurs de {{ referentiel.libelle }}</caption>
                <thead class="border-b border-secondary-200 bg-secondary-50 dark:border-secondary-700 dark:bg-secondary-800">
                <tr>
                    <th scope="col" class="px-4 py-3 text-left font-semibold">Code</th>
                    <th scope="col" class="px-4 py-3 text-left font-semibold">Libellé</th>
                    <th scope="col" class="px-4 py-3 text-left font-semibold">Valeur historique</th>
                    <th scope="col" class="px-4 py-3 text-center font-semibold">Ordre</th>
                    <th scope="col" class="px-4 py-3 text-left font-semibold">Statut</th>
                    <th scope="col" class="px-4 py-3 text-right font-semibold">Actions</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
                {% for valeur in valeurs %}
                    <tr class="hover:bg-secondary-50 dark:hover:bg-secondary-800">
                        <td class="px-4 py-3 font-mono">{{ valeur.code }}</td>
                        <td class="px-4 py-3">{{ valeur.libelle }}</td>
                        <td class="px-4 py-3 font-mono">{{ valeur.legacyValue ?? '—' }}</td>
                        <td class="px-4 py-3 text-center">{{ valeur.ordre }}</td>
                        <td class="px-4 py-3">{{ valeur.actif ? 'Active' : 'Inactive' }}</td>
                        <td class="px-4 py-3 text-right">
                            {% if referentiel.administrable %}
                                <a href="{{ path('admin_referentiel_edit_value', {id: valeur.id}) }}"
                                   data-action="click->modalturbo#open"
                                   data-turbo="true"
                                   class="inline-flex items-center gap-1 rounded-md border border-warning-300 bg-warning-50 px-2.5 py-1 text-xs font-semibold text-warning-700 transition hover:bg-warning-100 dark:border-warning-500 dark:bg-warning-900 dark:text-warning-300">
                                    <twig:UX:Icon name="icon:edit" class="h-4 w-4"/>
                                    <span>Modifier</span>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-4 py-8 text-center text-secondary-500">Aucune valeur dans ce référentiel.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block bouton_header %}
    <a href="{{ path('admin_referentiel_index') }}" class="btn border border-secondary-300 bg-secondary-50 text-secondary-700 hover:bg-secondary-100 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200">
        <twig:UX:Icon name="icon:arrow-left" class="h-4 w-4"/>
        <span>Référentiels</span>
    </a>
    {% if referentiel.extensible %}
        <a data-action="click->modalturbo#open" data-turbo="true"
           href="{{ path('admin_referentiel_add_value', {id: referentiel.id}) }}"
           class="btn border border-success-300 bg-success-50 text-success-700 hover:bg-success-100 dark:border-success-500 dark:bg-success-900 dark:text-success-300">
            <twig:UX:Icon name="icon:add" class="h-4 w-4"/>
            <span>Ajouter une valeur</span>
        </a>
    {% endif %}
{% endblock %}
