{% extends 'base.html.twig' %}
{% block body %}
<main class="container py-4">
<h1>Référentiels</h1>
<ul>
{% for referentiel in referentiels %}
<li><a href="{{ path('admin_referentiel_valeurs', {id: referentiel.id}) }}">{{ referentiel.libelle }}</a></li>
{% else %}<li>Aucun référentiel disponible.</li>{% endfor %}
</ul>
</main>
{% endblock %}
