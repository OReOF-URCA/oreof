{% extends 'base.html.twig' %}

{% block content %}
    <div class="space-y-6"
         {{ stimulus_controller('notification-center', {
             toggleUrl: path('app_user_mes_notifications_toggle'),
             resetUrl: path('app_user_mes_notifications_reset')
         }) }}
    >


        {# 1) Paramètres globaux par défaut #}
        <section
                class="rounded-2xl border border-secondary-200 bg-white p-5 shadow-xs dark:border-secondary-700 dark:bg-secondary-900 sm:p-6"
                data-setting-row>
            <div class="border-b border-secondary-100 pb-4 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-sm font-black uppercase tracking-wider text-secondary-500 dark:text-secondary-400">
                                Canaux par défaut globaux
                            </h2>
                            <div class="inline-flex items-center gap-1.5 rounded-full border border-primary-200 bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700 dark:border-primary-800 dark:bg-primary-950/40 dark:text-primary-300">
                                <twig:UX:Icon name="ph:sliders-horizontal" class="w-3.5 h-3.5"/>
                                <span><span data-notification-center-target="customCount">0</span> règle(s) personnalisée(s)</span>
                            </div>
                        </div>
                        <p class="mt-1 text-sm text-secondary-600 dark:text-secondary-400">
                            Ces préférences s'appliquent automatiquement à l'ensemble des événements si aucune règle
                            spécifique n'a été définie.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                {# Card Email #}
                <div class="flex items-center justify-between rounded-xl border border-secondary-200 bg-secondary-50/60 p-4 transition hover:border-secondary-300 dark:border-secondary-700 dark:bg-secondary-800/40">
                    <div class="flex items-start gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-100 text-primary-700 dark:bg-primary-950/50 dark:text-primary-300">
                            <twig:UX:Icon name="icon:mail" class="w-5 h-5"/>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-secondary-800 dark:text-secondary-100">
                                Notifications par Email
                            </div>
                            <div class="text-xs text-secondary-500 dark:text-secondary-400">
                                Courriels envoyés à votre adresse institutionnelle
                            </div>
                        </div>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer select-none"
                           title="Activer / désactiver les notifications email globales">
                        <input type="checkbox"
                               {{ global.email ? 'checked' : '' }}
                               data-action="change->notification-center#toggle"
                               data-channel="email"
                               class="sr-only peer"/>
                        <div class="w-10 h-5.5 bg-secondary-200 peer-focus:outline-none rounded-full peer dark:bg-secondary-700 peer-checked:after:translate-x-4.5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-secondary-300 after:border after:rounded-full after:h-4.5 after:w-4.5 after:transition-all dark:border-secondary-600 peer-checked:bg-primary"></div>
                    </label>
                </div>

                {# Card In-App #}
                <div class="flex items-center justify-between rounded-xl border border-secondary-200 bg-secondary-50/60 p-4 transition hover:border-secondary-300 dark:border-secondary-700 dark:bg-secondary-800/40">
                    <div class="flex items-start gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300">
                            <twig:UX:Icon name="icon:bell" class="w-5 h-5"/>
                        </div>
                        <div>
                            <div class="text-sm font-bold text-secondary-800 dark:text-secondary-100">
                                Notifications dans l'application
                            </div>
                            <div class="text-xs text-secondary-500 dark:text-secondary-400">
                                Alertes consultables depuis la cloche dans la barre supérieure
                            </div>
                        </div>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer select-none"
                           title="Activer / désactiver les notifications dans l'application">
                        <input type="checkbox"
                               {{ global.inapp ? 'checked' : '' }}
                               data-action="change->notification-center#toggle"
                               data-channel="inapp"
                               class="sr-only peer"/>
                        <div class="w-10 h-5.5 bg-secondary-200 peer-focus:outline-none rounded-full peer dark:bg-secondary-700 peer-checked:after:translate-x-4.5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-secondary-300 after:border after:rounded-full after:h-4.5 after:w-4.5 after:transition-all dark:border-secondary-600 peer-checked:bg-primary"></div>
                    </label>
                </div>
            </div>

            {# Explication de l'héritage #}
            <div class="mt-4 flex items-start gap-3 rounded-xl border border-info-200 bg-info-50/60 p-3 text-xs text-info-900 dark:border-info-900/60 dark:bg-info-950/20 dark:text-info-300">
                <twig:UX:Icon name="icon:info" class="w-4 h-4 text-info-600 shrink-0 mt-0.5"/>
                <div class="space-y-0.5">
                    <span class="font-semibold">Fonctionnement en cascade :</span>
                    <span>Les notifications suivent la hiérarchie <strong>Global ➔ Workflow ➔ Étape ➔ Transition</strong>. Par défaut, chaque niveau hérite de son parent. Dès qu'un commutateur est basculé, la règle devient <strong>Personnalisée</strong>. Vous pouvez à tout moment rétablir l'héritage d'un clic.</span>
                </div>
            </div>
        </section>

        {# 2) Onglets de sélection du Workflow #}
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-black uppercase tracking-wider text-secondary-500 dark:text-secondary-400">
                        Workflows disponibles
                    </h2>
                    <p class="text-xs text-secondary-500 dark:text-secondary-400">
                        Sélectionnez un workflow pour configurer ses notifications par étape et par action.
                    </p>
                </div>
            </div>

            {# Onglets des workflows #}
            <div class="flex flex-wrap items-center gap-2 border-b border-secondary-200 pb-3 dark:border-secondary-700">
                {% for wf in workflows %}
                    <button type="button"
                            data-notification-center-target="workflowTab"
                            data-action="click->notification-center#switchWorkflow"
                            data-workflow-name="{{ wf.name }}"
                            class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition border {{ loop.first ? 'bg-primary text-white border-primary shadow-xs' : 'bg-white text-secondary-700 border-secondary-200 hover:bg-secondary-50 hover:text-secondary-900 dark:bg-secondary-800 dark:text-secondary-300 dark:border-secondary-700 dark:hover:bg-secondary-700' }}">
                        <twig:UX:Icon name="{{ wf.icon }}" class="w-4 h-4"/>
                        <span>{{ wf.label }}</span>
                        <span data-tab-count
                              class="inline-flex items-center rounded-full px-1.5 py-0.2 text-[10px] font-bold {{ loop.first ? 'bg-white/20 text-white' : 'bg-secondary-100 text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300' }}">
                            {{ wf.places|length }}
                        </span>
                    </button>
                {% endfor %}
            </div>

            {# Panneaux des workflows #}
            {% for wf in workflows %}
                {% set totalTransitions = 0 %}
                {% for p in wf.places %}
                    {% set totalTransitions = totalTransitions + p.transitions|length %}
                {% endfor %}

                <div data-notification-center-target="workflowPanel"
                     data-workflow-name="{{ wf.name }}"
                     class="{{ loop.first ? '' : 'hidden' }} space-y-4">

                    <section
                            class="space-y-4 rounded-2xl border border-secondary-200 bg-white p-5 shadow-xs dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
                        {# En-tête du workflow #}
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between border-b border-secondary-100 pb-4 dark:border-secondary-800">
                            <div class="space-y-0.5">
                                <div class="flex items-center gap-2">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-950/50 dark:text-primary-300">
                                        <twig:UX:Icon name="{{ wf.icon }}" class="w-4 h-4"/>
                                    </div>
                                    <h3 class="text-base font-bold text-secondary-900 dark:text-secondary-100">
                                        {{ wf.label }}
                                    </h3>
                                    <span class="text-xs font-mono text-secondary-400">({{ wf.name }})</span>
                                    <span class="inline-flex items-center rounded-full bg-secondary-100 px-2.5 py-0.5 text-xs font-semibold text-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">
                                        {{ wf.places|length }} étapes
                                    </span>
                                    <span class="hidden sm:inline-flex items-center rounded-full bg-secondary-100 px-2.5 py-0.5 text-xs font-semibold text-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">
                                        {{ totalTransitions }} actions
                                    </span>
                                </div>
                                {% if wf.description %}
                                    <p class="text-xs text-secondary-500 dark:text-secondary-400">
                                        {{ wf.description }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>

                        {# Niveau workflow par défaut #}
                        <div class="flex flex-col gap-3 rounded-xl border border-secondary-200 bg-secondary-50/80 p-4 sm:flex-row sm:items-center sm:justify-between dark:border-secondary-700 dark:bg-secondary-800/40"
                             data-setting-row
                             data-is-custom="{{ wf.resolved.source == 'workflow' ? 'true' : 'false' }}">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-bold text-secondary-900 dark:text-secondary-100">
                                        Valeur par défaut pour {{ wf.label }}
                                    </span>
                                    {% if wf.resolved.source == 'workflow' %}
                                        <span data-badge
                                              class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                                            Personnalisé
                                        </span>
                                    {% else %}
                                        <span data-badge
                                              class="inline-flex items-center rounded-full bg-secondary-100 px-2 py-0.5 text-[11px] font-medium text-secondary-600 dark:bg-secondary-800 dark:text-secondary-400">
                                            Hérité : {{ wf.resolved.source }}
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-xs text-secondary-500 dark:text-secondary-400">
                                    S'applique à toutes les étapes de ce workflow qui ne sont pas explicitement
                                    personnalisées.
                                </p>
                            </div>

                            <div class="shrink-0">
                                {% include 'components/_notif_toggles.html.twig' with {
                                    workflow: wf.name,
                                    place: null,
                                    transition: null,
                                    channels: wf.resolved.channels,
                                    inherited: wf.resolved.source != 'workflow'
                                } %}
                            </div>
                        </div>

                        {# Barre d'outils interactive (Recherche & Filtres) #}
                        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:justify-between border-t border-secondary-100 dark:border-secondary-800">
                            <div class="relative flex-1 max-w-sm">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <twig:UX:Icon name="icon:search" class="w-4 h-4 text-secondary-400"/>
                                </div>
                                <input type="text"
                                       placeholder="Filtrer une étape ou action..."
                                       data-action="input->notification-center#filter"
                                       class="block w-full rounded-xl border border-secondary-200 bg-secondary-50/50 pl-9 pr-3 py-1.5 text-xs text-secondary-900 placeholder-secondary-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:bg-secondary-900"/>
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                                <div class="inline-flex rounded-xl border border-secondary-200 bg-secondary-50 p-0.5 dark:border-secondary-700 dark:bg-secondary-800">
                                    <button type="button"
                                            data-notification-center-target="filterBtn"
                                            data-status="all"
                                            data-action="click->notification-center#filterStatus"
                                            class="rounded-lg border border-primary-300 bg-primary-50 px-2.5 py-1 text-xs font-semibold text-primary-700 dark:border-primary-700 dark:bg-primary-950/40 dark:text-primary-300 transition">
                                        Tous
                                    </button>
                                    <button type="button"
                                            data-notification-center-target="filterBtn"
                                            data-status="custom"
                                            data-action="click->notification-center#filterStatus"
                                            class="rounded-lg border border-secondary-200 bg-white px-2.5 py-1 text-xs font-semibold text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-400 transition hover:text-secondary-900 dark:hover:text-secondary-200">
                                        Personnalisés
                                    </button>
                                    <button type="button"
                                            data-notification-center-target="filterBtn"
                                            data-status="inherited"
                                            data-action="click->notification-center#filterStatus"
                                            class="rounded-lg border border-secondary-200 bg-white px-2.5 py-1 text-xs font-semibold text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-400 transition hover:text-secondary-900 dark:hover:text-secondary-200">
                                        Hérités
                                    </button>
                                </div>

                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            data-action="click->notification-center#expandAll"
                                            class="inline-flex items-center gap-1 rounded-xl border border-secondary-200 bg-white px-2.5 py-1.5 text-xs font-medium text-secondary-600 hover:bg-secondary-50 hover:text-secondary-900 transition dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300 dark:hover:bg-secondary-700"
                                            title="Déplier toutes les étapes de ce workflow">
                                        <span>Tout déplier</span>
                                    </button>
                                    <button type="button"
                                            data-action="click->notification-center#collapseAll"
                                            class="inline-flex items-center gap-1 rounded-xl border border-secondary-200 bg-white px-2.5 py-1.5 text-xs font-medium text-secondary-600 hover:bg-secondary-50 hover:text-secondary-900 transition dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300 dark:hover:bg-secondary-700"
                                            title="Replier toutes les étapes de ce workflow">
                                        <span>Tout replier</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        {# Étapes du workflow #}
                        <div class="space-y-3 pt-1">
                            {% for p in wf.places %}
                                <details
                                        class="group rounded-2xl border border-secondary-200 bg-white shadow-xs dark:border-secondary-700 dark:bg-secondary-900 transition hover:border-secondary-300 dark:hover:border-secondary-600"
                                        data-notification-center-target="step"
                                        data-step-name="{{ p.name }}"
                                        data-step-label="{{ p.label|lower }}">
                                    {# En-tête de l'étape #}
                                    <summary
                                            class="flex flex-col gap-3 p-4 cursor-pointer select-none sm:flex-row sm:items-center sm:justify-between list-none [&::-webkit-details-marker]:hidden"
                                            data-setting-row
                                            data-is-custom="{{ p.resolved.source == 'step' ? 'true' : 'false' }}">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <twig:UX:Icon name="icon:chevron-right"
                                                          class="w-4 h-4 text-secondary-400 group-open:rotate-90 transition-transform duration-200 shrink-0"/>

                                            <div class="space-y-0.5 min-w-0">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="text-sm font-bold text-secondary-900 dark:text-secondary-100">
                                                        Étape : {{ p.label }}
                                                    </span>
                                                    <span class="inline-flex items-center rounded-full bg-secondary-100 px-2 py-0.5 text-[11px] font-medium text-secondary-600 dark:bg-secondary-800 dark:text-secondary-400">
                                                        {{ p.transitions|length }} action{{ p.transitions|length > 1 ? 's' : '' }}
                                                    </span>
                                                    <span class="text-[11px] font-mono text-secondary-400 dark:text-secondary-500 hidden md:inline">
                                                        ({{ p.name }})
                                                    </span>
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    {% if p.resolved.source == 'step' %}
                                                        <span data-badge
                                                              class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                                                            Personnalisé
                                                        </span>
                                                    {% else %}
                                                        <span data-badge
                                                              class="inline-flex items-center rounded-full bg-secondary-100 px-2 py-0.5 text-[11px] font-medium text-secondary-600 dark:bg-secondary-800 dark:text-secondary-400">
                                                            Hérité : {{ p.resolved.source }}
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="shrink-0 flex items-center gap-3">
                                            {% include 'components/_notif_toggles.html.twig' with {
                                                workflow: wf.name,
                                                place: p.name,
                                                transition: null,
                                                channels: p.resolved.channels,
                                                inherited: p.resolved.source != 'step'
                                            } %}
                                        </div>
                                    </summary>

                                    {# Transitions partant de l'étape #}
                                    <div class="border-t border-secondary-100 bg-secondary-50/50 p-4 dark:border-secondary-800 dark:bg-secondary-950/20">
                                        {% if p.transitions|length > 0 %}
                                            <div class="space-y-2">
                                                <div class="hidden sm:flex items-center justify-between px-3 py-1 text-[11px] font-black uppercase tracking-wider text-secondary-400 dark:text-secondary-500">
                                                    <span>Action / Transition</span>
                                                    <span>Canaux & Héritage</span>
                                                </div>

                                                {% for t in p.transitions %}
                                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 rounded-xl border border-secondary-100 bg-white dark:border-secondary-800 dark:bg-secondary-900 shadow-2xs hover:border-secondary-200 dark:hover:border-secondary-700 transition"
                                                         data-setting-row
                                                         data-transition-row
                                                         data-transition-name="{{ t.name }}"
                                                         data-transition-label="{{ t.label|lower }}"
                                                         data-is-custom="{{ t.resolved.source == 'transition' ? 'true' : 'false' }}">
                                                        <div class="space-y-0.5">
                                                            <div class="flex items-center gap-2">
                                                                <twig:UX:Icon name="icon:chevron-left"
                                                                              class="w-3 h-3 text-secondary-400 rotate-180 shrink-0"/>
                                                                <span class="text-xs font-semibold text-secondary-800 dark:text-secondary-200">
                                                                    {{ t.label }}
                                                                </span>
                                                                <span class="text-[10px] font-mono text-secondary-400 dark:text-secondary-500 hidden md:inline">
                                                                    ({{ t.name }})
                                                                </span>
                                                            </div>

                                                            <div class="flex items-center gap-2 pl-5">
                                                                {% if t.resolved.source == 'transition' %}
                                                                    <span data-badge
                                                                          class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.2 text-[10px] font-semibold text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                                                                        Personnalisé
                                                                    </span>
                                                                {% else %}
                                                                    <span data-badge
                                                                          class="inline-flex items-center rounded-full bg-secondary-100 px-2 py-0.2 text-[10px] font-medium text-secondary-600 dark:bg-secondary-800 dark:text-secondary-400">
                                                                        Hérité : {{ t.resolved.source }}
                                                                    </span>
                                                                {% endif %}
                                                            </div>
                                                        </div>

                                                        <div class="shrink-0">
                                                            {% include 'components/_notif_toggles.html.twig' with {
                                                                workflow: wf.name,
                                                                place: p.name,
                                                                transition: t.name,
                                                                channels: t.resolved.channels,
                                                                inherited: t.resolved.source != 'transition'
                                                            } %}
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="p-3 text-center text-xs text-secondary-500 dark:text-secondary-400">
                                                Aucune action spécifique configurée depuis cette étape. Les
                                                notifications de cette étape s'appliquent directement.
                                            </div>
                                        {% endif %}
                                    </div>
                                </details>
                            {% endfor %}
                        </div>
                    </section>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
