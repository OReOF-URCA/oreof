<div {{ stimulus_controller('formation--step1', {
    url: path('app_formation_save', {formation:formation.id}),
}) }}>
    {% form_theme form 'communs/form_theme.html.twig' %}
    {{ form_start(form) }}

    {# Ajout d'un RF / co-RF « hors liste » (création depuis le LDAP) : réservé aux non
       classiques (champs éditables ici) et aux administrateurs. #}
       
    {% set peutGererResp = (formation.typeDiplome.classique ?? true) == false and is_granted('ROLE_ADMIN') %}

    {{ form_row(form.responsableMention) }}
    {% if peutGererResp %}
        <a href="#"
           {{ stimulus_controller('modal', {
               size: 'lg',
               modalTitle: 'fiche_matiere.step1_collegue_manquant.title'|trans({}, 'form'),
               nomEvenement: 'refreshStep',
               modalUrl: path('app_user_missing', {action: 'responsableFormation', id: formation.id}) }) }}
           data-action="click->modal#openModal"
           data-size="lg"
           class="mb-3 d-inline-block"
           data-bs-toggle="tooltip" data-bs-placement="bottom"
           title="{{ 'fiche_matiere.step1_collegue_manquant.title'|trans({}, 'form') }}">
            <i class="{{ iconAdd }}"></i>
            <span> {{ 'fiche_matiere.step1_collegue_manquant.label'|trans({}, 'form') }}</span>
        </a>
    {% endif %}

    {{ form_row(form.coResponsable) }}
    {% if peutGererResp %}
        <a href="#"
           {{ stimulus_controller('modal', {
               size: 'lg',
               modalTitle: 'fiche_matiere.step1_collegue_manquant.title'|trans({}, 'form'),
               nomEvenement: 'refreshStep',
               modalUrl: path('app_user_missing', {action: 'coResponsableMention', id: formation.id}) }) }}
           data-action="click->modal#openModal"
           data-size="lg"
           class="mb-3 d-inline-block"
           data-bs-toggle="tooltip" data-bs-placement="bottom"
           title="{{ 'fiche_matiere.step1_collegue_manquant.title'|trans({}, 'form') }}">
            <i class="{{ iconAdd }}"></i>
            <span> {{ 'fiche_matiere.step1_collegue_manquant.label'|trans({}, 'form') }}</span>
        </a>
    {% endif %}
    {{ form(form) }}

    {# Formation mono-parcours non classique : le choix mono/multi (qui vivait dans l'onglet
       « Structure et organisation », masqué pour ces formations) est proposé ici. Passer à
       « Oui » transforme la formation en multi-parcours puis recharge la page. #}
    {% if formation.parcours[0] is defined and formation.hasParcours == false and formation.typeDiplome.isClassique == false %}
        <fieldset class="mb-3 mt-3">
            <legend class="col-form-label">Cette formation comporte-t-elle plusieurs parcours ?</legend>
            <div class="form-check">
                <input type="radio" id="formation_step1_parcours_1" name="formation_step1_parcours"
                       class="form-check-input" value="1"
                        {{ stimulus_action('formation--step1', 'changeHasParcours', 'click') }}>
                <label class="form-check-label" for="formation_step1_parcours_1">Oui</label>
            </div>
            <div class="form-check">
                <input type="radio" id="formation_step1_parcours_0" name="formation_step1_parcours"
                       class="form-check-input" value="0" checked
                        {{ stimulus_action('formation--step1', 'changeHasParcours', 'click') }}>
                <label class="form-check-label" for="formation_step1_parcours_0">Non</label>
            </div>
        </fieldset>
    {% endif %}

    {% if formation.typeDiplome.classique ?? true %}
    <div class="alert {% if formation.getEtatStep(1) %}alert-success{% else %}alert-warning{% endif %}"
         id="alertEtatStructure">
        <input type="checkbox"
               id="etatStructure"
               class="form-check-inline"
               {% if formation.getEtatStep(1) %}checked{% endif %}
                {{ stimulus_action('formation--step1', 'etatStep', 'change') }}
        ><label for="etatStructure">
            Cochez cette case si vous avez terminé ...</label>
    </div>
    {% endif %}

</div>