{# Colonne : Libellé + Contexte + Référent #}
<div class="space-y-2">
    <div class="flex flex-col gap-1">
        <span class="font-semibold text-secondary-900 dark:text-white">{{ row.libelle }}</span>
        {% if row.sigle != null %}
            <span class="text-xs text-secondary-500 dark:text-secondary-400">{{ row.sigle }}</span>
        {% endif %}
    </div>
    <div class="text-xs text-secondary-500 dark:text-secondary-400">
        {% if row.parcours != null %}
            {% if row.parcours.formation.hasParcours == true %}
                <span class="font-medium">{{ row.parcours.formation.display }}</span> › {{ row.parcours.libelle }}
            {% else %}
                <span class="font-medium">{{ row.parcours.formation.display }}</span>
            {% endif %}
        {% else %}
            <twig:Badge
                    label="Sans parcours"
                    variant="warning"
                    size="xs"
            />
        {% endif %}
    </div>
</div>
