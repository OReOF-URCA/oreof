{% set contexte = this.contexte %}
<section {{ attributes.defaults({class: 'rounded-xl border border-secondary-200 bg-surface p-4 shadow-sm dark:border-secondary-700'}) }}>
    <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold text-text">
        {{ ux_icon('icon:users', {class: 'h-4 w-4 text-info-600'}) }} Contexte ORéOF du demandeur
    </h2>

    {% if contexte is null %}
        <p class="text-sm text-secondary-400">Aucun compte ORéOF pour {{ demande.demandeurEmail }}.</p>
    {% else %}
        {% set user = contexte.user %}
        <div class="space-y-4 text-sm">
            <div>
                <p class="font-medium text-text">{{ user.display }} <span class="text-secondary-500 dark:text-secondary-400">({{ user.username }})</span></p>
                <div class="mt-1 flex flex-wrap gap-1">
                    <twig:Badge :label="contexte.compteValide ? 'Compte actif' : 'Compte non activé'" :variant="contexte.compteValide ? 'success' : 'danger'" size="sm" />
                    {% for role in contexte.roles|filter(r => r != 'ROLE_USER') %}
                        <twig:Badge :label="role" variant="secondary" size="sm" />
                    {% endfor %}
                </div>
                <div class="mt-2 flex flex-wrap gap-2">
                    <twig:Button label="Fiche utilisateur" variant="info" size="sm" icon="icon:info" href="{{ path('app_user_show', {id: user.id}) }}" />
                    <twig:Button label="Se connecter en tant que" variant="secondary" size="sm" icon="icon:login" href="{{ path('app_homepage', {_switch_user: user.username}) }}" />
                </div>
            </div>

            <div>
                <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-secondary-500 dark:text-secondary-400">Profils</h3>
                {% if contexte.profils is empty %}
                    <p class="text-secondary-400">Aucun profil.</p>
                {% else %}
                    <ul class="space-y-1">
                        {% for userProfil in contexte.profils %}
                            <li class="text-text">
                                <strong>{{ userProfil.profil ? userProfil.profil.libelle : '—' }}</strong>
                                {% if userProfil.displayCentre %} · {{ userProfil.displayCentre }}{% endif %}
                                {% if userProfil.campagneCollecte %}
                                    <span class="text-secondary-500 dark:text-secondary-400">— {{ userProfil.campagneCollecte.libelle }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# une ligne par campagne ; seuls les modules fermés alors que d'autres sont ouverts sont détaillés #}
            {% if contexte.campagnes is not empty %}
                <div>
                    <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-secondary-500 dark:text-secondary-400">Périodes de saisie</h3>
                    <ul class="space-y-1">
                        {% for bloc in contexte.campagnes %}
                            <li class="text-text" data-campagne="{{ bloc.campagne.id }}">
                                <div class="flex items-start gap-2">
                                    <twig:Dot :variant="bloc.etat == 'ouvertes' ? 'success' : (bloc.etat == 'mixte' ? 'warning' : 'danger')" />
                                    <span><strong>{{ bloc.campagne.libelle }}</strong>{% if bloc.campagne.defaut %} <span class="text-secondary-500 dark:text-secondary-400">(par défaut)</span>{% endif %} : {{ bloc.resume }}</span>
                                </div>
                                {% if bloc.details is not empty %}
                                    <ul class="ml-5 mt-1 space-y-0.5">
                                        {% for statut in bloc.details %}
                                            <li class="flex items-start gap-2 text-danger-700 dark:text-danger-300">
                                                <twig:Dot variant="danger" />
                                                <span><strong>{{ statut.module.label }}</strong> : {{ statut.message }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if contexte.demandesAcces is not empty %}
                <div>
                    <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-secondary-500 dark:text-secondary-400">Dernières demandes de modification</h3>
                    <ul class="space-y-1">
                        {% for dpe in contexte.demandesAcces %}
                            <li class="text-text">
                                {{ dpe.dateDemande ? dpe.dateDemande|date('d/m/Y') : '' }} —
                                {{ dpe.parcours ? dpe.parcours.display : (dpe.formation ? dpe.formation.display : '—') }}
                                {% if dpe.etatDemande %}<twig:Badge :label="dpe.etatDemande.libelle" :variant="dpe.etatDemande.badgeVariant" size="sm" />{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endif %}
</section>
