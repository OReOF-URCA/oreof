{# templates/components/FicheMatiereHeader.html.twig #}
{% set prefix = 'fiche_matiere' %}
{% set formation = ficheMatiere.parcours?.formation %}

{% set metaLabelClass = 'mb-1 text-[11px] font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500' %}
{% set metaValueClass = 'text-sm font-medium text-secondary-700 dark:text-secondary-200' %}
{% set emptyBadgeClass = 'inline-flex items-center rounded-full bg-danger-100 px-2 py-1 text-xs font-semibold text-danger-700 dark:bg-danger-500/15 dark:text-danger-300' %}
{% set quickBtnBase = 'inline-flex items-center justify-center gap-2 rounded-xl border px-3 py-2 text-sm font-semibold shadow-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2' %}
{% set quickBtnSecondary = quickBtnBase ~ ' border-secondary-300 bg-white text-secondary-700 hover:border-secondary-400 hover:bg-secondary-50 hover:text-secondary-900 focus-visible:ring-secondary-400 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:border-secondary-500 dark:hover:bg-secondary-700 dark:hover:text-white dark:focus-visible:ring-secondary-500 dark:focus-visible:ring-offset-secondary-900' %}
{% set quickBtnInfo = quickBtnBase ~ ' border-info-300 bg-info-50 text-info-700 hover:border-info-400 hover:bg-info-100 focus-visible:ring-info-400 dark:border-info-700 dark:bg-info-500/10 dark:text-info-300 dark:hover:border-info-600 dark:hover:bg-info-500/20 dark:focus-visible:ring-info-500 dark:focus-visible:ring-offset-secondary-900' %}
{% set quickBtnWarning = quickBtnBase ~ ' border-warning-300 bg-warning-50 text-warning-700 hover:border-warning-400 hover:bg-warning-100 focus-visible:ring-warning-400 dark:border-warning-700 dark:bg-warning-500/10 dark:text-warning-300 dark:hover:border-warning-600 dark:hover:bg-warning-500/20 dark:focus-visible:ring-warning-500 dark:focus-visible:ring-offset-secondary-900' %}
{% set quickBtnPrimary = quickBtnBase ~ ' border-primary-300 bg-primary-50 text-primary-700 hover:border-primary-400 hover:bg-primary-100 focus-visible:ring-primary-400 dark:border-primary-700 dark:bg-primary-500/10 dark:text-primary-300 dark:hover:border-primary-600 dark:hover:bg-primary-500/20 dark:focus-visible:ring-primary-500 dark:focus-visible:ring-offset-secondary-900' %}
{% set quickBtnSuccess = quickBtnBase ~ ' border-success-300 bg-success-50 text-success-700 hover:border-success-400 hover:bg-success-100 focus-visible:ring-success-400 dark:border-success-700 dark:bg-success-500/10 dark:text-success-300 dark:hover:border-success-600 dark:hover:bg-success-500/20 dark:focus-visible:ring-success-500 dark:focus-visible:ring-offset-secondary-900' %}
{% set panelClass = 'mt-4 rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm hidden dark:border-secondary-700 dark:bg-secondary-900' %}
{% set panelGridClass = 'grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4' %}

{% set dpeItemStyles = {
    'success': {
        badge: 'bg-success-100 text-success-700 dark:bg-success-500/15 dark:text-success-300',
        title: 'text-success-800 dark:text-success-200',
        hover: 'hover:bg-success-50 dark:hover:bg-success-500/10'
    },
    'warning': {
        badge: 'bg-warning-100 text-warning-700 dark:bg-warning-500/15 dark:text-warning-300',
        title: 'text-warning-800 dark:text-warning-200',
        hover: 'hover:bg-warning-50 dark:hover:bg-warning-500/10'
    },
    'danger': {
        badge: 'bg-danger-100 text-danger-700 dark:bg-danger-500/15 dark:text-danger-300',
        title: 'text-danger-800 dark:text-danger-200',
        hover: 'hover:bg-danger-50 dark:hover:bg-danger-500/10'
    },
    'info': {
        badge: 'bg-info-100 text-info-700 dark:bg-info-500/15 dark:text-info-300',
        title: 'text-info-800 dark:text-info-200',
        hover: 'hover:bg-info-50 dark:hover:bg-info-500/10'
    },
    'secondary': {
        badge: 'bg-secondary-100 text-secondary-700 dark:bg-secondary-700 dark:text-secondary-200',
        title: 'text-secondary-800 dark:text-secondary-100',
        hover: 'hover:bg-secondary-50 dark:hover:bg-secondary-800'
    }
} %}

{% set statusBadgeMap = {
    'completed': {
        bubble: 'bg-success-100 text-success-700 dark:bg-success-500/15 dark:text-success-300',
        line: 'bg-success-200 dark:bg-success-500/30'
    },
    'active': {
        bubble: 'bg-info-100 text-info-700 dark:bg-info-500/15 dark:text-info-300',
        line: 'bg-info-200 dark:bg-info-500/30'
    },
    'reserved': {
        bubble: 'bg-warning-100 text-warning-700 dark:bg-warning-500/15 dark:text-warning-300',
        line: 'bg-warning-200 dark:bg-warning-500/30'
    },
    'refused': {
        bubble: 'bg-danger-100 text-danger-700 dark:bg-danger-500/15 dark:text-danger-300',
        line: 'bg-danger-200 dark:bg-danger-500/30'
    },
    'pending': {
        bubble: 'bg-secondary-100 text-secondary-400 dark:bg-secondary-800 dark:text-secondary-500',
        line: 'bg-secondary-200 dark:bg-secondary-700'
    }
} %}

<div {{ attributes }}
        class="mb-4 rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
    <div class="space-y-4 p-4 sm:p-5">

        {# ── Bloc métadonnées ── #}
        <section
                class="rounded-2xl border border-secondary-200 bg-secondary-50/80 p-4 shadow-sm dark:border-secondary-700 dark:bg-secondary-800/50">
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-6">
                <div>
                    <dt class="{{ metaLabelClass }}">Type de fiche matière</dt>
                    <dd class="{{ metaValueClass }}">
                        {% if ficheMatiere.horsDiplome == true %}
                            <twig:Badge
                                    label="Hors Diplôme"
                                    variant="warning"
                                    size="xs"
                            />
                        {% else %}
                            <span class="inline-flex items-center rounded-full bg-info-100 px-2 py-1 text-xs font-semibold text-info-700 dark:bg-info-500/15 dark:text-info-300">
                                Classique
                            </span>
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="{{ metaLabelClass }}">Type diplôme</dt>
                    <dd class="{{ metaValueClass }}">
                        {% if ficheMatiere.horsDiplome == true %}
                            <twig:Badge
                                    label="Hors Diplôme"
                                    variant="warning"
                                    size="xs"
                            />
                        {% else %}
                            {{ formation.typeDiplome|typeDiplome }}
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="{{ metaLabelClass }}">Mention porteuse</dt>
                    <dd class="{{ metaValueClass }}">
                        {% if ficheMatiere.horsDiplome == true %}
                            <twig:Badge
                                    label="Hors Diplôme"
                                    variant="warning"
                                    size="xs"
                            />
                        {% else %}
                            {% if formation != null %}
                                {{ formation.display }}
                            {% else %}
                                <span class="{{ emptyBadgeClass }}">Non définie</span>
                            {% endif %}
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="{{ metaLabelClass }}">Parcours porteur</dt>
                    <dd class="{{ metaValueClass }}">
                        {% if ficheMatiere.horsDiplome == true %}
                            <twig:Badge
                                    label="Hors Diplôme"
                                    variant="warning"
                                    size="xs"
                            />
                        {% else %}
                            {% if ficheMatiere.parcours != null %}
                                {% if ficheMatiere.parcours.parcoursDefaut == false %}
                                    {{ ficheMatiere.parcours.libelle }}
                                {% else %}
                                    Mention sans parcours
                                {% endif %}
                            {% else %}
                                <span class="{{ emptyBadgeClass }}">Pas de parcours précisé</span>
                            {% endif %}
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="{{ metaLabelClass }}">Composante porteuse</dt>
                    <dd class="{{ metaValueClass }}">
                        {% if ficheMatiere.horsDiplome == true %}
                            <twig:Badge
                                    label="Hors Diplôme"
                                    variant="warning"
                                    size="xs"
                            />
                        {% else %}
                            {% if formation != null and formation.composantePorteuse != null %}
                                {{ formation.composantePorteuse.libelle }}
                            {% else %}
                                <span class="{{ emptyBadgeClass }}">Non définie</span>
                            {% endif %}
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="{{ metaLabelClass }}">Responsable fiche</dt>
                    <dd class="{{ metaValueClass }}">
                        {{ ficheMatiere.responsableFicheMatiere != null ? ficheMatiere.responsableFicheMatiere.display : 'Non défini' }}
                    </dd>
                </div>
            </dl>
        </section>

        {# ── État (verrouillée / en modification) + Avancement process ── #}
        <section class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex items-center gap-3 rounded-2xl border px-4 py-3 shadow-sm {{ hasDemande ? 'border-success-200 bg-success-50 text-success-800 dark:border-success-800/70 dark:bg-success-500/10 dark:text-success-300' : 'border-warning-200 bg-warning-50 text-warning-800 dark:border-warning-800/70 dark:bg-warning-500/10 dark:text-warning-300' }}">
                <div class="flex h-10 w-10 items-center justify-center rounded-full {{ hasDemande ? 'bg-success-100 text-success-700 dark:bg-success-500/15 dark:text-success-300' : 'bg-warning-100 text-warning-700 dark:bg-warning-500/15 dark:text-warning-300' }}"
                     data-controller="tooltip" data-tooltip-placement-value="bottom"
                     data-bs-original-title="{{ hasDemande ? 'Fiche matière en cours de modification.' : 'Fiche matière verrouillée.' }}">
                    {{ ux_icon(hasDemande ? 'icon:unlock' : 'icon:lock', {class: 'h-4 w-4'}) }}
                </div>
                <div>
                    <p class="text-sm font-semibold">{{ hasDemande ? 'Fiche matière en cours de modification.' : 'Fiche matière verrouillée.' }}</p>
                    <p class="text-xs opacity-80">Suivez l'avancement et les actions disponibles pour cette fiche.</p>
                </div>
            </div>

            <div class="rounded-2xl border border-secondary-200 bg-white px-4 py-3 shadow-sm dark:border-secondary-700 dark:bg-secondary-800/70">
                <p class="mb-2 text-[11px] font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500">
                    Avancement du process</p>
                <div class="flex flex-wrap items-center justify-center gap-2">
                    {% for key, step in processSteps %}
                        {% if validationSteps[key] is defined and validationSteps[key].status == 'completed' %}
                            {% set state = 'completed' %}
                        {% elseif validationSteps[key] is defined and validationSteps[key].status == 'active' %}
                            {% set state = 'active' %}
                        {% elseif validationSteps[key] is defined and validationSteps[key].status == 'reserved' %}
                            {% set state = 'reserved' %}
                        {% elseif validationSteps[key] is defined and validationSteps[key].status == 'refused' %}
                            {% set state = 'refused' %}
                        {% else %}
                            {% set state = 'pending' %}
                        {% endif %}
                        {% set stateConfig = statusBadgeMap[state] %}
                        <div class="flex items-center">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full ring-2 ring-white {{ stateConfig.bubble }} dark:ring-secondary-900"
                                 data-controller="tooltip" data-tooltip-placement-value="bottom"
                                 aria-label="{{ (prefix~'.'~step.label~'.btn-'~state)|trans({}, 'process') }}"
                                 data-bs-original-title="{{ (prefix~'.'~step.label~'.btn-'~state)|trans({}, 'process') }}">
                                <i class="fas {{ step.icon }} text-xs"></i>
                            </div>
                            {% if not loop.last %}
                                <div class="mx-1 h-0.5 w-5 rounded-full {{ stateConfig.line }}"></div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ── Actions rapides ── #}
        <section class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500">
                Actions rapides
            </div>

            <div class="flex flex-wrap items-center gap-2">
                {# Dropdown Gestion fiche matière #}
                <div class="relative" data-controller="navbar-dropdown"
                     data-action="click@window->navbar-dropdown#close">
                    <twig:Button
                            type="button"
                            variant="success"
                            :soft="false"
                            :outline="true"
                            size="sm"
                            icon="icon:check"
                            label="Gestion fiche matière"
                            dataAction="click->navbar-dropdown#toggle"
                            aria-expanded="false"
                            extraClass="{{ quickBtnSuccess }}"
                    >
                        {{ ux_icon('icon:chevron-down', {class: 'h-4 w-4'}) }}
                    </twig:Button>
                    <ul data-navbar-dropdown-target="content"
                        class="hidden absolute right-0 top-full z-30 mt-2 min-w-[22rem] rounded-2xl border border-secondary-200 bg-white p-2 shadow-2xl dark:border-secondary-700 dark:bg-secondary-900">
                        {% for key, option in validationOptions %}
                            {% set itemStyle = dpeItemStyles[option.metadata.button_class]|default(dpeItemStyles['secondary']) %}
                            <li>
                                <a class="flex items-start gap-3 rounded-xl px-3 py-3 text-sm text-secondary-700 transition {{ itemStyle.hover }} dark:text-secondary-200"
                                   data-action="click->modalturbo#open"
                                   data-turbo="true"
                                   href="{{ path('fiche_matiere_process_apply', {type: option.metadata.type, ficheMatiere: ficheMatiere.id, transition: key }) }}">
                                    <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ itemStyle.badge }}">
                                        <i class="fas {{ option.metadata.button_icon }} text-xs"></i>
                                    </span>
                                    <span class="min-w-0">
                                        <span class="block font-semibold {{ itemStyle.title }}">{{ ('workflow.'~key~'.menu.label')|trans({}, 'process') }}</span>
                                        <span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ ('workflow.'~key~'.menu.description')|trans({}, 'process') }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <twig:Button
                        type="button"
                        variant="secondary"
                        :soft="false"
                        :outline="true"
                        size="sm"
                        icon="icon:gear"
                        label="Actions complémentaires"
                        data-toggle-group="accordion-1"
                        data-toggle="actions"
                        data-target="#actions-panel"
                        data-toggle-icon-open="rotate-0"
                        data-toggle-icon-close="rotate-180"
                        extraClass="{{ quickBtnSecondary }}"
                >
                    {{ ux_icon('icon:chevron-up', {class: 'h-4 w-4 data-toggle-icon rotate-180 transition-transform duration-200'}) }}
                </twig:Button>

                <twig:Button
                        type="button"
                        variant="info"
                        :soft="false"
                        :outline="true"
                        size="sm"
                        icon="icon:download"
                        label="Exports"
                        data-toggle-group="accordion-1"
                        data-toggle="actions"
                        data-target="#exports-panel"
                        data-toggle-icon-open="rotate-0"
                        data-toggle-icon-close="rotate-180"
                        extraClass="{{ quickBtnInfo }}"
                >
                    {{ ux_icon('icon:chevron-up', {class: 'h-4 w-4 data-toggle-icon rotate-180 transition-transform duration-200'}) }}
                </twig:Button>

                {% if is_granted('ROLE_ADMIN') %}
                    <twig:Button
                            type="button"
                            variant="secondary"
                            :soft="false"
                            :outline="true"
                            size="sm"
                            icon="icon:wrench"
                            label="Gestion SES"
                            data-toggle-group="accordion-1"
                            data-toggle="actions"
                            data-target="#actions-panel-admin"
                            data-toggle-icon-open="rotate-0"
                            data-toggle-icon-close="rotate-180"
                            extraClass="{{ quickBtnSecondary }}"
                    >
                        {{ ux_icon('icon:chevron-up', {class: 'h-4 w-4 data-toggle-icon rotate-180 transition-transform duration-200'}) }}
                    </twig:Button>
                {% endif %}
            </div>
        </section>

        {# ── Panneau Actions complémentaires ── #}
        <div class="{{ panelClass }}" id="actions-panel">
            <div class="{{ panelGridClass }}">
                <div>
                    <twig:Button
                            type="button"
                            variant="success"
                            :soft="false"
                            :outline="true"
                            size="sm"
                            icon="icon:check"
                            label="Vérifier la saisie"
                            :fullWidth="true"
                            data-action="click->modalturbo#open"
                            data-turbo="true"
                            tooltip="{{ 'verifier.la.saisie.fiche_matiere.infobulle'|trans({}, 'process') }}"
                            extraClass="{{ quickBtnSuccess }}"
                    />
                </div>
                <div>
                    <twig:Button
                            type="button"
                            variant="primary"
                            :soft="false"
                            :outline="true"
                            size="sm"
                            icon="icon:timeline"
                            label="Historique"
                            :fullWidth="true"
                            data-action="click->modalturbo#open"
                            data-turbo="true"
                            href="{{ path('app_historique_fiche_matiere', {ficheMatiere: ficheMatiere.id}) }}"
                            tooltip="{{ 'historique.de.validation.fiche_matiere.infobulle'|trans({}, 'process') }}"
                            extraClass="{{ quickBtnPrimary }}"
                    />
                </div>
                <div>
                    {% if is_granted('ROLE_ADMIN') and hasLastVersion is defined and hasLastVersion == true %}
                        <a class="{{ quickBtnWarning }} w-full"
                           data-bs-toggle="collapse" data-bs-target="#diffGlobalParcours">
                            {{ ux_icon('icon:wrench', {class: 'h-4 w-4'}) }}
                            <span>Comparer les descriptifs</span>
                        </a>
                    {% endif %}
                </div>
                <div></div>
            </div>
        </div>

        {# ── Panneau Exports ── #}
        <div class="{{ panelClass }}" id="exports-panel">
            <div class="{{ panelGridClass }}">
                <div>
                    <a href="{{ path('app_fiche_matiere_export', {id:ficheMatiere.id}) }}"
                       class="{{ quickBtnPrimary }} w-full"
                       data-bs-toggle="tooltip"
                       data-bs-placement="bottom"
                       title="Télécharger en PDF">
                        {{ ux_icon('icon:download', {class: 'h-4 w-4'}) }}
                        <span>Fiche descriptive (PDF)</span>
                    </a>
                </div>
            </div>
        </div>

        {# ── Panneau Admin ── #}
        {% if is_granted('ROLE_ADMIN') %}
            <div class="{{ panelClass }}" id="actions-panel-admin">
                <div class="{{ panelGridClass }}">
                    <div>
                        <twig:Button
                                type="button"
                                variant="secondary"
                                :soft="false"
                                :outline="true"
                                size="sm"
                                icon="icon:gear"
                                label="Gérer codification"
                                :fullWidth="true"
                                extraClass="{{ quickBtnSecondary }}"
                        />
                    </div>
                    <div>
                        <twig:Button
                                type="button"
                                variant="secondary"
                                :soft="false"
                                :outline="true"
                                size="sm"
                                icon="icon:gear"
                                label="Gérer la version"
                                :fullWidth="true"
                                extraClass="{{ quickBtnSecondary }}"
                        />
                    </div>
                </div>
            </div>
        {% endif %}

    </div>
</div>
