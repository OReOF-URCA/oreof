<div {{ attributes }} class="datatable-wrapper space-y-4">

    {# ── Compteurs UX (résultats + filtres actifs) ─────────────────────────── #}
    {% set activeFilters = 0 %}
    {% for column in columns %}
        {% if column.filterable %}
            {% set currentFilter = filters[column.id]|default(null) %}
            {% if column.type == 'date' %}
                {% if currentFilter is iterable and (currentFilter.from|default('') != '' or currentFilter.to|default('') != '') %}
                    {% set activeFilters = activeFilters + 1 %}
                {% endif %}
            {% elseif currentFilter is not null and currentFilter is not same as('') %}
                {% set activeFilters = activeFilters + 1 %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {# ── Toolbar ─────────────────────────────────────────────────────────────── #}
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <div class="border-b border-slate-100 px-4 py-3 dark:border-slate-700">
            <div class="rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-900 dark:border-cyan-800 dark:bg-cyan-950/30 dark:text-cyan-100">
                <div class="flex flex-wrap items-center gap-2">
                    <span>
                        <strong>{{ this.getTotal }}</strong> résultat{{ this.getTotal > 1 ? 's' : '' }}
                    </span>
                    {% if activeFilters > 0 %}
                        <span class="opacity-70">•</span>
                        <twig:Badge
                                variant="info"
                                icon="icon:filter"
                                :label="activeFilters ~ ' filtre' ~ (activeFilters > 1 ? 's' : '') ~ ' actif' ~ (activeFilters > 1 ? 's' : '')"
                                extraClass="font-semibold"
                        />
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">

            {# Recherche globale #}
            <div class="relative w-full sm:max-w-sm">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                    <twig:UX:Icon name="icon:search" class="h-4 w-4"/>
                </span>
                <label for="recherche-datatable" class="sr-only">Recherche globale</label>
                <input
                        id="recherche-datatable"
                        type="text"
                        class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm text-slate-700 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder:text-slate-400"
                        placeholder="Rechercher..."
                        data-model="debounce(100)|globalSearch"
                        data-action="live#update"
                >
            </div>

            {# Actions toolbar #}
            <div class="flex shrink-0 items-center gap-2 self-end sm:self-auto">
                <twig:Button
                        type="button"
                        variant="secondary"
                        :soft="false"
                        :outline="true"
                        size="sm"
                        icon="icon:refresh"
                        label="Actualiser"
                        dataAction="live#$render"
                        tooltip="Actualiser les données"
                        extraClass="text-xs"
                />
                <twig:Button
                        type="button"
                        variant="danger"
                        :soft="false"
                        :outline="true"
                        size="sm"
                        icon="icon:sync"
                        label="Réinitialiser"
                        dataAction="live#action"
                        data-live-action-param="resetFilters"
                        tooltip="Réinitialiser les filtres"
                        extraClass="text-xs"
                />

                <twig:Button
                        type="button"
                        variant="secondary"
                        :soft="false"
                        :outline="true"
                        size="sm"
                        icon="icon:filter"
                        label="Filtres"
                        dataAction="live#action"
                        data-live-action-param="toggleFilters"
                        aria-controls="filters-panel"
                        aria-expanded="{{ filtersOpen ? 'true' : 'false' }}"
                        extraClass="text-xs {% if filtersOpen %}!border-indigo-300 !bg-indigo-50 !text-indigo-700 hover:!bg-indigo-100 dark:!border-indigo-600 dark:!bg-indigo-900/40 dark:!text-indigo-300{% endif %}"
                >
                    {% if activeFilters > 0 %}
                        <twig:Badge
                                variant="primary"
                                :soft="false"
                                :label="activeFilters"
                                extraClass="min-w-5 justify-center px-1.5 py-0.5 text-[10px]"
                        />
                    {% endif %}
                </twig:Button>
            </div>
        </div>

        {# ── Filtres avancés ──────────────────────────────────────────────────── #}
        {% if filtersOpen %}
            <div id="filters-panel"
                 class="border-t border-slate-100 bg-slate-50/60 p-4 dark:border-slate-700 dark:bg-slate-800/40">
                <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Filtres
                    avancés</p>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    {% for column in columns %}
                        {% if column.filterable %}
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-semibold text-slate-600 dark:text-slate-300"
                                       for="col_{{ column.id }}">{{ column.label }}</label>

                                {% set inputClass = "w-full rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-800 transition focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" %}

                                {% if column.type == 'text' %}
                                    <input id="col_{{ column.id }}" type="text" class="{{ inputClass }}"
                                           data-model="debounce(100)|filters.{{ column.id }}"
                                           value="{{ filters[column.id]|default('') }}" placeholder="Filtrer…">

                                {% elseif column.type == 'select' %}
                                    <select id="col_{{ column.id }}" class="{{ inputClass }}"
                                            data-model="on(change)|filters.{{ column.id }}">
                                        <option value="">Tous</option>
                                        {% for key, value in column.choices %}
                                            <option value="{{ key }}" {{ filters[column.id]|default('') == key ? 'selected' : '' }}>{{ value }}</option>
                                        {% endfor %}
                                    </select>

                                {% elseif column.type in ['entity', 'collection'] and column.entity %}
                                    {% set entityChoices = this.getEntityChoices(column) %}
                                    <select id="col_{{ column.id }}" class="{{ inputClass }}"
                                            data-model="on(change)|filters.{{ column.id }}">
                                        <option value="">Tous</option>
                                        {% for choice in entityChoices %}
                                            <option value="{{ choice.value }}" {{ filters[column.id]|default('') == choice.value ? 'selected' : '' }}>{{ choice.label }}</option>
                                        {% endfor %}
                                    </select>

                                {% elseif column.type == 'date' %}
                                    <div class="flex items-center gap-1">
                                        <input id="col_{{ column.id }}" type="date" class="{{ inputClass }}"
                                               data-model="filters.{{ column.id }}.from"
                                               value="{{ filters[column.id].from|default('') }}">
                                        <span class="text-xs text-slate-400">→</span>
                                        <label for="col_{{ column.id }}_to" class="sr-only">Au</label>
                                        <input id="col_{{ column.id }}_to" type="date" class="{{ inputClass }}"
                                               data-model="filters.{{ column.id }}.to"
                                               value="{{ filters[column.id].to|default('') }}">
                                    </div>

                                {% elseif column.type == 'boolean' %}
                                    <select id="col_{{ column.id }}" class="{{ inputClass }}"
                                            data-model="on(change)|filters.{{ column.id }}">
                                        <option value="">Tous</option>
                                        <option value="1" {{ filters[column.id]|default('') == '1' ? 'selected' : '' }}>
                                            Oui
                                        </option>
                                        <option value="0" {{ filters[column.id]|default('') == '0' ? 'selected' : '' }}>
                                            Non
                                        </option>
                                    </select>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>

    {# ── Table ───────────────────────────────────────────────────────────────── #}
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900">

        {# Méta-barre : résultats + per page #}
        <div class="flex flex-col gap-2 border-b border-slate-100 px-4 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                <span class="font-semibold text-slate-700 dark:text-slate-200">{{ ((page - 1) * perPage + 1) }}–{{ min(page * perPage, this.getTotal) }}</span>
                sur <span class="font-semibold text-slate-700 dark:text-slate-200">{{ this.getTotal }}</span> résultats
            </p>
            <div class="flex items-center gap-2">
                {% if selectable %}
                    <span class="text-xs text-slate-500 dark:text-slate-400"
                          data-check-all-counter="{{ selectionAllId }}">
                        0 / 0 élément(s) sélectionné(s)
                    </span>
                {% endif %}
                <label for="perPage" class="text-xs text-slate-500 dark:text-slate-400">Par page</label>
                <select id="perPage"
                        class="rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:border-indigo-400 focus:outline-none dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200"
                        data-model="perPage">
                    <option value="10" {{ perPage == 10 ? 'selected' : '' }}>10</option>
                    <option value="20" {{ perPage == 20 ? 'selected' : '' }}>20</option>
                    <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50</option>
                    <option value="100" {{ perPage == 100 ? 'selected' : '' }}>100</option>
                </select>
            </div>
        </div>

        {# Tableau principal #}
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
            <div class="overflow-x-auto">
                <table
                        class="min-w-full text-sm text-slate-700 dark:text-slate-200"
                        {% if selectable %}
                            {{ stimulus_controller('check_all', {
                                idCheckAll: selectionAllId,
                                classCheckAll: '.' ~ selectionInputClass
                            }) }}
                        {% endif %}
                >
                    <thead class="bg-slate-50 text-left text-xs font-black uppercase tracking-wider text-slate-500 dark:bg-slate-800/70 dark:text-slate-300">
                    <tr>
                        {% if selectable %}
                            <th class="w-12 px-4 py-3">
                                <label class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800">
                                    <input
                                            id="{{ selectionAllId }}"
                                            type="checkbox"
                                            class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                            {{ stimulus_action('check_all', 'checkAll', 'change') }}
                                    >
                                </label>
                            </th>
                        {% endif %}
                        {% for column in columns %}
                            <th class="px-4 py-3 {{ column.class }}">
                                {% if column.sortable %}
                                    <twig:Button
                                            type="button"
                                            variant="secondary"
                                            size="sm"
                                            :outline="true"
                                            :soft="false"
                                            :icon="sortField == column.field ? (sortDirection == 'asc' ? 'icon:chevron-up' : 'icon:chevron-down') : 'icon:chevron-down'"
                                            :label="column.label"
                                            dataAction="live#action"
                                            data-live-action-param="sort"
                                            data-live-field-param="{{ column.field }}"
                                            extraClass="!border-0 !bg-transparent !px-0 !py-0 !h-auto hover:!text-indigo-600 dark:hover:!text-indigo-400"
                                    />
                                {% else %}
                                    {{ column.label }}
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if actions is not empty %}
                            <th class="px-4 py-3 text-right">
                                Actions
                            </th>
                        {% endif %}
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    {% for item in this.getData %}
                        <tr class="align-top hover:bg-slate-50/70 dark:hover:bg-slate-800/40">
                            {% if selectable %}
                                <td class="px-4 py-3">
                                    {% set selectionValue = this.getFieldValue(item, selectionValueField) %}
                                    <label class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800">
                                        <input
                                                type="checkbox"
                                                class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 {{ selectionInputClass }}"
                                                name="{{ selectionName }}"
                                                value="{{ selectionValue }}"
                                                {{ stimulus_action('check_all', 'check', 'change') }}
                                        >
                                    </label>
                                </td>
                            {% endif %}
                            {% for column in columns %}
                                <td class="px-4 py-3 {{ column.class }}">
                                    {% if column.template %}
                                        {% include column.template with {item: item, value: this.getFieldValue(item, column.field)} %}
                                    {% else %}
                                        {% set value = this.getFieldValue(item, column.field) %}

                                        {% if column.format == 'date' and value %}
                                            {{ value|date('d/m/Y') }}

                                        {% elseif column.format == 'datetime' and value %}
                                            {{ value|date('d/m/Y H:i') }}

                                        {% elseif column.format == 'currency' and value %}
                                            {{ value|number_format(2, ',', ' ') }} €

                                        {% elseif column.format == 'boolean' %}
                                            {% if value %}
                                                <twig:Badge label="Oui" variant="success" icon="icon:check"/>
                                            {% else %}
                                                <twig:Badge label="Non" variant="secondary"/>
                                            {% endif %}

                                        {% elseif column.format == 'badge' %}
                                            {% set badgeClass = column.badge_map[value] ?? column.badge_class %}
                                            <twig:Badge
                                                    :label="column.choices[value] ?? value"
                                                    variant="secondary"
                                                    extraClass="{{ badgeClass }}"
                                            />

                                        {% elseif column.format == 'badges' and value %}
                                            {# Pour les collections ManyToMany #}
                                            {% if value is iterable %}
                                                {% for badgeItem in value %}
                                                    {% if column.collection_property == '__toString' %}
                                                        {% set itemValue = badgeItem %}
                                                    {% else %}
                                                        {% set getter = 'get' ~ column.collection_property|capitalize %}
                                                        {% set itemValue = attribute(badgeItem, getter) %}
                                                    {% endif %}
                                                    <twig:Badge
                                                            :label="itemValue"
                                                            variant="secondary"
                                                            extraClass="{{ column.badge_class }} me-1"
                                                    />
                                                {% endfor %}
                                            {% else %}
                                                <span class="text-slate-400">–</span>
                                            {% endif %}

                                        {% elseif column.format == 'entity_badge' %}
                                            {% set entityLabel = this.getEntityDisplayLabel(value, column) %}
                                            {% set entityBadgeClass = value is null
                                                ? (column.null_badge_class|default('bg-secondary'))
                                                : (column.badge_class|default('bg-info')) %}
                                            <twig:Badge
                                                    :label="entityLabel ?: '–'"
                                                    variant="secondary"
                                                    extraClass="{{ entityBadgeClass }}"
                                            />

                                        {% elseif column.type == 'collection' and value %}
                                            {# Pour les collections ManyToMany en texte simple #}
                                            {% if value is iterable %}
                                                {% set items = [] %}
                                                {% for collItem in value %}
                                                    {% if column.collection_property == '__toString' %}
                                                        {% set itemValue = collItem %}
                                                    {% else %}
                                                        {% set getter = 'get' ~ column.collection_property|capitalize %}
                                                        {% set itemValue = attribute(collItem, getter) %}
                                                    {% endif %}
                                                    {% set items = items|merge([itemValue]) %}
                                                {% endfor %}
                                                {{ items|join(column.separator) }}
                                            {% else %}
                                                –
                                            {% endif %}

                                        {% elseif value is not null and value is not same as '' %}
                                            {% if column.is_html %}
                                                {{ value|raw }}
                                            {% else %}
                                                {{ value }}
                                            {% endif %}
                                        {% else %}
                                            <span class="text-slate-300 dark:text-slate-600">–</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            {% endfor %}

                            {% if actions is not empty %}
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-1 flex-wrap">
                                        {% for name, action in actions %}
                                            {% set show = action.condition is null or action.condition(item) %}
                                            {% if show %}
                                                {% set routeUrl = path(action.route, {id: item.id}|merge(action.route_params)) %}
                                                {% if action.method == 'delete' %}
                                                    <twig:Button
                                                            type="button"
                                                            variant="danger"
                                                            size="sm"
                                                            {{ stimulus_action('crud', 'delete', 'click', {
                                                                url: routeUrl,
                                                                csrf: csrf_token('delete' ~ item.id)
                                                            }) }}
                                                            label="{{ action.label }}"
                                                            tooltip="{{ action.label }}"
                                                            extraClass="{{ action.class }}"
                                                    >
                                                        {% if action.icon %}<i class="{{ action.icon }}"></i>{% endif %}
                                                    </twig:Button>
                                                {% elseif action.method == 'duplicate' %}
                                                    <twig:Button
                                                            type="button"
                                                            variant="success"
                                                            size="sm"
                                                            {{ stimulus_action('crud', 'duplicate', 'click', {
                                                                url: routeUrl
                                                            }) }}
                                                            label="{{ action.label }}"
                                                            tooltip="{{ action.label }}"
                                                            extraClass="{{ action.class }}"
                                                    >
                                                        {% if action.icon %}<i class="{{ action.icon }}"></i>{% endif %}
                                                    </twig:Button>
                                                {% elseif action.modal %}
                                                    <a href="{{ routeUrl }}" data-turbo="true"
                                                       data-action="click->modalturbo#open" title="{{ action.label }}"
                                                       class="{{ action.class }}">
                                                        {% if action.icon %}<i class="{{ action.icon }}"></i>{% endif %}
                                                        {{ action.label }}
                                                    </a>
                                                {% else %}
                                                    <a href="{{ routeUrl }}" class="{{ action.class }}"
                                                       {% if action.confirm %}onclick="return confirm('{{ action.confirm }}')"{% endif %}>
                                                        {% if action.icon %}<i class="{{ action.icon }}"></i>{% endif %}
                                                        {{ action.label }}
                                                    </a>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ columns|length + (actions is not empty ? 1 : 0) + (selectable ? 1 : 0) }}"
                                class="px-4 py-16 text-center">
                                {{ include('_ui/_empty_table.html.twig', {
                                    message: 'Aucune donnée à afficher'
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ── Pagination ──────────────────────────────────────────────────────── #}
        {% set totalPages = this.getTotalPages %}
        {% if totalPages > 1 %}
            <div class="flex items-center justify-center gap-1 border-t border-slate-100 px-4 py-3 dark:border-slate-700">
                <twig:Button
                        type="button"
                        variant="secondary"
                        :outline="true"
                        size="sm"
                        icon="icon:chevrons-left"
                        :disabled="page == 1"
                        tooltip="Première page"
                        {{ live_action('goToPage', {'page': 1}) }}
                        extraClass="!h-8 !w-8 !min-w-0 !px-0"
                />
                <twig:Button
                        type="button"
                        variant="secondary"
                        :outline="true"
                        size="sm"
                        icon="icon:chevron-left"
                        :disabled="page == 1"
                        tooltip="Précédent"
                        {{ live_action('goToPage', {'page': page - 1}) }}
                        extraClass="!h-8 !w-8 !min-w-0 !px-0"
                />

                {% for p in range(max(1, page - 2), min(totalPages, page + 2)) %}
                    <twig:Button
                            type="button"
                            :label="p"
                            :variant="p == page ? 'primary' : 'secondary'"
                            :soft="p == page ? false : true"
                            size="sm"
                            {{ live_action('goToPage', {'page': p}) }}
                            extraClass="!h-8 !min-w-8 !px-2"
                    />
                {% endfor %}

                <twig:Button
                        type="button"
                        variant="secondary"
                        :outline="true"
                        size="sm"
                        icon="icon:chevron-right"
                        :disabled="page == totalPages"
                        tooltip="Suivant"
                        {{ live_action('goToPage', {'page': page + 1}) }}
                        extraClass="!h-8 !w-8 !min-w-0 !px-0"
                />
                <twig:Button
                        type="button"
                        variant="secondary"
                        :outline="true"
                        size="sm"
                        icon="icon:chevrons-right"
                        :disabled="page == totalPages"
                        tooltip="Dernière page"
                        {{ live_action('goToPage', {'page': totalPages}) }}
                        extraClass="!h-8 !w-8 !min-w-0 !px-0"
                />
            </div>
        {% endif %}
    </div>
</div>
