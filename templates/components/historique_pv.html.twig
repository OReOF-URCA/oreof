<div{{ attributes }}>
    <!-- component html -->
    {% if this.type == 'parcours' %}
        {% if this.hasPv == false %}
            {# todo: filtrer uniquement sur DPE pour la mise à jour #}
            <twig:Button
                    label="{{ 'deposer.le.pv'|trans({}, 'process') }}"
                    variant="warning"
                    :outline="true"
                    :soft="false"
                    icon="icon:edit"
                    size="sm"
                    href="{{ path('app_deposer_pv_conseil', {parcours:this.parcours.id}) }}"
                    tooltip="{{ 'deposer.le.pv.infobulle'|trans({}, 'process') }}"
                    dataAction="click->modalturbo#open"
            />
        {% else %}
            <twig:Button
                    label="{{ 'voir.le.pv'|trans({}, 'process') }}"
                    variant="info"
                    :outline="true"
                    :soft="false"
                    icon="icon:download"
                    size="sm"
                    href="{{ path('app_upload_download', {context: 'conseils', filename: this.fichier, originalName: this.fichierOriginal|default(this.fichier)}) }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    tooltip="{{ 'voir.le.pv.infobulle'|trans({}, 'process') }}"
            />
        {% endif %}
    {% elseif this.type == 'change_rf' %}
         {% if this.hasPv == false and this.hasHistorique == true %}
            <div {{ stimulus_controller('modal', {
                size: 'lg',
                nomEvenement: 'refreshPage',
                modalTitle: 'deposer.le.pv.title'|trans({}, 'process'),
                modalUrl: path('app_deposer_pv_conseil_change_rf', {changeRf:this.changeRf.id}) }) }}>
                <twig:Button
                        label="{{ 'deposer.le.pv'|trans({}, 'process') }}"
                        variant="warning"
                        :outline="true"
                        :soft="false"
                        icon="icon:edit"
                        size="sm"
                        type="button"
                        tooltip="{{ 'deposer.le.pv.infobulle'|trans({}, 'process') }}"
                        dataAction="click->modal#openModal"
                />
            </div>
        {% elseif this.hasPv == true and this.hasHistorique == true %}
            <twig:Button
                    label="{{ 'voir.le.pv'|trans({}, 'process') }}"
                    variant="info"
                    :outline="true"
                    :soft="false"
                    icon="icon:download"
                    size="sm"
                    href="{{ path('app_upload_download', {context: 'conseils', filename: this.fichier, originalName: this.fichierOriginal|default(this.fichier)}) }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    tooltip="{{ 'voir.le.pv.infobulle'|trans({}, 'process') }}"
            />
            {% else %}
            -
        {% endif %}
     {% else %}
        <twig:Badge label="Erreur de type" variant="danger" size="sm"/>
    {% endif %}
