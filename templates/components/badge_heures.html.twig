<div {{ attributes }}>
    {% if this.elementConstitutif.natureUeEc != null and this.elementConstitutif.natureUeEc.isLibre == true %}
        <span class="inline-flex w-full items-center justify-center rounded-md bg-cyan-100 px-2 py-1 text-xs font-semibold text-cyan-800">EC libre</span>
    {% else %}
        <a
                href="{{ path('parcours_ec_saisir_heures', { parcours: this.parcours.id, id: this.elementConstitutif.id }) }}"
                data-action="click->modalturbo#open"
                data-turbo="true"
                class="inline-flex w-full items-center justify-center gap-1 rounded-md border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 px-2 py-1.5 text-xs font-semibold text-secondary-700 dark:text-secondary-300 hover:bg-secondary-50 dark:hover:bg-secondary-700 transition-colors"
                title="Volumes Horaires"
        >
            {% if this.texte == true %}<twig:UX:icon name="icon:clock" class="h-3.5 w-3.5" />{% endif %}
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold {% if this.ecDesEnfants == true %}bg-primary-100 text-primary-800 dark:bg-primary-900/30 dark:text-primary-300{% elseif this.etatHeuresComplet == true %}bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300{% else %}bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300{% endif %}">
                {% if this.texte == true %}
                    {% if this.ecDesEnfants == true %}
                        EC des enfants
                    {% else %}
                        {% if this.etatHeuresComplet == true %}Complet{% else %}À saisir{% endif %}
                    {% endif %}
                {% else %}Heures{% endif %}
                {% if this.isParcoursProprietaire == false and this.isHeuresSpecifiques == false %}
                    <twig:UX:icon name="icon:link" class="h-3 w-3" title="Heures reprises de la fiche matière" />
                {% endif %}
            </span>
        </a>
    {% endif %}
</div>
