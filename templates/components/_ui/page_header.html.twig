{#
Composant PageHeader — exemples :
  <twig:PageHeader titleKey="page.admin_styleguide_index.title" descriptionKey="page.admin_styleguide_index.description" />

  <twig:PageHeader title="Titre" description="Description" :breadcrumb="false" :sticky="false">
      <twig:block name="actions">
          <twig:Button variant="secondary" label="Retour" href="#" />
      </twig:block>
  </twig:PageHeader>

Sticky : le composant se colle sous la topbar (h-16). Une fois collé (data-stuck="true", piloté par le
contrôleur Stimulus page-header), la description est masquée et le titre réduit.
#}

{% set resolvedTitle = titleKey ? titleKey|trans(translationParams, translationDomain) : title %}
{% set resolvedDescription = descriptionKey ? descriptionKey|trans(translationParams, translationDomain) : description %}
{% set hasDescription = resolvedDescription is not null and resolvedDescription|trim != '' %}

{% set slotActions %}{% block actions %}{% endblock %}{% endset %}
{% set resolvedActions = slotActions|trim != '' ? slotActions : actions %}
{% set hasActions = resolvedActions is not null and resolvedActions|trim != '' %}

{% set hasBreadcrumb = breadcrumb and breadcrumbs()|length > 1 %}

{% set rootClass = sticky
    ? 'group sticky top-16 z-40 pt-4 pb-8 transition-[padding,background-color] duration-200 data-[stuck=true]:bg-bg data-[stuck=true]:pt-3 data-[stuck=true]:pb-4 sm:pt-6 sm:pb-10 sm:data-[stuck=true]:pt-3 sm:data-[stuck=true]:pb-4'
    : 'pt-4 pb-8 sm:pt-6 sm:pb-10' %}

{% set extraClass = attributes.render('class') %}
<div class="{{ rootClass }}{{ extraClass ? ' ' ~ extraClass : '' }}"
     {% if sticky %}data-controller="page-header" data-stuck="false"{% endif %}
        {{- attributes.without('class') -}}>
    <section class="rounded-2xl border border-secondary-200 bg-white/90 p-4 shadow-sm backdrop-blur-sm transition-[padding] duration-200 dark:border-secondary-700 dark:bg-secondary-900/80 sm:p-5 group-data-[stuck=true]:py-3 sm:group-data-[stuck=true]:py-3">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between group-data-[stuck=true]:gap-2 lg:group-data-[stuck=true]:items-center">
            <div class="min-w-0 lg:flex-1 lg:pr-6">
                <h1 class="text-xl font-black leading-tight tracking-tight text-secondary-900 transition-[font-size] duration-200 sm:text-3xl group-data-[stuck=true]:sm:text-xl lg:overflow-hidden lg:text-ellipsis lg:whitespace-nowrap dark:text-secondary-100"
                    id="title">{{ resolvedTitle }}</h1>
                {% if hasDescription %}
                    <div class="grid grid-rows-[1fr] transition-[grid-template-rows,opacity] duration-200 group-data-[stuck=true]:grid-rows-[0fr] group-data-[stuck=true]:opacity-0">
                        <p class="min-h-0 max-w-3xl overflow-hidden text-sm text-secondary-600 dark:text-secondary-300">{{ resolvedDescription }}</p>
                    </div>
                {% endif %}
            </div>

            {% if hasActions %}
                <div class="flex flex-wrap items-center gap-2 self-start lg:max-w-[60%] lg:shrink-0 lg:justify-end lg:self-start group-data-[stuck=true]:lg:self-center [&_.btn]:inline-flex [&_.btn]:items-center [&_.btn]:gap-2 [&_.btn]:rounded-lg [&_.btn]:px-3 [&_.btn]:py-2 [&_.btn]:text-xs [&_.btn]:font-semibold">
                    {{ resolvedActions }}
                </div>
            {% endif %}
        </div>

        {% if hasBreadcrumb %}
            <div class="mt-4 border-t border-secondary-100 pt-3 transition-[margin,padding] duration-200 group-data-[stuck=true]:mt-2 group-data-[stuck=true]:pt-1.5 dark:border-secondary-700/80">
                {{ include('_layout/_breadcrumb.html.twig') }}
            </div>
        {% endif %}
    </section>
</div>
