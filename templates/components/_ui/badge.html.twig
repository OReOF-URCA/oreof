{#
Composant Badge — exemples :
  <twig:Badge label="Publie" variant="success" />
  <twig:Badge label="Brouillon" variant="secondary" icon="icon:edit" />
  <twig:Badge :label="value ? 'Oui' : 'Non'" :variant="value ? 'success' : 'danger'" />
#}

{% set sizeClass = {
    'sm': 'px-2 py-0.5 text-xs gap-1',
    'md': 'px-2.5 py-1 text-sm gap-1.5',
}[size] ?? 'px-2 py-0.5 text-xs gap-1' %}

{% set iconSizeClass = {
    'sm': 'h-3 w-3',
    'md': 'h-3.5 w-3.5',
}[size] ?? 'h-3 w-3' %}

{% set softColors = {
    'primary':   'border border-primary-300 bg-primary-50 text-primary-700 dark:border-primary-700 dark:bg-primary-900/30 dark:text-primary-300',
    'success':   'border border-success-300 bg-success-50 text-success-700 dark:border-success-700 dark:bg-success-900/30 dark:text-success-300',
    'warning':   'border border-warning-300 bg-warning-50 text-warning-700 dark:border-warning-700 dark:bg-warning-900/30 dark:text-warning-300',
    'danger':    'border border-danger-300 bg-danger-50 text-danger-700 dark:border-danger-700 dark:bg-danger-900/30 dark:text-danger-300',
    'info':      'border border-info-300 bg-info-50 text-info-700 dark:border-info-700 dark:bg-info-900/30 dark:text-info-300',
    'secondary': 'border border-secondary-300 bg-secondary-100 text-secondary-700 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-300',
} %}

{% set solidColors = {
    'primary':   'border border-transparent bg-primary-600 text-white',
    'success':   'border border-transparent bg-success-600 text-white',
    'warning':   'border border-transparent bg-warning-500 text-secondary-900',
    'danger':    'border border-transparent bg-danger-600 text-white',
    'info':      'border border-transparent bg-info-600 text-white',
    'secondary': 'border border-transparent bg-secondary-500 text-white',
} %}

{% set colorClass = soft ? (softColors[variant] ?? softColors['secondary']) : (solidColors[variant] ?? solidColors['secondary']) %}
{% set radiusClass = pill ? 'rounded-full' : 'rounded-md' %}
{% set classes = 'inline-flex items-center font-semibold ' ~ radiusClass ~ ' ' ~ sizeClass ~ ' ' ~ colorClass ~ (extraClass ? ' ' ~ extraClass : '') %}

<span class="{{ classes }}" {{- attributes -}}>
    {% if icon != '' and not iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
    {% if label != '' %}<span>{{ label }}</span>{% endif %}
    {% block content %}{% endblock %}
    {% if icon != '' and iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
</span>

