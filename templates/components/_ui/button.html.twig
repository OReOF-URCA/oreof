{#
Composant Button — exemples d'usage :
  <twig:Button label="Ajouter" variant="success" icon="icon:add" href="{{ path('...') }}" />
  <twig:Button label="Modifier" variant="warning" :soft="false" :outline="true" icon="icon:edit" href="{{ path('...') }}" />
  <twig:Button label="Enregistrer" variant="success" :soft="false" :outline="false" type="submit" icon="icon:save" />
  <twig:Button label="Supprimer" variant="danger" :soft="false" :outline="false" icon="icon:delete" />
#}

{% set isLink = href|trim != '' %}
{% set isModalLink = isLink and dataAction|trim != '' %}
{% set iconSize = 'h-4 w-4' %}
{% set iconStyle = 'width: 1rem; height: 1rem; min-width: 1rem; min-height: 1rem; flex: 0 0 auto;' %}

{# Contenu interne factorisé (icône début, label, slot, icône fin) #}
{% set innerContent %}
    {% if icon != '' and not iconEnd %}{{ ux_icon(icon, {class: iconSize, style: iconStyle}) }}{% endif %}
    {% if label != '' %}<span>{{ label }}</span>{% endif %}
    {% block content %}{% endblock %}
    {% if icon != '' and iconEnd %}{{ ux_icon(icon, {class: iconSize, style: iconStyle}) }}{% endif %}
{% endset %}

{% set extraAttrsRendered %}
    {% if attr is iterable %}
        {% for attrName, attrValue in attr %}
            {% if attrValue is same as(true) %} {{ attrName|e('html_attr') }}{% elseif attrValue is not same as(false) and attrValue is not null %} {{ attrName|e('html_attr') }}="{{ attrValue|e('html_attr') }}"{% endif %}
        {% endfor %}
    {% elseif attr is not empty %}
        {{ attr|raw }}
    {% endif %}
{% endset %}

{% if isLink %}
    <a href="{{ href }}"
       class="{{ this.allClasses }}"
       {% if tooltip %}{{ stimulus_controller('tooltip', {
           placement: tooltipPlacement,
           customClass: tooltipCustomClass,
           title: tooltip
       }) }}{% endif %}
       {% if not isModalLink and target != '' %}target="{{ target }}"{% endif %}
       {% if not isModalLink and rel != '' %}rel="{{ rel }}"{% endif %}
       {% if isModalLink %}data-turbo="false" data-turbo-preload="false" aria-haspopup="dialog"{% endif %}
       {% if dataAction != '' %}data-action="{{ dataAction }}"{% endif %}
       {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
       {{- extraAttrsRendered|raw -}}
       {{- attributes -}}
    >
        {{ innerContent|raw }}
    </a>
{% else %}
    <button
            type="{{ type }}"
            class="{{ this.allClasses }}"
            {% if form != '' %}form="{{ form }}"{% endif %}
            {% if tooltip %}{{ stimulus_controller('tooltip', {
                placement: tooltipPlacement,
                customClass: tooltipCustomClass,
                title: tooltip
            }) }}{% endif %}
            {% if dataAction != '' %}data-action="{{ dataAction }}"{% endif %}
            {% if disabled %}disabled{% endif %}
            {{- extraAttrsRendered|raw -}}
            {{- attributes -}}
    >
        {{ innerContent|raw }}
    </button>
{% endif %}
