{#
Composant Button — exemples d'usage :
  <twig:Button label="Ajouter" variant="success" icon="icon:add" href="{{ path('...') }}" />
  <twig:Button label="Modifier" variant="warning" :soft="false" :outline="true" icon="icon:edit" href="{{ path('...') }}" />
  <twig:Button label="Enregistrer" variant="success" :soft="false" :outline="false" type="submit" icon="icon:save" />
  <twig:Button label="Supprimer" variant="danger" :soft="false" :outline="false" icon="icon:delete" />
#}

{# ── Taille ───────────────────────────────────────────────────── #}
{% set sizeClass = {
    'sm': 'px-2.5 py-2 text-sm h-8 whitespace-nowrap',
    'md': 'px-4 py-2 text-sm h-10 whitespace-nowrap',
    'lg': 'px-5 py-2.5 text-base h-11 whitespace-nowrap',
}[size] ?? 'px-2.5 py-2 text-sm h-8 whitespace-nowrap' %}

{% set iconSizeClass = {
    'sm': 'h-4 w-4',
    'md': 'h-4 w-4',
    'lg': 'h-4 w-4',
}[size] ?? 'h-4 w-4' %}

{# ── Couleurs soft (défaut) : fond teinté, bordure légère ─────── #}
{% set softColors = {
    'primary':   'border border-primary-300 bg-primary-50 text-primary-700 hover:bg-primary-100 hover:text-primary-800 dark:hover:text-primary-100 dark:border-primary-500 dark:hover:border-primary-300 dark:bg-primary-900 dark:text-primary-300 dark:hover:bg-primary-900',
    'success':   'border border-success-300 bg-success-50 text-success-700 hover:bg-success-100 hover:text-success-800 dark:hover:text-success-100 dark:border-success-500 dark:hover:border-success-300 dark:bg-success-900 dark:text-success-300 dark:hover:bg-success-900',
    'warning':   'border border-warning-300 bg-warning-50 text-warning-700 hover:bg-warning-100 hover:text-warning-800 dark:hover:text-warning-100 dark:border-warning-500 dark:hover:border-warning-300 dark:bg-warning-900 dark:text-warning-300 dark:hover:bg-warning-900',
    'danger':    'border border-danger-300 bg-danger-50 text-danger-700 hover:bg-danger-100 hover:text-danger-800 dark:hover:text-danger-100 dark:border-danger-500 dark:hover:border-danger-300 dark:bg-danger-900 dark:text-danger-300 dark:hover:bg-danger-900',
    'info':      'border border-info-300 bg-info-50 text-info-700 hover:bg-info-100 hover:text-info-800 dark:hover:text-info-100 dark:border-info-500 dark:hover:border-info-300 dark:bg-info-900 dark:text-info-300 dark:hover:bg-info-900',
    'secondary': 'border border-secondary-300 bg-secondary-50 text-secondary-600 hover:bg-secondary-100 hover:text-secondary-800 dark:hover:text-secondary-100 dark:border-secondary-600 dark:hover:border-secondary-300 dark:bg-surface dark:text-secondary-300 dark:hover:bg-secondary-900',
} %}

{# ── Couleurs outline : bordure franche, fond transparent ─────── #}
{% set outlineColors = {
    'primary':   'border border-primary-600 text-primary-700 hover:bg-primary-600 hover:text-white focus:ring-primary-500 dark:border-primary-400 dark:text-primary-300 dark:hover:bg-primary-500',
    'success':   'border border-success-600 text-success-700 hover:bg-success-600 hover:text-white focus:ring-success-500 dark:border-success-400 dark:text-success-300 dark:hover:bg-success-500',
    'warning':   'border border-warning-500 text-warning-700 hover:bg-warning-500 hover:text-secondary-900 focus:ring-warning-400 dark:border-warning-400 dark:text-warning-300 dark:hover:bg-warning-400 dark:hover:text-secondary-900',
    'danger':    'border border-danger-600 text-danger-700 hover:bg-danger-600 hover:text-white focus:ring-danger-500 dark:border-danger-400 dark:text-danger-300 dark:hover:bg-danger-500',
    'info':      'border border-info-600 text-info-700 hover:bg-info-600 hover:text-white focus:ring-info-500 dark:border-info-400 dark:text-info-300 dark:hover:bg-info-500',
    'secondary': 'border border-secondary-400 text-secondary-600 hover:bg-secondary-500 hover:text-white focus:ring-secondary-400 dark:border-secondary-500 dark:text-secondary-200 dark:hover:bg-secondary-600',
} %}

{# ── Couleurs solid : fond plein ──────────────────────────────── #}
{% set solidColors = {
    'primary':   'bg-primary-600 text-white hover:bg-primary-700 focus:ring-primary-500 border border-transparent',
    'success':   'bg-success-600 text-white hover:bg-success-700 focus:ring-success-500 border border-transparent',
    'warning':   'bg-warning-500 text-secondary-900 hover:bg-warning-600 focus:ring-warning-400 border border-transparent',
    'danger':    'bg-danger-600 text-white hover:bg-danger-700 focus:ring-danger-500 border border-transparent',
    'info':      'bg-info-600 text-white hover:bg-info-700 focus:ring-info-500 border border-transparent',
    'secondary': 'bg-secondary-500 text-white hover:bg-secondary-600 focus:ring-secondary-400 border border-transparent',
} %}

{% if soft %}
    {% set colorClass = softColors[variant] ?? softColors['secondary'] %}
{% elseif outline %}
    {% set colorClass = outlineColors[variant] ?? outlineColors['secondary'] %}
{% else %}
    {% set colorClass = solidColors[variant] ?? solidColors['secondary'] %}
{% endif %}

{# ── Classes de base ──────────────────────────────────────────── #}
{% set baseClass = 'inline-flex items-center gap-1.5 rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed' %}
{% set disabledClass = disabled ? ' pointer-events-none opacity-50' : '' %}
{% set widthClass = fullWidth ? ' w-full' : '' %}
{% set justifyClass = centered ? ' justify-center' : '' %}
{% set allClasses = baseClass ~ justifyClass ~ widthClass ~ ' ' ~ sizeClass ~ ' ' ~ colorClass ~ disabledClass ~ (extraClass ? ' ' ~ extraClass : '') %}
{% set isLink = href|trim != '' %}
{% set isModalLink = isLink and dataAction|trim != '' %}
{% set extraAttrs = attr|default({}) %}
{% set extraAttrsRendered %}
    {% if extraAttrs is iterable %}
        {% for attrName, attrValue in extraAttrs %}
            {% if attrValue is same as(true) %} {{ attrName|e('html_attr') }}{% elseif attrValue is not same as(false) and attrValue is not null %} {{ attrName|e('html_attr') }}="{{ attrValue|e('html_attr') }}"{% endif %}
        {% endfor %}
    {% elseif extraAttrs is not empty %}
        {{ extraAttrs|raw }}
    {% endif %}
{% endset %}

{# ── Slot unique du composant ─────────────────────────────────── #}
{% set slotContent %}
    {% block content %}{% endblock %}
{% endset %}

{# ── Rendu ────────────────────────────────────────────────────── #}
{% if isLink %}
    <a href="{{ href }}"
       class="{{ allClasses }}"
            {% if tooltip %}{{ stimulus_controller('tooltip', {
                placement: tooltipPlacement,
                customClass: tooltipCustomClass,
                title: tooltip
            }) }}{% endif %}
            {% if not isModalLink and target != '' %}target="{{ target }}"{% endif %}
            {% if not isModalLink and rel != '' %}rel="{{ rel }}"{% endif %}
            {% if isModalLink %}data-turbo="true" aria-haspopup="dialog"{% endif %}
            {% if dataAction != '' %}data-action="{{ dataAction }}"{% endif %}
            {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}
            {{- extraAttrsRendered|raw -}}
            {{- attributes -}}
    >
        {% if icon != '' and not iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
        {% if label != '' %}<span>{{ label }}</span>{% endif %}
        {{ slotContent|trim }}
        {% if icon != '' and iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
    </a>
{% else %}
    <button
            type="{{ type }}"
            class="{{ allClasses }}"
            {% if form != '' %}form="{{ form }}"{% endif %}
            {% if tooltip %}{{ stimulus_controller('tooltip', {
                placement: tooltipPlacement,
                customClass: tooltipCustomClass,
                title: tooltip
            }) }}{% endif %}
            {% if dataAction != '' %}data-action="{{ dataAction }}"{% endif %}
            {% if disabled %}disabled{% endif %}
            {{- extraAttrsRendered|raw -}}
            {{- attributes -}}
    >
        {% if icon != '' and not iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
        {% if label != '' %}<span>{{ label }}</span>{% endif %}
        {{ slotContent|trim }}
        {% if icon != '' and iconEnd %}{{ ux_icon(icon, {class: iconSizeClass}) }}{% endif %}
    </button>
{% endif %}
