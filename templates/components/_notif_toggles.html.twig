{# templates/components/_notif_toggles.html.twig #}
{% set ch = channels %}
<div class="flex flex-wrap items-center gap-3 sm:gap-4 shrink-0" onclick="event.stopPropagation();">
    {# Email channel toggle #}
    <label class="inline-flex items-center gap-2 cursor-pointer select-none group" title="Notifications Email">
        <span class="relative inline-flex items-center">
            <input type="checkbox"
                   {{ ch.email ? 'checked' : '' }}
                   data-action="change->notification-center#toggle"
                   data-channel="email"
                   {% if workflow is defined and workflow %}data-workflow="{{ workflow }}"{% endif %}
                    {% if place is defined and place %}data-place="{{ place }}"{% endif %}
                    {% if transition is defined and transition %}data-transition="{{ transition }}"{% endif %}
                   class="sr-only peer">
            <div class="w-8 h-4.5 bg-secondary-200 peer-focus:outline-none rounded-full peer dark:bg-secondary-700 peer-checked:after:translate-x-3.5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-secondary-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all dark:border-secondary-600 peer-checked:bg-primary"></div>
        </span>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-secondary-600 group-hover:text-secondary-900 dark:text-secondary-400 dark:group-hover:text-secondary-200">
            <twig:UX:Icon name="icon:mail" class="w-3.5 h-3.5 text-secondary-400 group-hover:text-primary transition"/>
            {% if show_labels|default(true) %}<span class="hidden sm:inline">Email</span>{% endif %}
        </span>
    </label>

    {# In-app channel toggle #}
    <label class="inline-flex items-center gap-2 cursor-pointer select-none group"
           title="Notifications dans l'application">
        <span class="relative inline-flex items-center">
            <input type="checkbox"
                   {{ ch.inapp ? 'checked' : '' }}
                   data-action="change->notification-center#toggle"
                   data-channel="inapp"
                   {% if workflow is defined and workflow %}data-workflow="{{ workflow }}"{% endif %}
                    {% if place is defined and place %}data-place="{{ place }}"{% endif %}
                    {% if transition is defined and transition %}data-transition="{{ transition }}"{% endif %}
                   class="sr-only peer">
            <div class="w-8 h-4.5 bg-secondary-200 peer-focus:outline-none rounded-full peer dark:bg-secondary-700 peer-checked:after:translate-x-3.5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-secondary-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all dark:border-secondary-600 peer-checked:bg-primary"></div>
        </span>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-secondary-600 group-hover:text-secondary-900 dark:text-secondary-400 dark:group-hover:text-secondary-200">
            <twig:UX:Icon name="icon:bell" class="w-3.5 h-3.5 text-secondary-400 group-hover:text-primary transition"/>
            {% if show_labels|default(true) %}<span class="hidden sm:inline">In-app</span>{% endif %}
        </span>
    </label>

    {# Reset inheritance button #}
    {% if workflow is defined and workflow %}
        <button type="button"
                data-reset-btn
                data-action="click->notification-center#reset"
                data-workflow="{{ workflow }}"
                {% if place is defined and place %}data-place="{{ place }}"{% endif %}
                {% if transition is defined and transition %}data-transition="{{ transition }}"{% endif %}
                class="inline-flex items-center gap-1 rounded-lg border border-secondary-200 bg-white px-2 py-1 text-[11px] font-medium text-secondary-600 hover:border-secondary-300 hover:bg-secondary-50 hover:text-secondary-900 shadow-2xs transition dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300 dark:hover:bg-secondary-700 {{ inherited ? 'hidden' : '' }}"
                title="Rétablir la valeur héritée du niveau parent"
        >
            <twig:UX:Icon name="mdi:undo" class="w-3 h-3 text-secondary-400" />
            <span>Rétablir</span>
        </button>
    {% endif %}
</div>
