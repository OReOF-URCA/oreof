{% set sens = message.sens.value %}
{% set styles = {
    entrant: 'mr-8 border-secondary-200 bg-surface dark:border-secondary-700',
    sortant: 'ml-8 border-primary-200 bg-primary-50 dark:border-primary-700 dark:bg-primary-900/30',
    note: 'mx-4 border-warning-300 bg-warning-50 dark:border-warning-700 dark:bg-warning-900/30',
} %}
<article {{ attributes.defaults({class: 'rounded-xl border p-4 shadow-sm ' ~ styles[sens]}) }} id="message-{{ message.id }}">
    <header class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <span class="font-semibold text-text">{{ message.expediteurNom ?? message.expediteurEmail }}</span>
        {% if message.expediteurNom %}
            <span class="text-secondary-500 dark:text-secondary-400">{{ message.expediteurEmail }}</span>
        {% endif %}
        <twig:Badge :label="message.sens.libelle" :variant="sens == 'note' ? 'warning' : (sens == 'sortant' ? 'primary' : 'secondary')" size="sm" />
        {% if message.automatique %}
            <twig:Badge label="Message automatique" variant="secondary" size="sm" icon="mdi:robot-outline" />
        {% endif %}
        <time class="ml-auto text-xs text-secondary-500 dark:text-secondary-400" datetime="{{ message.dateEnvoi|date('c') }}">
            {{ message.dateEnvoi|date('d/m/Y à H:i') }}
        </time>
    </header>

    {% if message.destinataires is not empty %}
        {% set masques = this.destinatairesMasques %}
        <div class="mb-2 text-xs text-secondary-500 dark:text-secondary-400">
            À : {{ this.destinatairesVisibles|join(', ') }}
            {% if masques is not empty %}
                <details class="inline">
                    <summary class="inline cursor-pointer text-primary-600 hover:underline dark:text-primary-300">et {{ masques|length }} autres</summary>
                    {{ masques|join(', ') }}
                </details>
            {% endif %}
        </div>
    {% endif %}

    {% set classes_corps = 'max-w-none text-sm text-text [&_a]:text-primary-600 [&_a]:underline [&_p]:mb-2 dark:[&_a]:text-primary-300' %}
    <div class="assistance-message-corps {{ classes_corps }}">
        {# HTML nettoyé par le sanitizer « assistance_sanitizer » (à l'enregistrement, puis après découpage) #}
        {{ this.estHtml ? this.corps|raw : this.corps|nl2br }}
    </div>

    {% if this.historique is not null %}
        <details class="assistance-historique mt-2">
            <summary class="cursor-pointer text-xs text-secondary-500 hover:text-primary-600 dark:text-secondary-400">Afficher l'historique</summary>
            <div class="{{ classes_corps }} mt-2 border-l-2 border-secondary-200 pl-3 text-secondary-600 dark:border-secondary-700 dark:text-secondary-300">
                {{ this.estHtml ? this.historique|raw : this.historique|nl2br }}
            </div>
        </details>
    {% endif %}

    {% if message.piecesJointes is not empty %}
        <ul class="mt-3 flex flex-wrap gap-2">
            {% for piece in message.piecesJointes %}
                <li>
                    <twig:Button :label="piece.nomOriginal ~ ' (' ~ (piece.taille / 1024)|round(0, 'ceil') ~ ' Ko)'"
                                 variant="secondary" size="sm" icon="mdi:paperclip"
                                 href="{{ path('app_assistance_piece_jointe', {id: piece.id}) }}" />
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</article>
