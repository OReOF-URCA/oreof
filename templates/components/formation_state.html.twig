{% set colorClasses = {
    'muted': 'bg-secondary-100 text-secondary-400 dark:bg-secondary-800 dark:text-secondary-500',
    'info': 'bg-info-100 text-info-700 dark:bg-info-500/15 dark:text-info-300',
    'warning': 'bg-warning-100 text-warning-700 dark:bg-warning-500/15 dark:text-warning-300',
    'success': 'bg-success-100 text-success-700 dark:bg-success-500/15 dark:text-success-300'
} %}
{% set lineClasses = {
    'muted': 'bg-secondary-200 dark:bg-secondary-700',
    'info': 'bg-info-200 dark:bg-info-500/30',
    'warning': 'bg-warning-200 dark:bg-warning-500/30',
    'success': 'bg-success-200 dark:bg-success-500/30'
} %}


<div class="{{ this.class }}">
    {% for key, etape in this.process %}
        {% if (etape.showOn is defined and etape.showOn != false) or etape.showOn is not defined %}
            {% set state = this.stateProcess(key) %}
            {% set colorClass = colorClasses[state.color]|default(colorClasses['muted']) %}
            {% set lineClass = lineClasses[state.color]|default(lineClasses['muted']) %}

            {% if mode == 'liste' %}
                <button class="ml-1 inline-flex h-8 w-8 items-center justify-center rounded-full {{ colorClass }} transition hover:scale-105"
                        type="button"
                        data-controller="tooltip" data-tooltip-placement-value="bottom"
                        aria-label="{{ etape.label|trans({}, 'process') }}"
                        data-bs-original-title="{{ (etape.label~'.'~state.color)|trans({}, 'process') }}"
                >
                    {{ ux_icon(etape.icon, {class: 'h-4 w-4'}) }}
                </button>
            {% else %}
                <div class="flex items-center">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full ring-2 ring-white {{ colorClass }} dark:ring-secondary-900"
                         data-controller="tooltip" data-tooltip-placement-value="bottom"
                         aria-label="{{ etape.label|trans({}, 'process') }}"
                         data-bs-original-title="{{ (etape.label~'.'~state.color)|trans({}, 'process') }}"
                    >
                        {{ ux_icon(etape.icon, {class: 'h-4 w-4'}) }}
                    </div>
                    {% if not loop.last %}
                        <div class="mx-1 h-0.5 w-5 rounded-full {{ lineClass }}"></div>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
</div>
