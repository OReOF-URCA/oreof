<div {{ attributes }} data-action="modal:close@window->live#$render">
    {% if this.demandes|length > 0 %}
        {% set parent = this %}
        <section class="scroll-section" id="identite_formation">
            <twig:Card title="Demandes de changement de (co-) responsable" variant="default" extraClass="mb-6">
                <div class="divide-y divide-secondary-200 dark:divide-secondary-700">
                    {# En-têtes de table pour les grands écrans #}
                    <div class="hidden md:grid md:grid-cols-12 gap-4 pb-3 text-xs font-semibold text-secondary-500 uppercase tracking-wider items-center">
                        <div class="col-span-4">Détails de la demande</div>
                        <div class="col-span-3 text-center">Actions</div>
                        <div class="col-span-2 text-center">PV ?</div>
                        <div class="col-span-3 text-center">État des demandes</div>
                    </div>

                    {% for demande in parent.demandes %}
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-4 items-center">
                            {# Détails du changement de responsable #}
                            <div class="col-span-1 md:col-span-4 space-y-1">
                                <div class="text-sm text-text dark:text-secondary-100">
                                    Remplacement de
                                    <strong class="font-semibold text-secondary-900 dark:text-white">
                                        {{ demande.ancienResponsable != null ? demande.ancienResponsable.display : 'non défini' }}
                                    </strong>
                                    par
                                    <strong class="font-semibold text-secondary-900 dark:text-white">
                                        {{ demande.nouveauResponsable != null ? demande.nouveauResponsable.display : 'non défini' }}
                                    </strong>
                                </div>
                                <div class="flex flex-wrap gap-2 items-center text-xs text-secondary-500">
                                    <twig:Badge label="{{ demande.typeRf.value }}" variant="primary" size="sm" />
                                    <span>•</span>
                                    <span>Prise de fonction : {{ demande.datePriseFonction ? demande.datePriseFonction|date('d/m/Y') : 'non définie' }}</span>
                                </div>
                            </div>

                            {# Actions de transitions de workflow #}
                            <div class="col-span-1 md:col-span-3">
                                <div class="flex flex-wrap gap-2 justify-center">
                                    {% set place = parent.getPlace(demande) %}
                                    {% if parent.process[place] is defined %}
                                        {% if (is_granted('MANAGE', {route: 'app_composante', subject: parent.formation}) and place != 'soumis_ses' and place != 'soumis_cfvu') or
                                              (is_granted('MANAGE', {route: 'app_formation', subject: parent.formation}) and place != 'soumis_ses' and place != 'soumis_cfvu') or
                                              is_granted('ROLE_ADMIN') %}
                                            {% for key, state in hasTransitions(demande, 'changeRf') %}
                                                {% for keyTrans, transition in state %}
                                                    <twig:Button
                                                        variant="{{ transition.meta.btn }}"
                                                        :outline="true"
                                                        :soft="false"
                                                        label="{{ ('btn.validation.changeRf.'~keyTrans)|trans({}, 'process') }}"
                                                        icon="{{ transition.meta.icon|default('') }}"
                                                        tooltip="{{ ('title.validation.changeRf.'~keyTrans)|trans({}, 'process') }}"
                                                        data-turbo="true"
                                                        data-action="click->modalturbo#open"
                                                        href="{{ path('app_validation_change_rf_'~key, {
                                                                transition:keyTrans,
                                                                etape:place,
                                                                demande:demande.id
                                                        }) }}"
                                                    />
                                                {% endfor %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>

                            {# Dépôt/Téléchargement PV #}
                            <div class="col-span-1 md:col-span-2 flex justify-center items-center">
                                {{ component('historique_pv', {changeRf:demande, type:'change_rf'}) }}
                            </div>

                            {# Suivi des étapes de validation & Action de suppression #}
                            <div class="col-span-1 md:col-span-3 flex items-center justify-center gap-2">
                                <div class="flex items-center gap-1.5">
                                    {% set historique = parent.getHistoriques(demande) %}
                                    {% for key, etape in parent.process %}
                                        {% set class = 'btn-muted' %}
                                        {% if (isPlace('changeRf', demande, key)) %}
                                            {% set class = 'btn-info' %}
                                        {% else %}
                                            {% set class = hasHistorique(demande, 'changeRf.'~key, historique) %}
                                        {% endif %}

                                        {% set bgColors = {
                                            'btn-muted': 'bg-secondary-100 text-secondary-400 dark:bg-secondary-800 dark:text-secondary-500',
                                            'btn-info': 'bg-primary-100 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300 ring-2 ring-primary-500 ring-offset-2',
                                            'bg-success-100 text-success-700 dark:bg-success-900/40 dark:text-success-300': 'bg-success-100 text-success-700 dark:bg-success-900/40 dark:text-success-300',
                                            'btn-success': 'bg-success-100 text-success-700 dark:bg-success-900/40 dark:text-success-300',
                                            'btn-warning': 'bg-warning-100 text-warning-700 dark:bg-warning-900/40 dark:text-warning-300',
                                            'btn-danger': 'bg-danger-100 text-danger-700 dark:bg-danger-900/40 dark:text-danger-300'
                                        } %}
                                        {% set classBg = bgColors[class] ?? bgColors['btn-muted'] %}

                                        <button class="inline-flex items-center justify-center w-8 h-8 rounded-full {{ classBg }} transition-all focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-primary-500"
                                                type="button"
                                                data-controller="tooltip"
                                                data-tooltip-placement-value="bottom"
                                                aria-label="{{ ('changeRf.'~etape.label~'.'~class)|trans({}, 'process') }}"
                                                data-bs-original-title="{{ ('changeRf.'~etape.label~'.'~class)|trans({}, 'process') }}"
                                        >
                                            <twig:UX:Icon name="{{ etape.icon }}" class="w-4 h-4" />
                                        </button>
                                    {% endfor %}
                                </div>

                                {% if (place != 'soumis_ses' and place != 'soumis_cfvu') or is_granted('ROLE_ADMIN') %}
                                    <twig:DeleteButton
                                        :label="'btn.validation.changeRf.suppression'|trans({}, 'process')"
                                        :variant="'danger'"
                                        :outline="true"
                                        :soft="true"
                                        icon="icon:delete"
                                        :url="path('app_formation_change_rf_suppression', {demande:demande.id})"
                                        :tooltip="('btn.validation.changeRf.suppression'|trans({}, 'process'))"
                                    />
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </twig:Card>
        </section>
    {% endif %}
</div>
