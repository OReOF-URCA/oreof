<div {{ attributes }}>
    {% if this.elementConstitutif.natureUeEc != null and this.elementConstitutif.natureUeEc.isLibre == true %}
        <span class="inline-flex w-full items-center justify-center rounded-md bg-cyan-100 px-2 py-1 text-xs font-semibold text-cyan-800">EC libre</span>
    {% else %}
        {% set modalUrl = this.editable
            ? path('app_element_constitutif_bcc', { id: this.elementConstitutif.id, parcours: this.parcours.id })
            : path('app_element_constitutif_bcc_non_editable', { id: this.elementConstitutif.id, parcours: this.parcours.id })
        %}
        <a
                href="{{ modalUrl }}"
                data-action="click->modalturbo#open"
                data-turbo="true"
                class="inline-flex w-full items-center justify-center gap-1 rounded-md border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 px-2 py-1.5 text-xs font-semibold text-secondary-700 dark:text-secondary-300 hover:bg-secondary-50 dark:hover:bg-secondary-700 transition-colors"
                title="Blocs de compétences"
        >
            {% if this.texte == true %}<twig:UX:icon name="icon:check" class="h-3.5 w-3.5" />{% endif %}
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold {% if this.etatBccComplet == true %}bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300{% else %}bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300{% endif %}">
                {% if this.texte == true %}
                    {% if this.etatBccComplet == true %}Complet{% else %}À saisir{% endif %}
                {% else %}BCC{% endif %}
                {% if this.isParcoursProprietaire == false %}
                    <twig:UX:icon name="icon:link" class="h-3 w-3" title="BCC repris du parcours porteur" />
                {% endif %}
            </span>
        </a>
    {% endif %}
</div>
