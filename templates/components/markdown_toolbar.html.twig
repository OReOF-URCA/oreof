<div class="flex flex-wrap gap-2 p-2 bg-secondary-100 border border-secondary-300 rounded-t-lg dark:bg-secondary-800 dark:border-secondary-600">
    <!-- Undo/Redo -->
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="editorHistoryUndo()" title="Retour arrière">
        <twig:UX:Icon name="material-symbols:undo" class="h-4 w-4" />
    </button>
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="editorHistoryRedo()" title="Retour avant">
        <twig:UX:Icon name="material-symbols:redo" class="h-4 w-4" />
    </button>

    <div class="w-px bg-secondary-300 dark:bg-secondary-600"></div>

    <!-- Texte -->
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertMarkdown('**', '**')" title="Gras">
        <twig:UX:Icon name="glyphs:b-bold" class="h-4 w-4" />
    </button>
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertMarkdown('*', '*')" title="Italique">
        <twig:UX:Icon name="tabler:italic" class="h-4 w-4" />
    </button>

    <div class="w-px bg-secondary-300 dark:bg-secondary-600"></div>

    <!-- Structure -->
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertMarkdown('### ', '')" title="Titre">
        <twig:UX:Icon name="tabler:heading" class="h-4 w-4" />
    </button>
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertMarkdown('- ', '')" title="Liste à puces">
        <twig:UX:Icon name="material-symbols:list-rounded" class="h-4 w-4" />
    </button>
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertMarkdown('\n\n---\n\n', '')" title="Ligne horizontale">
        <twig:UX:Icon name="ic:round-minus" class="h-4 w-4" />
    </button>

    <div class="w-px bg-secondary-300 dark:bg-secondary-600"></div>

    <!-- Lien et Accordéon -->
    <button type="button" class="inline-flex items-center justify-center h-9 px-2 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertLink()" title="Insérer un lien">
        <twig:UX:Icon name="material-symbols:link-rounded" class="h-4 w-4" />
    </button>
    <button type="button" class="inline-flex items-center gap-1 h-9 px-3 text-sm font-medium rounded border border-secondary-300 bg-white text-secondary-700 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 dark:hover:bg-secondary-600 transition" onclick="insertAccordion()" title="Créer un sous-menu déroulant (accordéon)">
        <twig:UX:Icon name="gg:chevron-down-r" class="h-4 w-4" />
        Menu
    </button>

    <div class="w-px bg-secondary-300 dark:bg-secondary-600"></div>

    <!-- Média -->
    <button type="button" class="inline-flex items-center gap-1 h-9 px-3 text-sm font-medium rounded border border-primary-300 bg-primary-50 text-primary-700 hover:bg-primary-100 dark:border-primary-700 dark:bg-primary-900/30 dark:text-primary-300 dark:hover:bg-primary-900/50 transition" onclick="openImageModal()" title="Insérer une image">
        <twig:UX:Icon name="material-symbols:image-outline" class="h-4 w-4" />
        Image
    </button>
    <button type="button" class="inline-flex items-center gap-1 h-9 px-3 text-sm font-medium rounded border border-danger-300 bg-danger-50 text-danger-700 hover:bg-danger-100 dark:border-danger-700 dark:bg-danger-900/30 dark:text-danger-300 dark:hover:bg-danger-900/50 transition" onclick="insertVideo()" title="Insérer une vidéo YouTube/Vimeo">
        <twig:UX:Icon name="akar-icons:video" class="h-4 w-4" />
        Vidéo
    </button>
</div>
