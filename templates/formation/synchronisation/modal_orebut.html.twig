{# templates/formation/synchronisation/modal_orebut.html.twig #}
<div class="relative space-y-5"
     data-controller="orebut-modal"
     data-orebut-modal-url-value="{{ path('app_formation_synchronisation_orebut_modal', {formation: formation.id}) }}">

    {# Indicateur de chargement lors d'un changement de spécialité ou d'année #}
    <div data-orebut-modal-target="loader"
         class="hidden absolute inset-0 z-20 flex items-center justify-center rounded-2xl bg-white/70 backdrop-blur-[2px] dark:bg-secondary-900/70">
        <div class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-white dark:bg-secondary-800 shadow-md border border-secondary-200 dark:border-secondary-700 text-xs font-semibold text-primary-600 dark:text-primary-400">
            <twig:UX:Icon name="mdi:loading" class="h-4 w-4 animate-spin"/>
            <span>Chargement des données ORéBUT…</span>
        </div>
    </div>

    {# En-tête statut et connexion API #}
    <div class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-4 dark:border-secondary-700 dark:bg-secondary-800/50">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
                    <twig:UX:Icon name="mdi:api" class="h-4 w-4"/>
                </div>
                <div>
                    <div class="text-xs font-bold uppercase tracking-wider text-secondary-500 dark:text-secondary-400">
                        API ORéBUT connectée
                    </div>
                    <div class="text-sm font-semibold text-secondary-800 dark:text-secondary-100 font-mono">
                        {{ apiUrl }}
                    </div>
                </div>
            </div>
            <div>
                {% if hasCustomConfig %}
                    <twig:Badge label="Établissement" variant="success" icon="mdi:check-circle" />
                {% else %}
                    <twig:Badge label="URL nationale" variant="secondary" icon="mdi:information-outline" />
                {% endif %}
            </div>
        </div>

        {% if deptInfo is not null %}
            <div class="mt-3 pt-3 border-t border-secondary-200 dark:border-secondary-700 flex flex-wrap items-center gap-3 text-xs text-secondary-600 dark:text-secondary-300">
                <div class="flex items-center gap-1.5 font-medium text-success-700 dark:text-success-400">
                    <twig:UX:Icon name="mdi:check-circle" class="h-3.5 w-3.5"/>
                    <span>Spécialité détectée : <strong>{{ deptInfo.libelle }}</strong> ({{ deptInfo.sigle }})</span>
                </div>
                <span>•</span>
                <span>Programme version <strong>{{ selectedAnnee|default(2021) }}</strong></span>
                <span>•</span>
                <span>{{ deptInfo.apcParcours|default([])|length }} parcours nationaux</span>
                <span>•</span>
                <span>{{ deptInfo.apcCompetences|default([])|length }} compétences</span>
            </div>
        {% else %}
            <div class="mt-3 pt-3 border-t border-secondary-200 dark:border-secondary-700 flex items-center gap-2 text-xs text-warning-700 dark:text-warning-400">
                <twig:UX:Icon name="mdi:alert-circle" class="h-4 w-4 shrink-0"/>
                <span>Spécialité non trouvée directement avec le sigle « {{ detectedSigle }} » en version {{ selectedAnnee|default(2021) }}. Sélectionnez la spécialité correspondante ci-dessous.</span>
            </div>
        {% endif %}
    </div>

    {# Formulaire principal de synchronisation #}
    <form id="form-sync-orebut"
          method="post"
          action="{{ path('app_formation_synchronisation_orebut_modal', {formation: formation.id}) }}"
          data-turbo-frame="_top"
          class="space-y-5">
        <input type="hidden" name="_token" value="{{ csrf_token('orebut_sync_' ~ formation.id) }}">

        {# 1. Choix de l'année de version (2021 ou 2027) #}
        <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-200 mb-2">
                Version du programme national
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {# Option 2021 #}
                <label class="flex items-start gap-3 p-3.5 rounded-xl border cursor-pointer transition shadow-sm {% if selectedAnnee|default(2021) == 2021 %}border-primary-500 bg-primary-50/40 dark:border-primary-500 dark:bg-primary-950/30 ring-1 ring-primary-500{% else %}border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800{% endif %}">
                    <input type="radio"
                           name="annee"
                           value="2021"
                           {% if selectedAnnee|default(2021) == 2021 %}checked{% endif %}
                           data-action="change->orebut-modal#refresh"
                           class="mt-1 h-4 w-4 text-primary-600 border-secondary-300 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                    <div class="flex-1">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-bold text-secondary-800 dark:text-secondary-100">Programme 2021</span>
                            <span class="text-[10px] uppercase font-semibold px-1.5 py-0.5 rounded bg-secondary-100 dark:bg-secondary-700 text-secondary-600 dark:text-secondary-300">Initial</span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            Programme national originel du BUT (parcours 2021-2026).
                        </p>
                    </div>
                </label>

                {# Option 2027 #}
                <label class="flex items-start gap-3 p-3.5 rounded-xl border cursor-pointer transition shadow-sm {% if selectedAnnee|default(2021) == 2027 %}border-primary-500 bg-primary-50/40 dark:border-primary-500 dark:bg-primary-950/30 ring-1 ring-primary-500{% else %}border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800{% endif %}">
                    <input type="radio"
                           name="annee"
                           value="2027"
                           {% if selectedAnnee|default(2021) == 2027 %}checked{% endif %}
                           data-action="change->orebut-modal#refresh"
                           class="mt-1 h-4 w-4 text-primary-600 border-secondary-300 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                    <div class="flex-1">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-bold text-secondary-800 dark:text-secondary-100">Programme 2027</span>
                            <span class="text-[10px] uppercase font-semibold px-1.5 py-0.5 rounded bg-info-100 dark:bg-info-900/60 text-info-700 dark:text-info-300">Réforme</span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            Nouvelle mouture réformée du programme national du BUT.
                        </p>
                    </div>
                </label>
            </div>
        </div>

        {# 2. Choix du département / spécialité #}
        <div>
            <label for="orebut_sigle" class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-200 mb-1.5">
                Spécialité nationale ORéBUT
            </label>
            {% if allDepartements is defined and allDepartements|length > 0 %}
                <select id="orebut_sigle"
                        name="sigle"
                        data-orebut-modal-target="sigle"
                        data-action="change->orebut-modal#refresh"
                        class="w-full rounded-xl border border-secondary-300 bg-white px-3.5 py-2 text-sm text-secondary-800 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100">
                    {% for dept in allDepartements %}
                        {% set curSigle = dept.sigle|lower %}
                        <option value="{{ curSigle }}" {% if curSigle == detectedSigle|lower %}selected{% endif %}>
                            {{ dept.sigle }} — {{ dept.libelle }}
                        </option>
                    {% endfor %}
                </select>
            {% else %}
                <input type="text"
                       id="orebut_sigle"
                       name="sigle"
                       value="{{ detectedSigle }}"
                       data-orebut-modal-target="sigle"
                       data-action="change->orebut-modal#refresh"
                       class="w-full rounded-xl border border-secondary-300 bg-white px-3.5 py-2 text-sm text-secondary-800 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100"
                       required>
            {% endif %}
            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-1">
                Identifiant du programme national (ex : <code>info</code>, <code>cj</code>, <code>geii</code>, <code>tc</code>...).
            </p>
        </div>

        {# 3. Choix des parcours à reprendre #}
        {% if deptInfo is not null and deptInfo.apcParcours|default([])|length > 0 %}
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-200">
                        Parcours nationaux à intégrer
                    </span>
                    <label class="flex items-center gap-1.5 text-xs text-secondary-600 dark:text-secondary-400 cursor-pointer select-none">
                        <input type="checkbox"
                               checked
                               data-action="change->orebut-modal#toggleAllParcours"
                               class="h-3.5 w-3.5 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                        <span>Tout cocher / décocher</span>
                    </label>
                </div>

                <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                    {% for parcours in deptInfo.apcParcours %}
                        {% set pCode = parcours.code|default('') %}
                        {% set isAlreadyConfigured = existingParcoursSigles is defined and pCode in existingParcoursSigles %}
                        <label class="flex items-start gap-3 p-2.5 rounded-xl border border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800 cursor-pointer transition shadow-sm">
                            <input type="checkbox"
                                   name="parcours_codes[]"
                                   value="{{ pCode }}"
                                   checked
                                   class="mt-1 h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300 font-mono">
                                        {{ pCode }}
                                    </span>
                                    <span class="text-xs font-semibold text-secondary-800 dark:text-secondary-100 truncate">
                                        {{ parcours.libelle|default(pCode) }}
                                    </span>
                                    {% if isAlreadyConfigured %}
                                        <span class="text-[10px] font-medium px-1.5 py-0.2 rounded bg-success-50 text-success-700 border border-success-200 dark:bg-success-950/40 dark:text-success-300 dark:border-success-800">
                                            Déjà présent
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </label>
                    {% endfor %}
                </div>
                <p class="text-[11px] text-secondary-500 dark:text-secondary-400 mt-1.5">
                    Décocher les parcours que votre composante ne dispense pas. Seuls les parcours cochés seront synchronisés.
                </p>
            </div>
        {% endif %}

        {# 4. Options d'éléments à synchroniser sous forme de checkboxes #}
        <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-200 mb-2.5">
                Éléments à synchroniser
            </span>

            <div class="space-y-3">
                {# Option 1 : Parcours #}
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800 cursor-pointer transition shadow-sm">
                    <input type="checkbox"
                           name="sync_parcours"
                           value="1"
                           checked
                           class="mt-1 h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <twig:UX:Icon name="mdi:routes" class="h-4 w-4 text-primary-600 dark:text-primary-400"/>
                            <span class="text-sm font-bold text-secondary-800 dark:text-secondary-100">
                                Parcours et structure des semestres
                            </span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            Créer ou mettre à jour les parcours sélectionnés, configurer le tronc commun (S1-S2) et les semestres spécifiques (S3-S6).
                        </p>
                    </div>
                </label>

                {# Option 2 : Compétences #}
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800 cursor-pointer transition shadow-sm">
                    <input type="checkbox"
                           name="sync_competences"
                           value="1"
                           checked
                           class="mt-1 h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <twig:UX:Icon name="mdi:certificate" class="h-4 w-4 text-info-600 dark:text-info-400"/>
                            <span class="text-sm font-bold text-secondary-800 dark:text-secondary-100">
                                Référentiel de compétences & déclinaisons par parcours
                            </span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            Compétences, composantes essentielles, situations professionnelles, niveaux annuels et apprentissages critiques (AC). Crée les UEs de compétences par semestre pour les parcours choisis.
                        </p>
                    </div>
                </label>

                {# Option 3 : Maquette (Ressources & SAE) #}
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-secondary-200 bg-white hover:bg-secondary-50/60 dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:bg-secondary-800 cursor-pointer transition shadow-sm">
                    <input type="checkbox"
                           name="sync_maquette"
                           value="1"
                           checked
                           class="mt-1 h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-700">
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <twig:UX:Icon name="mdi:book-open-page-variant" class="h-4 w-4 text-warning-600 dark:text-warning-400"/>
                            <span class="text-sm font-bold text-secondary-800 dark:text-secondary-100">
                                Maquette pédagogique : Ressources et SAÉ
                            </span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            Fiches matières (descriptifs, objectifs, volumes horaires PPN), rattachements aux parcours, création des ECs dans les UEs avec coefficients ECTS et association des AC.
                        </p>
                    </div>
                </label>
            </div>
        </div>

        {# Avertissement sécurité #}
        <div class="rounded-xl border border-info-200 bg-info-50/60 p-3 text-xs text-info-800 dark:border-info-800 dark:bg-info-950/40 dark:text-info-300 flex items-start gap-2.5">
            <twig:UX:Icon name="mdi:information-outline" class="h-4 w-4 text-info-600 dark:text-info-400 shrink-0 mt-0.5"/>
            <div>
                La synchronisation est <strong>non destructive</strong> : les éléments existants sont mis à jour sans supprimer vos fiches matières personnalisées ni vos paramétrages d'heures locaux.
            </div>
        </div>
    </form>
</div>
