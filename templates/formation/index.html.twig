{% extends 'base.html.twig' %}

{% block content %}
    <section
            class="space-y-4 rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6"
            {{ stimulus_controller('crud', {
                url: path('app_formation_liste'),
                storageKey: 'formation_liste',
            }) }}
         data-action="base:refreshListe@window->crud#refreshListe"
    >
        <div {{ stimulus_target('crud', 'liste') }}>
        </div>
    </section>
{% endblock %}

{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button
                href="{{ path('app_parcours_lheo_invalid_list') }}"
                variant="success"
                size="sm"
                icon="icon:check"
                label="Verifier Export LHEO"
                tooltip="Verifier Export LHEO"
                class="mx-2"
        />
    {% endif %}

{% endblock %}
