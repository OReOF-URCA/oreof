<tr id="parcours_{{ formation.id }}" class="bg-secondary-100 dark:bg-secondary-800">
    <td colspan="5" class="p-0">
        <div class="border-l-4 border-info-400 bg-surface p-4 dark:border-info-300 dark:bg-surface">
            {% set nbParcoursTotal = formation.hasParcours ? formation.parcours|filter(parcours => parcours.formation.hasParcours)|length : (formation.parcours|length > 0 ? 1 : 0) %}
            {% set nbParcoursNonOuverts = 0 %}
            {% if formation.hasParcours %}
                {% for parcours in formation.parcours|filter(parcours => parcours.formation.hasParcours) %}
                    {% if dpesParcours[parcours.id].isNonOuvert %}
                        {% set nbParcoursNonOuverts = nbParcoursNonOuverts + 1 %}
                    {% endif %}
                {% endfor %}
            {% elseif formation.parcours|length > 0 %}
                {% set parcours = formation.parcours[0] %}
                {% if dpesParcours[parcours.id].isNonOuvert or formation.isNonOuvert %}
                    {% set nbParcoursNonOuverts = 1 %}
                {% endif %}
            {% endif %}
            {% set nbParcoursOuverts = nbParcoursTotal - nbParcoursNonOuverts %}

            <div class="mb-3 rounded-xl border border-secondary-200 bg-surface px-4 py-3 shadow-sm dark:border-secondary-700 dark:bg-surface">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold text-text dark:text-secondary-100">
                        Parcours de <span class="text-primary-700 dark:text-primary-300">{{ formation.display }}</span>
                    </p>
                    <div class="flex flex-wrap items-center gap-2 text-xs">
                        <twig:Badge label="{{ nbParcoursTotal }} parcours" variant="secondary" size="sm"/>
                        <twig:Badge label="{{ nbParcoursOuverts }} ouvert{{ nbParcoursOuverts > 1 ? 's' : '' }}" variant="success" size="sm"/>
                        <twig:Badge label="{{ nbParcoursNonOuverts }} non ouvert{{ nbParcoursNonOuverts > 1 ? 's' : '' }}" variant="warning" size="sm"/>
                    </div>
                </div>
            </div>

            <div class="overflow-hidden rounded-xl border border-secondary-200 bg-surface shadow-sm dark:border-secondary-700 dark:bg-surface">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm text-text dark:text-secondary-200">
                        <thead class="bg-secondary-50 text-left text-[11px] font-black uppercase tracking-wider text-secondary-600 dark:bg-secondary-800 dark:text-secondary-300">
                        <tr>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">Parcours</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">Lieu</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">Etat</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">BCC</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">MCCC</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">Conseil</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 dark:bg-secondary-800">Remplissage</th>
                            <th class="sticky top-0 z-10 bg-secondary-50 px-4 py-3 text-right dark:bg-secondary-800">Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
                        {% if formation.hasParcours %}
                             {% for parcours in formation.parcours|filter(parcours => parcours.formation.hasParcours) %}
                                <tr class="align-top hover:bg-secondary-100 dark:hover:bg-secondary-700">
                                    <td class="px-4 py-3">
                                        <div class="flex flex-col gap-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="font-medium text-text dark:text-secondary-100">{{ parcours.libelle }}</span>
                                                {% if parcours.typeParcours is not null and parcours.typeParcours.value != 'classique' %}
                                                    <twig:Badge label="{{ parcours.typeParcours.getLabel() }}" variant="{{ parcours.typeParcours.getColor() }}" size="sm"/>
                                                {% endif %}
                                            </div>
                                            <div class="text-xs text-secondary-600 dark:text-secondary-400">
                                                RP: {{ parcours.respParcours != null ? parcours.respParcours.display : 'Non défini' }}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">{{ parcours.localisation != null ? parcours.localisation.libelle : 'Non défini' }}</td>
                                    {% if dpesParcours[parcours.id].isNonOuvert %}
                                        <td colspan="5" class="px-4 py-3">
                                            <twig:Badge label="Parcours non ouvert" variant="warning" size="sm" extraClass="w-full justify-center"/>
                                        </td>
                                    {% else %}
                                        <td class="px-4 py-3">{{ include('communs/_badge_collection.html.twig', { badges: dpesParcours[parcours.id].etatValidation|badgeDpeDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('Badge', { dto: parcours.etatStep(3)|badgeStepDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('Badge', { dto: parcours.etatStep(4)|badgeStepDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('historique_pv', {parcours:parcours}) }}</td>
                                        <td class="px-4 py-3">{{ component('remplissage_progress', { value: parcours.remplissage }) }}</td>
                                    {% endif %}
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex flex-col items-stretch justify-end gap-2 sm:flex-row sm:items-center">
                                            <twig:Button
                                                    label="Voir"
                                                    variant="info"
                                                    :outline="true"
                                                    :soft="false"
                                                    icon="icon:info"
                                                    href="{{ path('parcours_v2_voir',{'parcours': parcours.id}) }}"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    size="sm"
                                                    tooltip="Voir le parcours"
                                            />
                                            {% set canAccess = is_granted('EDIT', {route: 'app_parcours', subject:  dpesParcours[parcours.id]}) %}
                                            {{ component('dropdown_actions', {
                                                label: 'Actions',
                                                help: 'Actions disponibles pour ce parcours',
                                                icon: 'icon:ellipsis-vertical',
                                                items: [
                                                    {
                                                        label: 'Vérifier la saisie',
                                                        icon: 'icon:check',
                                                        modal: true,
                                                        url: path('app_parcours_state', {parcours: parcours.id})
                                                    },
                                                    {
                                                        label: 'Modifier',
                                                        icon: 'icon:edit',
                                                        color: 'primary',
                                                        url: path('parcours_v2_modifier', {'parcours': parcours.id}),
                                                        disabled: not canAccess,
                                                        help: canAccess ? null : 'Vous n\'avez pas les droits pour modifier ce parcours'
                                                    },
                                                    {
                                                        label: 'Supprimer',
                                                        icon: 'icon:delete',
                                                        color: 'danger',
                                                        url: path('app_parcours_delete', {'id': parcours.id, csrf: csrf_token('delete' ~ parcours.id)}),
                                                        disabled: not is_granted('ROLE_ADMIN')
                                                    }
                                                ]
                                            }) }}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            {% if formation.parcours|length == 0 %}
                                <tr>
                                    <td colspan="8" class="px-4 py-4">
                                        <twig:Badge label="Formation non initialisée, pas de parcours ou de parcours par défaut." variant="warning" size="sm" extraClass="w-full justify-center"/>
                                    </td>
                                </tr>
                             {% else %}
                                {% set parcours = formation.parcours[0] %}
                                <tr class="align-top hover:bg-secondary-100 dark:hover:bg-secondary-700">
                                    <td class="px-4 py-3">
                                        <div class="font-medium text-text dark:text-secondary-100">{{ formation.display }}</div>
                                        <div class="mt-1 text-xs text-secondary-600 dark:text-secondary-400">
                                            RP: {{ formation.responsableMention != null ? formation.responsableMention.display : 'Non défini' }}
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">{{ formation.localisationMention != null and formation.localisationMention|length >= 1 ? formation.localisationMention[0].libelle : 'Non défini' }}</td>
                                    {% if dpesParcours[parcours.id].isNonOuvert or formation.isNonOuvert %}
                                        <td colspan="5" class="px-4 py-3">
                                            <twig:Badge label="Parcours non ouvert" variant="warning" size="sm" extraClass="w-full justify-center"/>
                                        </td>
                                    {% else %}
                                        <td class="px-4 py-3">{{ include('communs/_badge_collection.html.twig', { badges: dpesParcours[parcours.id].etatValidation|badgeDpeDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('Badge', { dto: parcours.etatStep(3)|badgeStepDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('Badge', { dto: parcours.etatStep(4)|badgeStepDto }) }}</td>
                                        <td class="px-4 py-3">{{ component('historique_pv', {parcours:parcours}) }}</td>
                                        <td class="px-4 py-3">{{ component('remplissage_progress', { value: parcours.remplissage }) }}</td>
                                    {% endif %}
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex flex-col items-stretch justify-end gap-2 sm:flex-row sm:items-center">
                                            <twig:Button
                                                    label="Voir"
                                                    variant="info"
                                                    :outline="true"
                                                    :soft="false"
                                                    icon="icon:info"
                                                    href="{{ path('formation_v2_voir',{'slug': formation.slug}) }}"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    size="sm"
                                                    tooltip="Voir la formation"
                                            />
                                            {% set canAccess = is_granted('EDIT', {route: 'app_formation', subject: formation}) or is_granted('EDIT', {route: 'app_parcours', subject: formation.parcours[0]}) %}
                                            {{ component('dropdown_actions', {
                                                label: 'Actions',
                                                help: 'Actions disponibles pour cette formation',
                                                icon: 'icon:ellipsis-vertical',
                                                items: [
                                                    {
                                                        label: 'Vérifier la saisie',
                                                        icon: 'icon:check',
                                                        modal: true,
                                                        url: path('app_formation_state', {slug: formation.slug})
                                                    },
                                                    {
                                                        label: 'Modifier',
                                                        icon: 'icon:edit',
                                                        color: 'primary',
                                                        url: path('formation_v2_modifier', {'slug': formation.slug}),
                                                        disabled: not canAccess,
                                                        help: canAccess ? null : 'Vous n\'avez pas les droits pour modifier cette formation'
                                                    }
                                                ]
                                            }) }}

                                            {% if is_granted('CAN_FORMATION_DELETE_MY') or is_granted('ROLE_ADMIN') %}
                                                <twig:Button
                                                        label="Supprimer"
                                                        variant="danger"
                                                        :soft="false"
                                                        icon="icon:delete"
                                                        size="sm"
                                                        type="button"
                                                        dataAction="click->crud#delete"
                                                        tooltip="Supprimer la formation"
                                                        extraClass="text-xs"
                                                        data-crud-url-param="{{ path('app_formation_delete',{'id': formation.id}) }}"
                                                        data-crud-csrf-param="{{ csrf_token('delete' ~ formation.id) }}"
                                                />
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                        {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </td>
</tr>
