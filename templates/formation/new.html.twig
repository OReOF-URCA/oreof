{% extends 'base.html.twig' %}

{% block content %}
    <div class="space-y-6">
        <!-- Bloc 1: Choix du type de diplôme -->
        <div class="rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
            {{ include('_layout/_section_shell.html.twig', {
                title_card: 'Créer une nouvelle formation',
                description_card: 'Sélectionnez d\'abord le type de diplôme pour configurer le formulaire.',
            }) }}
            
            <div class="mt-4">
                <label for="select_type_diplome" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Type de diplôme</label>
                <select id="select_type_diplome" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white">
                    <option value="" disabled {% if not selectedTypeDiplome %}selected{% endif %}>Choisir un type de diplôme...</option>
                    {% for td in typeDiplomes %}
                        <option value="{{ td.id }}" {% if selectedTypeDiplome and selectedTypeDiplome.id == td.id %}selected{% endif %}>{{ td.libelle }} ({{ td.libelleCourt }})</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <!-- Bloc 2: Formulaire dynamique chargé via Turbo Frame -->
        <turbo-frame id="formation_form_frame" target="_top">
            {% if selectedTypeDiplome and formTemplate %}
                <div class="rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
                    {{ include(formTemplate) }}
                </div>
            {% endif %}
        </turbo-frame>
    </div>

    <script>
        (function() {
            const select = document.getElementById('select_type_diplome');
            const frame = document.getElementById('formation_form_frame');
            if (!select || !frame) return;

            let isDirty = false;
            
            // Listen to inputs inside the frame to mark form as dirty
            frame.addEventListener('input', () => {
                isDirty = true;
            });

            select.dataset.initialValue = select.value;

            select.addEventListener('change', (e) => {
                if (isDirty) {
                    if (!confirm("Attention, changer le type de diplôme va réinitialiser le formulaire et vous perdrez les données déjà saisies. Voulez-vous continuer ?")) {
                        select.value = select.dataset.initialValue;
                        return;
                    }
                }
                isDirty = false;
                select.dataset.initialValue = select.value;

                // Load new form dynamically inside the turbo frame
                const url = new URL(window.location.href);
                url.searchParams.set('typeDiplome', select.value);
                
                // Set the src of the frame to fetch the new form
                frame.src = url.toString();

                // Update browser history URL
                window.history.pushState({}, '', url.toString());
            });
        })();
    </script>
{% endblock %}

{% set header_title %}
    Créer une nouvelle formation
{% endset %}



{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button
                href="{{ path('app_offre_index') }}"
                variant="secondary"
                :outline="true"
                :soft="false"
                icon="icon:arrow-left"
                label="Retour"
                tooltip="Retour"
        />
    {% endif %}
{% endblock %}
