{% extends 'base.html.twig' %}

{% set header_title %}
    Créer une nouvelle formation
{% endset %}

{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button
                href="{{ path('app_offre_index') }}"
                variant="secondary"
                :outline="true"
                :soft="false"
                icon="icon:arrow-left"
                label="Retour"
                tooltip="Retour"
        />
    {% endif %}
{% endblock %}

{% block content %}
    <div class="space-y-6 w-full">
        <!-- Bloc 1: Choix du type de diplôme -->
        <div class="rounded-2xl border border-secondary-200 bg-surface p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
            <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                    <div class="flex items-center gap-2">
                        <twig:UX:Icon name="icon:graduation" class="size-5 text-primary-600 dark:text-primary-400" />
                        <h2 class="text-base font-bold text-secondary-900 dark:text-secondary-50">
                            Type de diplôme
                        </h2>
                    </div>
                    <p class="mt-1 text-xs text-secondary-500 dark:text-secondary-400">
                        Sélectionnez le type de diplôme pour charger le formulaire adapté à sa maquette pédagogique.
                    </p>
                </div>
                {% if selectedTypeDiplome %}
                    <twig:Badge
                        variant="primary"
                        :label="selectedTypeDiplome.libelleCourt"
                        :pill="true"
                        size="md"
                    />
                {% endif %}
            </div>
            
            <div class="mt-2">
                <label for="select_type_diplome" class="sr-only">Type de diplôme</label>
                <select id="select_type_diplome" class="w-full rounded-xl border border-secondary-200 bg-white px-4 py-3 text-sm font-semibold text-secondary-800 shadow-sm transition focus:border-primary-500 focus:ring-2 focus:ring-primary-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:ring-primary-900/30">
                    <option value="" disabled {% if not selectedTypeDiplome %}selected{% endif %}>Choisir un type de diplôme...</option>
                    {% for td in typeDiplomes %}
                        <option value="{{ td.id }}" {% if selectedTypeDiplome and selectedTypeDiplome.id == td.id %}selected{% endif %}>{{ td.libelle }} ({{ td.libelleCourt }})</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <!-- Bloc 2: Formulaire dynamique chargé via Turbo Frame -->
        <turbo-frame id="formation_form_frame" target="_top">
            {% if selectedTypeDiplome and formTemplate %}
                <div class="rounded-2xl border border-secondary-200 bg-surface p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
                    {{ include(formTemplate) }}
                </div>
            {% elseif not selectedTypeDiplome %}
                <div class="rounded-2xl border border-dashed border-secondary-300 bg-secondary-50/50 p-8 text-center dark:border-secondary-700 dark:bg-secondary-900/40">
                    <twig:UX:Icon name="icon:info" class="mx-auto size-8 text-secondary-400 dark:text-secondary-500 mb-2" />
                    <p class="text-sm font-medium text-secondary-600 dark:text-secondary-400">
                        Veuillez choisir un type de diplôme ci-dessus pour afficher les options de création.
                    </p>
                </div>
            {% endif %}
        </turbo-frame>
    </div>

    <script>
        (function() {
            const select = document.getElementById('select_type_diplome');
            const frame = document.getElementById('formation_form_frame');
            if (!select || !frame) return;

            let isDirty = false;
            
            // Listen to inputs inside the frame to mark form as dirty
            frame.addEventListener('input', () => {
                isDirty = true;
            });

            select.dataset.initialValue = select.value;

            select.addEventListener('change', (e) => {
                if (isDirty) {
                    if (!confirm("Attention, changer le type de diplôme va réinitialiser le formulaire et vous perdrez les données déjà saisies. Voulez-vous continuer ?")) {
                        select.value = select.dataset.initialValue;
                        return;
                    }
                }
                isDirty = false;
                select.dataset.initialValue = select.value;

                // Load new form dynamically inside the turbo frame
                const url = new URL(window.location.href);
                url.searchParams.set('typeDiplome', select.value);
                
                // Set the src of the frame to fetch the new form
                frame.src = url.toString();

                // Update browser history URL
                window.history.pushState({}, '', url.toString());
            });
        })();
    </script>
{% endblock %}
