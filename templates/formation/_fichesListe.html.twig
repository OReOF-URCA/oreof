{# todo: reprendre cette page comme le bilan des formations pour le SES, DPE ou Admin avec état, remplissage et
bouton pour valider/invalide les étapes successives #}
<div class="space-y-4" {{ stimulus_controller('structure--formation') }}>
    {% set sort = params.sort is defined ? params.sort : 'typeDiplome' %}
    {% set direction = params.direction is defined ? params.direction : 'asc' %}

    {# Compter les filtres actifs #}
    {% set activeFilters = 0 %}
    {% if params['composantePorteuse'] is defined and params['composantePorteuse'] %}
        {% set activeFilters = activeFilters + 1 %}
    {% endif %}
    {% if params['typeDiplome'] is defined and params['typeDiplome'] %}
        {% set activeFilters = activeFilters + 1 %}
    {% endif %}
    {% if params['mention'] is defined and params['mention'] %}
        {% set activeFilters = activeFilters + 1 %}
    {% endif %}
    {% if params['responsable'] is defined and params['responsable'] %}
        {% set activeFilters = activeFilters + 1 %}
    {% endif %}
    {% if params['remplissage'] is defined and params['remplissage'] and params['remplissage'] != 'all' %}
        {% set activeFilters = activeFilters + 1 %}
    {% endif %}

    {# En-tête avec résumé #}
    <div class="space-y-3">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="rounded-2xl border border-info-200 bg-info-50 px-4 py-3 text-sm text-info-900 dark:border-info-800 dark:bg-info-950/30 dark:text-info-100">
                <div class="flex flex-wrap items-center gap-2">
                    <span><strong>{{ formations|length }}</strong> formation{{ formations|length > 1 ? 's' : '' }} trouvée{{ formations|length > 1 ? 's' : '' }}</span>

                    {% if activeFilters > 0 %}
                        <span class="text-xs opacity-75">•</span>
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-info-200 px-2.5 py-1 text-xs font-semibold dark:bg-info-900">
                            {{ ux_icon('icon:filter', {class: 'h-3.5 w-3.5'}) }}
                            {{ activeFilters }} filtre{{ activeFilters > 1 ? 's' : '' }} actif{{ activeFilters > 1 ? 's' : '' }}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% embed 'components/filter_panel.html.twig' with {
        title: 'Filtres',
        activeFilters: activeFilters,
        fieldsTitle: 'Filtres avancés',
        collapsible: true,
        collapsedByDefault: true
    } %}
        {% block search %}
            <label for="filter-quick-search" class="sr-only">Recherche rapide</label>
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-secondary-400">
                    {{ ux_icon('icon:search', {class: 'h-4 w-4'}) }}
                </span>
                <input type="text"
                       id="filter-quick-search"
                       class="w-full rounded-lg border border-secondary-300 bg-white py-2 pl-9 pr-3 text-sm text-secondary-700 shadow-sm outline-none transition placeholder:text-secondary-400 focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder:text-secondary-400 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                       placeholder="Rechercher une formation, mention, sigle..."
                       value="{{ params.q|default('') }}"
                        {{ stimulus_action('crud', 'rechercher', 'keyup') }}>
            </div>
        {% endblock %}

        {% block actions %}
            <twig:Button
                    variant="danger"
                    size="sm"
                    icon="icon:sync"
                    label="Réinitialiser"
                    dataAction="click->crud#effaceFiltre"
            />

            {% if collapsible|default(false) %}
                <label for="{{ toggleId }}"
                       class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-secondary-200 bg-white px-3 py-2 text-xs font-semibold text-secondary-600 shadow-sm transition hover:border-secondary-300 hover:text-secondary-900 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:border-secondary-500 dark:hover:text-white"
                       title="Afficher/masquer les filtres"
                       aria-label="Afficher ou masquer les filtres">
                    {{ ux_icon('icon:filter', {class: 'h-4 w-4'}) }}
                    Filtres
                    {% if activeFilters > 0 %}
                        <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-primary-600 px-1.5 py-0.5 text-[10px] font-bold text-white dark:bg-primary-500">
                            {{ activeFilters }}
                        </span>
                    {% endif %}
                </label>
            {% else %}
                <span class="inline-flex items-center gap-2 rounded-lg border border-secondary-200 bg-white px-3 py-2 text-xs font-semibold text-secondary-600 shadow-sm dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200">
                    {{ ux_icon('icon:filter', {class: 'h-4 w-4'}) }}
                    Filtres
                    {% if activeFilters > 0 %}
                        <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-primary-600 px-1.5 py-0.5 text-[10px] font-bold text-white dark:bg-primary-500">
                            {{ activeFilters }}
                        </span>
                    {% endif %}
                </span>
            {% endif %}
        {% endblock %}

        {% block fields %}
            <div>
                <label for="filter-mention"
                       class="mb-1 block text-xs font-semibold text-secondary-600 dark:text-secondary-300">Mention</label>
                <select id="filter-mention"
                        class="w-full rounded-lg border border-secondary-300 bg-white px-2.5 py-2 text-xs font-medium text-secondary-700 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                        {{ stimulus_action('crud', 'filter', 'change', {'field': 'mention'}) }}
                        {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                    <option value="">Toutes les mentions</option>
                    {% for mention in mentions %}
                        <option value="{{ mention.id }}"
                                {% if params['mention'] is defined and params['mention'] == mention.id %}selected{% endif %}>{{ mention.libelle }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="filter-composante"
                       class="mb-1 block text-xs font-semibold text-secondary-600 dark:text-secondary-300">Composante</label>
                <select id="filter-composante"
                        class="w-full rounded-lg border border-secondary-300 bg-white px-2.5 py-2 text-xs font-medium text-secondary-700 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                        {{ stimulus_action('crud', 'filter', 'change', {'field': 'composantePorteuse'}) }}
                        {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                    <option value="">Toutes les composantes</option>
                    {% for composante in composantes %}
                        <option value="{{ composante.id }}"
                                {% if params['composantePorteuse'] is defined and params['composantePorteuse'] == composante.id %}selected{% endif %}>{{ composante.libelle }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="filter-type_formation"
                       class="mb-1 block text-xs font-semibold text-secondary-600 dark:text-secondary-300">Type de diplôme</label>
                <select id="filter-type_formation"
                        class="w-full rounded-lg border border-secondary-300 bg-white px-2.5 py-2 text-xs font-medium text-secondary-700 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                        {{ stimulus_action('crud', 'filter', 'change', {'field': 'typeDiplome'}) }}
                        {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                    <option value="">Tous les types</option>
                    {% for type in typeDiplomes %}
                        <option value="{{ type.id }}"
                                {% if params['typeDiplome'] is defined and params['typeDiplome'] == type.id %}selected{% endif %}>{{ type.libelle }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="filter-responsable"
                       class="mb-1 block text-xs font-semibold text-secondary-600 dark:text-secondary-300">Responsable</label>
                <select id="filter-responsable"
                        class="w-full rounded-lg border border-secondary-300 bg-white px-2.5 py-2 text-xs font-medium text-secondary-700 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                        {{ stimulus_action('crud', 'filter', 'change', {'field': 'responsable'}) }}
                        {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                    <option value="">Tous les responsables</option>
                    {% for responsable in responsables %}
                        <option value="{{ responsable.id }}"
                                {% if params['responsable'] is defined and params['responsable'] == responsable.id %}selected{% endif %}>{{ responsable.display }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if not isCfvu %}
                <div>
                    <label for="filter-remplissage"
                           class="mb-1 block text-xs font-semibold text-secondary-600 dark:text-secondary-300">Remplissage</label>
                    <select id="filter-remplissage"
                            class="w-full rounded-lg border border-secondary-300 bg-white px-2.5 py-2 text-xs font-medium text-secondary-700 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-500 dark:focus:ring-primary-900/50"
                            {{ stimulus_action('crud', 'filter', 'change', {'field': 'remplissage'}) }}>
                        <option value="all">Tous</option>
                        <option value="0"
                                {% if params['remplissage'] is defined and params['remplissage'] == 0 %}selected{% endif %}>
                            Non complété
                        </option>
                        <option value="100"
                                {% if params['remplissage'] is defined and params['remplissage'] == 100 %}selected{% endif %}>
                            Complet
                        </option>
                    </select>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <div class="overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-secondary-700 dark:text-secondary-200">
                <thead class="bg-secondary-50 text-left text-xs font-black uppercase tracking-wider text-secondary-500 dark:bg-secondary-800/70 dark:text-secondary-300">
                <tr>
                    <th class="px-4 py-3">
                        <a href="#" class="inline-flex items-center gap-1 hover:text-secondary-900 dark:hover:text-white"
                                {{ stimulus_action('crud', 'sort', 'click', {
                                    'sort': 'composantePorteuse',
                                    'direction': getDirection('composantePorteuse', sort, direction)
                                }) }}
                        >
                            Composante {{ displaySort('composantePorteuse', sort, direction) }}
                        </a>
                    </th>
                    <th class="px-4 py-3">
                        <a href="#" class="inline-flex items-center gap-1 hover:text-secondary-900 dark:hover:text-white"
                                {{ stimulus_action('crud', 'sort', 'click', {
                                    'sort': 'typeDiplome',
                                    'direction': getDirection('typeDiplome', sort, direction)
                                }) }}
                        >
                            Type de formation {{ displaySort('typeDiplome', sort, direction) }}
                        </a>
                    </th>
                    <th class="px-4 py-3">
                        <a href="#" class="inline-flex items-center gap-1 hover:text-secondary-900 dark:hover:text-white"
                                {{ stimulus_action('crud', 'sort', 'click', {
                                    'sort': 'mention',
                                    'direction': getDirection('mention', sort, direction)
                                }) }}
                        >
                            Mention / spécialité {{ displaySort('mention', sort, direction) }}
                        </a>
                    </th>
                    <th class="px-4 py-3 text-center">En cours<br>rédaction</th>
                    <th class="px-4 py-3 text-center">État de remplissage<br><span class="normal-case tracking-normal">(complètes / total)</span>
                    </th>
                    <th class="px-4 py-3 text-center">En attente<br>validation RP / RF / DPE</th>
                    <th class="px-4 py-3 text-center">En attente<br>validation SES</th>
                    <th class="px-4 py-3 text-center">Fiches validées</th>
                    <th class="px-4 py-3 text-center">Publiées</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
                {% for formation in formations %}
                    {% if (params['remplissage'] is defined and formation.remplissage.calcul == params['remplissage']) or params['remplissage'] is not defined %}
                        <tr class="align-top hover:bg-secondary-50/70 dark:hover:bg-secondary-800/40">
                            <td class="px-4 py-3">
                                {% if formation.composantePorteuse != null %}
                                    {{ formation.composantePorteuse.libelle }}
                                {% else %}
                                    <twig:Badge label="Non définie" variant="danger" size="sm" />
                                {% endif %}
                            </td>
                            <td class="px-4 py-3">
                                <twig:Badge :label="formation.typeDiplome|typeDiplome" variant="info" size="sm" />
                            </td>
                            <td class="px-4 py-3">
                                {% if formation.mention != null or formation.mentionTexte != null %}
                                    {{ formation.display }}
                                {% else %}
                                    <twig:Badge label="Non définie" variant="danger" size="sm" />
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbEnCoursRedaction" variant="secondary" size="sm" extraClass="min-w-10 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbFichesCompletes ~ ' / ' ~ stats[formation.id].stats.nbFiches" variant="info" size="sm" extraClass="min-w-16 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbFichesNonValidees" variant="warning" size="sm" extraClass="min-w-10 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbFichesNonValideesSes" variant="warning" size="sm" extraClass="min-w-10 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbFichesValidees" variant="success" size="sm" extraClass="min-w-10 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Badge :label="stats[formation.id].stats.nbFichesPubliees" variant="primary" size="sm" extraClass="min-w-10 justify-center" />
                            </td>
                            <td class="px-4 py-3 text-right">
                                <twig:Button
                                        href="{{ path('fiche_matiere_valide_formation', {formation: formation.id}) }}"
                                        variant="success"
                                        size="sm"
                                        icon="icon:check"
                                        label="Voir les fiches"
                                        tooltip="Voir les fiches"
                                        target="_top"
                                />
                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="10" class="px-4 py-16 text-center">
                            {{ include('_ui/_empty_table.html.twig', {
                                message: 'Aucune donnée à afficher'
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
