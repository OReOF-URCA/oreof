{% extends 'base.html.twig' %}

{% set header_title %}
    Modifier la formation
{% endset %}

{% block bouton_header %}
    <twig:Button
            href="{{ path('formation_v2_modifier', {slug: formation.slug}) }}"
            variant="secondary"
            :outline="true"
            :soft="false"
            icon="icon:arrow-left"
            label="Retour"
            tooltip="Retour à la formation"
    />
{% endblock %}

{% block content %}
    <div class="space-y-6 w-full">
        <div class="rounded-2xl border border-secondary-200 bg-surface p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
            {{ include('formation/_new_form.html.twig', {
                is_modal: false,
                formation: formation,
                form: form,
                cancel_url: path('formation_v2_modifier', {slug: formation.slug}),
                submit_label: 'Enregistrer les modifications'
            }) }}
        </div>
    </div>
{% endblock %}
