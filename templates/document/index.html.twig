{% extends 'base.html.twig' %}

{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('app_document_upload') }}" enctype="multipart/form-data"
              {{ stimulus_controller('document-upload') }}>
            <input type="hidden" name="_token" value="{{ csrf_token('document_upload') }}">
            <input type="file" name="document" class="sr-only" tabindex="-1" aria-hidden="true"
                   accept="{{ upload_extensions }}"
                   data-document-upload-target="input" data-action="change->document-upload#submit">
            <twig:Button type="button" variant="primary" :soft="false" icon="icon:upload" label="Téléverser un document"
                         dataAction="click->document-upload#pick" />
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="space-y-10">
        {% for section in sections %}
            <section>
                <h2 class="text-lg font-semibold text-secondary-900 dark:text-secondary-100">{{ section.title }}</h2>
                {% if section.description is defined and section.description %}
                    <p class="mt-1 text-sm text-secondary-500 dark:text-secondary-400">{{ section.description }}</p>
                {% endif %}

                <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for item in section.items %}
                        <twig:DownloadCard
                            title="{{ item.label }}"
                            description="{{ item.file }}"
                            meta="{{ item.meta }}"
                            href="{{ asset('docs/' ~ item.file|url_encode) }}"
                            type="{{ item.type }}"
                            previewUrl="{{ asset('docs/' ~ item.file|url_encode) }}"
                        >
                            <twig:block name="actions">
                            {% if is_granted('ROLE_ADMIN') %}
                                <twig:DeleteButton
                                    id="doc-{{ item.id }}"
                                    url="{{ path('app_document_delete') }}"
                                    csrfTokenId="document_delete"
                                    size="md"
                                    :hiddenFields="{ file: item.file }"
                                    tooltip="Supprimer"
                                    title="Supprimer le document"
                                    message="Supprimer définitivement « {{ item.file }} » ? Cette action est irréversible."
                                />
                            {% endif %}
                            </twig:block>
                        </twig:DownloadCard>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <p class="text-sm text-secondary-500">Aucun document disponible.</p>
        {% endfor %}
    </div>
{% endblock %}
