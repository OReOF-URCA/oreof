{% extends 'base.html.twig' %}

{% block bouton_header %}
    <twig:Button
            href="{{ path('app_formation_responsable_liste_export') }}"
            variant="outline-info"
            size="sm"
            icon="icon:download"
            label="Exporter les demandes en PDF"
            tooltip="Exporter la liste des demandes de changement en PDF"
            extraClass="font-semibold"
    />
    <twig:Button
            href="{{ path('app_conseils_documents_download', { process: 'change_rf' }) }}"
            variant="info"
            size="sm"
            icon="icon:download"
            label="Télécharger les documents (ZIP)"
            tooltip="Télécharger tous les PV et justificatifs pour les changements de RF"
            extraClass="font-semibold"
    />
{% endblock %}

{% block content %}
    <div class="app-tabs mb-6">
        <div class="app-tabs-list" role="tablist" aria-label="Changement de responsable">
            <a id="tab-demandes"
               class="app-tab gap-2 {% if tab != 'documents' %}app-tab-active active{% endif %}"
               href="{{ path('app_formation_responsable_liste', { tab: 'demandes' }) }}"
               role="tab"
               aria-selected="{{ tab != 'documents' ? 'true' : 'false' }}"
            >
                <twig:UX:Icon name="mdi:account-switch-outline" class="size-4" />
                Liste des demandes
            </a>
            <a id="tab-documents"
               class="app-tab gap-2 {% if tab == 'documents' %}app-tab-active active{% endif %}"
               href="{{ path('app_formation_responsable_liste', { tab: 'documents' }) }}"
               role="tab"
               aria-selected="{{ tab == 'documents' ? 'true' : 'false' }}"
            >
                <twig:UX:Icon name="icon:file-text" class="size-4" />
                Documents du conseil (PV & notes)
            </a>
        </div>
    </div>

    {% if tab != 'documents' %}
        {% if table is defined and table is not null %}
            {{ component('DataTable', { config: table }) }}
        {% endif %}
    {% else %}
        <div class="space-y-4">
            <div class="rounded-xl border border-info-200 bg-info-50/50 p-4 text-sm text-info-800 dark:border-info-800 dark:bg-info-950/30 dark:text-info-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <twig:UX:Icon name="icon:info" class="size-5 shrink-0 text-info-600 dark:text-info-400" />
                    <span>Retrouvez ici les procès-verbaux et notes justificatives déposés pour les changements de responsables. Vous pouvez télécharger chaque document individuellement ou récupérer l'archive complète.</span>
                </div>
                <twig:Button
                        href="{{ path('app_conseils_documents_download', { process: 'change_rf' }) }}"
                        variant="info"
                        size="sm"
                        icon="icon:download"
                        label="Télécharger tout (ZIP)"
                        tooltip="Télécharger tous les PV et justificatifs en archive ZIP"
                        extraClass="whitespace-nowrap font-semibold"
                />
            </div>

            {{ include('_ui/_datatable_card.html.twig', { table: documentsTable }) }}
        </div>
    {% endif %}
{% endblock %}
