{#- Titre/description de page : header_title/header_description (surcharge de la page) > clés `<route>.title|description` du domaine `header` > clés `page.<route>.*` du domaine `menu` > nom de route.
    header_text_key() teste l'existence des clés sans trans() : chaque appel à trans() est collecté par le panneau des traductions. -#}
{%- set _route = app.request.attributes.get('_route') -%}

{%- if header_title|default(null) is empty -%}
    {%- set _title_key = header_text_key(_route, 'title') -%}
    {%- if _title_key -%}
        {%- set header_title = _title_key.key|trans({}, _title_key.domain) -%}
    {%- else -%}
        {%- set header_title = _route ? _route|replace({'_': ' ', 'app_': ''})|title : 'Titre par défaut' -%}
    {%- endif -%}
{%- endif -%}

{%- if header_description|default(null) is empty -%}
    {%- set _description_key = header_text_key(_route, 'description') -%}
    {%- set header_description = _description_key ? _description_key.key|trans({}, _description_key.domain) : '' -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="fr" data-footer="true" data-placement="horizontal" data-behaviour="pinned" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title> {{ header_title }} - {{ product_name }}</title>
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico', 'image_package') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
    <meta name="turbo-prefetch" content="false"/>
    <script>
      // Applique les préférences persistées (thème, accessibilité, couleur) AVANT le
      // premier rendu pour éviter tout flash. Doit rester aligné avec
      // assets/controllers/accessibility_controller.js et theme_controller.js.
      (function () {
        var root = document.documentElement

        var DEFAULTS = { theme: 'system', font: 'default', size: 'normal', contrast: false, motion: false }
        var a11y = DEFAULTS
        try {
          var raw = localStorage.getItem('oreof-a11y')
          if (raw) {
            a11y = Object.assign({}, DEFAULTS, JSON.parse(raw))
          }
        } catch (e) { /* localStorage indisponible ou JSON invalide */ }

        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
        // Priorité : choix explicite du panneau accessibilité > bascule rapide (oreof-theme) > préférence système
        var explicitTheme = (a11y.theme === 'dark' || a11y.theme === 'light') ? a11y.theme : null
        var quickTheme = localStorage.getItem('oreof-theme')
        var theme = explicitTheme
          || ((quickTheme === 'dark' || quickTheme === 'light') ? quickTheme : (prefersDark ? 'dark' : 'light'))

        root.setAttribute('data-theme', theme)
        root.setAttribute('data-a11y-font', a11y.font || 'default')
        root.setAttribute('data-a11y-size', a11y.size || 'normal')
        root.setAttribute('data-a11y-contrast', a11y.contrast ? 'high' : 'normal')
        root.setAttribute('data-a11y-motion', a11y.motion ? 'reduced' : 'normal')

        var colorTheme = localStorage.getItem('oreof-color-theme')
        if (colorTheme && colorTheme !== 'normal') {
          root.setAttribute('data-color-theme', colorTheme)
        } else {
          root.removeAttribute('data-color-theme')
        }
      })()
    </script>
    <link rel="preconnect" href="https://fonts.gstatic.com"/>
    <style>
        .markdown-body img {
            max-width: 100%;
            height: auto;
            border-radius: 4px;
        }

        @media (min-width: 992px) {
            .markdown-body img {
                max-width: 60%;
            }

            #helpOffcanvas .markdown-body img {
                max-width: 100%;
            }
        }

        .markdown-body iframe {
            border-radius: 4px;
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap"
          rel="stylesheet"/>
    {% block stylesheets %}
        {{ reprise_entry_link_tags('styles') }}
        {{ reprise_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {#            {% block importmap %}{{ importmap('app') }}{% endblock %} #}
        <script>
          window.toasts = {{ app.flashes('toast')|json_encode|raw }};
        </script>
        {{ reprise_entry_script_tags('app') }}
    {% endblock %}
</head>
