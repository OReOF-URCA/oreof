                        class="mb-8 rounded-2xl border border-slate-200 bg-white/90 p-4 shadow-sm backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900/80 sm:mb-10 sm:p-5">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                        <div class="min-w-0 lg:basis-1/2 lg:pr-6">
                            <h1 class="text-xl font-black leading-tight tracking-tight text-slate-900 sm:text-3xl lg:overflow-hidden lg:text-ellipsis lg:whitespace-nowrap dark:text-slate-100"
                                id="title">
                                {% block header %}
                                    {{ header_title|default('Titre par défaut') }}
                                {% endblock %}</h1>
                            <p class="max-w-3xl text-sm text-slate-600 dark:text-slate-300">
                                {{ header_description|default('Description par défaut') }}
                            </p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 self-start lg:basis-1/2 lg:justify-end lg:self-start [&_.btn]:inline-flex [&_.btn]:items-center [&_.btn]:gap-2 [&_.btn]:rounded-lg [&_.btn]:px-3 [&_.btn]:py-2 [&_.btn]:text-xs [&_.btn]:font-semibold">
