<!DOCTYPE html>
<html lang="fr" data-footer="true" data-placement="horizontal" data-behaviour="pinned" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title> {{ header_title|default('Titre par défaut') }} - {{ product_name }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
    <script>
      (function () {
        const savedTheme = localStorage.getItem('oreof-theme')
        let accessibility

        try {
          accessibility = JSON.parse(localStorage.getItem('oreof-a11y') || 'null')
        } catch (e) {
          accessibility = null
        }

          const preferredTheme = accessibility && accessibility.theme ? accessibility.theme : null
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          const themeFromPref = preferredTheme === 'system' ? null : preferredTheme
          const theme = (themeFromPref === 'dark' || themeFromPref === 'light')
            ? themeFromPref
          : ((savedTheme === 'dark' || savedTheme === 'light') ? savedTheme : (prefersDark ? 'dark' : 'light'))

          document.documentElement.setAttribute('data-theme', theme)
        }
      )
    </script>
    <link rel="preconnect" href="https://fonts.gstatic.com"/>
    <style>
        .markdown-body img {
            max-width: 100%;
            height: auto;
            border-radius: 4px;
        }

        @media (min-width: 992px) {
            .markdown-body img {
                max-width: 60%;
            }

            #helpOffcanvas .markdown-body img {
                max-width: 100%;
            }
        }

        .markdown-body iframe {
            border-radius: 4px;
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap"
          rel="stylesheet"/>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {% block legacy_stylesheets %}
            {#                        {{ encore_entry_link_tags('legacy') }} #}
        {% endblock %}
    {% endblock %}

    {% block javascripts %}
        {#            {% block importmap %}{{ importmap('app') }}{% endblock %} #}
        <script>
          window.toasts = {{ app.flashes('toast')|json_encode|raw }};
        </script>
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body
        class="min-h-screen"
        data-controller="modalturbo frame-loader"
>
<template id="global-loader-stimulus" hidden>
    <div class="flex justify-center py-6">
        <twig:Spinner size="md" variant="secondary" label="Chargement..."/>
    </div>
</template>
<!-- toast Tailwindcss-->
{# todo: peut être boucler sur les flashmessage à la fin ? #}
<div id="flash_toasts" class="fixed bottom-4 right-4 z-50 w-[min(24rem,calc(100vw-2rem))]"></div>
<!-- fin toast -->


<!-- Content Container Start -->
<div id="root" class="flex min-h-screen flex-col">


    <!-- Nav Content Start -->
    {% include '_layout/_topbar.html.twig' with { formation: formation is defined ? formation : null, parcours: parcours is defined ? parcours : null } %}
    <!-- Nav Content End -->

    <!-- Main Content Start -->

    <!-- Title and Top Buttons Start -->
    <div class="page-title-container fixed-title-container">
        <div class="mx-auto w-full space-y-4 px-4 sm:px-6 lg:px-8">
            <div>
                {% include 'components/impersonation_badge.html.twig' %}
            </div>

            {{ include('_layout/_campaign_banner.html.twig') }}


            {% block page_header %}
                <section
                        class="mb-8 rounded-2xl border border-secondary-200 bg-white/90 p-4 shadow-sm backdrop-blur-sm dark:border-secondary-700 dark:bg-secondary-900/80 sm:mb-10 sm:p-5">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                        <div class="min-w-0 lg:basis-1/2 lg:pr-6">
                            <h1 class="text-xl font-black leading-tight tracking-tight text-secondary-900 sm:text-3xl lg:overflow-hidden lg:text-ellipsis lg:whitespace-nowrap dark:text-secondary-100"
                                id="title">
                                {% block header %}
                                    {{ header_title|default('Titre par défaut') }}
                                {% endblock %}</h1>
                            <p class="max-w-3xl text-sm text-secondary-600 dark:text-secondary-300">
                                {{ header_description|default('Description par défaut') }}
                            </p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 self-start lg:basis-1/2 lg:justify-end lg:self-start [&_.btn]:inline-flex [&_.btn]:items-center [&_.btn]:gap-2 [&_.btn]:rounded-lg [&_.btn]:px-3 [&_.btn]:py-2 [&_.btn]:text-xs [&_.btn]:font-semibold">
                            {% block bouton_header %}

                            {% endblock %}
                        </div>
                    </div>

                    <div class="mt-4 border-t border-secondary-100 pt-3 dark:border-secondary-700/80">
                        <nav class="breadcrumb-container" aria-label="breadcrumb">
                            {% block breadcrumb %}
                            {% endblock %}
                        </nav>
                    </div>
                </section>
            {% endblock %}

        </div>
    </div>
    <main class="flex-1">
        <!-- messages flash (Tailwind) -->
        {# read and display all flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set bgClass = label == 'info' ? 'bg-indigo-600' : label == 'success' ? 'bg-green-600' : label == 'warning' ? 'bg-yellow-500' : label == 'danger' ? 'bg-red-600' : 'bg-gray-600' %}
                <div class="fixed top-4 right-4 z-50 max-w-[28rem] flex items-start space-x-3 p-3 rounded-lg shadow-lg text-white {{ bgClass }}"
                     role="status">
                    <div class="flex-1 text-sm">{{ message }}</div>
                    <button type="button" class="ml-2 text-white opacity-80 hover:opacity-100" aria-label="Close"
                            onclick="this.closest('[role=\'status\']').remove()">&times;
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- fin messages flash -->
        <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
            <!-- Title and Top Buttons End -->
            {% block content %}

            {% endblock %}
        </div>
    </main>
    <!-- Main Content End -->

    <!-- Footer Content Start -->
    {% include '_layout/_footer.html.twig' %}
    <!-- Footer Content End -->


</div>
<!-- Content Container End -->


