<!-- Content Container Start -->
<div id="root" class="flex min-h-screen flex-col">


    <!-- Nav Content Start -->
    {% include '_layout/_topbar.html.twig' with { formation: formation is defined ? formation : null, parcours: parcours is defined ? parcours : null } %}
    <!-- Nav Content End -->

    <!-- Main Content Start -->

    <!-- Title and Top Buttons Start -->
    <div class="page-title-container fixed-title-container">
        <div class="mx-auto w-full space-y-4 px-4 sm:px-6 lg:px-8">
            <div>
                {% include 'components/impersonation_badge.html.twig' %}
            </div>

            {{ include('_layout/_campaign_banner.html.twig') }}
        </div>
    </div>

    {# L'en-tête est un enfant direct de #root (et non du wrapper ci-dessus) pour pouvoir rester sticky sur toute la page. #}
    {% block page_header %}
        {% set _page_header_title %}{% block header %}{{ header_title }}{% endblock %}{% endset %}
        {% set _page_header_actions %}{% block bouton_header %}{% endblock %}{% endset %}
        <twig:PageHeader
                class="px-4 sm:px-6 lg:px-8"
                :title="_page_header_title"
                :description="header_description"
                :actions="_page_header_actions"
                :breadcrumb="header_breadcrumb|default(true)"
                :sticky="header_sticky|default(true)"
        />
    {% endblock %}
    <main class="flex-1">
        <!-- messages flash (Tailwind) -->
        {# read and display all flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set bgClass = label == 'info' ? 'bg-indigo-600' : label == 'success' ? 'bg-green-600' : label == 'warning' ? 'bg-yellow-500' : label == 'danger' ? 'bg-red-600' : 'bg-gray-600' %}
                <div class="fixed top-4 right-4 z-50 max-w-[28rem] flex items-start space-x-3 p-3 rounded-lg shadow-lg text-white {{ bgClass }}"
                     role="status">
                    <div class="flex-1 text-sm">{{ message }}</div>
                    <button type="button" class="ml-2 text-white opacity-80 hover:opacity-100" aria-label="Close"
                            onclick="this.closest('[role=\'status\']').remove()">&times;
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- fin messages flash -->
        <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
            <!-- Title and Top Buttons End -->
            {% block content %}

            {% endblock %}
        </div>
    </main>
    <!-- Main Content End -->

    <!-- Footer Content Start -->
    {% include '_layout/_footer.html.twig' %}
    <!-- Footer Content End -->


</div>
<!-- Content Container End -->


