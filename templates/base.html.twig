                            {% endblock %}
                        </div>
                    </div>

                    <div class="mt-4 border-t border-slate-100 pt-3 dark:border-slate-700/80">
                        <nav class="breadcrumb-container" aria-label="breadcrumb">
                            {% block breadcrumb %}
                            {% endblock %}
                        </nav>
                    </div>
                </section>
            {% endblock %}

        </div>
    </div>
    <main class="flex-1">
        <!-- messages flash (Tailwind) -->
        {# read and display all flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set bgClass = label == 'info' ? 'bg-indigo-600' : label == 'success' ? 'bg-green-600' : label == 'warning' ? 'bg-yellow-500' : label == 'danger' ? 'bg-red-600' : 'bg-gray-600' %}
                <div class="fixed top-4 right-4 z-50 max-w-[28rem] flex items-start space-x-3 p-3 rounded-lg shadow-lg text-white {{ bgClass }}" role="status">
                    <div class="flex-1 text-sm">{{ message }}</div>
                    <button type="button" class="ml-2 text-white opacity-80 hover:opacity-100" aria-label="Close" onclick="this.closest('[role=\'status\']').remove()">&times;</button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- fin messages flash -->
        <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
            <!-- Title and Top Buttons End -->
            {% block content %}

            {% endblock %}
        </div>
    </main>
    <!-- Main Content End -->

    <!-- Footer Content Start -->
    {% include '_layout/_footer.html.twig' %}
    <!-- Footer Content End -->


</div>
<!-- Content Container End -->


