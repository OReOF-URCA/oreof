<div
        data-navigation-palette-target="modal"
        class="hidden fixed inset-0 z-[200] mt-20"
        role="dialog"
        aria-modal="true"
        aria-label="Recherche rapide"
>
    <div
            class="absolute inset-0 z-0 bg-black/40 backdrop-blur-[2px]"
            data-action="click->navigation-palette#close"
    ></div>

    <div class="relative z-10 mx-auto mt-[10vh] w-[min(44rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-2xl dark:border-secondary-700 dark:bg-secondary-900">
        <div class="flex items-center gap-3 border-b border-secondary-200 px-4 py-3 dark:border-secondary-700">
            <twig:UX:Icon name="mdi:magnify" class="h-5 w-5 text-secondary-400"/>

            <input
                    data-navigation-palette-target="input"
                    data-action="input->navigation-palette#search"
                    type="text"
                    placeholder="Rechercher une page, une action..."
                    class="w-full border-0 bg-transparent text-sm text-secondary-900 outline-none placeholder:text-secondary-400 focus:ring-0 dark:text-secondary-100"
            >

            <kbd class="hidden rounded border border-secondary-200 bg-secondary-50 px-2 py-1 text-xs text-secondary-500 dark:border-secondary-700 dark:bg-secondary-800 sm:inline">
                Esc
            </kbd>
        </div>

        <div
                data-navigation-palette-target="results"
                class="max-h-[28rem] overflow-auto"
        >
            <div class="px-4 py-8 text-center text-sm text-secondary-500">
                Recherchez dans la navigation ORéOF.
            </div>
        </div>

        <div class="flex items-center justify-between border-t border-secondary-200 bg-secondary-50 px-4 py-2 text-xs text-secondary-500 dark:border-secondary-700 dark:bg-secondary-950">
            <div class="flex items-center gap-3">
                <span><kbd class="rounded border px-1">↑</kbd> <kbd class="rounded border px-1">↓</kbd> naviguer</span>
                <span><kbd class="rounded border px-1">Entrée</kbd> ouvrir</span>
                <span><kbd class="rounded border px-1">Esc</kbd> fermer</span>
            </div>
        </div>
    </div>
</div>


