<!-- Modal Image Fullscreen (Tailwind) -->
<div id="imageFullscreenModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/70 p-4"
     aria-hidden="true" role="dialog">
    <div class="relative max-w-[90vw] max-h-[90vh] w-full">
        <button id="imageFullscreenModalCloseBtn" class="absolute top-4 right-4 text-white text-2xl leading-none"
                aria-label="Fermer">&times;
        </button>
        <div class="flex items-center justify-center">
            <img id="fullscreenModalImage" src="" alt="Plein écran" class="max-h-[90vh] max-w-full rounded"/>
        </div>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Click on markdown images -> open fullscreen modal
    document.body.addEventListener('click', function (e) {
      if (e.target.tagName === 'IMG' && e.target.closest('.markdown-body')) {
        const src = e.target.src
        const modalImg = document.getElementById('fullscreenModalImage')
        const modal = document.getElementById('imageFullscreenModal')
        if (modalImg && modal) {
          modalImg.src = src
          modal.classList.remove('hidden')
          modal.classList.add('flex')
        }
      }
    })

    // Close modal handlers
    const modal = document.getElementById('imageFullscreenModal')
    const modalClose = document.getElementById('imageFullscreenModalCloseBtn')
    if (modal) {
      modal.addEventListener('click', (ev) => {
        if (ev.target === modal) {
          modal.classList.add('hidden')
          modal.classList.remove('flex')
          const modalImg = document.getElementById('fullscreenModalImage')
          if (modalImg) modalImg.src = ''
        }
      })
    }
    if (modalClose) {
      modalClose.addEventListener('click', () => {
        if (modal) {
          modal.classList.add('hidden')
          modal.classList.remove('flex')
          const modalImg = document.getElementById('fullscreenModalImage')
          if (modalImg) modalImg.src = ''
        }
      })
    }

    // Simple zoom-ready helper for markdown images
    const applyZoomReady = () => {
      const imgs = document.querySelectorAll('.markdown-body img:not(.zoom-ready)')
      imgs.forEach(img => {
        img.classList.add('zoom-ready')
        img.style.cursor = 'zoom-in'
        img.title = 'Cliquez pour agrandir'
      })
    }
    applyZoomReady()
    const observer = new MutationObserver(() => applyZoomReady())
    observer.observe(document.body, { childList: true, subtree: true })
  })
</script>

