<form action="{{ path('app_codification', {formation:formation.id}) }}" method="post">
    <div class="row" >
        {{ component('alerte', {
            'type': 'info',
            'message': 'Veuillez sélectionner au moins un type de diplôme et au moins un domaine'
        }) }}
        <div class="col-12">
            <div class="form-check mt-2">
                <input type="radio"
                       name="typeCodification"
                       class="form-check-input"
                       value="codifHaute"
                       id="codifHaute">
                <label for="codifHaute" class="form-check-label">
                    {{ 'codification.modal.uniquement_la_codification_haute_diplome_etape'|trans({}, 'modal') }}
                </label>
            </div>
            <div class="form-check mt-2">
                <input type="radio"
                       name="typeCodification"
                       class="form-check-input"
                       value="codifBasse"
                       id="codifBasse">
                <label for="codifBasse" class="form-check-label">
                    {{ 'codification.modal.uniquement_la_codification_basse_elp_semestre'|trans({}, 'modal') }}
                </label>
            </div>
            <div class="form-check mt-2">
                <input type="radio"
                       name="typeCodification"
                       class="form-check-input"
                       value="codifHauteBasse"
                       id="codifHauteBasse">
                <label for="codifHauteBasse" class="form-check-label">
                    {{ 'codification.modal.toute_la_codification_haute_et_basse'|trans({}, 'modal') }}
                </label>
            </div>

        </div>
    </div>
    <button type="submit" class="btn btn-success"
            {{ stimulus_action('base','sauvegardeFormModal', 'click') }}>
        <i class="fal fa-floppy-disk"></i>
        {{ 'codification.modal.generer_les_codes'|trans({}, 'modal') }}
    </button>
</form>
