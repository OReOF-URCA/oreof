<section class="space-y-4">
    <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-secondary-800">Liste des profils</h3>
        <span class="text-xs text-secondary-500">Gestion des profils affectés à l'utilisateur</span>
    </div>

    <div class="overflow-hidden rounded-xl border border-secondary-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-secondary-200">
                <thead class="bg-secondary-50">
                <tr>
                    <th scope="col"
                        class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-secondary-500">Profil
                    </th>
                    <th scope="col"
                        class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-secondary-500">Centre
                    </th>
                    <th scope="col"
                        class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-secondary-500">
                        Appliqué à
                    </th>
                    <th scope="col"
                        class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-secondary-500">Action
                    </th>
                </tr>
                </thead>
                <tbody class="divide-y divide-secondary-100">
                {% for userProfil in userProfils|filter(userProfil => ((userProfil.campagneCollecte != null and userProfil.campagneCollecte.id == user_data.campagneCollecte.id )) or userProfil.campagneCollecte == null) %}
                    <tr class="transition-colors hover:bg-secondary-50">
                        <td class="px-4 py-3 text-sm text-secondary-700">{{ userProfil.profil != null ? userProfil.profil.libelle : 'Non précisé' }}</td>
                        <td class="px-4 py-3 text-sm text-secondary-700">{{ component('Badge', { dto: userProfil|badgeTypeCentreDto }) }}</td>
                        <td class="px-4 py-3 text-sm text-secondary-700">{{ userProfil|centre }}</td>
                        <td class="px-4 py-3 text-right">
                            <button
                                    type="button"
                                    {{ stimulus_action('profil--user', 'delete', 'click', {
                                        url:path('app_user_profils_delete',{'userProfil': userProfil.id}),
                                        csrf: csrf_token('delete' ~ userProfil.id)
                                    }) }}
                                    class="inline-flex items-center gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-1.5 text-sm font-medium text-red-700 transition hover:border-red-300 hover:bg-red-100"
                            >
                                <i class="{{ iconDelete }}"></i>
                                Supprimer
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">
                            {{ include('_ui/_empty_table.html.twig', {message: 'Aucun profil associé.'}) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
