{% embed 'user_profils/_config_profil_select.html.twig' with {
    profil: profil,
    selectLabel: 'Choisir le parcours pour ce profil',
    placeholder: 'Selectionner un parcours'
} %}
    {% block options %}
        {% for item in parcours %}
            <option value="{{ item.id }}">{{ item.display }} - ({{ item.formation.displayLong(true) }})</option>
        {% endfor %}
    {% endblock %}
{% endembed %}
