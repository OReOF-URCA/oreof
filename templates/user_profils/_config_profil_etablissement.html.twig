{% embed 'user_profils/_config_profil_select.html.twig' with {
    profil: profil,
    selectLabel: "Choisir l'etablissement pour ce profil",
    placeholder: 'Selectionner un etablissement'
} %}
    {% block options %}
        {% for etab in etablissements %}
            <option value="{{ etab.id }}">{{ etab.libelle }}</option>
        {% endfor %}
    {% endblock %}
{% endembed %}
