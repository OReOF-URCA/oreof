{% embed 'user_profils/_config_profil_select.html.twig' with {
    profil: profil,
    selectLabel: 'Choisir la formation pour ce profil',
    placeholder: 'Selectionner une formation'
} %}
    {% block options %}
        {% for formation in formations %}
            <option value="{{ formation.id }}">{{ formation.displayLong(true) }}</option>
        {% endfor %}
    {% endblock %}
{% endembed %}
