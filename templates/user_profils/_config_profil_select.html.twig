<div class="space-y-3">
    <div class="flex items-center justify-between">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-secondary-500">Configuration du profil</h4>
        <span class="rounded-md bg-secondary-100 px-2 py-1 text-xs font-medium text-secondary-600">{{ profil.code }}</span>
    </div>

    <p class="text-sm text-secondary-700">Profil selectionné : <span
                class="font-medium text-secondary-900">{{ profil.libelle }}</span></p>

    <div class="space-y-2">
        <label class="block text-xs font-semibold uppercase tracking-wide text-secondary-500"
               for="selectListe">{{ selectLabel }}</label>
        <select id="selectListe"
                class="w-full rounded-md border border-secondary-200 bg-white px-3 py-2 text-sm text-secondary-700 shadow-sm outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100"
                required
                {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}
        >
            <option value="">{{ placeholder }}</option>
            {% block options %}{% endblock %}
        </select>
    </div>
</div>

