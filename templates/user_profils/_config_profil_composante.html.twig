{% embed 'user_profils/_config_profil_select.html.twig' with {
    profil: profil,
    selectLabel: 'Choisir la composante pour ce profil',
    placeholder: 'Selectionner une composante'
} %}
    {% block options %}
        {% for compo in composantes %}
            <option value="{{ compo.id }}">{{ compo.libelle }}</option>
        {% endfor %}
    {% endblock %}
{% endembed %}
