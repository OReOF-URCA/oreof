<div {{ stimulus_controller('profil--user', {
    urlConfigProfil: path('app_user_profils_config', {user:user.id}),
    urlListe: path('app_user_profils_liste', {user:user.id}),
    urlAdd: path('app_user_profils_add_valide', {user:user.id}),
}) }} class="space-y-6">
    {% if (hide is defined and hide != true) or hide is not defined %}
    <section class="rounded-xl border border-secondary-200 bg-secondary-50 px-4 py-3 shadow-sm">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-secondary-500">{{ 'user_profils.gestion_profils.utilisateur'|trans({}, 'modal') }}</h3>
        <p class="mt-2 text-sm text-secondary-700"><span class="font-medium text-secondary-900">{{ 'user_profils.gestion_profils.nom'|trans({}, 'modal') }}</span> {{ user.nom }}</p>
        <p class="text-sm text-secondary-700"><span class="font-medium text-secondary-900">{{ 'user_profils.gestion_profils.prenom'|trans({}, 'modal') }}</span> {{ user.prenom }}</p>
    </section>
    {% endif %}

    <div class="rounded-xl border border-secondary-200 bg-white p-2 shadow-sm">
        <div {{ stimulus_target('profil--user', 'liste') }}></div>
    </div>

    <section class="rounded-xl border border-secondary-200 bg-white p-4 shadow-sm md:p-5">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-secondary-800">{{ 'user_profils.gestion_profils.ajouter_un_profil'|trans({}, 'modal') }}</h3>
            <span class="text-xs text-secondary-500">{{ 'user_profils.gestion_profils.associer_un_profil_a_un_centre'|trans({}, 'modal') }}</span>
        </div>

        <div class="space-y-2">
            <label class="block text-xs font-semibold uppercase tracking-wide text-secondary-500" for="typeCentre">{{ 'user_profils.gestion_profils.choisir_le_profil'|trans({}, 'modal') }}</label>
            <select id="typeCentre"
                    class="w-full rounded-md border border-secondary-200 bg-white px-3 py-2 text-sm text-secondary-700 shadow-sm outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100"
                    {{ stimulus_action('profil--user', 'changeProfil') }}
                    required
                    {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}
            >
                <option value="">{{ 'user_profils.gestion_profils.choisir_un_centre'|trans({}, 'modal') }}</option>
                {% for profil in profils %}
                    <option value="{{ profil.id }}">{{ profil.libelle }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="mt-4 rounded-lg border border-dashed border-secondary-200 bg-secondary-50 p-3"
                {{ stimulus_target('profil--user', 'configProfil') }}
        ></div>

        <div class="mt-4 flex justify-end">
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 transition hover:border-emerald-300 hover:bg-emerald-100"
                    {{ stimulus_action('profil--user', 'addProfil') }}>
                {{ 'user_profils.gestion_profils.ajouter_le_centre'|trans({}, 'modal') }}
            </button>
        </div>
    </section>
</div>
