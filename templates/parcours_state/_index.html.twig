{% set sectionTitleClass = 'border-y border-secondary-200 bg-secondary-100/90 px-4 py-3.5 text-left text-sm font-extrabold tracking-wide text-secondary-700 dark:border-secondary-700 dark:bg-secondary-800/80 dark:text-secondary-100' %}
{% set dataRowClass = 'border-b border-secondary-200 dark:border-secondary-700' %}
{% set labelCellClass = 'px-4 py-4 align-top font-medium leading-relaxed text-secondary-700 dark:text-secondary-200' %}
{% set valueCellClass = 'px-4 py-4 align-top leading-relaxed text-secondary-700 dark:text-secondary-200' %}
{% set subLabelCellClass = 'px-4 py-3.5 pl-8 align-top leading-relaxed text-secondary-600 dark:text-secondary-300' %}
{% set deepSubLabelCellClass = 'px-4 py-3.5 pl-12 align-top leading-relaxed text-secondary-600 dark:text-secondary-300' %}
{% set choiceBadgeClass = 'ml-2 inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-200' %}

<div class="overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
    <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-secondary-700 dark:text-secondary-200">
            <tbody>
            <tr>
                <th colspan="2" class="{{ sectionTitleClass }}">Présentation du parcours</th>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Responsable du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.respParcours|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Objectifs du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.objectifsParcours|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Résultats attendus du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.resultatsAttendus|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Contenu du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.contenuParcours|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Mots clés du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.motsCles|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Rythme de formation du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.rythmeParcours|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">Localisation du parcours</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.localisation|badgeValideDto }) }}</td>
            </tr>

            {{ include('parcours_state/_commun.html.twig') }}
            </tbody>
        </table>
    </div>
</div>
