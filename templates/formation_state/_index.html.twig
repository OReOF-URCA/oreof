{% set sectionTitleClass = 'border-y border-secondary-200 bg-secondary-100/90 px-4 py-3.5 text-left text-sm font-extrabold tracking-wide text-secondary-700 dark:border-secondary-700 dark:bg-secondary-800/80 dark:text-secondary-100' %}
{% set dataRowClass = 'border-b border-secondary-200 dark:border-secondary-700' %}
{% set labelCellClass = 'px-4 py-4 align-top font-medium leading-relaxed text-secondary-700 dark:text-secondary-200' %}
{% set valueCellClass = 'px-4 py-4 align-top leading-relaxed text-secondary-700 dark:text-secondary-200' %}

<div class="overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
    <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-secondary-700 dark:text-secondary-200">
            <tbody>
            <tr>
                <th colspan="2" class="{{ sectionTitleClass }}">{{ 'formation_state.index.localisation_de_la_formation'|trans({}, 'modal') }}</th>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step1.labels.responsableMention'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.respFormation|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step1.labels.localisationMention.label'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.localisations|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step1.labels.composantesInscription.label'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.composantesInscriptions|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step1.labels.regimeInscription.label'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.regimeInscription|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step1.labels.modalitesAlternance'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.modaliteAlternance|badgeValideDto }) }}</td>
            </tr>

            <tr>
                <th colspan="2" class="{{ sectionTitleClass }}">{{ 'formation_state.index.structure_et_organisation_de_la_formation'|trans({}, 'modal') }}</th>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'formation_step3.labels.hasParcours'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.hasParcours|badgeValideDto }) }}</td>
            </tr>
            <tr class="{{ dataRowClass }}">
                <td class="{{ labelCellClass }}">{{ 'form.labels.objectifsFormation'|trans({}, 'form') }}</td>
                <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.objectifsFormation|badgeValideDto }) }}</td>
            </tr>

            {% if formation.isHasparcours == true %}
                <tr class="{{ dataRowClass }}">
                    <td class="{{ labelCellClass }}">{{ 'formation_state.index.parcours_present'|trans({}, 'modal') }}</td>
                    <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.erreurHasParcours|badgeValideDto }) }}</td>
                </tr>
            {% else %}
                <tr class="{{ dataRowClass }}">
                    <td class="{{ labelCellClass }}">{{ 'formation_state.index.parcours_unique_present'|trans({}, 'modal') }}</td>
                    <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.erreurHasParcours|badgeValideDto }) }}</td>
                </tr>
                <tr class="{{ dataRowClass }}">
                    <td class="{{ labelCellClass }}">{{ 'formation_state.index.etat_du_parcours_unique_de_la'|trans({}, 'modal') }}</td>
                    <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.valideParcours|badgeValideDto }) }}</td>
                </tr>

                {% if valide.etat.etatParcoursDefaut is defined %}
                    <tr>
                        <th colspan="2" class="{{ sectionTitleClass }}">{{ 'formation_state.index.presentation_de_la_formation'|trans({}, 'modal') }}</th>
                    </tr>
                    <tr class="{{ dataRowClass }}">
                        <td class="{{ labelCellClass }}">{{ 'formation_state.index.objectifs_de_la_formation'|trans({}, 'modal') }}</td>
                        <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.objectifsFormation|badgeValideDto }) }}</td>
                    </tr>
                    <tr class="{{ dataRowClass }}">
                        <td class="{{ labelCellClass }}">{{ 'formation_state.index.resultats_attendus_de_la_formation'|trans({}, 'modal') }}</td>
                        <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.resultatsAttendus|badgeValideDto }) }}</td>
                    </tr>
                    <tr class="{{ dataRowClass }}">
                        <td class="{{ labelCellClass }}">{{ 'formation_state.index.contenu_de_la_formation'|trans({}, 'modal') }}</td>
                        <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.contenuFormation|badgeValideDto }) }}</td>
                    </tr>
                    <tr class="{{ dataRowClass }}">
                        <td class="{{ labelCellClass }}">{{ 'formation_state.index.rythme_de_la_formation'|trans({}, 'modal') }}</td>
                        <td class="{{ valueCellClass }}">{{ component('Badge', { dto: valide.etat.rythmeFormation|badgeValideDto }) }}</td>
                    </tr>

                    {{ include('parcours_state/_commun.html.twig', {valide: valide.etat.etatParcoursDefaut, parcours: formation.parcours[0], typeDiplome: formation.typeDiplome}) }}
                {% endif %}
            {% endif %}
            </tbody>
        </table>
    </div>
</div>

