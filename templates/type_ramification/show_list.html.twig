{% extends 'base.html.twig' %}

{% set header_title = 'Liste des ramifications des parcours' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .min-size-card-ramif {
            min-height: 17.5rem;
            max-height: 17.5rem;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .hover-link-card:hover {
            color: var(--primary);
        }

        a.hover-link-card {
            color: var(--body);
        }

        .search-button:hover {
            cursor: pointer;
        }
    </style>
{% endblock %}

{% set cardPerRows = 3 %}

{% block content %}
<div class="main-div"
    {{ stimulus_controller('ramification-search') }}
    data-ramification-search-div-class-value="col-card-ramif"
    data-ramification-search-text-class-value="card-title"
>
    <div class="row">
        <!-- spacer -->
        <div class="col-4 col-md-3 col-lg-2 col-xl-1"></div>
        <div class="col-4">
            <a href="{{ path('app_config_type_ramification_show') }}">
                <button
                    class="btn btn-sm btn-icon btn-icon-only btn-primary"
                    type="button"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    data-bs-original-title="Précédent"
                >
                    <i class="fa-light fa-arrow-left"></i>
                </button>
            </a>
        </div>
    </div>
    <div class="row justify-content-center mb-3 {{ parcoursRamifications|length > 0 ? '' : 'd-none' }}">
        <div class="col-12 col-md-10 col-lg-5 col-xxl-4">
            <div class="input-group">
                <span class="input-group-text bg-info text-white">
                    Nom du parcours
                </span>
                <input type="text" class="form-control" placeholder="Entrez votre recherche..."
                    {{ stimulus_target('ramification-search', 'searchInput') }}
                    {{ stimulus_action('ramification-search', '_onSearchCardInput', 'change') }}
                >
                <span class="input-group-text bg-info search-button"
                    {{ stimulus_action('ramification-search', '_onSearchCardInput', 'click') }}
                >
                    <i class="fa-duotone fa-solid fa-magnifying-glass fa-xl"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-12 col-md-11 col-lg-10 col-xl-9">
            {% if parcoursRamifications|length == 0 %}
                <div class="row justify-content-center">
                    <div class="fs-6 alert alert-info col-6 text-center">
                        Aucunes ramifications de parcours enregistrées...
                    </div>
                </div>
            {% else %}
                {% set ramifRows = ((parcoursRamifications|length // cardPerRows) + (parcoursRamifications|length % cardPerRows)) %}
                {% for row in 1..ramifRows %}
                        <div class="row justify-content-center w-100 my-4">
                            {% for a in 1..cardPerRows %}
                                {% set cardIndex = ((row - 1) * cardPerRows) + (a - 1) %}
                                {% if parcoursRamifications[cardIndex] is defined %}
                                    <div class="col-4 col-card-ramif">
                                        <div class="card min-size-card-ramif">
                                            <div class="card-body">
                                                <a 
                                                    href="{{ path('app_parcours_show', 
                                                        {id: parcoursRamifications[cardIndex][0].parcours_cible_id }) 
                                                    }}"
                                                >
                                                    <h5 class="card-title hover-link-card">
                                                        {{ parcoursRamifications[cardIndex][0].parcours_cible_libelle_complet }}
                                                    </h5>
                                                </a>
                                                <span class="text-center badge rounded-pill text-bg-info card-substitle mt-1 mb-3">
                                                    {{ parcoursRamifications[cardIndex][0].code_type_ramif }}
                                                </span>
                                                <ul class="no-padding-list">
                                                {% for links in parcoursRamifications[cardIndex] %}
                                                    <li>
                                                        <a 
                                                            class="hover-link-card"
                                                            href="{{ path('app_parcours_show', {id: links.parcours_origine_id}) }}"
                                                        >
                                                            {{ links.parcours_origine_libelle_complet }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}