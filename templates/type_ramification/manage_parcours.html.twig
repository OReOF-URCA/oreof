{% extends 'base.html.twig' %}

{% set header_title %}
    Configuration des ramifications des parcours
{% endset %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .search-result-list {
            height: 17.5em;
            overflow-y: scroll;
            scrollbar-width: thin;
            scrollbar-color: var(--primary);
            background-color: lightgrey;
            border-radius: .95em;
            border: 1.5px solid var(--primary);
        }

        .search-result-node:hover {
            background-color: var(--primary);
        }

        .search-result-node {
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="row justify-content-center"
        {{ stimulus_controller('ramification-parcours-manage') }}
        data-ramification-parcours-manage-search-url-value="{{ path('app_config_type_ramification_search_parcours_by_name') }}"
    >
        <div class="col-12 col-md-11 col-lg-9">
            <div class="col-12 text-start">
                <a href="{{ path('app_config_type_ramification_show') }}">
                    <button
                        class="btn btn-sm btn-icon btn-icon-only btn-primary"
                        type="button"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        data-bs-original-title="Précédent"
                    >
                        <i class="fa-light fa-arrow-left"></i>
                    </button>
                </a>
            </div>
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8 col-xl-7">
                    <div class="input-group">
                        <span class="input-group-text">Nom du parcours</span>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="Entrez votre recherche..."
                            value=""
                            {{ stimulus_target('ramification-parcours-manage', 'searchInput') }}
                            {{ stimulus_action('ramification-parcours-manage', 'onSearchInputChange', 'change') }}
                        >
                    </div>
                </div>
                <div class="row justify-content-center mt-4">
                    <div class="col-12 col-md-10 col-lg-8 col-xl-7 search-result-list"
                        {{ stimulus_target('ramification-parcours-manage', 'resultList') }}
                    >

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}