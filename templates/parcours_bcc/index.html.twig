{% extends 'base.html.twig' %}

{% block content %}
    {{ include('parcours_bcc/_tableauCroise.html.twig') }}
{% endblock %}

{% set header_title %}
    BCC pour le parcours {{ parcours.libelle }} {# todo: ou formation? #}
{% endset %}

{% block bouton_header %}
    <a href="{{ path('app_competence_export_bcc', {parcours:parcours.id}) }}"
       class="btn btn-sm btn-outline-info btn-icon btn-icon-end w-100 w-sm-auto mx-2"
       data-bs-toggle="tooltip"
       data-bs-placement="bottom"
       title=" Export des BCC"
    >
        <i class="{{ iconDownload }}"></i>
        <span> Export des BCC</span>
    </a>
    <a href="{{ path('app_competence_export_croise', {parcours:parcours.id}) }}"
       class="btn btn-sm btn-outline-info btn-icon btn-icon-end w-100 w-sm-auto mx-2"
       data-bs-toggle="tooltip"
       data-bs-placement="bottom"
       title="Export du tableau croisé BCC/EC"
    >
        <i class="{{ iconDownload }}"></i>
        <span> Export du tableau croisé BCC/EC (PDF)</span>
    </a>
    <a href="{{ path('app_competence_export_croise_global', {parcours:parcours.id}) }}"
       class="btn btn-sm btn-outline-info btn-icon btn-icon-end w-100 w-sm-auto mx-2"
       data-bs-toggle="tooltip"
       data-bs-placement="bottom"
       title="Export du tableau croisé BCC/EC"
    >
        <i class="{{ iconDownload }}"></i>
        <span> Export du tableau croisé BCC/EC (Xlsx)</span>
    </a>
    <a href="{{ path('parcours_v2_modifier', {parcours:parcours.id}) }}"
       class="btn btn-sm btn-outline-success btn-icon btn-icon-end w-100 w-sm-auto mx-2"
       data-bs-toggle="tooltip"
       data-bs-placement="bottom"
       title="Retour au parcours"
    >
        <i class="{{ iconBack }}"></i>
        <span> Retour au parcours</span>{# todo: ou formation? #}
    </a>
{% endblock %}
