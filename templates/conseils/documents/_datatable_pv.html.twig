{% set complements = item.complements ?? {} %}
{% set fichier = complements.fichier|default(item.documentPv is defined and item.documentPv ? item.documentPv.filename : null) %}
{% set fichierOriginal = complements.fichier_original|default(item.documentPv is defined and item.documentPv ? item.documentPv.originalFilename : fichier) %}

{% if fichier %}
    <div class="flex items-center gap-2">
        <twig:Badge label="Oui" variant="success" size="sm"/>
        <twig:Button
                href="{{ path('app_upload_download', {
                    context: 'conseils',
                    filename: fichier,
                    originalName: fichierOriginal
                }) }}"
                variant="info"
                size="sm"
                icon="icon:download"
                label="Télécharger"
                target="_blank"
                rel="noopener noreferrer"
        />
    </div>
{% else %}
    <twig:Badge label="Non" variant="danger" size="sm"/>
{% endif %}
