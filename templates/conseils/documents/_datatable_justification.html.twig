{% set entity = row|default(item|default(null)) %}
{% set complements = entity ? (entity.complements ?? {}) : {} %}
{% set fichier = complements.fichier_note|default(entity and entity.documentNote is defined and entity.documentNote ? entity.documentNote.filename : null) %}
{% set fichierOriginal = complements.fichier_note_original|default(entity and entity.documentNote is defined and entity.documentNote ? entity.documentNote.originalFilename : fichier) %}

{% if fichier %}
    <div class="flex items-center gap-2">
        <twig:Badge label="Oui" variant="success" size="sm"/>
        <twig:Button
                href="{{ path('app_upload_download', {
                    context: 'conseils',
                    filename: fichier,
                    originalName: fichierOriginal
                }) }}"
                variant="warning"
                size="sm"
                icon="icon:download"
                label="Télécharger"
                target="_blank"
                rel="noopener noreferrer"
        />
    </div>
{% else %}
    <twig:Badge label="Non" variant="danger" size="sm"/>
{% endif %}

