{% extends 'base.html.twig' %}



{% block bouton_header %}
    <twig:Button
            href="{{ path('app_conseils_documents_download', {
                composante: selectedComposanteId,
                formation: selectedFormationId,
                parcours: selectedParcoursId,
                hasPv: selectedHasPv,
                hasJustification: selectedHasJustification
            }) }}"
            variant="info"
            icon="icon:download"
            label="Télécharger les documents filtrés (ZIP)"
            tooltip="Télécharger tous les PV et justificatifs correspondant aux filtres"
    />
{% endblock %}

{% block content %}
    {{ component('DataTable', { config: table }) }}
{% endblock %}


