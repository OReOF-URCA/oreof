{% extends 'base.html.twig' %}

{% block content %}
    <section class="space-y-6" {{ stimulus_controller('translation--recherche', {
        url: path('translations_search')
    }) }} xmlns:twif="http://www.w3.org/1999/html">
        <div class="rounded-xl border border-secondary-200 bg-white p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
            <div class="mb-4">
                <h2 class="text-base font-semibold text-secondary-900 dark:text-secondary-100">Recherche rapide</h2>
                <p class="mt-1 text-sm text-secondary-500 dark:text-secondary-400">Saisissez au moins 3 caractères pour lancer
                    la recherche.</p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                <div class="flex-1">
                    <label for="search" class="mb-1 block text-sm font-medium text-secondary-700 dark:text-secondary-300">Clé ou
                        texte à rechercher</label>
                    <input
                            type="text"
                            id="search"
                            name="search"
                            data-translation--recherche-target="search"
                            data-action="keydown.enter->translation--recherche#recherche"
                            class="block w-full rounded-lg border border-secondary-300 bg-white px-3 py-2 text-sm text-secondary-800 placeholder:text-secondary-400 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-primary-400 dark:focus:ring-primary-900"
                            placeholder="Ex: menu.admin, campagne, publier..."
                    />
                </div>
                <button
                        type="button"
                        class="inline-flex items-center justify-center rounded-lg border border-primary-300 bg-primary-50 px-4 py-2 text-sm font-semibold text-primary-700 transition hover:bg-primary-100 dark:bg-primary-900 dark:text-primary-300 dark:border-primary-500 dark:hover:border-primary-300 dark:hover:text-primary-100"
                        {{ stimulus_action('translation--recherche', 'recherche') }}
                >
                    Rechercher
                </button>
            </div>

            <div class="mt-5" {{ stimulus_target('translation--recherche', 'resultats') }}></div>
        </div>

        <div class="rounded-xl border border-secondary-200 bg-white p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-base font-semibold text-secondary-900 dark:text-secondary-100">Fichiers de traduction</h2>
                <span class="rounded-full bg-secondary-100 px-2.5 py-1 text-xs font-semibold text-secondary-600 dark:bg-secondary-800 dark:text-secondary-300">{{ files|length }}</span>
            </div>

            <ul class="space-y-2">
                {% for file in files %}
                    <li>
                        <a
                                href="{{ path('translations_edit', {filename: file|basename}) }}"
                                class="block rounded-lg border border-secondary-200 px-3 py-2 text-sm font-medium text-secondary-700 transition hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700 dark:border-secondary-500 dark:text-secondary-200 dark:hover:border-primary-500 dark:hover:bg-secondary-800 dark:bg-primary-900 dark:text-primary-300 dark:hover:text-primary-100"
                        >
                            {{ file|basename }}
                        </a>
                    </li>
                {% else %}
                    <li class="rounded-lg border border-dashed border-secondary-300 bg-secondary-50 px-3 py-4 text-sm text-secondary-500 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-400">
                        Aucun fichier trouvé dans `/translations`.
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock %}

{% block bouton_header %}
    <div class="flex flex-wrap justify-end gap-2">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_export_translations_xlsx') }}"
               class="inline-flex items-center gap-2 rounded-lg border border-info-300 bg-info-50 px-3 py-2 text-sm font-semibold text-info-700 transition hover:bg-info-100 dark:bg-info-900 dark:text-info-300 dark:border-info-500 dark:hover:border-info-300 dark:hover:text-info-100"
                    {{ stimulus_controller('tooltip', {
                        placement: 'bottom',
                        customClass: 'app-tooltip',
                        title: 'Exporter traductions'
                    }) }}
            >
                <twig:UX:Icon name="icon:download" class="h-4 w-4"/>
                <span> Exporter traductions</span>
            </a>
        {% endif %}
    </div>
{% endblock %}

