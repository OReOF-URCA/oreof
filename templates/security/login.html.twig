{% extends 'base-speciale.html.twig' %}

{% block title %}Connexion | {{ product_name }}{% endblock %}

{% block content %}
    <div class="space-y-6" {{ stimulus_controller('login') }}>
        <div class="space-y-2">
            <p class="inline-flex items-center rounded-full bg-primary-100 dark:bg-primary-800 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-400">
                Connexion</p>
            <h2 class="text-3xl font-black leading-tight text-text">Bienvenue, connectez-vous</h2>
            <p class="text-sm text-secondary">Choisissez la méthode la plus rapide pour accéder a la plateforme.</p>
        </div>

        {# Parcours principal : compte institutionnel, puis demande d'accès #}
        <div class="space-y-3 m-0">
            <twig:Button
                    href="{{ path('cas_return') }}"
                    variant="primary"
                    size="md"
                    :solid="true"
                    :soft="false"
                    label="Se connecter avec votre compte URCA"
                    extraClass="w-full justify-center"
            />
            <p class="pt-1 text-center text-xs font-semibold uppercase tracking-[0.15em] text-secondary-400">ou pour votre première connexion</p>
            <twig:Button
                    href="{{ path('app_register') }}"
                    variant="success"
                    :solid="true"
                    :soft="false"
                    size="md"
                    label="Demander un accès"
                    extraClass="w-full justify-center"
            />
        </div>

        {# Accès secondaire (administrateurs) : login / mot de passe, formulaire ouvert d'office après une erreur #}
        {% set formOpen = error is not null %}
        {% if error %}
            {{ component('alerte', {type:'danger', message: error.messageKey|trans(error.messageData, 'security') }) }}
        {% endif %}

        {# 32 px au-dessus du trait, du trait au bouton, et du bouton au pied de page (le pied de page a mt-10 : -mb-2 le ramène à 32 px) #}
        <div class="-mb-2 mt-8 border-t border-secondary-300 pt-8 dark:border-secondary-600">
            <twig:Button
                    variant="secondary"
                    size="md"
                    :label="formOpen ? 'Masquer le formulaire login/mot de passe' : 'Connexion avec login/mot de passe'"
                    dataAction="click->login#showFormLogin"
                    extraClass="w-full justify-center"
                    data-login-target="toggleButton"
            />
        </div>

        <form class="{{ formOpen ? '' : 'hidden ' }}space-y-4 rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-bg p-4 mt-6 mb-0" method="post" id="formLogin">
            <div class="space-y-1">
                <label for="inputUsername" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300">Login</label>
                <input
                        type="text"
                        value="{{ last_username }}"
                        name="username"
                        id="inputUsername"
                        class="block w-full rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface px-3 py-2 text-secondary-900 placeholder-secondary-400 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
                        autocomplete="username"
                        required
                        autofocus
                >
            </div>
            <div class="space-y-1">
                <label for="inputPassword" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300">Mot de passe</label>
                <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        class="block w-full rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface px-3 py-2 text-secondary-900 placeholder-secondary-400 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
                        autocomplete="current-password"
                        required
                >
            </div>

            <div class="flex items-center gap-2">
                <input id="rememberMe" type="checkbox" name="_remember_me" value="on"
                       class="h-4 w-4 rounded border-secondary-200 dark:border-secondary-700 text-primary-600 focus:ring-secondary-500 dark:text-primary-400">
                <label for="rememberMe" class="text-sm text-secondary-600 dark:text-secondary-300">Se souvenir de moi</label>
            </div>

            <input type="hidden" name="_csrf_token"
                   value="{{ csrf_token('authenticate') }}"
            >
            <twig:Button
                    type="submit"
                    variant="warning"
                    :soft="false"
                    size="md"
                    label="Se connecter"
                    extraClass="w-full justify-center"
            />
        </form>

    </div>
{% endblock %}
