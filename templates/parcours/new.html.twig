{% form_theme form 'communs/form_theme_v2.html.twig' %}
{{ form_start(form, {
    'attr': {
        'id': 'modal_form'
    }
}) }}
    {{ form_row(form.libelle, {label: texte == 'option' ? 'options.labels.libelle'|trans({}, 'form') : ''}) }}
    {{ form_row(form.respParcours, {label: texte == 'option' ? 'options.labels.respParcours'|trans({}, 'form') : ''}) }}

{{ form_row(form.coResponsable, {label: texte == 'option' ? 'options.labels.coResponsable'|trans({}, 'form') : ''}) }}

{{ form_row(form.sigle, {label: texte == 'option' ? 'options.labels.sigle'|trans({}, 'form') : ''}) }}

{{ form_row(form.typeParcours) }}
{{ form_row(form.parcoursOrigine) }}

{% if is_granted('ROLE_ADMIN') %}
    {{ form_row(form.codeMentionApogee) }}
{% endif %}
{{ form_end(form) }}

