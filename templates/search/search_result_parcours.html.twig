<div
        class="space-y-4"
        id="rootListElement"
        data-fiche-matiere-url="{{ absolute_url(path('fiche_matiere_v2_voir', {slug: 'µ#+'})) }}"
>
    <div class="space-y-4">
        {% if parcoursArray|length > 0 %}
            {% for p in parcoursArray %}
                <article
                        class="rounded-2xl border border-secondary-200 bg-surface p-5 shadow-sm transition hover:border-primary-300 hover:shadow-md dark:border-secondary-700 dark:bg-secondary-950/40">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                        <div class="min-w-0 space-y-3">
                            <div class="flex flex-wrap items-center gap-2">
                                {% if isParcoursDefautArray[loop.index0] == true %}
                                    <twig:Badge label="Parcours par défaut" variant="info"/>
                                {% endif %}

                                {% if resultArrayBadge[loop.index0]['typeParcoursLibelle']|length > 0 %}
                                    <twig:Badge :label="resultArrayBadge[loop.index0]['typeParcoursLibelle']"
                                                variant="secondary"/>
                                {% endif %}
                            </div>

                            {% if isParcoursDefautArray[loop.index0] == true %}
                                <a
                                        href="{{ path('formation_v2_voir', {slug: p.formation_slug}) }}"
                                        class="block text-lg font-semibold text-primary-700 transition hover:text-primary-800 hover:underline dark:text-primary-300 dark:hover:text-primary-200"
                                        target="_blank"
                                        rel="noreferrer"
                                >
                                    {{ resultArrayBadge[loop.index0]['libelleMention'] }}
                                </a>
                            {% else %}
                                <a
                                        href="{{ path('parcours_v2_voir', {parcours: p.parcours_id}) }}"
                                        class="block text-lg font-semibold text-primary-700 transition hover:text-primary-800 hover:underline dark:text-primary-300 dark:hover:text-primary-200"
                                        target="_blank"
                                        rel="noreferrer"
                                >
                                    {{ resultArrayBadge[loop.index0]['libelleMention'] }} -
                                    Parcours {{ p.parcours_libelle }}
                                </a>
                            {% endif %}

                            <p class="text-sm text-secondary-500 dark:text-secondary-400">
                                Sigle
                                : {{ isParcoursDefautArray[loop.index0] == true ? p.formation_sigle : p.parcours_sigle }}
                            </p>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-wrap gap-2">
                        {% if 'objectifsParcours' in resultArrayBadge[loop.index0] %}
                            <twig:Badge label="Objectifs du parcours" variant="success"/>
                        {% endif %}
                        {% if 'poursuitesEtudes' in resultArrayBadge[loop.index0] %}
                            <twig:Badge label="Poursuite d'études" variant="warning"/>
                        {% endif %}
                        {% if 'contenuFormation' in resultArrayBadge[loop.index0] %}
                            <twig:Badge label="Contenu de la formation" variant="primary"/>
                        {% endif %}
                        {% if 'resultatsAttendus' in resultArrayBadge[loop.index0] %}
                            <twig:Badge label="Résultats attendus" variant="info"/>
                        {% endif %}
                        {% if 'objectifsFormation' in resultArrayBadge[loop.index0] %}
                            <twig:Badge label="Objectifs de la formation" variant="secondary"/>
                        {% endif %}
                    </div>

                    {% if resultArrayBadge[loop.index0]['fichesMatieres'] is defined and resultArrayBadge[loop.index0]['fichesMatieres']|length > 0 %}
                        {% set nbFichesMatieres = resultArrayBadge[loop.index0]['fichesMatieres']|length %}
                        <div class="mt-4">
                            <twig:Button
                                    :label="nbFichesMatieres > 1 ? nbFichesMatieres ~ ' fiches matières associées' : nbFichesMatieres ~ ' fiche matière associée'"
                                    variant="secondary"
                                    size="sm"
                                    icon="icon:folder"
                                    dataAction="click->modalturbo#open"
                                    href="{{ path('app_fiche_matiere_search', { parcours: p.parcours_id, keyword: keyword_1 }) }}"
                            />
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        {% else %}
            <div class="rounded-2xl border border-dashed border-secondary-300 bg-secondary-50 p-8 text-center text-secondary-600 dark:border-secondary-700 dark:bg-secondary-950/20 dark:text-secondary-400">
                <p class="text-lg font-semibold text-text dark:text-secondary-100">
                    Aucun parcours trouvé
                </p>
                <p class="mt-2 text-sm">
                    Essayez un autre mot-cl&eacute; ou changez le type de recherche.
                </p>
            </div>
        {% endif %}
    </div>
</div>
