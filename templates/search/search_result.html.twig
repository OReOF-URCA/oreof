{% extends 'base.html.twig' %}

{% set header_title %}
    Résultats de la recherche{% if keyword_1 is not empty %} — {{ keyword_1 }}{% endif %}
{% endset %}

{% block content %}
    <div class="space-y-8">


        <twig:SearchForm
                action="{{ path('app_search_action') }}"
                keyword="{{ keyword_1 }}"
                :searchType="typeRecherche"
                fieldId="newSearchField"
                placeholder="Nouvelle recherche..."
                :resetHref="path('app_search')"
        />

        <div class="flex flex-wrap gap-2">
            {% if keyword_1 is not empty %}
                <twig:Badge :label="'Mot-clé : ' ~ keyword_1" variant="secondary"/>
            {% endif %}
            <twig:Badge
                    :label="typeRecherche == 'parcours' ? 'Type : parcours' : 'Type : fiche matière'"
                    variant="info"
            />
            <twig:Badge
                    :label="typeRecherche == 'parcours'
                    ? (parcoursArray|length ~ (parcoursArray|length > 1 ? ' parcours trouvés' : ' parcours trouvé'))
                    : (nombreTotal ~ (nombreTotal > 1 ? ' fiches matières trouvées' : ' fiche matière trouvée'))"
                    variant="success"
            />
        </div>

        {% if typeRecherche == 'parcours' %}
            {{ include('search/search_result_parcours.html.twig') }}
        {% elseif typeRecherche == 'ficheMatiere' %}
            {{ include('search/search_result_fiche_matiere.html.twig') }}
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}

{% if typeRecherche == 'ficheMatiere' %}
    <script src="{{ asset('search/search_fiche_matiere.js') }}"></script>
{% endif %}

{% endblock %}
