<div class="app-modal-footer-actions">
    <button type="button"
            class="app-modal-footer-btn app-modal-footer-btn--secondary inline-flex items-center gap-2"
            data-action="click->modalturbo#open"
            href="{{ backUrl }}">
        <twig:UX:Icon name="icon:arrow-left" class="h-4 w-4" />
        <span>{{ 'historique.footer_edit.annuler'|trans({}, 'modal') }}</span>
    </button>

    <button type="submit"
            class="app-modal-footer-btn app-modal-footer-btn--primary inline-flex items-center gap-2"
            form="form_edit_historique">
        <twig:UX:Icon name="icon:save" class="h-4 w-4" />
        <span>{{ 'historique.footer_edit.enregistrer'|trans({}, 'modal') }}</span>
    </button>
</div>
