{% extends 'base.html.twig' %}

{% block content %}
    {{ include('_ui/_datatable_card.html.twig', { table: table }) }}
{% endblock %}

{% block bouton_header %}
    <a
            data-action="click->modalturbo#open"
            data-turbo="true"
            href="{{ path('app_domaine_new') }}"
            class="btn border border-success-300 bg-success-50 text-success-700 hover:bg-success-100 hover:text-success-800 dark:bg-success-900 dark:text-success-300 dark:border-success-500 dark:hover:border-success-300 dark:hover:text-success-100"
            {{ stimulus_controller('tooltip', {
                placement: 'bottom',
                customClass: 'app-tooltip',
                title: "Ajouter un domaine"
            }) }}
    >
        <twig:UX:Icon name="icon:add" class="h-4 w-4"/>
        <span> Ajouter un domaine</span>
    </a>
{% endblock %}
