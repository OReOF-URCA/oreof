{% extends 'base.html.twig' %}

{% form_theme form 'communs/form_theme_v2.html.twig' %}

{% block content %}
    <section class="space-y-6">
        {# Carte d'introduction et contexte sécurité #}
        <div class="rounded-2xl border border-secondary-200 bg-white p-6 shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-secondary-100 dark:border-secondary-800">
                <div class="flex items-center gap-3">
                    <div class="rounded-xl bg-primary-50 p-2.5 text-primary-600 dark:bg-primary-900/50 dark:text-primary-400">
                        <twig:UX:Icon name="icon:key" class="w-6 h-6"/>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-secondary-900 dark:text-secondary-100">
                            Clés d'API tierces — {{ etablissement.libelle }}
                        </h2>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400">
                            Configuration sécurisée des points d'accès et jetons pour les plateformes externes (Apogée, Pégase, ORéBUT, ROME, MonMaster, Parcoursup, etc.).
                        </p>
                    </div>
                </div>
                <div>
                    <twig:Badge
                        label="{{ etablissement.apiKeys|length }} configurée{{ etablissement.apiKeys|length > 1 ? 's' : '' }}"
                        variant="info"
                        icon="icon:link"
                    />
                </div>
            </div>

            <div class="mt-4 rounded-xl border border-warning-200 bg-warning-50/70 p-4 text-xs text-warning-800 dark:border-warning-800 dark:bg-warning-950/40 dark:text-warning-300 flex items-start gap-3">
                <twig:UX:Icon name="icon:lock" class="w-5 h-5 shrink-0 text-warning-600 dark:text-warning-400 mt-0.5"/>
                <div>
                    <span class="font-bold">Espace d'administration sécurisé :</span>
                    Ces identifiants et clés API permettent les échanges automatisés entre ORéOF et les systèmes d'information tiers. Les clés secrètes sont masquées par défaut. Utilisez l'icône d'œil pour afficher ou vérifier un jeton en clair.
                </div>
            </div>
        </div>

        {# Formulaire avec gestionnaire de collection dynamique #}
        {{ form_start(form, {'attr': {'id': 'form-api-keys'}}) }}
        <div class="rounded-2xl border border-secondary-200 bg-white p-6 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-secondary-900 dark:text-secondary-100 flex items-center gap-2">
                        <twig:UX:Icon name="icon:gear" class="w-5 h-5 text-primary"/>
                        <span>Liste des connecteurs d'API</span>
                    </h3>
                    <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                        Ajoutez, modifiez ou retirez les connexions vers vos applications partenaires.
                    </p>
                </div>
            </div>

            {% set prototypeHtml %}
                <div data-form-collection-target="field"
                     class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-5 dark:border-secondary-700 dark:bg-secondary-800/60 shadow-sm relative transition mb-4">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-secondary-200 dark:border-secondary-700">
                        <span class="text-xs font-bold uppercase tracking-wider text-primary flex items-center gap-1.5">
                            <twig:UX:Icon name="icon:key" class="w-4 h-4"/>
                            <span data-step-title>Nouvelle API tierce</span>
                        </span>

                        <button type="button"
                                data-action="click->form-collection#removeItem"
                                class="inline-flex items-center gap-1 text-xs font-semibold text-danger-600 hover:text-danger-700 hover:underline dark:text-danger-400 dark:hover:text-danger-300 cursor-pointer">
                            <twig:UX:Icon name="icon:delete" class="w-4 h-4"/>
                            Supprimer
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            {% if form.apiKeys.vars.prototype.plateforme is defined %}
                                {{ form_row(form.apiKeys.vars.prototype.plateforme) }}
                            {% endif %}
                        </div>
                        <div>
                            {% if form.apiKeys.vars.prototype.url is defined %}
                                {{ form_row(form.apiKeys.vars.prototype.url) }}
                            {% endif %}
                        </div>
                        <div>
                            {% if form.apiKeys.vars.prototype.login is defined %}
                                {{ form_row(form.apiKeys.vars.prototype.login) }}
                            {% endif %}
                        </div>
                        <div>
                            {% if form.apiKeys.vars.prototype.apiKey is defined %}
                                <div {{ stimulus_controller('password-toggle') }} class="space-y-2 group mb-4">
                                    <div class="flex justify-between items-center mb-1">
                                        <label class="text-[12px] font-black text-secondary-500 uppercase">
                                            Clé API / Token <span class="text-[10px] font-bold text-red-300">Champs Requis</span>
                                        </label>
                                        <div class="flex items-center gap-1">
                                            <span data-password-toggle-target="copyFeedback" class="hidden text-[10px] font-bold text-success-600 dark:text-success-400 uppercase">Copié !</span>
                                            <button type="button"
                                                    data-action="click->password-toggle#copy"
                                                    class="text-secondary-400 hover:text-secondary-700 dark:hover:text-secondary-200 p-0.5 cursor-pointer"
                                                    title="Copier la clé">
                                                <twig:UX:Icon name="icon:duplicate" class="w-3.5 h-3.5"/>
                                            </button>
                                            <button type="button"
                                                    data-action="click->password-toggle#toggle"
                                                    class="text-secondary-400 hover:text-secondary-700 dark:hover:text-secondary-200 p-0.5 cursor-pointer"
                                                    title="Afficher / Masquer la clé">
                                                <span data-password-toggle-target="iconShow"><twig:UX:Icon name="icon:eye" class="w-3.5 h-3.5"/></span>
                                                <span data-password-toggle-target="iconHide" class="hidden"><twig:UX:Icon name="icon:eye-slash" class="w-3.5 h-3.5"/></span>
                                            </button>
                                        </div>
                                    </div>
                                    {{ form_widget(form.apiKeys.vars.prototype.apiKey) }}
                                    {{ form_errors(form.apiKeys.vars.prototype.apiKey) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endset %}

            <div {{ stimulus_controller('form-collection', {
                'prototype': prototypeHtml|json_encode,
                'max-items': 0,
                'sortable': false
            }) }} class="space-y-4">
                <div data-form-collection-target="fields" class="space-y-4">
                    {% for keyForm in form.apiKeys %}
                        <div data-form-collection-target="field"
                             class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-5 dark:border-secondary-700 dark:bg-secondary-800/60 shadow-sm relative transition">
                            <div class="flex items-center justify-between pb-3 mb-4 border-b border-secondary-200 dark:border-secondary-700">
                                <span class="text-xs font-bold uppercase tracking-wider text-primary flex items-center gap-1.5">
                                    <twig:UX:Icon name="icon:key" class="w-4 h-4"/>
                                    <span data-step-title>API : {{ keyForm.vars.data.plateforme|default('Plateforme') }}</span>
                                </span>

                                <button type="button"
                                        data-action="click->form-collection#removeItem"
                                        class="inline-flex items-center gap-1 text-xs font-semibold text-danger-600 hover:text-danger-700 hover:underline dark:text-danger-400 dark:hover:text-danger-300 cursor-pointer">
                                    <twig:UX:Icon name="icon:delete" class="w-4 h-4"/>
                                    Supprimer
                                </button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div>
                                    {{ form_row(keyForm.plateforme) }}
                                </div>
                                <div>
                                    {{ form_row(keyForm.url) }}
                                </div>
                                <div>
                                    {{ form_row(keyForm.login) }}
                                </div>
                                <div>
                                    <div {{ stimulus_controller('password-toggle') }} class="space-y-2 group mb-4">
                                        <div class="flex justify-between items-center mb-1">
                                            <label class="text-[12px] font-black text-secondary-500 uppercase">
                                                Clé API / Token <span class="text-[10px] font-bold text-red-300">Champs Requis</span>
                                            </label>
                                            <div class="flex items-center gap-1">
                                                <span data-password-toggle-target="copyFeedback" class="hidden text-[10px] font-bold text-success-600 dark:text-success-400 uppercase">Copié !</span>
                                                <button type="button"
                                                        data-action="click->password-toggle#copy"
                                                        class="text-secondary-400 hover:text-secondary-700 dark:hover:text-secondary-200 p-0.5 cursor-pointer"
                                                        title="Copier la clé">
                                                    <twig:UX:Icon name="icon:duplicate" class="w-3.5 h-3.5"/>
                                                </button>
                                                <button type="button"
                                                        data-action="click->password-toggle#toggle"
                                                        class="text-secondary-400 hover:text-secondary-700 dark:hover:text-secondary-200 p-0.5 cursor-pointer"
                                                        title="Afficher / Masquer la clé">
                                                    <span data-password-toggle-target="iconShow"><twig:UX:Icon name="icon:eye" class="w-3.5 h-3.5"/></span>
                                                    <span data-password-toggle-target="iconHide" class="hidden"><twig:UX:Icon name="icon:eye-slash" class="w-3.5 h-3.5"/></span>
                                                </button>
                                            </div>
                                        </div>
                                        {{ form_widget(keyForm.apiKey) }}
                                        {{ form_errors(keyForm.apiKey) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="rounded-xl border border-dashed border-secondary-300 p-8 text-center dark:border-secondary-700">
                            <twig:UX:Icon name="icon:key" class="mx-auto h-8 w-8 text-secondary-400 dark:text-secondary-500 mb-2"/>
                            <p class="text-sm font-semibold text-secondary-700 dark:text-secondary-300">
                                Aucune API tierce configurée
                            </p>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-1">
                                Cliquez sur le bouton ci-dessous pour ajouter une première connexion d'API externe.
                            </p>
                        </div>
                    {% endfor %}
                </div>

                <div class="pt-2">
                    <button type="button"
                            data-action="click->form-collection#addItem"
                            data-form-collection-target="addButton"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-primary-300 bg-primary-50 px-3.5 py-2 text-xs font-bold text-primary-700 transition hover:bg-primary-100 dark:border-primary-600 dark:bg-primary-950/60 dark:text-primary-300 dark:hover:bg-primary-900 cursor-pointer">
                        <twig:UX:Icon name="icon:add" class="w-4 h-4"/>
                        <span>Ajouter une API tierce</span>
                    </button>
                </div>
            </div>

            <div class="pt-4 border-t border-secondary-200 dark:border-secondary-700 flex items-center justify-between">
                <twig:Button
                    type="submit"
                    variant="success"
                    :soft="false"
                    :outline="false"
                    icon="icon:save"
                    label="Enregistrer les clés d'API"
                />
            </div>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}

{% set header_title %}
    {{ titre }}
{% endset %}

{% block bouton_header %}
    <twig:Button
        href="{{ path('app_etablissement_index') }}"
        variant="secondary"
        icon="icon:arrow-left"
        label="Retour aux établissements"
        tooltip="Retour à la liste des établissements"
    />
{% endblock %}
