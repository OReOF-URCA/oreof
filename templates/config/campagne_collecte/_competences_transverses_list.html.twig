<div id="competences_transverses_list" class="space-y-4">
    {% if blocs is empty %}
        <div class="rounded-2xl border-2 border-dashed border-secondary-300 dark:border-secondary-700 p-12 text-center bg-white dark:bg-secondary-800">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-secondary-100 dark:bg-secondary-700/60 text-secondary-500 dark:text-secondary-400 mb-4">
                <twig:UX:Icon name="mdi:format-list-checks" class="h-7 w-7"/>
            </div>
            <h3 class="text-base font-bold text-secondary-900 dark:text-secondary-100">
                Aucune compétence transversale définie pour cette campagne
            </h3>
            <p class="mt-1 text-sm text-secondary-500 dark:text-secondary-400 max-w-md mx-auto">
                Vous pouvez créer de nouveaux blocs de compétences ou importer l'ensemble du référentiel transverse
                depuis la campagne précédente.
            </p>

            <div class="mt-6 flex items-center justify-center gap-3 flex-wrap">
                <twig:Button
                        href="{{ path('app_campagne_collecte_competence_transverse_bloc_new', { id: campagne.id }) }}"
                        variant="primary"
                        :soft="false"
                        :outline="false"
                        icon="icon:add"
                        label="Créer le premier bloc"
                        dataAction="click->modalturbo#open"
                />

                {% if sourceCampagneN1 is defined and sourceCampagneN1 is not null %}
                    <form method="post"
                          action="{{ path('app_campagne_collecte_competences_transverses_import_n1', { id: campagne.id }) }}"
                          class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('import-transverse-' ~ campagne.id) }}">
                        <input type="hidden" name="source_campagne_id" value="{{ sourceCampagneN1.id }}">
                        <twig:Button
                                type="submit"
                                variant="info"
                                :soft="true"
                                icon="mdi:content-copy"
                                label="Importer depuis {{ sourceCampagneN1.libelle }}"
                                tooltip="Copier les compétences transversales de la campagne précédente"
                        />
                    </form>
                {% endif %}
            </div>
        </div>
    {% else %}
        {% for bloc in blocs %}
            <div class="rounded-2xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 shadow-sm overflow-hidden transition hover:border-secondary-300 dark:hover:border-secondary-600">
                {# En-tête du bloc #}
                <div class="flex items-center justify-between gap-4 p-5 bg-secondary-50/50 dark:bg-secondary-800/80 border-b border-secondary-100 dark:border-secondary-700 flex-wrap sm:flex-nowrap">
                    <div class="flex items-center gap-3 min-w-0">
                        <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-lg bg-primary-100 dark:bg-primary-950/80 text-primary-700 dark:text-primary-300 font-bold text-xs shrink-0 tracking-wide">
                            {{ bloc.code ?? ('BC ' ~ loop.index) }}
                        </span>
                        <div class="min-w-0">
                            <h4 class="font-bold text-base text-secondary-900 dark:text-secondary-100 break-words">
                                {{ bloc.libelle }}
                            </h4>
                            <span class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5 block">
                                {{ bloc.competences|length }} {{ bloc.competences|length > 1 ? 'compétences rattachées' : 'compétence rattachée' }}
                            </span>
                        </div>
                    </div>

                    {# Actions sur le bloc #}
                    <div class="flex items-center gap-2 shrink-0">
                        <twig:Button
                                href="{{ path('app_campagne_collecte_competence_transverse_competence_new', { id: bloc.id }) }}"
                                variant="success"
                                size="sm"
                                :soft="true"
                                icon="icon:add"
                                label="Ajouter une compétence"
                                dataAction="click->modalturbo#open"
                        />

                        <twig:Button
                                href="{{ path('app_campagne_collecte_competence_transverse_bloc_edit', { id: bloc.id }) }}"
                                variant="secondary"
                                size="sm"
                                :soft="true"
                                icon="icon:edit"
                                label="Modifier"
                                dataAction="click->modalturbo#open"
                        />

                        <twig:DeleteButton
                                url="{{ path('app_campagne_collecte_competence_transverse_bloc_delete', { id: bloc.id }) }}"
                                csrfTokenId="delete-bloccompetence-{{ bloc.id }}"
                                title="Supprimer le bloc de compétences"
                                message="Voulez-vous vraiment supprimer le bloc « {{ bloc.libelle }} » ainsi que toutes ses compétences rattachées ?"
                                size="sm"
                                :soft="true"
                        />
                    </div>
                </div>

                {# Liste des compétences du bloc #}
                <div class="p-5">
                    {% if bloc.competences is empty %}
                        <div class="text-center py-6 text-secondary-400 dark:text-secondary-500 text-sm italic">
                            Aucune compétence détaillée dans ce bloc.
                            <a href="{{ path('app_campagne_collecte_competence_transverse_competence_new', { id: bloc.id }) }}"
                               class="text-primary-600 dark:text-primary-400 hover:underline font-medium not-italic ml-1 inline-flex items-center gap-1"
                               data-action="click->modalturbo#open"
                            >
                                <twig:UX:Icon name="icon:add" class="w-3.5 h-3.5"/>
                                <span>Ajouter la première</span>
                            </a>
                        </div>
                    {% else %}
                        <div class="grid grid-cols-1 gap-2.5">
                            {% for comp in bloc.competences %}
                                <div class="flex items-center justify-between gap-3 p-3.5 rounded-xl border border-secondary-100 dark:border-secondary-700/80 bg-white dark:bg-secondary-800/50 hover:bg-secondary-50/60 dark:hover:bg-secondary-700/30 transition">
                                    <div class="flex items-start gap-3 min-w-0">
                                        <span class="inline-flex items-center justify-center px-2 py-0.5 rounded bg-secondary-100 dark:bg-secondary-700 text-secondary-700 dark:text-secondary-300 font-semibold text-xs shrink-0 mt-0.5 font-mono">
                                            {{ comp.code|default(loop.index) }}
                                        </span>
                                        <span class="text-sm text-secondary-800 dark:text-secondary-200 leading-snug break-words">
                                            {{ comp.libelle }}
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <twig:Button
                                                href="{{ path('app_campagne_collecte_competence_transverse_competence_edit', { id: comp.id }) }}"
                                                variant="secondary"
                                                size="sm"
                                                :soft="true"
                                                icon="icon:edit"
                                                tooltip="Modifier cette compétence"
                                                dataAction="click->modalturbo#open"
                                        />

                                        <twig:DeleteButton
                                                url="{{ path('app_campagne_collecte_competence_transverse_competence_delete', { id: comp.id }) }}"
                                                csrfTokenId="delete-competence-{{ comp.id }}"
                                                title="Supprimer la compétence"
                                                message="Voulez-vous supprimer la compétence « {{ comp.libelle }} » ?"
                                                size="sm"
                                                :soft="true"
                                        />
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
