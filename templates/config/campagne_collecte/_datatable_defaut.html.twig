{# Template partiel pour la colonne "Collecte DPE active ?" #}
{% set obj = row ?? item ?? entity %}
<span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium {% if obj.defaut %}bg-success-50 text-success-700 ring-1 ring-inset ring-success-600/20 dark:bg-success-900/30 dark:text-success-300 dark:ring-success-700{% else %}bg-warning-50 text-warning-700 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700{% endif %}">
    {{ obj.defaut ? 'Active' : 'Non' }}
</span>
