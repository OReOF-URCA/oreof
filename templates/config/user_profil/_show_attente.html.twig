<div class="space-y-6">
    <section class="rounded-xl border border-secondary-200 bg-secondary-50 px-4 py-3 shadow-sm">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-secondary-500">{{ 'config.user_profil.show_attente.utilisateur'|trans({}, 'modal') }}</h3>
        <p class="mt-2 text-sm text-secondary-700"><span
                    class="font-medium text-secondary-900">{{ 'config.user_profil.show_attente.login'|trans({}, 'modal') }}</span> {{ user.username }}</p>
        <p class="mt-2 text-sm text-secondary-700"><span class="font-medium text-secondary-900">{{ 'config.user_profil.show_attente.nom'|trans({}, 'modal') }}</span> {{ user.nom }}</p>
        <p class="mt-2 text-sm text-secondary-700"><span
                    class="font-medium text-secondary-900">{{ 'config.user_profil.show_attente.prenom'|trans({}, 'modal') }}</span> {{ user.prenom }}</p>
        <p class="mt-2 text-sm text-secondary-700"><span class="font-medium text-secondary-900">{{ 'config.user_profil.show_attente.email'|trans({}, 'modal') }}</span> {{ user.email }}
        </p>
        <p class="mt-2 text-sm text-secondary-700"><span class="font-medium text-secondary-900">{{ 'config.user_profil.show_attente.centre_de_gestion'|trans({}, 'modal') }}</span>
            {% if user.composanteDemande != null %}
                {{ 'config.user_profil.show_attente.composante_demandee'|trans({}, 'modal') }} {{ user.composanteDemande.libelle }}
            {% elseif user.etablissementDemande != null %}
                {{ 'config.user_profil.show_attente.etablissement_demande'|trans({}, 'modal') }} {{ user.etablissementDemande.libelle }}
            {% else %}
                <twig:Badge
                        variant="danger"
                        label="{{ 'config.user_profil.show_attente.erreur_de_demande'|trans({}, 'modal') }}"
                />
            {% endif %}
        </p>
    </section>

    {{ include('user_profils/_gestion_profils.html.twig', {hide:true}) }}

    <div class="mt-2">
        {% if user.isEnable %}
            <twig:Button
                    variant="danger"
                    :soft="true"
                    label="{{ 'config.user_profil.show_attente.desactiver_l_acces'|trans({}, 'modal') }}"
                    tooltip="{{ 'config.user_profil.show_attente.desactiver_l_acces'|trans({}, 'modal') }}"
                    href="{{ path('app_user_gestion_revoque_admin', {user:user.id}) }}"
            />
        {% else %}
            {% if (user.isValidDpe == false and (user.userProfils|length >0 and (user.userProfils[0].profil.centre == 'cg_composante' or user.userProfils[0].profil.centre == 'cg_formation'))
                ) or user.isValideAdministration == false %}
                <p class="mb-2">
                    {% if user.isValidDpe == false %}
                        <twig:Badge variant="warning" label="{{ 'config.user_profil.show_attente.non_valide_par_dpe'|trans({}, 'modal') }}"/>
                    {% else %}
                        <twig:Badge variant="success" label="Validé par DPE le {{ user.dateValideDpe|dateTimeFr }}"/>
                    {% endif %}
                </p>

                {% if not is_granted('ROLE_ADMIN') %}
                    <twig:Button
                            href="{{ path('app_user_gestion_valid_dpe', {user:user.id}) }}"
                            variant="success"
                            :soft="false"
                            label="{{ 'config.user_profil.show_attente.valider_l_acces'|trans({}, 'modal') }}"
                            tooltip="{{ 'config.user_profil.show_attente.valider_l_acces_pour_cet_utilisateur'|trans({}, 'modal') }}"
                    />

                    <twig:Button
                            variant="danger"
                            :soft="true"
                            label="{{ 'config.user_profil.show_attente.refuser_l_acces'|trans({}, 'modal') }}"
                            tooltip="{{ 'config.user_profil.show_attente.refuser_l_acces_pour_cet_utilisateur'|trans({}, 'modal') }}"
                            dataAction="{{ stimulus_action('register', 'refuserAcces') }}"
                    />


                    <div id="motifRefus" class="hidden">
                        <label class="form-label" for="texteMotifRefus"></label>
                        <textarea class="form-control" id="texteMotifRefus"></textarea>
                        <twig:Button
                                variant="danger"
                                :soft="true"
                                label="{{ 'config.user_profil.show_attente.confirmer_le_refus_d_acces'|trans({}, 'modal') }}"
                                tooltip="{{ 'config.user_profil.show_attente.confirmer_le_refus_d_acces'|trans({}, 'modal') }}"
                                dataAction="{{ stimulus_action('register', 'confirmeRefusAcces') }}"
                        />
                    </div>
                {% endif %}

            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                {% if user.isValideAdministration == false %}
                    <twig:Button
                            href="{{ path('app_user_gestion_valid_admin', {user:user.id}) }}"
                            variant="success"
                            :soft="false"
                            label="{{ 'config.user_profil.show_attente.valider_l_acces'|trans({}, 'modal') }}"
                            tooltip="{{ 'config.user_profil.show_attente.valider_l_acces_pour_cet_utilisateur'|trans({}, 'modal') }}"
                    />

                    <twig:Button
                            variant="danger"
                            :soft="true"
                            label="{{ 'config.user_profil.show_attente.refuser_l_acces'|trans({}, 'modal') }}"
                            tooltip="{{ 'config.user_profil.show_attente.refuser_l_acces_pour_cet_utilisateur'|trans({}, 'modal') }}"
                            dataAction="{{ stimulus_action('register', 'refuserAcces') }}"
                    />

                    <div id="motifRefus" class="hidden">
                        <label class="form-label" for="texteMotifRefus"></label>
                        <textarea class="form-control" id="texteMotifRefus"></textarea>
                        <twig:Button
                                variant="danger"
                                :soft="true"
                                label="{{ 'config.user_profil.show_attente.confirmer_le_refus_d_acces'|trans({}, 'modal') }}"
                                tooltip="{{ 'config.user_profil.show_attente.confirmer_le_refus_d_acces'|trans({}, 'modal') }}"
                                dataAction="{{ stimulus_action('register', 'confirmeRefusAcces') }}"
                        />
                    </div>
                {% else %}
                    <twig:Button
                            href="{{ path('app_user_gestion_revoque_admin', {user:user.id}) }}"
                            variant="danger"
                            :soft="false"
                            label="{{ 'config.user_profil.show_attente.revoquer_l_acces'|trans({}, 'modal') }}"
                            tooltip="{{ 'config.user_profil.show_attente.revoquer_l_acces_pour_cet_utilisateur'|trans({}, 'modal') }}"
                    />
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
</div>
