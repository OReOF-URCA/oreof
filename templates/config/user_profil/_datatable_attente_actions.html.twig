<twig:Button
        label="Voir et gérer"
        variant="info"
        icon="icon:info"
        href="{{ path('app_user_show_attente', {'id': item.id, 'dpe': dpe ?? false}) }}"
        dataAction="click->modalturbo#open"
        tooltip="Voir les détails de l'utilisateur"
/>
{% if is_granted('ROLE_ADMIN') %}
    <twig:DeleteButton
            :soft="true"
            tooltip="Supprimer la demande"
            url="{{ path('app_user_profil_delete_demande', {'id': item.id}) }}"
            csrfTokenId="{{ 'delete-user-' ~ item.id }}"
            title="Supprimer la demande de {{ item.prenom }} {{ item.nom }}"
            message="Cette action supprimera définitivement la demande de cet utilisateur."
            confirmLabel="Supprimer"
            cancelLabel="Annuler"
            id="user-demande-{{ item.id }}"
    />
{% endif %}

