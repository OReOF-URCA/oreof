<div>
    {% if not is_granted('ROLE_ADMIN') %}
        <div class="mb-3 rounded-lg border border-cyan-200 bg-cyan-50 p-3 text-sm text-cyan-800">
            {{ 'config.user.new_ldap.la_demande_sera_validee_par_l'|trans({}, 'modal') }}
        </div>
    {% endif %}
    {% form_theme form 'communs/form_theme_v2.html.twig' %}
    {{ form_start(form, {
        attr: {
            id: 'modal_form',
        }}) }}
    <div class="space-y-3">
        {{ form_row(form.email) }}
    </div>
    {{ form_end(form) }}
</div>

