<div>
    {% form_theme form 'communs/form_theme_v2.html.twig' %}
    {{ form_start(form, {
        attr: {
            id: 'modal_form',
        }}) }}
    <div class="space-y-3">
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.email) }}
    </div>
    {{ form_end(form) }}
</div>

