{% extends 'base.html.twig' %}

{% block content %}
    <div {{ stimulus_controller('profil--index', {
        profil: profilId,
        urlListe: path('app_administration_profils_liste'),
        urlChangeDroit: path('app_administration_profils_change_droit'),
    }) }}>
        <div class="mt-2 rounded-lg border border-secondary-200 dark:border-secondary-700 bg-surface shadow-sm">
            <div class="p-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="profil" class="mb-1 block text-sm font-medium text-secondary-700 dark:text-secondary-100">
                            Profil <span class="text-danger-500">*</span>
                        </label>
                        <select name="profil" id="profil"
                                class="block w-full rounded-md border border-secondary-300 dark:border-secondary-700 bg-surface px-3 py-2 text-sm shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
                                {{ stimulus_action('profil--index', 'changeProfil') }}
                                {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}
                        >
                            <option value="">Choisir un profil</option>
                            {% for profil in profils %}
                                <option value="{{ profil.id }}"
                                        {% if profil.id == profilId %}selected{% endif %}
                                >{{ profil.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div></div>
                </div>
            </div>
        </div>

        <div {{ stimulus_target('profil--index', 'liste') }} class="mt-2"></div>
    </div>
{% endblock %}

{% set header_title %}
    Gestion des profils
{% endset %}

{% block bouton_header %}
    <button
            {{ stimulus_controller('modal', {
                size: 'lg',
                modalTitle: 'Ajouter un profil',
                modalUrl: path('app_administration_profils_creer') }) }}
            data-action="click->modal#openModal"
            class="btn border border-success-300 bg-success-50 text-success-700 hover:bg-success-100 hover:text-success-800 dark:bg-success-900 dark:text-success-300 dark:border-success-500 dark:hover:border-success-300 dark:hover:text-success-100"
            {{ stimulus_controller('tooltip', {
                placement: 'bottom',
                customClass: 'app-tooltip',
                title: 'Ajouter un rôle'
            }) }}
    >
        <twig:UX:Icon name="icon:add" class="h-4 w-4"/>
        <span> Créer un profil</span>
    </button>
{% endblock %}
