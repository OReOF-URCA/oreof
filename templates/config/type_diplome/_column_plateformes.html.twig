{# templates/config/type_diplome/_column_plateformes.html.twig #}
{% set plateformes = row.typeDiplomePlateformeAdmissions %}
{% if plateformes|length > 0 %}
    <div class="flex flex-wrap gap-1.5 items-center">
        {% for tpa in plateformes %}
            {% set pf = tpa.plateforme %}
            {% if pf %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-primary-50 text-primary-700 border border-primary-200 dark:bg-primary-950/40 dark:text-primary-300 dark:border-primary-800"
                      title="{{ pf.libelle }}{% if tpa.annees %} (Années : {{ tpa.annees|join(', ') }}){% endif %}">
                    <twig:UX:Icon name="icon:globe" class="w-3 h-3 text-primary-500 shrink-0"/>
                    <span>{{ pf.libelle }}</span>
                    {% if tpa.annees %}
                        <span class="text-[10px] text-secondary-500 font-mono font-normal">({{ tpa.annees|join(',') }})</span>
                    {% endif %}
                </span>
            {% endif %}
        {% endfor %}
    </div>
{% else %}
    <span class="text-xs text-secondary-400 italic">Aucune</span>
{% endif %}
