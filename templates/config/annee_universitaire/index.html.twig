{% extends 'base.html.twig' %}

{% block content %}
    {{ component('DataTable', { config: table }) }}
{% endblock %}

{% set header_title %}
    Gestion des années universitaires
{% endset %}

{% block bouton_header %}
    <a
            data-action="click->modalturbo#open"
            data-turbo="true"
            href="{{ path('app_annee_universitaire_new') }}"
            class="btn border border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 hover:text-emerald-800"
            {{ stimulus_controller('tooltip', {
                placement: 'bottom',
                customClass: 'app-tooltip',
                title: "Ajouter une année universitaire"
            }) }}
    >
        <twig:UX:Icon name="icon:add" class="h-4 w-4"/>
        <span> Ajouter une année universitaire</span>
    </a>
{% endblock %}
