{% extends 'base.html.twig' %}

{% block content %}
    {{ include('_ui/_datatable_card.html.twig', { table: table }) }}
{% endblock %}

{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <a
                data-action="click->modalturbo#open"
                data-turbo="true"
                href="{{ path('app_mention_codification_modal') }}"
                class="btn border border-warning-300 bg-warning-50 text-warning-700 hover:bg-warning-100 hover:text-warning-800 dark:bg-warning-900 dark:text-warning-300 dark:border-warning-500 dark:hover:border-warning-300 dark:hover:text-warning-100"
                {{ stimulus_controller('tooltip', {
                    placement: 'bottom',
                    customClass: 'app-tooltip',
                    title: "Générer Codification"
                }) }}
        >
            <twig:UX:Icon name="icon:wrench" class="h-4 w-4"/>
            <span> Générer Codification</span>
        </a>
    {% endif %}

    <a
            data-action="click->modalturbo#open"
            data-turbo="true"
            href="{{ path('app_mention_new') }}"
            class="btn border border-success-300 bg-success-50 text-success-700 hover:bg-success-100 hover:text-success-800 dark:bg-success-900 dark:text-success-300 dark:border-success-500 dark:hover:border-success-300 dark:hover:text-success-100"
            {{ stimulus_controller('tooltip', {
                placement: 'bottom',
                customClass: 'app-tooltip',
                title: "Ajouter une mention"
            }) }}
    >
        <twig:UX:Icon name="icon:add" class="h-4 w-4"/>
        <span> Ajouter une mention</span>
    </a>
{% endblock %}
