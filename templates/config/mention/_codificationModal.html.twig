<form action="{{ path('app_mention_codification') }}" method="post">
    <div class="row" >
        {{ component('alerte', {
            'type': 'info',
            'message': 'Veuillez sélectionner au moins une période d\'accréditation et au moins un domaine'
        }) }}
        <div class="col-6" {{ stimulus_controller('check_all', {
            'idCheckAll': 'accreditation',
            'classCheckAll': '.accreditation',
        }) }}>
            <div class="form-check mt-2">
                <input type="checkbox"
                       name="allAccreditation"
                       class="form-check-input"
                       value="all"
                       id="accreditation" {{ stimulus_action('check_all', 'checkAll', 'click', {'classCheckAll' : 'accreditation', 'idCheckAll': 'accreditation'}) }}>
                <label for="accreditation" class="form-check-label">
                    {{ 'config.mention.codificationModal.toutes_les_periodes'|trans({}, 'modal') }}
                </label>
            </div>
            {% for accreditation in accreditations %}
                <div class="form-check">
                    <input type="checkbox"
                           name="accreditation[]"
                           class="form-check-input accreditation"
                           value="{{ accreditation.id }}"
                           id="acc_{{ accreditation.id }}" {{ stimulus_action('check_all', 'check', 'click', {'classcheckall' : 'accreditation', 'idcheckall': 'accreditation'}) }}>
                    <label for="acc_{{ accreditation.id }}" class="form-check-label">
                        {{ accreditation.libelle }}
                    </label>
                </div>
            {% endfor %}
        </div>
        <div class="col-6" {{ stimulus_controller('check_all', {
            'idCheckAll': 'domaine',
            'classCheckAll': '.domaine',
        }) }}>
            <div class="form-check mt-2">
                <input type="checkbox"
                       name="allDomaine"
                       value="all"
                       class="form-check-input"
                       id="domaine" {{ stimulus_action('check_all', 'checkAll', 'click', {'classCheckAll' : 'domaine', 'idCheckAll': 'domaine'}) }}>
                <label for="domaine" class="form-check-label">
                    {{ 'config.mention.codificationModal.tous_les_domaines'|trans({}, 'modal') }}
                </label>
            </div>
            {% for domaine in domaines %}
                <div class="form-check">
                    <input type="checkbox"
                           name="domaine[]"
                           value="{{ domaine.id }}"
                           id="domaine_{{ domaine.id }}"
                           class="form-check-input domaine"
                            {{ stimulus_action('check_all', 'check', 'click', {'classcheckall' : 'domaine', 'idcheckall': 'domaine'}) }}>
                    <label for="domaine_{{ domaine.id }}" class="form-check-label">
                        {{ domaine.libelle }}
                    </label>
                </div>
            {% endfor %}
        </div>
    </div>
    <button type="submit" class="btn btn-success"
            {{ stimulus_action('base','sauvegardeFormModal', 'click') }}>
        <i class="fal fa-floppy-disk"></i>
        {{ 'config.mention.codificationModal.generer_les_codes'|trans({}, 'modal') }}
    </button>
</form>
