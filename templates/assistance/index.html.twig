{% extends 'base.html.twig' %}

{% block bouton_header %}
    <form method="post" action="{{ path('app_assistance_relever') }}" class="inline-flex items-center gap-3"
          data-controller="assistance-releve"
          data-assistance-releve-url-value="{{ path('app_assistance_relever_auto') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('assistance_relever') }}">
        <span class="text-sm text-secondary-500 dark:text-secondary-400" data-assistance-releve-target="statut" role="status" hidden></span>
        <twig:Button label="Relever maintenant" variant="primary" icon="icon:refresh" type="submit" />
    </form>
{% endblock %}

{% block content %}
    <div class="space-y-6">
        {# indicateurs des demandes à traiter (notifications et annonces exclues) ; chaque carte filtre la liste #}
        {% set lien = path('app_assistance_index') %}
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            <div data-indicateur="a_moi">
                <twig:Kpi title="À moi" :value="indicateurs.a_moi" description="Ouvertes, dont je suis responsable" variant="primary" icon="mdi:account-check-outline" href="{{ lien }}?responsable=moi" extraClass="{{ indicateurs.a_moi > 0 ? 'ring-2 ring-primary-300 dark:ring-primary-700' }}" />
            </div>
            <div data-indicateur="nouvelles">
                <twig:Kpi title="Nouvelles" :value="indicateurs.nouvelles" description="Pas encore traitées" variant="danger" icon="mdi:email-alert-outline" href="{{ lien }}?statut=nouvelle" />
            </div>
            <div data-indicateur="en_cours">
                <twig:Kpi title="En cours" :value="indicateurs.en_cours" description="En traitement" variant="warning" icon="mdi:progress-clock" href="{{ lien }}?statut=en_cours" />
            </div>
            <div data-indicateur="en_attente_usager">
                <twig:Kpi title="En attente" :value="indicateurs.en_attente_usager" description="Réponse de l'usager attendue" variant="info" icon="mdi:account-clock-outline" href="{{ lien }}?statut=en_attente_usager" />
            </div>
            <div data-indicateur="sans_responsable">
                <twig:Kpi title="Sans responsable" :value="indicateurs.sans_responsable" description="Ouvertes, à prendre en charge" variant="secondary" icon="mdi:account-question-outline" href="{{ lien }}?responsable=aucun" />
            </div>
            <div data-indicateur="ouvertes">
                <twig:Kpi title="Ouvertes" :value="indicateurs.ouvertes" description="Total à traiter" variant="default" icon="mdi:lifebuoy" href="{{ lien }}" />
            </div>
        </div>

        <section class="rounded-xl border border-secondary-200 bg-surface shadow-sm dark:border-secondary-700">
            {# onglets : vraies demandes / notifications système / annonces de l'équipe #}
            {% set libellesOnglets = {demandes: ['Demandes', 'mdi:lifebuoy'], notifications: ['Notifications système', 'mdi:robot-outline'], annonces: ['Annonces', 'mdi:bullhorn-outline']} %}
            <nav class="flex gap-1 overflow-x-auto border-b border-secondary-200 px-4 dark:border-secondary-700" aria-label="Type d'éléments">
                {% for cle, onglet in libellesOnglets %}
                    {% set actif = vue == cle %}
                    <a href="{{ path('app_assistance_index', cle == 'demandes' ? {} : {vue: cle}) }}"
                       data-onglet="{{ cle }}" {% if actif %}aria-current="page"{% endif %}
                       class="-mb-px inline-flex items-center gap-2 whitespace-nowrap border-b-2 px-3 py-3 text-sm font-medium {{ actif ? 'border-primary-500 text-primary-700 dark:text-primary-300' : 'border-transparent text-secondary-500 hover:border-secondary-300 hover:text-text dark:text-secondary-400' }}">
                        {{ ux_icon(onglet[1], {class: 'h-4 w-4'}) }}
                        {{ onglet[0] }}
                        <span data-compteur class="rounded-full px-2 py-0.5 text-xs {{ actif ? 'bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-200' : 'bg-secondary-100 text-secondary-600 dark:bg-secondary-800 dark:text-secondary-300' }}">{{ onglets[cle] }}</span>
                    </a>
                {% endfor %}
            </nav>
            <div class="p-4">
                {% if vue == 'notifications' %}
                    <p class="mb-4 text-sm text-secondary-500 dark:text-secondary-400">Mails envoyés automatiquement (notifications ORéOF, adresses no-reply, rebonds…). Rien à traiter : une notification redevient une demande dès qu'une personne y répond.</p>
                {% elseif vue == 'annonces' %}
                    <p class="mb-4 text-sm text-secondary-500 dark:text-secondary-400">Mails de masse envoyés par l'équipe. Chaque réponse d'un usager ouvre sa propre demande.</p>
                {% endif %}
                <form method="get" class="mb-4 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-12" data-controller="auto-submit">
                    {% if vue != 'demandes' %}<input type="hidden" name="vue" value="{{ vue }}">{% endif %}
                    <div class="lg:col-span-4">
                        <label for="assistance-q" class="sr-only">Rechercher</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary">{{ ux_icon('icon:search', {class: 'h-4 w-4'}) }}</span>
                            <input type="search" id="assistance-q" name="q" value="{{ filtres.q }}"
                                   class="w-full rounded-lg border border-secondary-200 bg-white px-10 py-2 text-sm text-text placeholder:text-secondary-400 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder:text-secondary-400 dark:focus:border-primary-400 dark:focus:ring-primary-900"
                                   placeholder="Sujet, email ou nom du demandeur…" autocomplete="off"
                                   data-action="input->auto-submit#debouncedSubmit">
                        </div>
                    </div>
                    {% if vue == 'demandes' %}
                    <div class="lg:col-span-3">
                        <label for="assistance-statut" class="sr-only">Statut</label>
                        <select id="assistance-statut" name="statut" class="app-filter-select app-select-required" data-action="change->auto-submit#submit"
                                {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                            <option value="ouvertes" {{ filtres.statut == 'ouvertes' ? 'selected' }}>Demandes ouvertes</option>
                            <option value="toutes" {{ filtres.statut == 'toutes' ? 'selected' }}>Toutes les demandes</option>
                            {% for statut in statuts %}
                                <option value="{{ statut.value }}" {{ filtres.statut == statut.value ? 'selected' }}>{{ statut.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="lg:col-span-3">
                        <label for="assistance-responsable" class="sr-only">Responsable</label>
                        <select id="assistance-responsable" name="responsable" class="app-filter-select" data-action="change->auto-submit#submit"
                                {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                            <option value="">Tous les responsables</option>
                            <option value="moi" {{ filtres.responsable == 'moi' ? 'selected' }}>Mes demandes</option>
                            <option value="aucun" {{ filtres.responsable == 'aucun' ? 'selected' }}>Sans responsable</option>
                            {% for membre in equipe %}
                                <option value="{{ membre.id }}" {{ filtres.responsable == membre.id ~ '' ? 'selected' }}>{{ membre.display }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endif %}
                    <div class="flex flex-wrap items-center gap-2 lg:col-span-2">
                        <twig:Button label="Filtrer" variant="primary" type="submit" icon="icon:search" size="sm" />
                        <twig:Button label="Réinitialiser" variant="secondary" :outline="true" size="sm" href="{{ path('app_assistance_index', vue == 'demandes' ? {} : {vue: vue}) }}" />
                    </div>
                </form>

                {% if total == 0 %}
                    <p class="py-8 text-center text-secondary-400">{{ vue == 'notifications' ? 'Aucune notification.' : (vue == 'annonces' ? 'Aucune annonce.' : 'Aucune demande.') }}</p>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="table w-full text-sm">
                            <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600 dark:bg-secondary-900 dark:text-secondary-300">
                                <tr>
                                    <th class="px-3 py-2">Sujet</th>
                                    <th class="px-3 py-2">Demandeur</th>
                                    <th class="px-3 py-2">Statut</th>
                                    <th class="px-3 py-2">Responsable</th>
                                    <th class="px-3 py-2">Messages</th>
                                    <th class="px-3 py-2">Dernier message</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
                                {# bandeau de couleur par statut (mêmes couleurs que les indicateurs) ; mes demandes surlignées #}
                                {% set bandeaux = {nouvelle: 'border-l-rose-500', en_cours: 'border-l-amber-500', en_attente_usager: 'border-l-cyan-500', resolue: 'border-l-emerald-500'} %}
                                {% for demande in demandes %}
                                    {% set aMoi = moi is not null and demande.responsable is not null and demande.responsable.id == moi.id and demande.statut.estOuverte %}
                                    {% set nouvelle = demande.statut.value == 'nouvelle' and not demande.annonce and not demande.notification %}
                                    <tr data-statut="{{ demande.statut.value }}" {% if aMoi %}data-a-moi{% endif %}
                                        class="{{ aMoi ? 'bg-primary-100 hover:bg-primary-200/70 dark:bg-primary-900/40 dark:hover:bg-primary-900/60' : 'hover:bg-secondary-50 dark:hover:bg-secondary-800' }}">
                                        <td class="border-l-4 px-3 py-2 {{ demande.annonce or demande.notification ? 'border-l-secondary-300 dark:border-l-secondary-600' : bandeaux[demande.statut.value] }}">
                                            {% set nombre = demande.messages|length %}
                                            <details class="assistance-fil group">
                                                <summary class="flex cursor-pointer list-none items-baseline gap-2 [&::-webkit-details-marker]:hidden">
                                                    <span class="text-secondary-400 transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
                                                    {% if nouvelle %}<span class="h-2 w-2 shrink-0 self-center rounded-full bg-rose-500" title="Nouvelle demande"></span>{% endif %}
                                                    <a href="{{ path('app_assistance_show', {id: demande.id}) }}" class="{{ nouvelle ? 'font-bold' : 'font-medium' }} text-primary-700 hover:underline dark:text-primary-300">{{ demande.sujet }}</a>
                                                    <span class="whitespace-nowrap text-xs text-secondary-500 dark:text-secondary-400">{{ nombre }} message{{ nombre > 1 ? 's' }}</span>
                                                </summary>
                                                <ul class="mt-2 space-y-0.5 border-l border-secondary-200 dark:border-secondary-700">
                                                    {% set decalages = ['pl-3', 'pl-7', 'pl-11', 'pl-15'] %}
                                                    {% for noeud in fil.arbre(demande.messages) %}
                                                        {% set message = noeud.message %}
                                                        <li>
                                                            <a href="{{ path('app_assistance_show', {id: demande.id}) }}#message-{{ message.id }}"
                                                               data-profondeur="{{ noeud.profondeur }}"
                                                               class="flex items-baseline gap-2 rounded py-1 pr-2 text-xs hover:bg-secondary-100 dark:hover:bg-secondary-800 {{ decalages[noeud.profondeur] }}">
                                                                {% if noeud.profondeur > 0 %}<span class="text-secondary-300 dark:text-secondary-600" aria-hidden="true">└</span>{% endif %}
                                                                <span class="shrink-0 font-medium text-text">{{ message.expediteurNom ?? message.expediteurEmail }}</span>
                                                                {% if message.estNote %}
                                                                    <twig:Badge label="Note" variant="warning" size="sm" />
                                                                {% elseif message.automatique %}
                                                                    <twig:Badge label="Automatique" variant="secondary" size="sm" />
                                                                {% endif %}
                                                                <span class="min-w-0 grow truncate text-secondary-600 dark:text-secondary-300">{{ fil.extrait(message) }}</span>
                                                                <time class="shrink-0 text-secondary-500 dark:text-secondary-400" datetime="{{ message.dateEnvoi|date('c') }}">{{ message.dateEnvoi|date('d/m H:i') }}</time>
                                                            </a>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </details>
                                        </td>
                                        <td class="px-3 py-2 text-text">
                                            {{ demande.demandeurNom ?? demande.demandeurEmail }}
                                            {% if demande.demandeurNom %}<span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ demande.demandeurEmail }}</span>{% endif %}
                                        </td>
                                        <td class="px-3 py-2">
                                            {% if demande.annonce %}
                                                <twig:Badge label="Annonce" variant="info" size="sm" icon="mdi:bullhorn-outline" />
                                            {% elseif demande.notification %}
                                                <twig:Badge label="Notification" variant="secondary" size="sm" icon="mdi:robot-outline" />
                                            {% else %}
                                                <twig:Badge :label="demande.statut.libelle" :variant="demande.statut.badgeVariant" size="sm" />
                                            {% endif %}
                                        </td>
                                        <td class="px-3 py-2 text-text">
                                            {% if aMoi %}
                                                <twig:Badge label="Vous" variant="primary" size="sm" icon="mdi:account-check-outline" />
                                            {% elseif demande.responsable %}
                                                {{ demande.responsable.display }}
                                            {% elseif demande.statut.estOuverte and not demande.annonce and not demande.notification %}
                                                <span class="text-xs italic text-secondary-500 dark:text-secondary-400">À prendre</span>
                                            {% else %}
                                                —
                                            {% endif %}
                                        </td>
                                        <td class="px-3 py-2 text-text">{{ demande.messages|length }}</td>
                                        <td class="px-3 py-2 whitespace-nowrap text-secondary-600 dark:text-secondary-300">{{ demande.dateDernierMessage|date('d/m/Y H:i') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if pages > 1 %}
                        <nav class="mt-4 flex items-center justify-between text-sm" aria-label="Pagination">
                            <span class="text-secondary-500 dark:text-secondary-400">{{ total }} demande(s) — page {{ page }} / {{ pages }}</span>
                            <div class="flex gap-2">
                                {% if page > 1 %}
                                    <twig:Button label="Précédente" variant="secondary" size="sm" href="{{ path('app_assistance_index', filtres|merge({page: page - 1})) }}" />
                                {% endif %}
                                {% if page < pages %}
                                    <twig:Button label="Suivante" variant="secondary" size="sm" href="{{ path('app_assistance_index', filtres|merge({page: page + 1})) }}" />
                                {% endif %}
                            </div>
                        </nav>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
