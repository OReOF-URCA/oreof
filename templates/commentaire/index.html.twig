{% extends 'base.html.twig' %}

{% set header_title %}
    Mes commentaires
{% endset %}


{% block breadcrumb %}
    {{ include('communs/_breadcrumb.html.twig', {liens:[
        { title: header_title }
    ]}) }}
{% endblock %}

{% block bouton_header %}
    <twig:Button
            href="{{ path('app_commentaire_export') }}"
            variant="info"
            size="sm"
            icon="icon:download"
            label="Télécharger en PDF"
            tooltip="Télécharger en PDF"
    />
{% endblock %}

{% block content %}
    <section
            class="space-y-4 rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm dark:border-secondary-700 dark:bg-secondary-900 sm:p-6">
        <div class="space-y-1">
            <h2 class="text-sm font-black uppercase tracking-widest text-secondary-500 dark:text-secondary-400">Vos
                commentaires</h2>
            <p class="text-sm text-secondary-600 dark:text-secondary-300">Retrouvez ici vos remarques et accédez directement à
                la zone concernée.</p>
        </div>

        <div class="overflow-hidden rounded-xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
            <div class="divide-y divide-secondary-200 dark:divide-secondary-700">
                {% for commentaire in commentaires %}
                    {% if commentaire.formation is defined and commentaire.formation != null %}
                        {% set contexteLabel = 'Formation' %}
                        {% set contexteVariant = 'info' %}
                        {% set contexteDescription = commentaire.formation.displayLong %}
                        {% set url = path('formation_v2_voir', { slug: commentaire.formation.slug }) ~ '#' ~ commentaire.zone %}
                    {% elseif commentaire.parcours is defined and commentaire.parcours != null %}
                        {% set contexteLabel = 'Parcours' %}
                        {% set contexteVariant = 'primary' %}
                        {% set contexteDescription = commentaire.parcours.libelle ~ ' / ' ~ commentaire.parcours.formation.displayLong %}
                        {% set url = path('parcours_v2_voir', { parcours: commentaire.parcours.id }) ~ '#' ~ commentaire.zone %}
                    {% elseif commentaire.ficheMatiere is defined and commentaire.ficheMatiere != null %}
                        {% set contexteLabel = 'Fiche EC' %}
                        {% set contexteVariant = 'warning' %}
                        {% set contexteDescription = commentaire.ficheMatiere.display %}
                        {% set url = path('fiche_matiere_v2_voir', { slug: commentaire.ficheMatiere.slug }) ~ '#' ~ commentaire.zone %}
                    {% else %}
                        {% set contexteLabel = 'Erreur' %}
                        {% set contexteVariant = 'danger' %}
                        {% set contexteDescription = 'Contexte non identifié' %}
                        {% set url = '' %}
                    {% endif %}

                    <article class="flex flex-col gap-4 p-4 sm:flex-row sm:items-start sm:justify-between sm:p-5">
                        <div class="space-y-2">
                            <div class="flex flex-wrap items-center gap-2">
                                {{ component('Badge', { label: contexteLabel, variant: contexteVariant }) }}
                                <p class="text-sm font-medium text-secondary-800 dark:text-secondary-100">{{ contexteDescription }}</p>
                            </div>
                            <p class="text-xs font-medium uppercase tracking-wide text-secondary-500 dark:text-secondary-400">
                                Zone : {{ commentaire.zone }}</p>
                            <div class="text-sm text-secondary-700 dark:text-secondary-200">
                                {{ commentaire.texte|raw }}
                            </div>
                        </div>

                        <div class="shrink-0">
                            {% if url != '' %}
                                <twig:Button
                                        href="{{ url }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        variant="info"
                                        size="sm"
                                        label="Accéder"
                                />
                            {% else %}
                                <span class="inline-flex rounded-md border border-secondary-200 bg-secondary-50 px-3 py-1.5 text-xs font-medium text-secondary-500 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">Lien indisponible</span>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <div class="p-8 text-center text-sm text-secondary-500 dark:text-secondary-400">
                        Aucun commentaire pour le moment.
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
