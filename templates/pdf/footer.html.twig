<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Footer PDF</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 8px;
            color: #64748b;
            width: 100%;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        {% if withTemplate is defined and withTemplate == true %}
        footer {
            margin: 0;
            bottom: 0;
            width: 100%;
            height: 3.2cm;
            left: 0;
            right: 0;
            text-align: right;
        }

        #class_vague {
            margin: 0;
            padding: 0;
            width: 100%;
            text-align: right;
        }

        #class_vague img {
            height: 3.2cm;
            max-width: 100%;
            object-fit: cover;
        }
        {% else %}
        footer {
            display: table;
            width: 100%;
            table-layout: fixed;
            padding: 4px 1.2cm 0 1.2cm;
            border-top: 1px solid #e2e8f0;
        }

        .footer-col-left {
            display: table-cell;
            width: 35%;
            vertical-align: middle;
            text-align: left;
            color: #475569;
            font-weight: 500;
        }

        .footer-col-center {
            display: table-cell;
            width: 45%;
            vertical-align: middle;
            text-align: center;
            color: #64748b;
            font-size: 7.5px;
        }

        .footer-col-right {
            display: table-cell;
            width: 20%;
            vertical-align: middle;
            text-align: right;
            font-weight: 600;
            color: #334155;
        }

        .footer-tag {
            display: inline-block;
            padding: 1px 4px;
            border-radius: 2px;
            font-size: 7px;
            text-transform: uppercase;
            font-weight: 700;
        }

        .footer-tag-valid {
            background-color: #dcfce7;
            color: #166534;
        }

        .footer-tag-prov {
            background-color: #fef3c7;
            color: #92400e;
        }
        {% endif %}
    </style>
</head>
<body>
<footer>
    {% if withTemplate is defined and withTemplate == true and image is defined and image is not empty %}
        <div id="class_vague">
            <img src="data:image/jpeg;base64,{{ image }}" alt="footer">
        </div>
    {% else %}
        <div class="footer-col-left">
            Université de Reims Champagne-Ardenne &bull; ORéOF
        </div>
        <div class="footer-col-center">
            Généré le {{ 'now'|date('d/m/Y à H:i') }}
            &bull;
            {% if final is defined and final == true %}
                <span class="footer-tag footer-tag-valid">Document validé</span>
            {% else %}
                <span class="footer-tag footer-tag-prov">Provisoire non validé</span>
            {% endif %}
        </div>
        <div class="footer-col-right">
            Page <span class="pageNumber"></span> / <span class="totalPages"></span>
        </div>
    {% endif %}
</footer>
</body>
</html>

