<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Header PDF</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 8.5px;
            color: #475569;
            width: 100%;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        {% if withTemplate is defined and withTemplate == true %}
        header {
            margin: 0;
            top: 0;
            width: 100%;
            height: 2.8cm;
            left: 0;
            right: 0;
            text-align: right;
        }

        #class_vague {
            margin: 0;
            padding: 0;
            width: 100%;
            text-align: right;
        }

        #class_vague img {
            height: 2.8cm;
            max-width: 100%;
            object-fit: cover;
        }
        {% else %}
        header {
            display: table;
            width: 100%;
            table-layout: fixed;
            padding: 0 1.2cm 4px 1.2cm;
            border-bottom: 1px solid #e2e8f0;
        }

        .header-logo-cell {
            display: table-cell;
            width: 25%;
            vertical-align: middle;
            text-align: left;
        }

        .header-logo-cell img {
            height: 0.9cm;
            max-width: 100%;
            object-fit: contain;
        }

        .header-title-cell {
            display: table-cell;
            width: 75%;
            vertical-align: middle;
            text-align: right;
            padding-left: 10px;
        }

        .header-title-cell h1 {
            font-size: 8.5px;
            font-weight: 600;
            color: #334155;
            line-height: 1.35;
            margin: 0;
        }
        {% endif %}
    </style>
</head>
<body>
<header>
    {% if withTemplate is defined and withTemplate == true and image is defined and image is not empty %}
        <div id="class_vague">
            <img src="data:image/jpeg;base64,{{ image }}" alt="logo">
        </div>
    {% else %}
        <div class="header-logo-cell">
            {% if image is defined and image is not empty %}
                <img src="data:image/png;base64,{{ image }}" alt="URCA">
            {% endif %}
        </div>
        <div class="header-title-cell">
            <h1>{{ titre|raw }}</h1>
        </div>
    {% endif %}
</header>
</body>
</html>

