{% extends 'base.html.twig' %}

{% set header_title = 'page.app_composante.title'|trans({'%composante%':  composante.libelle}, 'menu') %}

{% block content %}
    <div {{ stimulus_controller('composante--gestion') }} class="space-y-6">

        {# ── Bandeau identité composante ─────────────────────────────────────────── #}
        <section
                class="rounded-2xl border border-secondary-200 bg-white p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    {# Icône / Logo #}
                    <div class="relative group flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-secondary-200 bg-cyan-50 dark:border-secondary-700 dark:bg-cyan-950/30">
                        {% if composante.logo %}
                            <img src="{{ asset('uploads/logos/' ~ composante.logo) }}" alt="{{ composante.libelle }}" class="h-full w-full object-contain p-1">
                        {% else %}
                            <span class="text-xl font-black text-cyan-700 dark:text-cyan-300">{{ composante.sigle|upper|slice(0,2) }}</span>
                        {% endif %}
                    </div>

                    <div class="space-y-1">
                        <h1 class="text-lg font-bold text-secondary-900 dark:text-secondary-100">
                            {{ composante.libelle }}
                        </h1>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">
                            Sigle : <span class="font-semibold text-secondary-700 dark:text-secondary-300">{{ composante.sigle }}</span>
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    {# Bouton upload logo composante #}
                    <form action="{{ path('app_composante_logo', {composante: composante.id}) }}" method="post" enctype="multipart/form-data" class="flex items-center">
                        <label class="app-btn app-btn-neutral text-xs cursor-pointer" title="Modifier le logo de la composante">
                            <twig:UX:Icon name="icon:upload" class="h-3.5 w-3.5"/>
                            <span>{{ composante.logo ? 'Changer le logo' : 'Ajouter un logo' }}</span>
                            <input type="file" name="logo" accept="image/*" class="sr-only" onchange="this.form.submit()">
                        </label>
                    </form>

                    {% if composante.logo %}
                        <form action="{{ path('app_composante_logo_delete', {composante: composante.id}) }}" method="post" onsubmit="return confirm('Supprimer le logo de la composante ?');">
                            <button type="submit" class="app-btn app-btn-danger text-xs" title="Supprimer le logo">
                                <twig:UX:Icon name="icon:trash" class="h-3.5 w-3.5"/>
                            </button>
                        </form>
                    {% endif %}

                    <a href="{{ path('app_plaquette', {composante: composante.id}) }}" class="app-btn app-btn-primary text-xs">
                        <twig:UX:Icon name="mdi:file-document" class="h-3.5 w-3.5"/>
                        <span>Plaquette de communication</span>
                    </a>

                    {# Remplissage global #}
                    <div class="shrink-0 pl-2">
                        {{ component('remplissage_progress', { value: composante.remplissage }) }}
                    </div>
                </div>
            </div>
        </section>


        {# ── Onglets de processus des formations ────────────────────────────────── #}
        <div class="app-tabs" {{ stimulus_controller('tabs', { rememberHash: true }) }}>
            <div class="app-tabs-list" role="tablist" aria-label="Processus des formations">
                <button type="button"
                        class="app-tab gap-2 app-tab-active active"
                        role="tab"
                        data-tabs-target="tab"
                        data-action="tabs#change"
                        data-tab-id="formations-accreditees"
                        aria-selected="true">
                    <twig:UX:Icon name="icon:award" class="h-4 w-4 text-cyan-600 dark:text-cyan-400"/>
                    <span>Formations accréditées</span>
                    <span class="rounded-full bg-cyan-100 px-2 py-0.5 text-xs font-bold text-cyan-800 dark:bg-cyan-900/60 dark:text-cyan-200">
                        {{ formationsAccreditees|length }}
                    </span>
                </button>
                <button type="button"
                        class="app-tab gap-2"
                        role="tab"
                        data-tabs-target="tab"
                        data-action="tabs#change"
                        data-tab-id="formations-non-accreditees"
                        aria-selected="false">
                    <twig:UX:Icon name="ph:buildings-bold" class="h-4 w-4 text-amber-600 dark:text-amber-400"/>
                    <span>Formations non accréditées (établissement)</span>
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-200">
                        {{ formationsNonAccreditees|length }}
                    </span>
                </button>
            </div>

            {# ── Corps principal : identité + formulaire processus | formations ──────────────── #}
            <div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">

                {# ════════════ Colonne gauche (1/3) ════════════ #}
                <div class="space-y-6">

                    {# Identité #}
                    <section
                            class="rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
                        <div class="flex items-center gap-2 border-b border-secondary-100 px-5 py-4 dark:border-secondary-800">
                            <twig:UX:Icon name="icon:info" class="h-4 w-4 text-cyan-600 dark:text-cyan-400"/>
                            <h2 class="text-sm font-black uppercase tracking-widest text-secondary-500 dark:text-secondary-400">
                                Identité
                            </h2>
                        </div>
                        <dl class="divide-y divide-secondary-100 dark:divide-secondary-800">
                            {% set items = [
                                { label: 'Directeur',          value: composante.directeur ? composante.directeur.display : null, empty: 'Non défini' },
                                { label: 'Responsable DPE',    value: composante.responsableDpe ? composante.responsableDpe.display : null, empty: 'Non défini' },
                            ] %}
                            {% for item in items %}
                                <div class="flex flex-col gap-0.5 px-5 py-3 sm:flex-row sm:items-start sm:gap-4">
                                    <dt class="w-40 shrink-0 text-xs font-semibold uppercase tracking-wide text-secondary-400 dark:text-secondary-500 sm:pt-0.5">
                                        {{ item.label }}
                                    </dt>
                                    <dd class="text-sm font-medium text-secondary-800 dark:text-secondary-200">
                                        {{ item.value ?? item.empty }}
                                    </dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </section>

                    {# Contact #}
                    <section
                            class="rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
                        <div class="flex items-center gap-2 border-b border-secondary-100 px-5 py-4 dark:border-secondary-800">
                            <twig:UX:Icon name="icon:phone" class="h-4 w-4 text-cyan-600 dark:text-cyan-400"/>
                            <h2 class="text-sm font-black uppercase tracking-widest text-secondary-500 dark:text-secondary-400">
                                Contact
                            </h2>
                        </div>
                        <dl class="divide-y divide-secondary-100 dark:divide-secondary-800">
                            {% if composante.adresse %}
                                <div class="px-5 py-3">
                                    <dt class="mb-0.5 text-xs font-semibold uppercase tracking-wide text-secondary-400 dark:text-secondary-500">
                                        Adresse
                                    </dt>
                                    <dd class="text-sm text-secondary-700 dark:text-secondary-300">{{ composante.adresse.display|raw }}</dd>
                                </div>
                            {% endif %}
                            {% if composante.telStandard %}
                                <div class="flex items-center gap-3 px-5 py-3">
                                    <twig:UX:Icon name="icon:phone" class="h-4 w-4 shrink-0 text-secondary-400"/>
                                    <span class="text-sm text-secondary-700 dark:text-secondary-300">{{ composante.telStandard|tel_format }}</span>
                                </div>
                            {% endif %}
                            {% if composante.telComplementaire %}
                                <div class="flex items-center gap-3 px-5 py-3">
                                    <twig:UX:Icon name="icon:phone" class="h-4 w-4 shrink-0 text-secondary-400"/>
                                    <span class="text-sm text-secondary-500 dark:text-secondary-400">{{ composante.telComplementaire|tel_format }}</span>
                                </div>
                            {% endif %}
                            {% if composante.mailContact %}
                                <div class="flex items-center gap-3 px-5 py-3">
                                    <twig:UX:Icon name="icon:mail" class="h-4 w-4 shrink-0 text-secondary-400"/>
                                    <span class="text-sm text-secondary-700 dark:text-secondary-300">{{ composante.mailContact|mailto }}</span>
                                </div>
                            {% endif %}
                            {% if composante.urlSite %}
                                <div class="flex items-center gap-3 px-5 py-3">
                                    <twig:UX:Icon name="icon:link" class="h-4 w-4 shrink-0 text-secondary-400"/>
                                    <span class="text-sm text-secondary-700 dark:text-secondary-300">{{ composante.urlSite|open_url }}</span>
                                </div>
                            {% endif %}
                        </dl>
                    </section>

                    {# ── Processus Onglet 1 : Formations accréditées (Validation post-conseil + dépôt PV) ─────────────── #}
                    <div data-tabs-target="panel" data-panel-id="formations-accreditees">
                        <section
                                class="rounded-2xl border border-indigo-200 bg-indigo-50/60 shadow-sm dark:border-indigo-800 dark:bg-indigo-950/20">
                            <div class="flex items-center gap-2 border-b border-indigo-200 px-5 py-4 dark:border-indigo-800">
                                <twig:UX:Icon name="icon:check-circle"
                                              class="h-4 w-4 text-indigo-600 dark:text-indigo-400"/>
                                <h2 class="text-sm font-black uppercase tracking-widest text-indigo-700 dark:text-indigo-300">
                                    Validation post-conseil
                                </h2>
                            </div>
                            <div class="space-y-4 p-5">
                                <p class="text-xs text-secondary-600 dark:text-secondary-400">
                                    Sélectionnez les formations accréditées concernées dans le tableau, renseignez la
                                    date du conseil,
                                    puis déposez éventuellement le procès-verbal avant de valider.
                                </p>

                                {# Compteur de sélection #}
                                <div class="flex items-center gap-2 rounded-xl border border-indigo-200 bg-white px-3 py-2 text-sm dark:border-indigo-700 dark:bg-secondary-900">
                                    <twig:UX:Icon name="icon:check" class="h-4 w-4 text-indigo-500"/>
                                    <span class="text-secondary-500 dark:text-secondary-400">Sélection :</span>
                                    <span class="total font-semibold text-indigo-700 dark:text-indigo-300"
                                          data-check-all-counter="check-all-accreditees">0 / {{ formationsAccreditees|length }} formation(s)</span>
                                </div>

                                {# Date du conseil #}
                                <div class="space-y-1.5">
                                    <label for="date"
                                           class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-secondary-600 dark:text-secondary-400">
                                        {{ ('valide.conseil.date.label')|trans({}, 'process') }}
                                        <span class="text-red-500">*</span>
                                        <i class="fal fa-question-circle text-secondary-400"
                                           data-controller="tooltip"
                                           data-tooltip-placement-value="bottom"
                                           aria-label="{{ ('valide.conseil.helps.date.help')|trans({}, 'process') }}"></i>
                                    </label>
                                    <input type="date" name="date" id="date"
                                           class="w-full rounded-xl border border-secondary-200 bg-white px-3 py-2 text-sm text-secondary-800 shadow-sm transition focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-indigo-600">
                                </div>

                                {# Dépôt PV (PDF) #}
                                <div class="space-y-1.5">
                                    <label for="file"
                                           class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-secondary-600 dark:text-secondary-400">
                                        {{ ('valide.conseil.fichier.label')|trans({}, 'process') }}
                                        <i class="fal fa-question-circle text-secondary-400"
                                           data-controller="tooltip"
                                           data-tooltip-placement-value="bottom"
                                           aria-label="{{ ('valide.conseil.helps.fichier.help')|trans({}, 'process') }}"></i>
                                    </label>
                                    <label for="file"
                                           class="flex cursor-pointer flex-col items-center gap-2 rounded-xl border-2 border-dashed border-indigo-200 bg-white px-4 py-4 text-center text-sm text-secondary-500 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-indigo-800 dark:bg-secondary-900 dark:hover:bg-indigo-950/30">
                                        <twig:UX:Icon name="icon:upload" class="h-6 w-6 text-indigo-400"/>
                                        <span>Déposer ou sélectionner un PDF</span>
                                        <input type="file" name="file" id="file" accept="application/pdf"
                                               class="sr-only">
                                    </label>
                                </div>

                                {# Bouton submit #}
                                <button type="button"
                                        class="app-btn app-btn-success w-full justify-center"
                                        {{ stimulus_action('composante--gestion', 'valideConseil', null, { selector: '.check-accreditees:checked' }) }}>
                                    <twig:UX:Icon name="icon:save" class="h-4 w-4"/>
                                    <span>Valider post-conseil et transmettre le PV</span>
                                </button>
                            </div>
                        </section>
                    </div>

                    {# ── Processus Onglet 2 : Formations non accréditées (Processus établissement) ─────────────── #}
                    <div data-tabs-target="panel" data-panel-id="formations-non-accreditees" class="hidden">
                        <section
                                class="rounded-2xl border border-amber-200 bg-amber-50/60 shadow-sm dark:border-amber-800 dark:bg-amber-950/20">
                            <div class="flex items-center gap-2 border-b border-amber-200 px-5 py-4 dark:border-amber-800">
                                <twig:UX:Icon name="ph:buildings-bold"
                                              class="h-4 w-4 text-amber-600 dark:text-amber-400"/>
                                <h2 class="text-sm font-black uppercase tracking-widest text-amber-700 dark:text-amber-300">
                                    Processus établissement
                                </h2>
                            </div>
                            <div class="space-y-4 p-5">
                                <p class="text-xs text-secondary-600 dark:text-secondary-400">
                                    Sélectionnez les formations d'établissement concernées dans le tableau. Ces
                                    formations non accréditées (DU, DIU, certificats, etc.) suivent le circuit de
                                    validation propre à l'établissement.
                                </p>

                                {# Compteur de sélection #}
                                <div class="flex items-center gap-2 rounded-xl border border-amber-200 bg-white px-3 py-2 text-sm dark:border-amber-700 dark:bg-secondary-900">
                                    <twig:UX:Icon name="icon:check" class="h-4 w-4 text-amber-500"/>
                                    <span class="text-secondary-500 dark:text-secondary-400">Sélection :</span>
                                    <span class="total font-semibold text-amber-700 dark:text-amber-300"
                                          data-check-all-counter="check-all-non-accreditees">0 / {{ formationsNonAccreditees|length }} formation(s)</span>
                                </div>

                                {# Date de l'instance / conseil établissement #}
                                <div class="space-y-1.5">
                                    <label for="date_etablissement"
                                           class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-secondary-600 dark:text-secondary-400">
                                        Date de la validation d'établissement
                                        <span class="text-red-500">*</span>
                                    </label>
                                    <input type="date" name="date_etablissement" id="date_etablissement"
                                           class="w-full rounded-xl border border-secondary-200 bg-white px-3 py-2 text-sm text-secondary-800 shadow-sm transition focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-200 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:focus:border-amber-600">
                                </div>

                                {# Dépôt PV / délibération établissement (PDF) #}
                                <div class="space-y-1.5">
                                    <label for="file_etablissement"
                                           class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-secondary-600 dark:text-secondary-400">
                                        Procès-verbal / délibération (optionnel)
                                    </label>
                                    <label for="file_etablissement"
                                           class="flex cursor-pointer flex-col items-center gap-2 rounded-xl border-2 border-dashed border-amber-200 bg-white px-4 py-4 text-center text-sm text-secondary-500 transition hover:border-amber-400 hover:bg-amber-50/50 dark:border-amber-800 dark:bg-secondary-900 dark:hover:bg-amber-950/30">
                                        <twig:UX:Icon name="icon:upload" class="h-6 w-6 text-amber-400"/>
                                        <span>Déposer ou sélectionner un PDF</span>
                                        <input type="file" name="file_etablissement" id="file_etablissement"
                                               accept="application/pdf" class="sr-only">
                                    </label>
                                </div>

                                {# Bouton submit #}
                                <button type="button"
                                        class="app-btn app-btn-warning w-full justify-center"
                                        {{ stimulus_action('composante--gestion', 'valideEtablissement', null, { selector: '.check-non-accreditees:checked' }) }}>
                                    <twig:UX:Icon name="icon:save" class="h-4 w-4"/>
                                    <span>Valider les formations d'établissement</span>
                                </button>
                            </div>
                        </section>
                    </div>

                </div>{# fin colonne gauche #}

                {# ════════════ Colonne droite (2/3) ════════════ #}
                <div class="xl:col-span-2">

                    {# Panel Formations accréditées #}
                    <div data-tabs-target="panel" data-panel-id="formations-accreditees">
                        {{ include('composante/_formations_table.html.twig', {
                            title: 'Formations accréditées',
                            iconName: 'icon:award',
                            formations: formationsAccreditees,
                            idCheckAll: 'check-all-accreditees',
                            classCheck: 'check-accreditees',
                            nameInput: 'formations[]',
                            emptyMessage: "Aucune formation accréditée n'est rattachée à cette composante."
                        }) }}
                    </div>

                    {# Panel Formations non accréditées (établissement) #}
                    <div data-tabs-target="panel" data-panel-id="formations-non-accreditees" class="hidden">
                        {{ include('composante/_formations_table.html.twig', {
                            title: 'Formations d\'établissement (non accréditées)',
                            iconName: 'ph:buildings-bold',
                            formations: formationsNonAccreditees,
                            idCheckAll: 'check-all-non-accreditees',
                            classCheck: 'check-non-accreditees',
                            nameInput: 'formations_etablissement[]',
                            emptyMessage: "Aucune formation non accréditée / d'établissement n'est rattachée à cette composante."
                        }) }}
                    </div>

                </div>{# fin colonne droite #}

            </div>{# fin grille principale #}
        </div>{# fin app-tabs #}
    </div>
{% endblock %}

{% block bouton_header %}{% endblock %}
