<section
        class="rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-secondary-100 px-5 py-4 dark:border-secondary-800">
        <div class="flex items-center gap-2">
            <twig:UX:Icon name="{{ iconName|default('icon:graduation') }}"
                          class="h-4 w-4 text-cyan-600 dark:text-cyan-400"/>
            <h2 class="text-sm font-black uppercase tracking-widest text-secondary-500 dark:text-secondary-400">
                {{ title }}
            </h2>
        </div>
        <span class="rounded-full border border-secondary-200 bg-secondary-50 px-2.5 py-0.5 text-xs font-semibold text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">
            {{ formations|length }} formation{{ formations|length > 1 ? 's' : '' }}
        </span>
    </div>

    {# Tableau des formations #}
    <div class="overflow-x-auto"
            {{ stimulus_controller('check_all', {
                idCheckAll: idCheckAll,
                classCheckAll: '.' ~ classCheck
            }) }}>

        {# Toolbar de sélection #}
        <div class="flex items-center gap-3 border-b border-secondary-100 bg-secondary-50/80 px-5 py-2.5 text-sm dark:border-secondary-800 dark:bg-secondary-950/30">
            <label class="flex cursor-pointer items-center gap-2 font-medium text-secondary-600 dark:text-secondary-400">
                <input type="checkbox"
                       id="{{ idCheckAll }}"
                        {{ stimulus_action('check_all', 'checkAll', null, { idcheckall: idCheckAll, classcheckall: classCheck }) }}
                       class="h-4 w-4 rounded border-secondary-300 text-indigo-600 accent-indigo-600 focus:ring-indigo-500 dark:border-secondary-600">
                <span>Tout sélectionner</span>
            </label>
            <span class="total text-xs text-secondary-400 dark:text-secondary-500"
                  data-check-all-counter="{{ idCheckAll }}"></span>
        </div>

        <table class="w-full min-w-[600px] text-sm">
            <thead>
            <tr class="border-b border-secondary-100 bg-secondary-50/50 text-[11px] font-black uppercase tracking-[0.16em] text-secondary-400 dark:border-secondary-800 dark:bg-secondary-950/20 dark:text-secondary-500">
                <th class="w-10 px-4 py-3 text-center"></th>
                <th class="px-4 py-3 text-left">Type</th>
                <th class="px-4 py-3 text-left">Mention</th>
                <th class="px-4 py-3 text-center">État</th>
                <th class="px-4 py-3 text-center">Parcours</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-secondary-100 dark:divide-secondary-800">
            {% for formation in formations %}
                <tr class="group transition hover:bg-secondary-50/80 dark:hover:bg-secondary-800/50">
                    {# Checkbox #}
                    <td class="px-4 py-3 text-center">
                        <input
                                {{ stimulus_action('check_all', 'check', null, { idcheckall: idCheckAll, classcheckall: classCheck }) }}
                                type="checkbox"
                                class="{{ classCheck }} h-4 w-4 rounded border-secondary-300 text-indigo-600 accent-indigo-600 focus:ring-indigo-500 dark:border-secondary-600"
                                name="{{ nameInput|default('formations[]') }}"
                                value="{{ formation.id }}"
                        >
                    </td>
                    {# Type diplôme #}
                    <td class="px-4 py-3">
                        <span class="inline-flex rounded-lg bg-secondary-100 px-2 py-0.5 text-xs font-semibold text-secondary-600 dark:bg-secondary-800 dark:text-secondary-300">
                            {{ formation.typeDiplome ? formation.typeDiplome.libelle : '—' }}
                        </span>
                    </td>
                    {# Mention #}
                    <td class="px-4 py-3 font-medium text-secondary-800 dark:text-secondary-200">
                        {{ formation.mention ? formation.mention.libelle : (formation.mentionTexte|default('—')) }}
                    </td>
                    {# État DPE #}
                    <td class="px-4 py-3 text-center">
                        <div class="flex flex-wrap justify-center gap-1">
                            {{ include('communs/_badge_collection.html.twig', { badges: formation.etatDpe|badgeDpeDto }) }}
                        </div>
                    </td>
                    {# Nb parcours #}
                    <td class="px-4 py-3 text-center">
                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-secondary-100 text-xs font-bold text-secondary-600 dark:bg-secondary-800 dark:text-secondary-300">
                            {{ formation.parcours|length }}
                        </span>
                    </td>
                    {# Actions #}
                    <td class="px-4 py-3 text-right">
                        <a href="{{ path('formation_v2_voir', {slug: formation.slug}) }}"
                           class="app-btn app-btn-neutral text-xs">
                            <twig:UX:Icon name="icon:eye" class="h-3.5 w-3.5"/>
                            <span>Voir</span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6"
                        class="px-5 py-8 text-center text-sm text-secondary-400 dark:text-secondary-500">
                        <twig:UX:Icon name="icon:inbox" class="mx-auto mb-2 h-8 w-8 opacity-40"/>
                        <p>{{ emptyMessage|default("Aucune formation n'est rattachée à cette composante.") }}</p>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
