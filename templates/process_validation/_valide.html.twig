{{ component('alerte', {
    type: 'info',
    message: (process.label~'.valide.alerte')|trans({}, 'process')|nl2br|raw
}) }}

<form id="modal_form"
      action="{{ path('app_validation_valider', {etape:etape, type:type, id:id, transition: transition}) }}"
      method="post"
      enctype="multipart/form-data"
      class="space-y-4"
>

    {% if meta.hasValidLheo is defined and meta.hasValidLheo == true %}
        <a href="{{ path('app_parcours_export_xml_lheo', {'parcours': objet.id}) }}">
            <span class="mt-4 badge {{ validLheo ? 'bg-success' : 'bg-danger' }}">
                {{ validLheo ? 'Export LHEO valide' : 'Export LHEO invalide' }}
            </span>
        </a>
        {% if xmlErrorArray|length > 0 %}
            <div class="alert alert-danger mt-2">
                <ul>
                    {% for xmlError in xmlErrorArray %}
                        <li>{{ xmlError }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endif %}

    {% if meta.hasDate is defined and meta.hasDate == true %}
        <div class="space-y-1">
            <div class="flex justify-between items-center mb-1">
                <label for="date" class="text-[12px] font-black text-secondary-500 uppercase">
                    {{ ('valide.'~process.label~'.date.label')|trans({}, 'process') }}
                </label>
                <span class="text-[10px] font-bold text-red-300 uppercase">Champs Requis</span>
            </div>
            <input type="date" name="date" class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700" id="date" required>
        </div>
    {% endif %}

    {% if process.check is defined and process.check == true %}
        {{ include('process_validation/'~process.templateCheck) }}
    {% endif %}

    {% if etape == 'soumis_cfvu' %}
        {# regarder si dans l'historique on à un laissez-passer sur le conseil  #}
        {% if laisserPasser is defined and laisserPasser != false %}
            {% if laisserPasser.etat == 'laisserPasser' %}
                {{ component('alerte', {type:'warning', message: 'Un laissez-passer a été demandé le '~laisserPasser.created|date('d/m/Y')~'.'}) }}
            {% else %}
                <a
                        href="{{ path('app_upload_download', {context: 'conseils', filename: laisserPasser.complements.fichier, originalName: laisserPasser.complements.fichier_original|default(laisserPasser.complements.fichier)}) }}"
                        target="_blank"
                        class="mt-1 flex items-center gap-1 text-indigo-600 hover:underline font-semibold"
                >
                    <i class="{{ iconDownload }}"></i>
                    <span> {{ 'voir.le.pv'|trans({}, 'process') }}</span>
                </a>
            {% endif %}
        {% endif %}

        <div class="space-y-2">
            <label class="flex items-start gap-3 cursor-pointer">
                <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="radio" value="acceptationDirecte" id="acceptationDirecte"
                        {% if laisserPasser is defined and laisserPasser != false and laisserPasser.etat == "valide" %} checked {% endif %}
                       name="acceptationDirecte">
                <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                    {{ (process.label~'.valide.cas.acceptation.directe.'~processData.placeTexte)|trans({}, 'process') }}
                </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
                <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="radio" value="acceptationNonDirecte" id="acceptationNonDirecte"
                        {% if laisserPasser is defined and laisserPasser != false and laisserPasser.etat == "laisserPasser" %} checked {% endif %}
                       name="acceptationDirecte">
                <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                    {{ (process.label~'.valide.cas.acceptation.non.directe.'~processData.placeTexte)|trans({}, 'process') }}
                </span>
            </label>
        </div>

        <div class="pl-7 space-y-2 border-l border-secondary-200 ml-2 mt-2">
            <label class="flex items-start gap-3 cursor-pointer">
                <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="checkbox" value="true" id="sousReserveConseil"
                        {% if laisserPasser is defined and laisserPasser != false and laisserPasser.etat == "laisserPasser" %} checked {% endif %}
                       name="sousReserveConseil">
                <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                    {{ (process.label~'.valide.cas.sous.reserve.conseil.'~processData.placeTexte)|trans({}, 'process') }}
                </span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
                <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="checkbox" value="true" id="sousReserveModifications"
                       name="sousReserveModifications">
                <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                    {{ (process.label~'.valide.cas.sous.reserve.modifications.'~processData.placeTexte)|trans({}, 'process') }}
                </span>
            </label>
        </div>

        <div class="space-y-1">
            <label for="argumentaire_sousReserveModifications" class="text-[12px] font-black text-secondary-500 uppercase">
                {{ (process.label~'.valide.commentaire.cas.sous.reserve.modifications.argumentaire.'~processData.placeTexte)|trans({}, 'process') }}
            </label>
            <textarea name="argumentaire_sousReserveModifications"
                      class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm min-h-[120px] placeholder:text-secondary-400 dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700"
                      id="argumentaire_sousReserveModifications"
                      rows="4"
            ></textarea>
        </div>

    {% endif %}

    {% if meta.hasUpload is defined and meta.hasUpload == true %}
        <div class="space-y-2">
            <div class="flex justify-between items-center mb-1">
                <label class="text-[12px] font-black text-secondary-500 uppercase">
                    {{ ('valide.'~process.label~'.fichier.label')|trans({}, 'process') }}
                </label>
            </div>

            {% if existingPvs is defined and existingPvs|length > 0 %}
                <div class="mb-3">
                    <label for="pv_id" class="block text-[11px] font-semibold text-secondary-400 uppercase mb-1">
                        Ou sélectionner un PV déjà déposé pour cette composante :
                    </label>
                    <select name="pv_id" id="pv_id" 
                            onchange="document.getElementById('file_upload_wrapper').style.display = this.value ? 'none' : 'block'"
                            class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700">
                        <option value="">-- Téléverser un nouveau PV --</option>
                        {% for pv in existingPvs %}
                            <option value="{{ pv.id }}">{{ pv.originalFilename }} (déposé le {{ pv.uploadedAt|date('d/m/Y') }}{% if pv.uploadedBy %} par {{ pv.uploadedBy.username }}{% endif %})</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div id="file_upload_wrapper" class="space-y-2">
                <input type="file" name="file" id="file" accept="application/pdf" class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700">
                
                {% if type == 'formation' and otherFormations is defined and otherFormations|length > 1 %}
                    <div class="p-3 bg-secondary-50 border border-secondary-200 rounded-xl dark:bg-secondary-800/40 dark:border-secondary-700">
                        <span class="block text-xs font-black text-secondary-500 uppercase mb-2">Partager également ce PV avec les formations de la composante :</span>
                        <div class="max-h-32 overflow-y-auto space-y-2">
                            {% for otherF in otherFormations %}
                                <label class="flex items-start gap-3 cursor-pointer">
                                    <input type="checkbox" name="formations_pv[]" value="{{ otherF.id }}" id="share_pv_{{ otherF.id }}" class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" {% if otherF.id == id %}checked disabled{% endif %}>
                                    <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                                        {{ otherF.displayLong }}
                                        {% if otherF.id == id %} <span class="text-xs font-semibold text-indigo-500">(Formation actuelle)</span>{% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            <label class="flex items-start gap-3 cursor-pointer">
                <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="checkbox" value="laisserPasser" id="laisserPasser" name="laisserPasser">
                <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                    {{ ('valide.'~process.label~'.helps.laisserPasser.texte')|trans({}, 'process') }}
                </span>
            </label>
        </div>
    {% endif %}

    {% if meta.hasUploadNote is defined and meta.hasUploadNote == true %}
        <div class="space-y-2">
            <div class="flex justify-between items-center mb-1">
                <label class="text-[12px] font-black text-secondary-500 uppercase">
                    {{ ('valide.'~process.label~'.note_explicative.label')|trans({}, 'process') }}
                </label>
            </div>

            {% if existingNotes is defined and existingNotes|length > 0 %}
                <div class="mb-3">
                    <label for="note_id" class="block text-[11px] font-semibold text-secondary-400 uppercase mb-1">
                        Ou sélectionner une note explicative déjà déposée pour cette composante :
                    </label>
                    <select name="note_id" id="note_id" 
                            onchange="document.getElementById('note_upload_wrapper').style.display = this.value ? 'none' : 'block'"
                            class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700">
                        <option value="">-- Téléverser une nouvelle note --</option>
                        {% for note in existingNotes %}
                            <option value="{{ note.id }}">{{ note.originalFilename }} (déposée le {{ note.uploadedAt|date('d/m/Y') }}{% if note.uploadedBy %} par {{ note.uploadedBy.username }}{% endif %})</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div id="note_upload_wrapper" class="space-y-2">
                <input type="file" name="fileNote" id="fileNote" accept="application/pdf" class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700">
                <p class="text-xs text-secondary-500">Un modèle de note explicative est disponible ici : <a href="{{ asset('modeles/note_explicative.docx') }}" class="text-indigo-600 hover:underline font-semibold" target="_blank">Télécharger le modèle</a></p>
                
                {% if type == 'formation' and otherFormations is defined and otherFormations|length > 1 %}
                    <div class="p-3 bg-secondary-50 border border-secondary-200 rounded-xl dark:bg-secondary-800/40 dark:border-secondary-700">
                        <span class="block text-xs font-black text-secondary-500 uppercase mb-2">Partager également cette Note avec les formations de la composante :</span>
                        <div class="max-h-32 overflow-y-auto space-y-2">
                            {% for otherF in otherFormations %}
                                <label class="flex items-start gap-3 cursor-pointer">
                                    <input type="checkbox" name="formations_note[]" value="{{ otherF.id }}" id="share_note_{{ otherF.id }}" class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" {% if otherF.id == id %}checked disabled{% endif %}>
                                    <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                                        {{ otherF.displayLong }}
                                        {% if otherF.id == id %} <span class="text-xs font-semibold text-indigo-500">(Formation actuelle)</span>{% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</form>
