{{ component('alerte', {
    type: 'info',
    message: ('demande.reouverture.annuler.alerte')|trans({}, 'process')|nl2br|raw
}) }}

<form action="{{ path('app_validation_demande_reouverture_cloture', {parcours:parcours.id}) }}" method="post"
      enctype="multipart/form-data">
    <input type="hidden" name="action" id="cloture_action" value="{{ hasDifferences ? 'soumettre' : 'annuler' }}">

    {% if hasDifferences %}
        <twig:alerte type="warning"
                     message="Des différences existent entre la version actuelle et la version précédente."/>

        <p class="mt-2 font-medium">Les différences portent sur les champs suivants :</p>
        <ul class="list-disc list-inside text-sm text-secondary-700 dark:text-secondary-300">
            {% for key, diff in stringDifferencesParcours|filter(diff => diff != null) %}
                <li>{{ key|trans({}, 'process') }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <twig:alerte type="success"
                     message="Aucune différence n'a été détectée entre la version actuelle et la version précédente. Vous pouvez clôturer la réouverture sans modification (l'état initial sera restauré sans relancer les processus de validation)."/>
    {% endif %}

    <div class="mt-3 rounded-lg border border-secondary-200 bg-secondary-50 p-2.5 text-xs text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800/60 dark:text-secondary-300">
        <i class="fal fa-info-circle mr-1"></i>
        État restauré en cas d'annulation ou sans modification :
        <strong class="text-secondary-800 dark:text-secondary-100">{{ targetState == 'tacite_reconduction' ? 'Tacite reconduction' : 'Publié' }}</strong>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
        {% if hasDifferences %}
            <twig:Button
                    type="submit"
                    variant="primary"
                    :soft="false"
                    size="md"
                    icon="icon:paper-plane"
                    label="{{ (type_modif == 'MODIFICATION_TEXTE' ? 'btn.demande.reouverture.cloture.sans_cfvu.ses' : 'btn.demande.reouverture.cloture.ses')|trans({}, 'process') }}"
                    onclick="document.getElementById('cloture_action').value='soumettre';"
            />
            <twig:Button
                    type="submit"
                    variant="danger"
                    :soft="false"
                    size="md"
                    icon="icon:close"
                    label="Annuler la réouverture (annuler les modifications)"
                    onclick="document.getElementById('cloture_action').value='annuler';"
            />
        {% else %}
            <twig:Button
                    type="submit"
                    variant="success"
                    :soft="false"
                    size="md"
                    icon="icon:check"
                    label="Clôturer la réouverture (aucune modification)"
                    onclick="document.getElementById('cloture_action').value='annuler';"
            />
        {% endif %}
    </div>
</form>
