{{ component('alerte', {
    type: 'warning',
    message: (process.label~'.reserve.alerte')|trans({}, 'process')|nl2br|raw
}) }}

<form id="modal_form" action="{{ path('app_validation_reserver', {etape:etape, type:type, id:id, transition: transition}) }}" method="post" class="space-y-4">
    {% if meta.hasDate is defined and meta.hasDate == true %}
        <div class="space-y-1">
            <div class="flex justify-between items-center mb-1">
                <label for="date" class="text-[12px] font-black text-secondary-500 uppercase">
                    {{ ('reserve.'~process.label~'.date.label')|trans({}, 'process') }}
                </label>
                <span class="text-[10px] font-bold text-red-300 uppercase">Champs Requis</span>
            </div>
            <input type="date" name="date"
                   class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700"
                   required
                   id="date"
                   value="{{ 'now'|date('Y-m-d') }}">
        </div>
    {% endif %}

    <div class="space-y-1">
        <div class="flex justify-between items-center mb-1">
            <label for="argumentaire" class="text-[12px] font-black text-secondary-500 uppercase">
                {{ ('reserve.'~process.label~'.argumentaire.label')|trans({}, 'process') }}
            </label>
            <span class="text-[10px] font-bold text-red-300 uppercase">Champs Requis</span>
        </div>
        <textarea name="argumentaire"
                  class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm min-h-[150px] placeholder:text-secondary-400 dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700"
                  required
                  id="argumentaire"
                  rows="5"
        ></textarea>
    </div>

    {% if meta.hasReserve is defined and meta.hasReserve is iterable %}
        {% for cas in process.hasReserve %}
            <div class="space-y-3 p-3 bg-secondary-50 border border-secondary-200 rounded-xl dark:bg-secondary-800/40 dark:border-secondary-700">
                <label class="flex items-start gap-3 cursor-pointer">
                    <input class="mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600 text-indigo-600 focus:ring-indigo-500" type="checkbox" value="" id="{{ cas }}">
                    <span class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                        {{ ('reserve.'~process.label~'.helps.'~cas~'.'~processData.placeTexte~'.label')|trans({}, 'process')}}
                    </span>
                </label>
                
                <div class="space-y-1">
                    <label for="argumentaire_{{ cas }}" class="text-[12px] font-black text-secondary-500 uppercase">
                        {{ (process.label~'.reserve.commentaire.cas.'~cas~'.'~processData.placeTexte)|trans({}, 'process') }}
                    </label>
                    <textarea name="argumentaire_{{ cas }}"
                              class="w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm min-h-[100px] placeholder:text-secondary-400 dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700"
                              required
                              id="argumentaire_{{ cas }}"
                              rows="3"
                    ></textarea>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</form>
