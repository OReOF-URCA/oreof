{{ component('alerte', {
    type: 'info',
    message: ('demande.reouverture.annuler.alerte')|trans({}, 'process')|nl2br|raw
}) }}

<form action="{{ path('app_validation_demande_reouverture_cloture_mention', {formation: formation.id}) }}" method="post"
      enctype="multipart/form-data">
    <input type="hidden" name="action" value="annuler">

    {% if hasDifferences %}
        <twig:alerte type="warning"
                     message="Des modifications ont été apportées depuis la réouverture de la mention. L'annulation rétablira l'état initial et annulera l'ensemble de ces modifications."/>

        <p class="mt-2 font-medium">Les champs suivants ont été modifiés et seront réinitialisés :</p>
        <ul class="list-disc list-inside text-sm text-secondary-700 dark:text-secondary-300">
            {% for key, diff in stringDifferencesParcours|filter(diff => diff is not empty) %}
                <li>{{ key|trans({}, 'process') }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <twig:alerte type="success"
                     message="Aucune modification n'a été détectée depuis la réouverture de la mention. L'annulation rétablira directement l'état initial sans relancer de circuit de validation."/>
    {% endif %}

    <div class="mt-3 rounded-lg border border-secondary-200 bg-secondary-50 p-2.5 text-xs text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800/60 dark:text-secondary-300">
        <i class="fal fa-info-circle mr-1"></i>
        État restauré :
        <strong class="text-secondary-800 dark:text-secondary-100">{{ targetState == 'tacite_reconduction' ? 'Tacite reconduction' : 'Publié' }}</strong>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
        <twig:Button
                type="submit"
                variant="danger"
                :soft="false"
                size="md"
                icon="icon:close"
                label="Annuler la réouverture"
        />
    </div>
</form>
