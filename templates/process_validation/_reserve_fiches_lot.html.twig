{{ component('alerte', {
    type: 'warning',
    message: (process.label|default(etape)~'.reserve.alerte')|trans({}, 'process')|nl2br|raw
}) }}

<form action="{{ path('app_validation_reserve_fiche_lot', {etape:etape}) }}" method="post">
    <input type="hidden" name="fiches" value="{{ sFiches }}">

    {% if process.hasDate is defined and process.hasDate %}
    <div>
        <label for="date" class="form-label">{{ ('reserve.'~process.label|default(etape)~'.date.label')|trans({}, 'process') }} <span class="required"></span> <i class="fal fa-question-circle ms-1"
                                  data-controller="tooltip"
                                  data-tooltip-placement-value="bottom"
                                  aria-label="{{ ('reserve.'~process.label|default(etape)~'.helps.date.help')|trans({}, 'process') }}"
                                  data-bs-original-title="{{ ('reserve.'~process.label|default(etape)~'.helps.date.help')|trans({}, 'process') }}"></i></label>
        <input type="date" name="date"
               class="form-control"
               required
               id="date"
               value="{{ 'now'|date('Y-m-d') }}">
    </div>
{% endif %}

<div>
    <label for="argumentaire" class="form-label">{{ ('reserve.'~process.label|default(etape)~'.argumentaire.label')|trans({}, 'process') }} <span class="required"></span><i class="fal fa-question-circle ms-1"
                                              data-controller="tooltip"
                                              data-tooltip-placement-value="bottom"
                                              aria-label="{{ ('reserve.'~process.label|default(etape)~'.helps.argumentaire.help')|trans({}, 'process') }}"
                                              data-bs-original-title="{{ ('reserve.'~process.label|default(etape)~'.helps.argumentaire.help')|trans({}, 'process') }}"></i></label>
    <textarea name="argumentaire"
              class="form-control"
              required
              id="argumentaire"
              rows="5"
    > </textarea>
</div>

{% if process.hasReserve is defined and process.hasReserve is iterable %}
    {% for cas in process.hasReserve %}
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="" id="{{ cas }}">
            <label class="form-check-label" for="{{ cas }}">
                {{ ('reserve.'~process.label|default(etape)~'.helps.'~cas~'.'~processData.placeTexte)|trans({}, 'process')}} <i
                        class="fal fa-question-circle ms-1"
                        data-controller="tooltip"
                        data-tooltip-placement-value="bottom"
                        aria-label="{{ ('reserve.'~process.label|default(etape)~'.helps.'~cas~'.'~processData.placeTexte~'.help')|trans({}, 'process') }}"
                        data-bs-original-title="{{ ('reserve.'~process.label|default(etape)~'.helps.'~cas~'.'~processData.placeTexte~'.help')|trans({}, 'process') }}"></i>
            </label>
        </div>
        <div>
            <label for="argumentaire_{{ cas }}" class="form-label"> {{ (process.label|default(etape)~'.reserve.commentaire.cas.'~cas~'.'~processData.placeTexte)|trans({}, 'process') }} <span class="required"></span>
                <i class="fal fa-question-circle ms-1"
                   data-controller="tooltip"
                   data-tooltip-placement-value="bottom"
                   aria-label="{{ (process.label|default(etape)~'.reserve.helps.commentaire.cas.'~cas~'.'~processData.placeTexte)|trans({}, 'process') }}"
                   data-bs-original-title="{{ (process.label|default(etape)~'.reserve.helps.commentaire.cas.'~cas~'.'~processData.placeTexte)|trans({}, 'process') }}"></i>
            </label>
            <textarea name="argumentaire_{{ cas }}"
                      class="form-control"
                      required
                      id="argumentaire_{{ cas }}"
                      rows="5"
            > </textarea>
        </div>
    {% endfor %}
{% endif %}

<div class="mt-2">
    <button type="submit" class="btn btn-success">
        <i class="fal fa-floppy-disk"></i>
        {{ ('btn.'~process.label|default(etape)~'.reserve')|trans({}, 'process') }}
    </button>
</div>
</form>
