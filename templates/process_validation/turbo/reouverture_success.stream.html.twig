{# Rafraîchissement direct de l'en-tête du parcours si présent sur la page #}
{% if parcours is defined and parcours is not null %}
    <turbo-stream action="replace" target="parcours_header_component">
        <template>
            <div id="parcours_header_component">
                <twig:ParcoursHeader
                        parcoursId="{{ parcours.id }}"
                        formationId="{{ parcours.formation.id }}"
                />
            </div>
        </template>
    </turbo-stream>

    <turbo-stream action="replace" target="parcours_voir_actions">
        <template>
            {{ include('parcours_v2/_voir_actions.html.twig', {parcours: parcours, dpeParcours: dpeParcours|default(null)}) }}
        </template>
    </turbo-stream>
{% endif %}

{# Affichage du toast standard unifié (Tailwind / Stimulus dans #flash_toasts) #}
{{ include('_ui/_toast.stream.html.twig', {
    message: message|default('DPE ouvert'),
    undo: null,
    type: 'success'
}) }}

{# Fermeture propre de la modal #}
{{ include('_ui/_force_close_modal.html.twig') }}

{# Redirection vers l'édition du parcours #}
<turbo-stream action="append" target="flash_toasts">
    <template>
        <script>
            (function () {
                const targetUrl = "{{ redirectUrl }}";
                if (window.Turbo && typeof window.Turbo.visit === 'function') {
                    window.Turbo.visit(targetUrl, {action: 'advance'});
                } else {
                    window.location.href = targetUrl;
                }
            })();
        </script>
    </template>
</turbo-stream>
