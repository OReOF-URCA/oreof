{% if item.niveauDemande == 'F' %}
    <div class="space-y-1">
        {{ component('Badge', { label: 'Mention', variant: 'info' }) }}
        <p class="text-sm text-secondary-600 dark:text-secondary-300">Demande au niveau de la formation</p>
    </div>
{% else %}
    <span class="font-medium text-secondary-700 dark:text-secondary-200">{{ item.parcours != null ? item.parcours.libelle : '-' }}</span>
{% endif %}

