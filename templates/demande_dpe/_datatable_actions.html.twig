<div class="flex flex-wrap justify-end gap-2">
    {% if item.niveauDemande == 'F' %}
        <twig:Button
                href="{{ path('formation_v2_voir', {slug: item.formation.slug}) }}"
                target="_blank"
                rel="noopener noreferrer"
                variant="info"
                size="sm"
                icon="icon:info"
                label="Voir"
                tooltip="Voir la formation"
                :centered="false"
        />
    {% else %}
        <twig:Button
                href="{{ path('parcours_v2_voir', {parcours: item.parcours.id}) }}"
                target="_blank"
                rel="noopener noreferrer"
                variant="info"
                size="sm"
                icon="icon:info"
                label="Voir"
                tooltip="Voir le parcours"
                :centered="false"
        />
    {% endif %}

        {% set dropdownItems = [
                {
                        label: 'Modifier',
                        icon: 'icon:edit',
                        color: 'warning',
                        url: path('app_demande_dpe_edit', {'id': item.id}),
                        modal: true,
                        help: "Modifier l'argumentaire"
                }
        ] %}

    {% if is_granted('ROLE_ADMIN') %}
            {% set dropdownItems = dropdownItems|merge([
                    {
                            type: 'delete',
                            label: 'Supprimer',
                            icon: 'icon:delete',
                            color: 'danger',
                            url: path('app_demande_dpe_delete', {'id': item.id}),
                            method: 'DELETE',
                            csrfTokenId: 'delete' ~ item.id,
                            title: "Supprimer la demande",
                            message: "Cette action est irréversible. Voulez-vous continuer ?",
                            confirmLabel: "Supprimer",
                            cancelLabel: "Annuler",
                            id: "demande-" ~ item.id
                    }
            ]) %}
    {% endif %}

        {{ component('dropdown_actions', {
                label: 'Actions',
                help: 'Actions disponibles',
                icon: 'icon:ellipsis-vertical',
                items: dropdownItems
        }) }}
</div>

