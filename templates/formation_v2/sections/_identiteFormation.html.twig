{% set dtClass = 'text-[11px] font-black uppercase tracking-wide text-primary-500 dark:text-primary-300' %}
{% set ddClass = 'mt-2 text-sm leading-relaxed text-secondary-700 dark:text-secondary-400' %}
{% set columnClass = 'rounded-xl border border-secondary-200 dark:border-secondary-700 bg-bg p-4' %}

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="{{ columnClass }}">
        <dl class="space-y-4">
            {% if is_granted('ROLE_ADMIN') %}
                <div>
                    <dt class="{{ dtClass }}">Id formation</dt>
                    <dd class="{{ ddClass }}">#{{ formation.id }}</dd>
                </div>
            {% endif %}

            <div>
                <dt class="{{ dtClass }}">Type de diplôme</dt>
                <dd class="{{ ddClass }}">{{ typeDiplome|typeDiplome }}</dd>
            </div>

            <div>
                <dt class="{{ dtClass }}">Mention/Spécialité</dt>
                <dd class="{{ ddClass }} flex items-center gap-2 flex-wrap">
                    <span>{{ formation.display }}</span>
                    {% if formation.accreditation != null %}
                        <span class="inline-flex items-center rounded-full bg-info-100 px-2.5 py-0.5 text-xs font-semibold text-info-800 dark:bg-info-900/40 dark:text-info-300">
                            {{ formation.accreditation.libelle }}
                        </span>
                    {% endif %}
                </dd>
            </div>

            <div>
                <dt class="{{ dtClass }}">Période d'accréditation</dt>
                <dd class="{{ ddClass }}">
                    {% if formation.accreditation != null %}
                        <span class="inline-flex items-center rounded-full bg-info-100 px-2.5 py-0.5 text-xs font-semibold text-info-800 dark:bg-info-900/40 dark:text-info-300">
                            {{ formation.accreditation.libelle }}
                        </span>
                    {% else %}
                        <span class="text-xs text-secondary-400 dark:text-secondary-500">Non définie</span>
                    {% endif %}
                </dd>
            </div>

            <div>
                <dt class="{{ dtClass }}">Domaine(s)</dt>
                <dd class="{{ ddClass }}">
                    {% for domaine in formation.domaines %}
                        {{ domaine.libelle }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        -erreur-
                    {% endfor %}
                </dd>
            </div>

            <div>
                <dt class="{{ dtClass }}">Composante porteuse</dt>
                <dd class="{{ ddClass }}">{{ formation.composantePorteuse != null ? formation.composantePorteuse.libelle : 'erreur' }}</dd>
            </div>
        </dl>
    </div>

    <div class="{{ columnClass }}">
        <dl class="space-y-4">
            {% if formation.isHasParcours == true and print is defined and print == true %}
                <dt class="{{ dtClass }}">Parcours</dt>
                <dd class="{{ ddClass }}">
                    <ul class="list-disc pl-5">
                        {% for parcours in formation.parcours %}
                            <li>{{ parcours.libelle }}</li>
                        {% endfor %}
                    </ul>
                </dd>
            {% endif %}

            <dt class="{{ dtClass }}">Responsable de la formation</dt>
            <dd class="{{ ddClass }}">
                {{ formation.responsableMention != null ? formation.responsableMention.display : 'erreur' }}<br>
                <a href="mailto:{{ formation.responsableMention != null ? formation.responsableMention.email : 'erreur' }}"
                   class="text-xs text-indigo-500 hover:underline">{{ formation.responsableMention != null ? formation.responsableMention.email : 'erreur' }}</a>
            </dd>


            {% if formation.coResponsable != null %}
                <dt class="{{ dtClass }}">Co-responsable de la formation</dt>
                <dd class="{{ ddClass }}">
                    {{ formation.coResponsable != null ? formation.coResponsable.display : 'erreur' }}<br>
                    <a href="mailto:{{ formation.coResponsable != null ? formation.coResponsable.email : 'erreur' }}"
                       class="text-xs text-indigo-500 hover:underline">{{ formation.coResponsable != null ? formation.coResponsable.email : 'erreur' }}</a>
                </dd>
                {% if stringDifferencesFormation.responsableDeFormation is defined %}
                    {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                        textDifferences: stringDifferencesFormation.responsableDeFormation,
                        idCollapse: 'diffGlobalParcours'
                    }) }}
                {% endif %}
            {% endif %}

            {% if stringDifferencesFormation.coResponsableDeFormation is defined %}
                {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                    textDifferences: stringDifferencesFormation.coResponsableDeFormation,
                    idCollapse: 'diffGlobalParcours'
                }) }}
            {% endif %}

            <dt class="{{ dtClass }}">Inscription au RNCP</dt>
            <dd class="{{ ddClass }}">{{ formation.inRncp == true ? formation.codeRncp : 'Non inscrit' }}</dd>

            <dt class="{{ dtClass }}">Niveau à l'entrée de la formation</dt>
            <dd class="{{ ddClass }}">{{ referentiel_label('niveau_formation', formation.niveauEntreeValue) ?? (formation.niveauEntree != null ? formation.niveauEntree.libelle : 'Non renseigné') }}</dd>

            <dt class="{{ dtClass }}">Niveau à la sortie de la formation</dt>
            <dd class="{{ ddClass }}">{{ referentiel_label('niveau_formation', formation.niveauSortieValue) ?? (formation.niveauSortie != null ? formation.niveauSortie.libelle : 'Non renseigné') }}</dd>


        </dl>
    </div>
</div>

{% set tdEntity = (formation.typeDiplome ?? typeDiplome ?? null) %}
{% set tdLogos = tdEntity ? (tdEntity.logo ?? []) : [] %}
{% set currentParcours = parcours ?? (formation.hasParcours == false ? formation.parcours.first : null) %}
{% set pLogos = currentParcours ? currentParcours.logosNormalized : [] %}

{% if tdLogos|length > 0 or pLogos|length > 0 %}
    <div class="mt-4 grid grid-cols-1 gap-4 {{ (tdLogos|length > 0 and pLogos|length > 0) ? 'lg:grid-cols-2' : '' }}">
        {% if tdLogos|length > 0 %}
            <div class="{{ columnClass }}">
                <div class="{{ dtClass }} mb-3">Logo{{ tdLogos|length > 1 ? 's' : '' }} du type de diplôme</div>
                <div class="flex flex-wrap items-center gap-3">
                    {% for tdLogo in tdLogos %}
                        <div class="flex items-center justify-center p-3 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 shadow-xs"
                             title="Logo {{ typeDiplome|typeDiplome }}">
                            <img src="{{ asset('uploads/logos/' ~ tdLogo) }}" alt="Logo {{ typeDiplome|typeDiplome }}"
                                 class="max-h-16 max-w-36 object-contain">
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if pLogos|length > 0 %}
            <div class="{{ columnClass }}">
                <div class="{{ dtClass }} mb-3">Logo{{ pLogos|length > 1 ? 's' : '' }} du
                    parcours{{ currentParcours.libelle ? ' (' ~ currentParcours.libelle ~ ')' : '' }}</div>
                <div class="flex flex-wrap items-center gap-4">
                    {% for logo in pLogos %}
                        <div class="flex flex-col items-center p-2.5 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 shadow-xs hover:shadow transition">
                            {% if logo.url %}
                                <a href="{{ logo.url }}" target="_blank" rel="noopener noreferrer"
                                   class="flex flex-col items-center group text-center"
                                   title="Ouvrir le lien web : {{ logo.url }}">
                                    <img src="{{ asset('uploads/logos/' ~ logo.filename) }}" alt="Logo du parcours"
                                         class="max-h-16 max-w-32 object-contain">
                                    <span class="text-[11px] text-primary-600 dark:text-primary-400 group-hover:underline flex items-center gap-1 mt-1.5 truncate max-w-32 font-medium">
                                        <twig:UX:Icon name="icon:link" class="w-3 h-3 inline shrink-0"/>
                                        <span class="truncate">{{ logo.url|replace({'https://': '', 'http://': ''}) }}</span>
                                    </span>
                                </a>
                            {% else %}
                                <img src="{{ asset('uploads/logos/' ~ logo.filename) }}" alt="Logo du parcours"
                                     class="max-h-16 max-w-32 object-contain">
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
