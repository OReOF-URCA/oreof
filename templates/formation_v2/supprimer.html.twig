{% extends 'base.html.twig' %}

{% set header_title %}
    Suppression définitive de la formation : <strong>{{ formation.display }}</strong>
{% endset %}

{% block bouton_header %}
    <twig:Button
        href="{{ path('formation_v2_voir', {slug: formation.slug}) }}"
        variant="secondary"
        icon="icon:arrow-left"
        label="Annuler et retourner à la formation"
        tooltip="Annuler et retourner à la fiche de la formation"
    />
{% endblock %}

{% block content %}
    <div class="mx-auto max-w-3xl space-y-6">
        <div class="rounded-2xl border border-danger-200 bg-surface p-6 shadow-xs dark:border-danger-800">
            {% include 'formation_v2/_modal_delete.html.twig' %}

            <div class="flex items-center justify-between gap-3 pt-5 mt-6 border-t border-secondary-200 dark:border-secondary-700">
                <twig:Button
                    href="{{ path('formation_v2_voir', {slug: formation.slug}) }}"
                    variant="secondary"
                    label="Annuler"
                />
                {% if analysis.canDelete %}
                    <twig:Button
                        type="submit"
                        variant="danger"
                        :soft="false"
                        icon="icon:trash"
                        label="Supprimer définitivement"
                        form="modal_form"
                    />
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
