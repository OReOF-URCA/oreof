{# templates/formation_v2/change_rf/_recap_responsables.html.twig #}
{% if formation is defined and formation is not null %}
    <div class="mb-5 space-y-3">
        <div class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-4 dark:border-secondary-700 dark:bg-secondary-900/40">
            <h4 class="text-xs font-bold uppercase tracking-wider text-secondary-500 dark:text-secondary-400 mb-3 flex items-center gap-2">
                <twig:UX:Icon name="icon:users" class="w-4 h-4 text-secondary-600 dark:text-secondary-300"/>
                <span>Responsables actuels de la formation</span>
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="rounded-lg border border-secondary-200/80 bg-white p-3 dark:border-secondary-800 dark:bg-secondary-800/60 shadow-xs">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center rounded-md bg-primary-50 px-2 py-0.5 text-xs font-semibold text-primary-700 dark:bg-primary-950 dark:text-primary-300">
                            RF
                        </span>
                        <span class="text-xs text-secondary-500 font-medium">Responsable de formation</span>
                    </div>
                    <div class="mt-1.5 text-sm font-semibold text-secondary-900 dark:text-secondary-100">
                        {% if formation.responsableMention %}
                            <div>{{ formation.responsableMention.display }}</div>
                            {% if formation.responsableMention.email %}
                                <div class="text-xs font-normal text-secondary-500 dark:text-secondary-400">
                                    {{ formation.responsableMention.email }}
                                </div>
                            {% endif %}
                        {% else %}
                            <span class="text-xs font-normal italic text-secondary-400">Non défini</span>
                        {% endif %}
                    </div>
                </div>

                <div class="rounded-lg border border-secondary-200/80 bg-white p-3 dark:border-secondary-800 dark:bg-secondary-800/60 shadow-xs">
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center rounded-md bg-secondary-100 px-2 py-0.5 text-xs font-semibold text-secondary-700 dark:bg-secondary-700 dark:text-secondary-300">
                            CORF
                        </span>
                        <span class="text-xs text-secondary-500 font-medium">Co-responsable</span>
                    </div>
                    <div class="mt-1.5 text-sm font-semibold text-secondary-900 dark:text-secondary-100">
                        {% if formation.coResponsable %}
                            <div>{{ formation.coResponsable.display }}</div>
                            {% if formation.coResponsable.email %}
                                <div class="text-xs font-normal text-secondary-500 dark:text-secondary-400">
                                    {{ formation.coResponsable.email }}
                                </div>
                            {% endif %}
                        {% else %}
                            <span class="text-xs font-normal italic text-secondary-400">Aucun co-responsable</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if demandesEnCours is defined and demandesEnCours|length > 0 %}
            <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/60 dark:bg-amber-950/30">
                <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-200 mb-2.5 flex items-center gap-2">
                    <twig:UX:Icon name="mdi:alert-circle" class="w-4 h-4 text-amber-600 dark:text-amber-400"/>
                    <span>Demande{{ demandesEnCours|length > 1 ? 's' : '' }} en cours pour cette formation</span>
                </h4>
                <div class="space-y-2">
                    {% for item in demandesEnCours %}
                        {% set d = item.demande %}
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-lg bg-white/90 p-2.5 text-xs border border-amber-200/80 dark:bg-secondary-900/90 dark:border-amber-900/50 shadow-xs">
                            <div class="space-y-0.5">
                                <div class="flex items-center gap-2">
                                    <span class="rounded px-1.5 py-0.5 font-bold text-[10px] {{ d.typeRf.value == 'RF' ? 'bg-primary-100 text-primary-800 dark:bg-primary-950 dark:text-primary-300' : 'bg-secondary-100 text-secondary-800 dark:bg-secondary-800 dark:text-secondary-300' }}">
                                        {{ d.typeRf.value }}
                                    </span>
                                    <span class="text-secondary-800 dark:text-secondary-200">
                                        Remplacement de <strong>{{ d.ancienResponsable ? d.ancienResponsable.display : 'Non défini' }}</strong>
                                        par <strong
                                                class="text-amber-900 dark:text-amber-300">{{ d.nouveauResponsable ? d.nouveauResponsable.display : 'Non défini' }}</strong>
                                    </span>
                                </div>
                                <div class="text-[11px] text-secondary-500 dark:text-secondary-400 pl-7">
                                    Prise de fonction
                                    : {{ d.datePriseFonction ? d.datePriseFonction|date('d/m/Y') : 'Non définie' }}
                                    {% if d.dateDemande %} • Demandé le {{ d.dateDemande|date('d/m/Y') }}{% endif %}
                                </div>
                            </div>
                            <div class="shrink-0 pl-7 sm:pl-0">
                                {% set placeLabels = {
                                    'soumis_conseil': 'En attente conseil composante',
                                    'soumis_ses': 'Soumis au SES',
                                    'soumis_cfvu': 'Soumis à la CFVU',
                                    'attente_pv': 'En attente de PV',
                                    'verification_pv': 'Vérification PV',
                                    'demande_initialisee': 'Demande initialisée'
                                } %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">
                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                    {{ placeLabels[item.place]|default(item.place) }}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
