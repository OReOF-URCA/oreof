<div class="app-modal-footer-actions">
    <button type="button"
            class="app-modal-footer-btn app-modal-footer-btn--secondary"
            data-action="modalturbo#close">
        {{ 'formation_v2.modal_delete_footer.annuler'|trans({}, 'modal') }}
    </button>

    {% if analysis.canDelete %}
        <button type="submit"
                class="app-modal-footer-btn app-modal-footer-btn--danger"
                form="modal_form">
            {{ 'formation_v2.modal_delete_footer.supprimer_definitivement'|trans({}, 'modal') }}
        </button>
    {% else %}
        <button type="button"
                disabled
                class="app-modal-footer-btn app-modal-footer-btn--danger opacity-50 cursor-not-allowed">
            {{ 'formation_v2.modal_delete_footer.suppression_bloquee'|trans({}, 'modal') }}
        </button>
    {% endif %}
</div>
