{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% if cssDiff is defined and cssDiff is not empty %}
        <style>
            {{ cssDiff|raw }}
            {{ include('communs/versioning_view_style.html.twig') }}
        </style>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if (canSeeDifferences ?? false) == true %}
        <script src="{{ asset('versioning/display_differences.js') }}"></script>
    {% endif %}
{% endblock %}

{% block content %}
    <twig:FormationHeader formationId="{{ formation.id }}"/>
    {% if formation.hasParcours == false and parcours is defined and parcours is not null %}
        {# si la formation n'a pas de parcours i.e. parcours par défaut, alors on affiche le menu aussi du parcours pour le processus. #}
        <twig:ParcoursHeader formationId="{{ formation.id }}" parcoursId="{{ parcours.id }}"/>
    {% endif %}
    <div id="change_rf_state">
        <twig:ChangeRfState formation="{{ formation }}"/>
    </div>

    {% if (canSeeDifferences ?? false) and displayComparaison in ['diffGlobalParcours', 'diffGlobalParcoursCampagne'] %}
        {% set isCampagne = displayComparaison == 'diffGlobalParcoursCampagne' %}
        {% set diffCount = isCampagne ? (diffCountCampagne ?? 0) : (diffCountLastVersion ?? 0) %}
        {% set modeTitle = isCampagne ? "Comparaison avec l'année précédente (campagne N-1)" : "Comparaison avec la dernière version validée" %}

        <div class="mb-4 rounded-2xl border p-4 shadow-sm transition {{ diffCount > 0 ? 'border-info-300 bg-info-50/90 text-info-950 dark:border-info-700 dark:bg-info-950/40 dark:text-info-100' : 'border-secondary-300 bg-secondary-50 text-secondary-800 dark:border-secondary-700 dark:bg-secondary-800/60 dark:text-secondary-200' }}">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start sm:items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl {{ diffCount > 0 ? 'bg-info-100 text-info-700 dark:bg-info-900/50 dark:text-info-300' : 'bg-secondary-200 text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300' }}">
                        {{ ux_icon('ph:not-equals-bold', {class: 'h-5 w-5'}) }}
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-black uppercase tracking-wider text-info-700 dark:text-info-300">Mode Comparaison Actif</span>
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ diffCount > 0 ? 'bg-info-200 text-info-800 dark:bg-info-900/80 dark:text-info-200' : 'bg-secondary-200 text-secondary-700 dark:bg-secondary-700 dark:text-secondary-300' }}">
                                {{ diffCount }} champ{{ diffCount > 1 ? 's' : '' }} avec modification{{ diffCount > 1 ? 's' : '' }}
                            </span>
                        </div>
                        <p class="text-sm font-semibold mt-0.5">
                            {{ modeTitle }}
                        </p>
                        <p class="text-xs opacity-80 mt-0.5">
                            {% if diffCount > 0 %}
                                Les modifications sont surlignées dans les blocs descriptifs ci-dessous (<span class="font-semibold text-success-700 dark:text-success-300">texte vert</span> = ajouts, <span class="font-semibold text-danger-700 dark:text-danger-300 line-through">texte rouge barré</span> = suppressions).
                            {% else %}
                                <strong>Aucune modification détectée</strong> : la saisie actuelle est strictement identique à la version de référence comparée.
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 self-end sm:self-center shrink-0">
                    {% if not isCampagne %}
                        <a href="{{ path('formation_v2_voir', {slug: formation.slug, optionDisplay: 'diffGlobalParcoursCampagne'}) }}"
                           class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                            {{ ux_icon('icon:calendar', {class: 'h-3.5 w-3.5 text-info-500'}) }}
                            <span>Comparer avec N-1</span>
                        </a>
                    {% else %}
                        <a href="{{ path('formation_v2_voir', {slug: formation.slug, optionDisplay: 'diffGlobalParcours'}) }}"
                           class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                            {{ ux_icon('mdi:history', {class: 'h-3.5 w-3.5 text-info-500'}) }}
                            <span>Comparer avec version validée</span>
                        </a>
                    {% endif %}
                    <a href="{{ path('formation_v2_voir', {slug: formation.slug}) }}"
                       class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 hover:text-secondary-900 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                        {{ ux_icon('icon:close', {class: 'h-3.5 w-3.5'}) }}
                        <span>Quitter</span>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {% set userCanEditFormation = is_granted('EDIT', {route: 'app_formation', subject: formation})
        or is_granted('EDIT', {route: 'app_composante', subject: formation})
        or is_granted('EDIT', {route: 'app_etablissement', subject: formation})
        or is_granted('ROLE_ADMIN') 
        or (is_granted('ROLE_SAISIE_FORM_GENERIQUE_DIRECTION') and formation.classique == false)
    %}
    {% if formation.hasParcours == true %}
        {% set canEditFormation = userCanEditFormation and isOuvert(formation) %}
    {% else %}
        {% set canEditFormation = userCanEditFormation and dpeParcours is not null and isOuvert(dpeParcours) and isEditable(dpeParcours) %}
    {% endif %}

    <div class="flex bg-surface dark:bg-secondary-900" data-controller="scroll-spy">
        <aside class="app-scrollspy-aside w-72 flex flex-col p-3 space-y-8">
            <div class="sticky top-[calc(var(--page-header-offset,4rem)+0.5rem)] space-y-8">
                <div class="h-[calc(100vh-var(--page-header-offset,4rem)-1rem)] overflow-y-scroll">
                    <p class="app-scrollspy-section-title">Navigation</p>
                    <nav class="space-y-1">
                        <a href="#identite_formation" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                             Identité de la formation
                         </a>
                         <a href="#localisation" data-scroll-spy-target="link"
                            class="app-scrollspy-link">
                             Localisation
                         </a>
                         <a href="#presentation" data-scroll-spy-target="link"
                            class="app-scrollspy-link">
                             Présentation de la formation
                         </a>

                         {% if formation.isHasParcours == false %}
                             {# formation sans parcours #}
                             <a href="#competences" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Compétences Acquises
                             </a>

                             <a href="#structure" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Structure & maquette
                             </a>
                             <a href="#admission" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Admission
                             </a>

                             <a href="#inscription" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Inscription
                             </a>

                             <a href="#et_apres" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Et après...
                             </a>

                             <a href="#contacts" data-scroll-spy-target="link"
                                class="app-scrollspy-link">
                                 Contacts pédagogiques
                             </a>
                         {% else %}
                             {% for parcours in formation.parcours %}
                                 {% set canEditP = isOuvert(parcours) and isEditable(parcours) and (is_granted('ROLE_ADMIN') or is_granted('EDIT', parcours)) %}
                                 <div class="flex items-center justify-between gap-1 pr-2 mt-6 mb-1">
                                     <p class="app-scrollspy-section-title app-scrollspy-section-title--accent !mb-0 truncate flex-1">
                                         Parcours {{ parcours.libelle }}{% set typeParcoursBadge = parcours.typeParcours|badgeTypeParcours %}{% if typeParcoursBadge is not null %} {{ component('Badge', { dto: typeParcoursBadge }) }}{% endif %}</p>
                                     {% if canEditP %}
                                         <a href="{{ path('parcours_v2_modifier', {parcours: parcours.id}) }}"
                                            class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg text-warning-600 hover:bg-warning-100 hover:text-warning-800 transition dark:text-warning-400 dark:hover:bg-warning-950/60"
                                                 {{ stimulus_controller('tooltip') }}
                                            title="Modifier ce parcours">
                                             {{ ux_icon('icon:edit', {class: 'h-3.5 w-3.5'}) }}
                                         </a>
                                     {% endif %}
                                 </div>

                                 <a href="#presentation_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Présentation du parcours
                                 </a>

                                 <a href="#descriptif_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Descriptif du parcours
                                 </a>

                                 <a href="#competences_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Compétences Acquises
                                 </a>

                                 <a href="#structure_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Structure & maquette
                                 </a>
                                 <a href="#admission_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Admission
                                 </a>

                                 <a href="#inscription_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Inscription
                                 </a>

                                 <a href="#et_apres_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Et après...
                                 </a>

                                 <a href="#contacts_{{ parcours.id }}" data-scroll-spy-target="link"
                                    class="app-scrollspy-link">
                                     Contacts pédagogiques
                                 </a>
                             {% endfor %}
                         {% endif %}
                    </nav>
                </div>
            </div>
        </aside>
        <div class="ps-3 flex-1 overflow-y-auto flex flex-col pt-0">
            {{ include([
                'typeDiplome/' ~ constant('TEMPLATE_FOLDER', typeD) ~ '/_show_formation.html.twig',
                'formation_v2/_show_formation.html.twig'
            ]) }}
        </div>
    </div>

    {# Widget flottant d'actions rapides & retour en haut (Option 2 - positionné à gauche du bouton d'aide) #}
    <div data-controller="floating-actions"
         data-floating-actions-target="container"
         class="fixed bottom-6 right-[5.5rem] sm:bottom-8 sm:right-[6.5rem] z-40 flex items-center gap-2.5 opacity-0 translate-y-4 pointer-events-none transition-all duration-300">

        {# Dropup Popover #}
        <div data-floating-actions-target="menu"
             class="hidden absolute bottom-full right-0 mb-3 w-80 max-h-[calc(100vh-10rem)] overflow-y-auto rounded-2xl border border-secondary-200 bg-surface/95 p-3 shadow-2xl backdrop-blur-md ring-1 ring-secondary-200/60 dark:border-secondary-700 dark:bg-secondary-900/95 dark:ring-secondary-700/60">
            <div class="mb-2 flex items-center justify-between border-b border-secondary-100 pb-2 dark:border-secondary-800">
                <span class="text-[11px] font-black uppercase tracking-wider text-secondary-500 dark:text-secondary-400">
                    Accès rapide aux modifications
                </span>
                <button type="button"
                        data-action="click->floating-actions#close"
                        class="text-secondary-400 hover:text-secondary-600 dark:hover:text-secondary-200">
                    {{ ux_icon('icon:close', {class: 'h-3.5 w-3.5'}) }}
                </button>
            </div>

            {{ include('formation_v2/_actions_modifier_menu.html.twig', {
                formation: formation,
                canEditFormation: canEditFormation
            }) }}

            <div class="mt-2 pt-2 border-t border-secondary-100 dark:border-secondary-800 flex items-center justify-between text-xs">
                <a href="{{ path('app_formation_index') }}"
                   class="inline-flex items-center gap-1.5 text-secondary-500 hover:text-secondary-800 dark:text-secondary-400 dark:hover:text-secondary-200 transition">
                    {{ ux_icon('icon:arrow-left', {class: 'h-3.5 w-3.5'}) }}
                    <span>Retour liste</span>
                </a>
                <button type="button"
                        data-action="click->floating-actions#scrollToTop"
                        class="inline-flex items-center gap-1 text-primary-600 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-200 transition font-medium">
                    {{ ux_icon('icon:chevron-up', {class: 'h-3.5 w-3.5'}) }}
                    <span>Haut de page</span>
                </button>
            </div>
        </div>

        {# Bouton principal d'édition flottant #}
        <button type="button"
                data-floating-actions-target="button"
                data-action="click->floating-actions#toggle"
                class="inline-flex items-center gap-2 rounded-full border border-warning-400 bg-warning-500 px-4 py-3 text-xs sm:text-sm font-bold text-white shadow-xl hover:bg-warning-600 focus:outline-none focus:ring-2 focus:ring-warning-500/40 transition dark:border-warning-600 dark:bg-warning-600 dark:hover:bg-warning-500 cursor-pointer h-12 sm:h-14"
                aria-haspopup="true"
                aria-expanded="false">
            {{ ux_icon('icon:edit', {class: 'h-4 w-4 shrink-0'}) }}
            <span>Modifier...</span>
            {{ ux_icon('icon:chevron-up', {class: 'h-3.5 w-3.5 shrink-0 transition-transform duration-200', 'data-floating-actions-target': 'chevron'}) }}
        </button>

        {# Bouton remonter en haut #}
        <button type="button"
                data-action="click->floating-actions#scrollToTop"
                class="inline-flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full border border-secondary-200 bg-surface/95 text-secondary-600 shadow-xl backdrop-blur hover:bg-secondary-100 hover:text-secondary-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 transition dark:border-secondary-700 dark:bg-secondary-800/90 dark:text-secondary-300 dark:hover:bg-secondary-700 cursor-pointer"
                {{ stimulus_controller('tooltip') }}
                title="Remonter en haut de page">
            {{ ux_icon('icon:chevron-up', {class: 'h-4 w-4'}) }}
        </button>
    </div>
{% endblock %}

{% set header_title %}
    {{ 'formation_v2_voir.title'|trans({'%display%': formation.display}, 'header') }}
{% endset %}

{% block bouton_header %}
    <div class="flex flex-wrap gap-2 justify-start lg:justify-end">
        {% set userCanEditFormation = is_granted('EDIT', {route: 'app_formation', subject: formation})
            or is_granted('EDIT', {route: 'app_composante', subject: formation})
            or is_granted('EDIT', {route: 'app_etablissement', subject: formation})
            or is_granted('ROLE_ADMIN') 
            or (is_granted('ROLE_SAISIE_FORM_GENERIQUE_DIRECTION') and formation.classique == false)
        %}
        {% if formation.hasParcours == true %}
            {% set canEditFormation = userCanEditFormation and isOuvert(formation) %}
            {% if userCanEditFormation %}
                <twig:Button
                        href="{{ canEditFormation ? path('formation_v2_modifier', {slug:formation.slug}) : '' }}"
                        variant="warning"
                        icon="icon:edit"
                        label="Modifier la formation"
                        :disabled="not canEditFormation"
                        tooltip="{{ canEditFormation ? 'Modifier la formation' : 'Formation verrouillée' }}"
                />
            {% endif %}
        {% else %}
            {% set canEditFormation = userCanEditFormation and dpeParcours is not null and isOuvert(dpeParcours) and isEditable(dpeParcours) %}
            {% if userCanEditFormation %}
                <twig:Button
                        href="{{ canEditFormation ? path('formation_v2_modifier', {slug:formation.slug}) : '' }}"
                        variant="warning"
                        icon="icon:edit"
                        label="Modifier la formation"
                        :disabled="not canEditFormation"
                        tooltip="{{ canEditFormation ? 'Modifier la formation' : 'Formation verrouillée' }}"
                />
            {% endif %}
        {% endif %}

        <twig:Button
                href="{{ path('app_formation_index') }}"
                variant="success"
                icon="icon:arrow-left"
                label="Retour à la liste des formations"
                tooltip="Retour à la liste des formations"
        />
    </div>
{% endblock %}
