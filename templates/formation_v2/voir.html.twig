                                    Admission
                                </a>

                                <a href="#inscription_{{ parcours.id }}" data-scroll-spy-target="link"
                                   class="app-scrollspy-link">
                                    Inscription
                                </a>

                                <a href="#et_apres_{{ parcours.id }}" data-scroll-spy-target="link"
                                   class="app-scrollspy-link">
                                    Et après...
