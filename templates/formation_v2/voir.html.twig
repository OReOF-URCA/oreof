{% endblock %}

{% set header_title %}
    Détail de la formation : {{ formation.display }}
{% endset %}

{% block bouton_header %}
    {% if formation.hasParcours == true %}
        {% if (is_granted('EDIT', {route: 'app_formation', subject: formation})
            or is_granted('EDIT', {route: 'app_composante', subject: formation})
            or is_granted('EDIT', {route: 'app_etablissement', subject: formation})
            or is_granted('ROLE_ADMIN')) and isOuvert(formation) %}
            <twig:Button
                    href="{{ path('formation_v2_modifier', {slug:formation.slug}) }}"
                    variant="warning"
                    icon="icon:edit"
                    label="Modifier le DPE"
                    tooltip="Modifier le DPE"
            />
        {% endif %}
    {% else %}
        {% if (is_granted('EDIT', {route: 'app_formation', subject: formation})
            or is_granted('EDIT', {route: 'app_composante', subject: formation})
            or is_granted('EDIT', {route: 'app_etablissement', subject: formation})
            or is_granted('ROLE_ADMIN')) and isOuvert(formation.parcours[0].dpeParcours[0]) %}
            <twig:Button
                    href="{{ path('formation_v2_modifier', {slug:formation.slug}) }}"
                    variant="warning"
                    icon="icon:edit"
                    label="Modifier le DPE"
                    tooltip="Modifier le DPE"
            />
        {% endif %}
    {% endif %}

    <twig:Button
            href="{{ path('app_formation_index') }}"
            variant="success"
            icon="icon:arrow-left"
            label="Retour à la liste des formations"
            tooltip="Retour à la liste des formations"
    />
{% endblock %}
