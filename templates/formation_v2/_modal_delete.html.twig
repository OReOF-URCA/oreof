<div class="space-y-4 text-text">

    {# 1. Bannière d'avertissement rouge #}
    <div class="rounded-xl border border-danger-200 bg-danger-50 p-4 dark:border-danger-800 dark:bg-danger-900/30">
        <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-danger-100 text-danger-700 dark:bg-danger-800 dark:text-danger-200">
                <twig:UX:Icon name="icon:warning" class="h-5 w-5" />
            </div>
            <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-sm font-bold text-danger-900 dark:text-danger-100">
                        Suppression définitive et irréversible
                    </h3>
                    <twig:Badge variant="danger" size="sm" label="Admin exclusivement" />
                </div>
                <p class="text-xs text-danger-800 dark:text-danger-200 leading-relaxed">
                    Cette action détruira définitivement la formation <strong>« {{ formation.displayLong ?? formation.display }} »</strong> en base de données.
                    Elle doit être réservée aux <strong>erreurs de création ou de recopie</strong>.
                </p>
            </div>
        </div>
    </div>

    {# 2. Contexte : Composante et Mention #}
    <div class="rounded-xl border border-secondary-200 bg-secondary-50/50 p-3 text-xs dark:border-secondary-700 dark:bg-secondary-800/40 space-y-1.5">
        <div class="flex items-center justify-between gap-2">
            <span class="text-secondary-500 dark:text-secondary-400">Composante porteuse :</span>
            <span class="font-semibold text-secondary-900 dark:text-secondary-100">
                {{ formation.composantePorteuse ? formation.composantePorteuse.libelle : 'Non définie' }}
            </span>
        </div>
        {% if formation.typeDiplome %}
            <div class="flex items-center justify-between gap-2">
                <span class="text-secondary-500 dark:text-secondary-400">Type de diplôme :</span>
                <span class="font-semibold text-secondary-900 dark:text-secondary-100">
                    {{ formation.typeDiplome.libelleCourt }}
                </span>
            </div>
        {% endif %}
        {% if formation.mention %}
            <div class="flex items-center justify-between gap-2">
                <span class="text-secondary-500 dark:text-secondary-400">Mention :</span>
                <span class="font-semibold text-secondary-900 dark:text-secondary-100">
                    {{ formation.mention.libelle }}
                </span>
            </div>
        {% endif %}
    </div>

    {# 3. Blocage ou information sur les parcours #}
    {% if not analysis.canDelete %}
        <div class="rounded-xl border border-danger-200 bg-danger-50 p-3.5 text-xs text-danger-900 dark:border-danger-800 dark:bg-danger-900/30 dark:text-danger-100 space-y-2">
            <div class="flex items-center gap-2 font-bold text-sm text-danger-700 dark:text-danger-300">
                <twig:UX:Icon name="icon:danger" class="h-4 w-4 shrink-0" />
                <span>Suppression non autorisée</span>
            </div>
            <div class="space-y-1 text-danger-800 dark:text-danger-200 leading-relaxed">
                {% for reason in analysis.blockingReasons %}
                    <p>{{ reason }}</p>
                {% endfor %}
            </div>
            <p class="text-[11px] text-danger-700 dark:text-danger-300 italic pt-1 border-t border-danger-200 dark:border-danger-800">
                Une formation ne peut être supprimée que si elle ne contient plus aucun parcours ou uniquement son parcours par défaut.
            </p>
        </div>
    {% else %}
        {% if analysis.parcoursDefaut %}
            <div class="rounded-xl border border-warning-200 bg-warning-50 p-3 text-xs text-warning-800 dark:border-warning-800 dark:bg-warning-900/30 dark:text-warning-200 flex items-start gap-2.5">
                <twig:UX:Icon name="icon:warning" class="h-4 w-4 shrink-0 text-warning-600 dark:text-warning-300 mt-0.5" />
                <div>
                    <strong>Parcours par défaut associé :</strong> Cette formation possède un parcours par défaut (<strong>« {{ analysis.parcoursDefaut.libelle }} »</strong>). Il sera supprimé automatiquement avec tous ses éléments en cascade.
                </div>
            </div>
        {% else %}
            <div class="rounded-xl border border-secondary-200 bg-secondary-50/50 p-3 text-xs text-secondary-800 dark:border-secondary-700 dark:bg-secondary-800/40 dark:text-secondary-200 flex items-center gap-2.5">
                <twig:UX:Icon name="icon:info" class="h-4 w-4 shrink-0 text-secondary-500 dark:text-secondary-400" />
                <span>Cette formation ne contient aucun parcours.</span>
            </div>
        {% endif %}
    {% endif %}

    {# 4. Dépendances partagées #}
    {% if analysis.hasSharedDependencies %}
        <div class="rounded-xl border border-danger-200 bg-surface p-4 shadow-xs dark:border-danger-800 space-y-3">
            <div class="flex items-center gap-2 text-danger-700 dark:text-danger-300 text-sm font-bold">
                <twig:UX:Icon name="icon:warning" class="h-4 w-4" />
                <span>Dépendances partagées détectées ({{ analysis.sharedDependenciesCount }})</span>
            </div>
            <p class="text-xs text-secondary-500 dark:text-secondary-400">
                Certains éléments associés sont liés à d'autres formations ou sont des versions officielles :
            </p>

            <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                {% for dep in analysis.sharedDependencies %}
                    <div class="rounded-lg border p-2.5 text-xs {{ dep.severity == 'danger' ? 'border-danger-200 bg-danger-50 dark:border-danger-800 dark:bg-danger-900/20' : 'border-warning-200 bg-warning-50 dark:border-warning-800 dark:bg-warning-900/20' }}">
                        <div class="font-semibold text-secondary-900 dark:text-secondary-100 flex items-center gap-1.5">
                            <twig:Badge variant="{{ dep.severity }}" size="sm" label="{{ dep.titre }}" />
                        </div>
                        <p class="mt-1 text-secondary-700 dark:text-secondary-300 leading-snug">
                            {{ dep.description }}
                        </p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% elseif analysis.canDelete %}
        <div class="rounded-xl border border-success-200 bg-success-50 p-3 text-xs text-success-800 dark:border-success-800 dark:bg-success-900/30 dark:text-success-200 flex items-center gap-2.5">
            <twig:UX:Icon name="icon:check" class="h-4 w-4 shrink-0 text-success-600 dark:text-success-300" />
            <span><strong>Aucune dépendance partagée :</strong> Cette formation est isolée, la suppression n'impactera aucune autre formation.</span>
        </div>
    {% endif %}

    {# 5. Résumé des éléments internes qui seront supprimés #}
    {% if analysis.canDelete %}
        <div class="rounded-xl border border-secondary-200 bg-surface p-3.5 dark:border-secondary-700">
            <div class="text-xs font-bold uppercase tracking-wider text-secondary-500 dark:text-secondary-400 mb-2">
                Éléments internes détruits en cascade
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
                <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                    <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.versions_formation|default(0) }}</div>
                    <div class="text-[11px] text-secondary-500 dark:text-secondary-400">Versions form.</div>
                </div>
                <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                    <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.blocs_competences_formation|default(0) }}</div>
                    <div class="text-[11px] text-secondary-500 dark:text-secondary-400">Blocs comp.</div>
                </div>
                <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                    <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.profils_utilisateurs|default(0) }}</div>
                    <div class="text-[11px] text-secondary-500 dark:text-secondary-400">Profils liés</div>
                </div>
                <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                    <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.parcours_semestres_parcours|default(0) }}</div>
                    <div class="text-[11px] text-secondary-500 dark:text-secondary-400">Semestres</div>
                </div>
            </div>
        </div>

        {# 6. Formulaire de confirmation #}
        <form id="modal_form" action="{{ path('formation_v2_supprimer_post', {formation: formation.id}) }}" method="post" class="space-y-3.5 pt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('formation_delete_' ~ formation.id) }}">

            {% if analysis.hasSharedDependencies %}
                <div class="rounded-xl border border-danger-200 bg-danger-50 p-3 dark:border-danger-800 dark:bg-danger-900/30">
                    <label class="flex items-start gap-2.5 cursor-pointer">
                        <input
                            type="checkbox"
                            name="force"
                            value="1"
                            required
                            class="mt-0.5 h-4 w-4 rounded border-danger-300 text-danger-600 focus:ring-danger-500 cursor-pointer"
                        >
                        <span class="text-xs font-semibold text-danger-900 dark:text-danger-200">
                            Je confirme avoir vérifié les dépendances partagées et souhaite forcer la suppression définitive.
                        </span>
                    </label>
                </div>
            {% endif %}

            <div>
                <label for="confirmation_text" class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-300 mb-1">
                    Saisissez le libellé de la formation ou « SUPPRIMER » pour confirmer <span class="text-danger-600">*</span>
                </label>
                <div class="text-[11px] text-secondary-500 dark:text-secondary-400 mb-1.5">
                    Texte attendu : <code class="rounded bg-secondary-100 px-1 py-0.5 font-mono font-bold text-danger-700 dark:bg-secondary-800 dark:text-danger-300">{{ formation.display }}</code> ou <code class="rounded bg-secondary-100 px-1 py-0.5 font-mono font-bold text-danger-700 dark:bg-secondary-800 dark:text-danger-300">SUPPRIMER</code>
                </div>
                <input
                    type="text"
                    name="confirmation_text"
                    id="confirmation_text"
                    required
                    autocomplete="off"
                    placeholder="{{ formation.display }}"
                    class="w-full rounded-xl border border-secondary-300 bg-white px-3.5 py-2.5 text-sm font-medium text-secondary-900 shadow-sm transition placeholder:text-secondary-400 focus:border-danger-500 focus:outline-none focus:ring-2 focus:ring-danger-500/20 dark:border-secondary-600 dark:bg-secondary-900 dark:text-secondary-100"
                >
            </div>
        </form>
    {% endif %}

</div>
