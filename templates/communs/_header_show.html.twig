{% set color = color is defined ? color : 'primary' %}
{% set color_map = {
    'primary': 'app-section-header-icon--primary',
    'warning': 'app-section-header-icon--warning',
    'danger': 'app-section-header-icon--danger',
    'success': 'app-section-header-icon--success',
    'info': 'app-section-header-icon--info'
} %}
{% set icon_color_class = color_map[color]|default(color_map['primary']) %}

<div class="app-section-header">
    <div class="app-section-header-main">
        <div class="app-section-header-icon {{ icon_color_class }}">
            <twig:UX:Icon :name="icon" class="w-5 h-5"/>
        </div>
        <h3 class="app-section-header-title">{{ title }}</h3>
    </div>
    {% if (print is not defined or print == false) %}
        <div class="ml-4">
            {{ component('commentaire', {
                commentaires: formation.commentaires,
                id: formation.id,
                type: 'formation',
                zone: 'identite_formation',
            }) }}
        </div>
    {% endif %}
</div>
