{# templates/form/form_theme_v2.html.twig #}
{% use "form_div_layout.html.twig" %}
{% trans_default_domain 'form' %}

{% block color_variant_widget %}
    {% set colors = {
        primary: 'bg-primary',
        secondary: 'bg-secondary',
        success: 'bg-success',
        info: 'bg-info',
        warning: 'bg-warning',
        danger: 'bg-danger'
    } %}

    <div class="flex flex-wrap gap-2">
        {% for child in form %}
            <label class="cursor-pointer">
                {{ form_widget(child, {
                    attr: {
                        class: 'peer sr-only'
                    }
                }) }}

                <span class="
                    flex items-center gap-2 rounded-lg border px-3 py-2 text-sm
                    border-gray-300 bg-white
                    peer-checked:border-primary peer-checked:ring-2 peer-checked:ring-primary/30
                ">
                    <span class="h-4 w-4 rounded-full {{ colors[child.vars.value]|default('bg-gray-300') }}"></span>
                    {% if form.vars.show_labels %}
                        <span>{{ child.vars.label }}</span>
                    {% endif %}
                </span>
            </label>
        {% endfor %}
    </div>
{% endblock %}

{# --- LIGNE DE FORMULAIRE (ROW) --- #}
{% block form_row %}
    {% set helpContent = form_help(form) %}
    {% set widgetAttr = attr %}
    {% set descriptions = widgetAttr['aria-describedby']|default('')|split(' ') %}
    {% if helpContent|trim != '' and (id ~ '_help') not in descriptions %}
        {% set descriptions = descriptions|merge([id ~ '_help']) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% if (id ~ '_errors') not in descriptions %}{% set descriptions = descriptions|merge([id ~ '_errors']) %}{% endif %}
        {% set widgetAttr = widgetAttr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {% if descriptions|join(' ')|trim != '' %}
        {% set widgetAttr = widgetAttr|merge({'aria-describedby': descriptions|join(' ')|trim}) %}
    {% endif %}
    <div class="space-y-2 group mb-4">
        {{ form_label(form) }}
        {{ form_widget(form, {attr: widgetAttr}) }}
        {{ helpContent|raw }}
        {{ form_errors(form) }}
    </div>
{% endblock form_row %}

{% block trix_widget %}
    {% set maxlength = attr.maxlength|default(attr['maxlength']|default(maxLength|default(form.vars.attr.maxlength|default(null)))) %}
    {% if maxlength is defined and maxlength is not empty and maxlength > 0 %}
        <div {{ stimulus_controller('char-count', { max: maxlength }) }} class="w-full">
            <input id="trix-input-{{ trixId }}" value="{{ value }}" type="hidden" name="{{ full_name }}">
            <trix-editor id="{{ id }}" input="trix-input-{{ trixId }}"{% with {attr: attr} %} {{ block('attributes') }}{% endwith %}></trix-editor>
            <div class="mt-1 flex justify-end">
                <span class="text-xs text-secondary-500 dark:text-secondary-400 font-mono transition-colors" data-char-count-target="counter">
                    <span data-char-count-target="current">{{ value|default('')|length }}</span> / {{ maxlength }} caractères
                    <span data-char-count-target="limitBadge" class="hidden text-danger-600 dark:text-danger-400 font-semibold ml-1">(limite atteinte)</span>
                </span>
            </div>
        </div>
    {% else %}
        <input id="trix-input-{{ trixId }}" value="{{ value }}" type="hidden" name="{{ full_name }}">
        <trix-editor id="{{ id }}" input="trix-input-{{ trixId }}"{% with {attr: attr} %} {{ block('attributes') }}{% endwith %}></trix-editor>
    {% endif %}
{% endblock %}

{# --- LABEL --- #}
{% block form_label %}
    {% if not compound %}{% set label_attr = label_attr|merge({'for': id}) %}{% endif %}
    {% if label is not same as(false) %}
        <div class="flex justify-between items-center mb-1">
            <label {% with { attr: label_attr|merge({ class: 'text-[12px] font-black text-secondary-500 group-focus-within:text-indigo-500 transition-colors uppercase' }) } %}{{ block('attributes') }}{% endwith %}>
                {{- block('form_label_content') -}}
            </label>
            {% if required %}<span class="text-[10px] font-bold text-red-300 uppercase">Champs Requis</span>{% endif %}
        </div>
    {% endif %}
{% endblock form_label %}

{% block form_label_inline_create_entity_select %}
    {% set label_attr = label_attr|merge({'for': form.entity.vars.id}) %}
    {% if label is not same as(false) %}
        <div class="flex items-center mb-1 gap-2 w-full">
            <div class="flex items-center gap-2 min-w-0">
                <label
                        {% with { attr: label_attr|merge({
                            class: 'text-[12px] font-black text-secondary-500 group-focus-within:text-indigo-500 transition-colors uppercase'
                        }) } %}
                            {{ block('attributes') }}
                        {% endwith %}
                >
                    {{- block('form_label_content') -}}
                </label>

                <button type="button"
                        data-inline-create-target="toggleButton"
                        data-action="click->inline-create#toggleNewField"
                        class="text-[10px] font-black text-indigo-600 hover:underline shrink-0">
                    + Créer nouveau
                </button>
            </div>

            {% if required %}
                <span class="ml-auto text-[10px] font-bold text-red-300 uppercase whitespace-nowrap shrink-0">
            Champ requis
        </span>
            {% endif %}
        </div>

    {% endif %}
{% endblock form_label_inline_create_entity_select %}

{# --- INPUT TEXT / EMAIL / PASSWORD --- #}
{% block form_widget_simple %}
    {#    {% set attr = attr|merge({ class: attr.class|default('') ~ ' w-full p-2 bg-white border border-secondary-200 rounded-sm font-semibold text-secondary-700 focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm placeholder:text-secondary-300' }) %}    #}

    {% set attr = attr|merge({ class: attr.class|default('') ~ ' w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-bold placeholder:text-secondary-400 dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700 dark:placeholder:text-secondary-500' }) %}
    {{ parent() }}
{% endblock form_widget_simple %}

{# --- TEXTAREA --- #}
{% block textarea_widget %}
    {% set maxlength = attr.maxlength|default(attr['maxlength']|default(maxLength|default(form.vars.attr.maxlength|default(null)))) %}
    {% set attr = attr|merge({ class: attr.class|default('') ~ ' w-full p-2 bg-secondary-50 text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm min-h-[150px] placeholder:text-secondary-400 dark:bg-secondary-900 dark:text-secondary-100 dark:border-secondary-700 dark:placeholder:text-secondary-500' }) %}
    {% if maxlength is defined and maxlength is not empty and maxlength > 0 %}
        <div {{ stimulus_controller('char-count', { max: maxlength }) }} class="w-full">
            {{ parent() }}
            <div class="mt-1 flex justify-end">
                <span class="text-xs text-secondary-500 dark:text-secondary-400 font-mono transition-colors" data-char-count-target="counter">
                    <span data-char-count-target="current">{{ value|default('')|length }}</span> / {{ maxlength }} caractères
                    <span data-char-count-target="limitBadge" class="hidden text-danger-600 dark:text-danger-400 font-semibold ml-1">(limite atteinte)</span>
                </span>
            </div>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock textarea_widget %}

{# --- SELECT --- #}
{% block choice_widget_collapsed %}
    {% set isDisabled = (attr.disabled is defined and attr.disabled) or (disabled is defined and disabled) or (form.vars.disabled is defined and form.vars.disabled) %}
    {% set isAutocomplete = (attr['data-controller'] is defined and ('autocomplete' in attr['data-controller'] or 'icon-select' in attr['data-controller'])) or (form.vars.attr['data-controller'] is defined and ('autocomplete' in form.vars.attr['data-controller'] or 'icon-select' in form.vars.attr['data-controller'])) %}
    
    {% if isAutocomplete %}
        {% set attr = attr|merge({ class: attr.class|default('') ~ ' w-full' }) %}
        {{ parent() }}
    {% else %}
        {% set baseClass = ' w-full p-2 rounded-sm font-bold focus:ring-4 focus:ring-indigo-50 focus:border-indigo-500 outline-none transition-all shadow-sm appearance-none' %}
        {% set normalClass = ' bg-secondary-50 border border-secondary-200 text-secondary-800 cursor-pointer dark:bg-secondary-900 dark:border-secondary-700 dark:text-secondary-100' %}
        {% set disabledClass = ' bg-secondary-200 border border-secondary-200 text-secondary-400 cursor-not-allowed opacity-70 dark:bg-secondary-800 dark:border-secondary-700 dark:text-secondary-500' %}
        {% set attr = attr|merge({ class: attr.class|default('') ~ baseClass ~ (isDisabled ? disabledClass : normalClass) }) %}
        <div class="relative">
            {{ parent() }}
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-secondary-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path>
                </svg>
            </div>
        </div>
    {% endif %}
{% endblock choice_widget_collapsed %}

{# --- AIDE (HELP) --- #}
{% block form_help %}
    {% import _self as macros %}
    {% set helpContent = macros.resolved_help_content(form, help, help_translation_parameters, translation_domain, help_html|default(false)) %}

    {% if helpContent is not empty and helpContent|trim != '' %}
        <p id="{{ id }}_help" class="text-xs text-secondary-600 dark:text-secondary-300 italic mt-1 pl-1 flex items-start gap-2">
            <span class="flex-shrink-0 w-5 h-5 bg-secondary-200 text-secondary-500 flex items-center justify-center text-[10px] rounded-full">
                <twig:UX:Icon name="icon:info" aria-hidden="true"/>
            </span>
            <span>{{ helpContent|raw }}</span>
        </p>
    {% endif %}
{% endblock form_help %}

{# --- ERREURS --- #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <div id="{{ id }}_errors" class="mt-2 space-y-1">
            {% for error in errors %}
                <p class="text-sm font-semibold text-danger-700 dark:text-danger-300 flex items-center gap-1">
                    <span class="w-1 h-1 bg-danger-500 rounded-full" aria-hidden="true"></span>
                    {{ error.message }}
                </p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock form_errors %}

{%- block form_label_content -%}
    {% import _self as macros %}
    {% apply spaceless %}
        {%- if label is empty -%}
            {%- set t = label_translation_parameters['%transition%'] ?? null -%}
            {%- set f = label_translation_parameters['%field%'] ?? null -%}

            {%- if t and f -%}
                {%- set label = 'workflow.' ~ t ~ '.' ~ f ~ '.label' -%}
            {%- else -%}
                {# fallback existant #}
                {% import _self as macros %}
                {% set label = macros.form_parent_name(form) %}
            {%- endif -%}
        {%- endif -%}
        {%- if translation_domain is same as(false) -%}
            {%- if label_html is same as(false) -%}
                {{- label -}}
            {%- else -%}
                {{- label|raw -}}
            {%- endif -%}
        {%- else -%}
            {%- if label_html is same as(false) -%}
                {{- label|trim|trans(label_translation_parameters, translation_domain) -}}
            {%- else -%}
                {{- label|trim|trans(label_translation_parameters, translation_domain)|raw -}}
            {%- endif -%}
        {%- endif -%}
    {% endapply %}
{%- endblock form_label_content -%}

{% macro form_parent_name(form, prefix) %}
    {% apply spaceless %}
        {% import _self as macros %}

        {% set prefix = prefix|default(false) %}

        {% if form.parent is empty %}
            {{- form.vars.name -}}.labels
        {% else %}
            {% if form.vars.compound and not prefix %}
                {{- macros.form_parent_name(form.parent) -}}.{{- form.vars.name -}}.label
            {% else %}
                {{- macros.form_parent_name(form.parent, true) -}}.{{- form.vars.name -}}
            {% endif %}
        {% endif %}
    {% endapply %}
{% endmacro %}

{% macro form_parent_help_name(form, prefix) %}
    {% apply spaceless %}
        {% import _self as macros %}

        {% set prefix = prefix|default(false) %}

        {% if form.parent is empty %}
            {{- form.vars.name -}}.helps
        {% else %}
            {% if form.vars.compound and not prefix %}
                {{- macros.form_parent_help_name(form.parent) -}}.{{- form.vars.name -}}.help
            {% else %}
                {{- macros.form_parent_help_name(form.parent, true) -}}.{{- form.vars.name -}}
            {% endif %}
        {% endif %}
    {% endapply %}
{% endmacro %}

{# --- GROUPES D'OPTIONS (checkbox/radio) --- #}

{% block choice_widget_expanded %}
    {# On récupère le nombre de colonnes, par défaut 1 si non défini #}
    {% set cols = attr.columns|default(4) %}

    {# Mapping pour transformer le chiffre en classe Tailwind #}
    {% set gridClasses = {
        '1': 'grid-cols-1',
        '2': 'grid-cols-2',
        '3': 'grid-cols-3',
        '4': 'grid-cols-4'
    } %}

    <div {{ block('widget_container_attributes') }}
            class="grid {{ gridClasses[cols]|default('grid-cols-1') }} gap-4">

        {%- for child in form %}
            <div class="flex items-center gap-2">
                {{- form_widget(child, {
                    'attr': child.vars.attr|merge({
                        'class': 'focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300',
                        'aria-describedby': (child.vars.attr['aria-describedby']|default('') ~ ' ' ~ attr['aria-describedby']|default(''))|trim,
                        'aria-invalid': attr['aria-invalid']|default('false')
                    })
                }) -}}
                {{- form_label(child, null, {
                    'label_attr': {'for': child.vars.id, 'class': 'text-sm font-medium text-gray-700'}
                }) -}}
            </div>
        {% endfor -%}
    </div>
{% endblock choice_widget_expanded %}

{% block radio_label %}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' text-sm font-medium text-gray-700 cursor-pointer')|trim}) -%}
    <label{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- label|trans({}, translation_domain) -}}
    </label>
{% endblock radio_label %}

{% block entity_with_add_row %}
    <div {{ stimulus_controller('entity_with_add') }}>
        {{- form_row(form) -}}
    </div>
{% endblock %}

{% block entity_with_add_widget %}
    <div class="flex flex-col gap-1">
        <div class="flex-1">
            {{ block('choice_widget') }}
        </div>
        <div>
            <button
                    {{ stimulus_action('entity_with_add', 'showAdd', 'click') }}
                    type="button"
                    class="text-emerald-600 hover:underline text-sm font-medium mt-1 p-0 bg-transparent"
            >
                {% if iconAdd is defined and iconAdd != '' %}<i
                class="{{ iconAdd }} mr-1 text-emerald-600"></i>{% endif %}Ajouter
            </button>
        </div>
    </div>
    <div class="mt-2 hidden" {{ stimulus_target('entity_with_add', 'zoneAdd') }}>
        <div class="flex items-center gap-4">
            <div class="flex-1">
                <label for="{{ name_field_to_add }}" class="sr-only">{{ name_field_to_add }}</label>
                <input type="text" class="w-full p-2 bg-white border border-secondary-200 rounded-sm text-secondary-700"
                       name="{{ name_field_to_add }}" id="{{ name_field_to_add }}">
                <span class="text-sm text-secondary-500 block mt-1">{{ help_to_add }}</span>
            </div>
            <div class="flex-none w-24">
                &nbsp;
            </div>
        </div>
    </div>
{% endblock %}


{% block inline_create_entity_select_row %}
    {% set helpContent = form_help(form) %}
    {% set widgetAttr = attr %}
    {% set descriptions = widgetAttr['aria-describedby']|default('')|split(' ') %}
    {% if helpContent|trim != '' and (id ~ '_help') not in descriptions %}
        {% set descriptions = descriptions|merge([id ~ '_help']) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% if (id ~ '_errors') not in descriptions %}{% set descriptions = descriptions|merge([id ~ '_errors']) %}{% endif %}
        {% set widgetAttr = widgetAttr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {% if descriptions|join(' ')|trim != '' %}
        {% set widgetAttr = widgetAttr|merge({'aria-describedby': descriptions|join(' ')|trim}) %}
    {% endif %}
    <div class="field-group space-y-2 group mb-4" data-controller="inline-create">
        <div class="flex justify-between items-center">
            {{ block('form_label_inline_create_entity_select') }}
        </div>

        {% set entityAttr = form.entity.vars.attr|default({})|merge(widgetAttr) %}
        {% if form.entity.vars.attr['data-controller'] is defined and form.entity.vars.attr['data-controller'] not in entityAttr['data-controller']|default('') %}
            {% set entityAttr = entityAttr|merge({
                'data-controller': (entityAttr['data-controller']|default('') ~ ' ' ~ form.entity.vars.attr['data-controller'])|trim
            }) %}
        {% endif %}
        {% set entityAttr = entityAttr|merge({
            class: (entityAttr.class|default('') ~ ' select-field w-full p-4 bg-white border border-secondary-200 rounded-2xl font-semibold appearance-none cursor-pointer focus:ring-4 focus:ring-indigo-50')|trim,
            'data-inline-create-target': 'select',
            'data-inline-create-original-required': form.entity.vars.required ? '1' : '0'
        }) %}

        {{ form_widget(form.entity, {
            attr: entityAttr
        }) }}

        {{ form_widget(form.new, {
            attr: widgetAttr|merge({
                class: 'input-field hidden w-full p-4 bg-emerald-50 border border-emerald-200 rounded-2xl font-semibold outline-none',
                'data-inline-create-target': 'newInput',
                'data-inline-create-original-required': form.entity.vars.required ? '1' : '0'

            })
        }) }}
        {{ helpContent|raw }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{# templates/form/cards_choice_theme.html.twig #}

{% block cards_choice_widget %}
    <div class="space-y-4 w-full"
            {% if on_change_action or event_name or update_target %}
                data-controller="cards-choice"
                {% if event_name %}data-cards-choice-event-name-value="{{ event_name }}"{% endif %}
                {% if update_target %}data-cards-choice-update-target-value="{{ update_target }}"{% endif %}
            {% endif %}
    >

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ columns|default(3) }} gap-4">
            {% for child in form %}
                {% set subtitle = child.vars.attr['data-card-subtitle'] ?? '' %}
                {% set icon = child.vars.attr['data-card-icon'] ?? '' %}
                {% set childId = child.vars.id %}

                <div class="relative min-h-full">
                    {# 1. L'input est le premier élément du bloc #}
                    {{ form_widget(child, {
                        id: childId,
                        attr: {
                            class: 'sr-only peer',
                            name: full_name,
                            'data-action': on_change_action ?: 'change->cards-choice#changed'
                        }
                    }) }}

                    {# 2. Le LABEL est un frère de l'input. On lui donne une classe de base. #}
                    <label for="{{ childId }}" class="relative flex flex-col h-full p-4 bg-white border-2 border-secondary-200 rounded-lg cursor-pointer transition-all
            peer-checked:border-indigo-600 peer-checked:ring-4 peer-checked:ring-indigo-50">

                        <div class="flex justify-between items-start mb-3">
                            {# ICI : On utilise les sélecteurs arbitraires de Tailwind pour cibler l'état du PEER (l'input) #}
                            <div class="w-10 h-10 bg-secondary-100 text-secondary-500 rounded-md flex items-center justify-center transition-colors
                    peer-checked:bg-indigo-600 peer-checked:text-white">
                                {% if icon %}
                                    <i class="{{ icon }} text-lg"></i>
                                {% endif %}
                            </div>

                            <div class="h-5 w-5 rounded-full border-2 border-secondary-300 flex items-center justify-center transition-all
                    peer-checked:border-indigo-600 peer-checked:bg-indigo-600">
                                <div class="h-2 w-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                            </div>
                        </div>

                        <span class="font-bold text-secondary-900 leading-tight">{{ child.vars.label|trans }}</span>

                        {% if subtitle %}
                            <span class="text-xs text-secondary-500 mt-1 italic">{{ subtitle|trans }}</span>
                        {% endif %}
                    </label>
                </div>
            {% endfor %}
        </div>

        {% if form.vars.help %}
            <p class="text-xs text-secondary-500">{{ form.vars.help }}</p>
        {% endif %}
    </div>
{% endblock %}

{% block checkbox_row %}
    {% set helpContent = form_help(form) %}
    {% set widgetAttr = attr %}
    {% set descriptions = widgetAttr['aria-describedby']|default('')|split(' ') %}
    {% if helpContent|trim != '' and (id ~ '_help') not in descriptions %}
        {% set descriptions = descriptions|merge([id ~ '_help']) %}
    {% endif %}
    {% if errors|length > 0 %}
        {% if (id ~ '_errors') not in descriptions %}{% set descriptions = descriptions|merge([id ~ '_errors']) %}{% endif %}
        {% set widgetAttr = widgetAttr|merge({'aria-invalid': 'true'}) %}
    {% endif %}
    {% if descriptions|join(' ')|trim != '' %}
        {% set widgetAttr = widgetAttr|merge({'aria-describedby': descriptions|join(' ')|trim}) %}
    {% endif %}
    <div>
        {{ form_errors(form) }}

        <div class="flex items-start gap-3">
            {{ form_widget(form, {
                attr: widgetAttr|merge({
                    class: 'mt-1 h-4 w-4 rounded border-gray-300 dark:border-secondary-600 dark:bg-secondary-900 dark:checked:bg-indigo-600 dark:checked:border-indigo-600'
                })
            }) }}
            {{ form_label(form) }}
        </div>
    </div>
    {{ helpContent|raw }}
{% endblock %}

{# Widget pour le type JsonConfig #}
{% block json_config_widget %}
    <div
            data-controller="json-config"
            data-json-config-value="{{ value|json_encode|e('html_attr') }}"
            class="space-y-3"
    >
        {% if help_text %}
            <div class="text-sm text-gray-600 mb-2">{{ help_text }}</div>
        {% endif %}

        {# Onglets pour basculer entre les modes #}
        <div class="flex gap-2 border-b border-gray-200">
            <button
                    type="button"
                    data-action="click->json-config#switchToWizard"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-transparent hover:border-gray-300 transition-colors"
            >
                <i class="fas fa-wand-magic-sparkles mr-1"></i> Mode Assistant
            </button>
            <button
                    type="button"
                    data-action="click->json-config#switchToJson"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-primary transition-colors"
            >
                <i class="fas fa-code mr-1"></i> Mode JSON
            </button>
        </div>

        {# MODE WIZARD #}
        <div data-json-config-target="wizardMode" class="hidden space-y-3">
            <div class="bg-blue-50 border border-blue-200 rounded-md p-3 text-sm text-blue-800">
                <i class="fas fa-info-circle mr-1"></i>
                Ajoutez vos configurations ligne par ligne. Les modifications sont automatiquement converties en JSON.
            </div>

            {# En-têtes des colonnes #}
            <div class="grid grid-cols-12 gap-2 px-3 text-xs font-semibold text-gray-600 uppercase">
                <div class="col-span-3">Clé</div>
                <div class="col-span-2">Type</div>
                <div class="col-span-6">Valeur</div>
                <div class="col-span-1"></div>
            </div>

            {# Conteneur pour les lignes du wizard #}
            <div data-json-config-target="wizardContainer" class="space-y-2"></div>

            {# Bouton pour ajouter une ligne #}
            <button
                    type="button"
                    data-action="click->json-config#addNewWizardRow"
                    class="w-full px-3 py-2 text-sm bg-green-50 hover:bg-green-100 text-green-700 border border-green-300 rounded-md transition-colors"
            >
                <i class="fas fa-plus mr-1"></i> Ajouter une configuration
            </button>

            {# Bouton pour revenir au JSON #}
            <div class="flex justify-end">
                <button
                        type="button"
                        data-action="click->json-config#switchToJson"
                        class="px-4 py-2 text-sm bg-primary text-white rounded-md hover:bg-primary-dark transition-colors"
                >
                    <i class="fas fa-check mr-1"></i> Appliquer et voir le JSON
                </button>
            </div>
        </div>

        {# MODE JSON #}
        <div data-json-config-target="jsonMode" class="space-y-2">
            <div class="relative">
                <textarea
                    {{ block('widget_attributes') }}
                    data-json-config-target="textarea"
                    data-action="blur->json-config#validate"
                    class="w-full px-3 py-2 border rounded-md font-mono text-sm min-h-[200px] focus:ring-2 focus:ring-primary focus:border-primary"
                    placeholder='{"clé": "valeur", "autre_clé": "autre_valeur"}'
                >{{ value|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</textarea>

                {# Indicateur de validation #}
                <div
                        data-json-config-target="validation"
                        class="hidden mt-1 text-sm"
                ></div>
            </div>

            {% if add_button_text %}
                <div class="flex gap-2">
                    <button
                            type="button"
                            data-action="click->json-config#format"
                            class="px-3 py-1 text-sm bg-gray-100 hover:bg-gray-200 rounded-md transition-colors"
                    >
                        <i class="fas fa-magic mr-1"></i> Formater JSON
                    </button>

                    <button
                            type="button"
                            data-action="click->json-config#clear"
                            class="px-3 py-1 text-sm bg-red-50 hover:bg-red-100 text-red-600 rounded-md transition-colors"
                    >
                        <i class="fas fa-trash mr-1"></i> Vider
                    </button>
                </div>
            {% endif %}
        </div>

        {# Aide contextuelle (visible dans les deux modes) #}
        <details class="mt-3">
            <summary class="cursor-pointer text-sm text-gray-600 hover:text-gray-800">
                <i class="fas fa-info-circle mr-1"></i> Aide sur le format JSON
            </summary>
            <div class="mt-2 p-3 bg-gray-50 rounded-md text-sm space-y-2">
                <p><strong>Format valide :</strong></p>
                <pre class="bg-white p-2 rounded border text-xs">{
  "clé": "valeur",
  "nombre": 123,
  "booléen": true,
  "tableau": ["item1", "item2"]
}</pre>
                <p class="text-xs text-gray-600">
                    <i class="fas fa-lightbulb mr-1"></i>
                    <strong>Mode Assistant :</strong> Ajoutez vos configurations ligne par ligne avec une interface
                    simple.
                    <br>
                    <strong>Mode JSON :</strong> Éditez directement le JSON si vous êtes à l'aise avec ce format.
                </p>
            </div>
        </details>
    </div>
{% endblock %}

{% macro resolved_help_key(form, help, parameters) %}
    {%- import _self as macros -%}
    {%- if help is not empty and help != '-' -%}
        {{- help -}}
    {%- elseif parameters['%transition%']|default(null) and parameters['%field%']|default(null) -%}
        {{- 'workflow.' ~ parameters['%transition%'] ~ '.' ~ parameters['%field%'] ~ '.help' -}}
    {%- else -%}
        {{- macros.form_parent_help_name(form) -}}
    {%- endif -%}
{% endmacro %}

{% macro resolved_help_content(form, help, parameters, translation_domain, help_html) %}
    {%- apply spaceless -%}
        {%- import _self as macros -%}
        {%- if help is same as(false) -%}
            {# Aide explicitement désactivée #}
        {%- elseif help is not empty and help != '-' -%}
            {%- if translation_domain is same as(false) -%}
                {{- help_html ? help|raw : help -}}
            {%- else -%}
                {{- help|trans(parameters|default({}), translation_domain|default('help'))|raw -}}
            {%- endif -%}
        {%- elseif parameters['%transition%']|default(null) and parameters['%field%']|default(null) -%}
            {%- set wf_key = 'workflow.' ~ parameters['%transition%'] ~ '.' ~ parameters['%field%'] ~ '.help' -%}
            {%- set wf_trans = wf_key|trans(parameters|default({}), 'help') -%}
            {%- if wf_trans != wf_key and wf_trans|trim != '' -%}
                {{- wf_trans|raw -}}
            {%- endif -%}
        {%- else -%}
            {%- set key1 = (macros.form_parent_help_name(form) ~ '')|trim -%}
            {%- set trans1 = key1 != '' ? key1|trans(parameters|default({}), 'help') : '' -%}
            {%- if trans1 != key1 and trans1|trim != '' -%}
                {{- trans1|raw -}}
            {%- elseif key1 ends with '.help' -%}
                {%- set key2 = key1|slice(0, -5) -%}
                {%- set trans2 = key2 != '' ? key2|trans(parameters|default({}), 'help') : '' -%}
                {%- if trans2 != key2 and trans2|trim != '' -%}
                    {{- trans2|raw -}}
                {%- endif -%}
            {%- else -%}
                {%- set key3 = key1 ~ '.help' -%}
                {%- set trans3 = key1 != '' ? key3|trans(parameters|default({}), 'help') : '' -%}
                {%- if trans3 != key3 and trans3|trim != '' -%}
                    {{- trans3|raw -}}
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}
    {%- endapply -%}
{% endmacro %}

{# A summary is rendered inside the form, including when the form is returned in a modal stream. #}
{% block form_start %}
    {{ parent() }}
    {{ include('communs/_form_error_summary.html.twig', {errorForm: form}, with_context: false) }}
{% endblock %}
