<div id="parcours_voir_actions" class="flex flex-wrap gap-2 justify-start lg:justify-end">
    {% set isParcoursEditable = isEditable is defined ? isEditable : isEditable(dpeParcours) %}
    {% set userCanEdit = is_granted('ROLE_ADMIN')
        or is_granted('EDIT', parcours)
        or is_granted('EDIT', {route: 'app_composante', subject: dpeParcours})
        or is_granted('EDIT', {route: 'app_formation', subject: dpeParcours})
        or is_granted('EDIT', {route: 'app_parcours', subject: dpeParcours})
        or is_granted('EDIT', {route: 'app_etablissement', subject: dpeParcours}) %}
    {% set canEditParcours = isParcoursEditable and userCanEdit %}
    {% set canSeeActions = userCanEdit
        or is_granted('RELATED_TO_PARCOURS', parcours)
        or is_granted('SHOW', parcours)
        or is_granted('SHOW', {route: 'app_composante', subject: dpeParcours})
        or is_granted('SHOW', {route: 'app_formation', subject: dpeParcours})
        or is_granted('SHOW', {route: 'app_parcours', subject: dpeParcours})
        or is_granted('SHOW', {route: 'app_etablissement', subject: dpeParcours}) %}

    {% if canSeeActions %}
        <twig:Button
                href="{{ canEditParcours ? path('parcours_v2_modifier', {parcours: parcours.id}) : '' }}"
                variant="warning"
                :soft="false"
                :outline="true"
                size="sm"
                icon="icon:edit"
                label="Modifier le parcours"
                :disabled="not canEditParcours"
                tooltip="{{ canEditParcours ? 'Modifier le parcours' : 'Parcours verrouillé' }}"
        />
        {% if isParcoursEditable or is_granted('ROLE_ADMIN') %}
            <twig:Button
                    href="{{ path('parcours_v2_dupliquer', {parcours: parcours.id}) }}"
                    variant="primary"
                    :soft="false"
                    :outline="true"
                    size="sm"
                    icon="icon:duplicate"
                    label="Dupliquer"
                    tooltip="Dupliquer l'intégralité du parcours"
                    dataAction="click->modalturbo#open"
            />
        {% endif %}
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button
                href="{{ path('parcours_v2_supprimer', {parcours: parcours.id}) }}"
                variant="danger"
                :soft="false"
                :outline="true"
                size="sm"
                icon="icon:trash"
                label="Supprimer définitivement"
                tooltip="Supprimer définitivement ce parcours (Admin)"
                dataAction="click->modalturbo#open"
        />
    {% endif %}
</div>
