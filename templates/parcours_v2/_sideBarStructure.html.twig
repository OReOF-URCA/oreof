<div class="space-y-1">
    {% for annee in dto.annees %}
        <div class="flex items-center p-2 bg-gray-200 rounded-md text-[11px] font-black text-secondary-500">
                                <span class="inline-flex items-center gap-1 whitespace-nowrap">
{#                                    <a href="{{ path('parcours_v2_annee', { parcours: parcours.id, annee: annee.annee.id }) }}" #}
                                    {#                                       data-turbo-frame="tab-content" #}
                                    {#                                       data-turbo-action="advance" #}
                                    {#                                       data-tabs-target="tab" #}
                                    {#                                    > #}
                                        Année {{ annee.annee.ordre }}
                                    {% if annee.annee.isOuvert == false %}
                                        <span class="inline-flex items-center gap-1">
                                            <twig:UX:icon name="mdi:do-not-enter-outline" class="h-4 w-4"/>
                                            <span>Non ouvert</span>
                                        </span>
                                    {% endif %}
                                    {#                                    </a> #}
                                </span>
            {#            <div class="flex items-center gap-2 ml-auto"> #}
            {#                <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span> #}
            {#            </div> #}
        </div>

        <div class="ml-4 pl-2 border-l border-secondary-700 space-y-1 pt-1">
            {% for sem in annee.semestres %}
                <div class="flex items-center p-2 text-[10px] font-bold text-secondary-500">
                    <span>
                        <a href="{{ path('parcours_v2_semestre', { parcours: parcours.id, semestreParcours: sem.semestreParcours.id }) }}"
                           data-turbo-frame="tab-content"
                           data-turbo-action="advance"
                           data-tabs-target="tab"
                        >
                        S{{ sem.semestreParcours.ordre }}
                            {% if sem.raccroche == true %}
                                <i class="fal fa-chain"></i>
                            {% endif %}
                            {% if sem.semestreParcours.isOuvert == false %}
                                <i class="fal fa-do-not-enter"></i> Non ouvert
                            {% endif %}
                        </a>
                    </span>
                    <div class="flex items-center gap-2 ml-auto">
                        <span class="text-[8px] opacity-80">{{ sem.heuresEctsSemestre.sommeSemestreEcts }} ECTS</span>
                        <twig:Dot :dto="sem.semestre.validationStatus|badgeValidationDot('xs')"/>
                    </div>
                </div>
            {% else %}
                <div class="flex items-center p-2 text-[10px] font-bold text-secondary-500">
                    Pas de semestres
                </div>
            {% endfor %}
        </div>
    {% endfor %}

    <div class="pt-2">
        <a href="{{ path('parcours_v2_saisie_rapide_heures', { parcours: parcours.id }) }}"
           class="flex items-center gap-2 p-2 rounded-lg text-xs font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition">
            <i class="fal fa-table-cells text-amber-600"></i>
            <span>Grille de saisie rapide</span>
        </a>
    </div>
</div>
