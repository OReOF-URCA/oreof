<turbo-frame id="tab-content">
    {{ include('parcours_v2/tabs/_header.html.twig', {tabKey: 'et_apres'}) }}

    <div class="flex-1 overflow-y-auto mt-4 custom-scrollbar">
        {% form_theme form 'communs/form_theme_v2.html.twig' %}
        {{ form_start(form, {
            attr: {
                id: 'tab_form_et_apres',
                'data-controller': 'autosave',
                'data-autosave-url-value': path('parcours_v2_tab_autosave', { id: parcours.id, tabKey: 'et_apres' }),
                'data-action': 'input->autosave#queue'

            }
        }) }}

        {{ form_errors(form) }}
        {{ form_widget(form) }}

        {% set romeCodes = [] %}
        {% for rome in parcours.codesRome|default([]) %}
            {% if rome.code is defined %}
                {% set romeCodes = romeCodes|merge([rome.code|upper]) %}
            {% endif %}
        {% endfor %}

        {% set isRomeApiConnected = parcours.hasRomeApi %}
        {% set romeConfig = parcours.romeApiConfiguration %}

        <div class="space-y-2 group mb-6 rounded-xl border border-secondary-200 bg-white p-4 shadow-xs dark:border-secondary-700 dark:bg-secondary-900"
                {{ stimulus_controller('parcours--rome', {
                    initialCodes: romeCodes,
                    apiConnected: isRomeApiConnected,
                    searchUrl: path('parcours_v2_rome_search', { id: parcours.id }),
                    verifyUrl: path('parcours_v2_rome_verify', { id: parcours.id })
                }) }}>
            <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                <div class="flex items-center gap-2">
                    <label class="text-[12px] font-black text-secondary-500 uppercase">
                        {{ 'parcours_step6.labels.codeRome'|trans({}, 'form') }}
                    </label>
                    <span class="text-[10px] font-bold text-red-300 uppercase">Champs Requis</span>
                </div>
                <div class="flex items-center gap-2">
                    {% if isRomeApiConnected %}
                        <twig:Badge
                            label="API ROME 4.0 connectée"
                            variant="success"
                            icon="icon:check-circle"
                            size="sm"
                        />
                        <button type="button"
                                data-action="click->parcours--rome#verifyConsistency"
                                class="inline-flex items-center gap-1 text-[11px] font-semibold text-primary-600 hover:text-primary-700 hover:underline dark:text-primary-400 cursor-pointer"
                                title="Vérifier la cohérence de tous les codes auprès du référentiel ROME">
                            <twig:UX:Icon name="icon:sync" class="w-3 h-3"/>
                            <span>Vérifier cohérence</span>
                        </button>
                        <span data-parcours--rome-target="verifyLoader" class="hidden text-[11px] text-secondary-400 italic">
                            Vérification en cours...
                        </span>
                    {% else %}
                        <twig:Badge
                            label="Saisie manuelle"
                            variant="secondary"
                            icon="icon:info"
                            size="sm"
                        />
                    {% endif %}
                </div>
            </div>

            {# Champ texte unique (CSV) persisté par autosave #}
            <input type="hidden"
                   name="parcours_step6[codesRome]"
                    {{ stimulus_target('parcours--rome', 'codesText') }}>

            {# Zone de saisie / recherche #}
            <div class="relative">
                <div class="flex items-start gap-2">
                    <label class="sr-only" for="parcours_step6_codesRome_input">Code ou métier ROME</label>
                    <div class="relative flex-1">
                        <input id="parcours_step6_codesRome_input"
                               type="text"
                               autocomplete="off"
                               placeholder="{{ isRomeApiConnected ? 'Rechercher un métier par nom ou taper un code ROME (ex: M1805, Développeur)...' : 'Ex: M1805' }}"
                               class="w-full p-2 bg-secondary-50 border border-secondary-200 rounded-sm font-semibold text-sm placeholder:text-secondary-400 dark:bg-secondary-800 dark:border-secondary-700 dark:text-secondary-100"
                                {{ stimulus_target('parcours--rome', 'codeInput') }}
                                {{ stimulus_action('parcours--rome', 'onSearchInput', 'input') }}
                                {{ stimulus_action('parcours--rome', 'addCodeFromEnter', 'keydown') }}>

                        {% if isRomeApiConnected %}
                            {# Liste déroulante des résultats de recherche API #}
                            <div data-parcours--rome-target="searchResults"
                                 class="hidden absolute z-50 left-0 right-0 mt-1 max-h-64 overflow-y-auto rounded-lg border border-secondary-200 bg-white shadow-xl dark:border-secondary-700 dark:bg-secondary-900 custom-scrollbar">
                            </div>
                        {% endif %}
                    </div>

                    <button type="button"
                            class="inline-flex items-center gap-1 rounded-sm bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition cursor-pointer shrink-0"
                            {{ stimulus_action('parcours--rome', 'addCode', 'click') }}>
                        <twig:UX:Icon name="icon:add" class="w-4 h-4"/>
                        <span>Ajouter</span>
                    </button>
                </div>
            </div>

            {# Liste des codes ROME sélectionnés et vérifiés #}
            <div {{ stimulus_target('parcours--rome', 'listeCodes') }}></div>

            <p class="text-[11px] text-secondary-400 italic mt-2 pl-1 flex items-start gap-2">
                <span class="flex-shrink-0 w-4 h-4 bg-secondary-200 text-secondary-500 flex items-center justify-center text-[10px] rounded-full dark:bg-secondary-800 dark:text-secondary-400">
                    <twig:UX:Icon name="icon:info" class="w-3 h-3"/>
                </span>
                <span>
                    {% if isRomeApiConnected %}
                        L'API ROME 4.0 vérifie automatiquement la cohérence des codes et associe l'intitulé officiel du métier. Vous pouvez rechercher directement par nom de métier ou saisir un code ROME (1 lettre + 4 chiffres).
                    {% else %}
                        {{ 'parcours_step6.helps.codeRome.help'|trans({}, 'help')|raw }}
                    {% endif %}
                </span>
            </p>
        </div>


        {{ form_end(form) }}
    </div>

</turbo-frame>
