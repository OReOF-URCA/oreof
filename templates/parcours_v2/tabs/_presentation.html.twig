<turbo-frame id="tab-content">
    {% set canEdit = canEditTab ?? isTabEditable(parcours, 'presentation') %}
    {{ include('parcours_v2/tabs/_header.html.twig', {tabKey: 'presentation', withNoDone: not canEdit}) }}

    <div class="flex-1 overflow-y-auto mt-4 custom-scrollbar">
        {% if not canEdit or form is null %}
            <twig:alerte type="warning">
                Cet onglet n'est pas modifiable dans le niveau d'ouverture actuel du parcours. Affichage en lecture seule.
            </twig:alerte>
            <div class="mt-4 space-y-4">
                {{ include('parcours_v2/sections/_presentationParcours.html.twig', {parcours: parcours}) }}
                {{ include('parcours_v2/sections/_localisationParcours.html.twig', {parcours: parcours}) }}
            </div>
        {% else %}
        {% form_theme form 'communs/form_theme_v2.html.twig' %}
        {{ form_start(form, {
            attr: {
                id: 'tab_form_presentation',
                'data-controller': 'autosave',
                'data-autosave-url-value': path('parcours_v2_tab_autosave', { id: parcours.id, tabKey: 'presentation' }),
                'data-action': 'change->autosave#queue'

            }
        }) }}

        {{ form_errors(form) }}
        {{ form_widget(form) }}

        {{ form_end(form) }}

            {# Gestion des logos du parcours et liens web #}
            <div class="mt-6 rounded-2xl border border-secondary-200 bg-white p-5 shadow-sm dark:border-secondary-700 dark:bg-secondary-900"
                    {{ stimulus_controller('parcours-logos', {
                        logosUrl: path('parcours_v2_logos', {parcours: parcours.id, editable: true}),
                        uploadLogoUrl: path('parcours_v2_upload_logo', {parcours: parcours.id}),
                        deleteLogoUrl: path('parcours_v2_delete_logo', {parcours: parcours.id}),
                        updateLogoUrl: path('parcours_v2_update_logo_url', {parcours: parcours.id})
                    }) }}>
                <div class="flex items-center justify-between border-b border-secondary-200 dark:border-secondary-700 pb-3 mb-4">
                    <div class="flex items-center gap-2">
                    <span class="p-2 rounded-xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400">
                        <twig:UX:Icon name="icon:info" class="w-5 h-5"/>
                    </span>
                        <div>
                            <h4 class="text-sm font-bold text-secondary-800 dark:text-secondary-100">Logos du parcours
                                et liens web</h4>
                            <p class="text-xs text-secondary-400 mt-0.5">Ajoutez un ou plusieurs logos pour identifier
                                ce parcours (partenaires, certifications, etc.) et associez-y un lien web si besoin.</p>
                        </div>
                    </div>
                </div>

                {# Liste des logos actuels #}
                <div class="mb-5">
                    <h5 class="text-xs font-bold uppercase tracking-wider text-secondary-400 dark:text-secondary-500 mb-3">
                        Logos enregistrés</h5>
                    {{ include('parcours_v2/tabs/_logos.html.twig', {parcours: parcours, editable: true}) }}
                </div>

                {# Formulaire d'ajout de logo #}
                <div class="rounded-xl border border-dashed border-secondary-300 dark:border-secondary-700 p-4 bg-secondary-50/50 dark:bg-secondary-800/30">
                    <h5 class="text-xs font-bold uppercase tracking-wider text-secondary-500 mb-3 flex items-center gap-1.5">
                        <twig:UX:Icon name="icon:add" class="w-4 h-4 text-primary-500"/>
                        Ajouter un nouveau logo
                    </h5>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-end">
                        <div>
                            <label class="block text-xs font-semibold text-secondary-600 dark:text-secondary-400 mb-1">
                                Fichier image (PNG, JPEG uniquement - max 10 Mo)
                            </label>
                            <input type="file"
                                   accept="image/png, image/jpeg"
                                   class="block w-full text-xs text-secondary-600 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:bg-secondary-800 dark:file:text-primary-400 border border-secondary-300 dark:border-secondary-600 rounded-lg p-1 bg-white dark:bg-secondary-800"
                                   data-parcours-logos-target="fileInput">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-secondary-600 dark:text-secondary-400 mb-1">
                                Lien web associé (optionnel)
                            </label>
                            <input type="url"
                                   placeholder="https://example.com"
                                   class="w-full text-xs py-2 px-3 rounded-lg border border-secondary-300 dark:border-secondary-600 dark:bg-secondary-800"
                                   data-parcours-logos-target="urlInput">
                        </div>
                    </div>

                    <div class="mt-3 flex items-center justify-between">
                        <twig:Button
                                type="button"
                                variant="primary"
                                :soft="false"
                                :outline="false"
                                icon="icon:upload"
                                label="Ajouter ce logo"
                                dataAction="click->parcours-logos#uploadLogo"
                                size="sm"
                        />
                        <div id="parcours-logo-upload-errors" data-parcours-logos-target="errors"></div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</turbo-frame>
