<turbo-frame id="tab-content">
    {{ include('parcours_v2/tabs/_header.html.twig', {tabKey: 'configuration', withNoDone: true}) }}

    <div class="flex-1 overflow-y-auto mt-4 custom-scrollbar">
        {% form_theme form 'communs/form_theme_v2.html.twig' %}
        {{ form_start(form, {
            attr: {
                id: 'tab_form_presentation',
                'data-controller': 'autosave',
                'data-autosave-url-value': path('parcours_v2_tab_autosave', { id: parcours.id, tabKey: 'configuration' }),
                'data-action': 'change->autosave#queue'

            }
        }) }}

        {{ form_errors(form) }}
        {{ form_row(form.descriptifHautPageAutomatique) }}
        {{ form_row(form.descriptifHautPage) }}
        {{ form_row(form.descriptifBasPage) }}

        <div class="mt-4 p-4 rounded-xl border border-secondary-200 bg-white dark:border-secondary-700 dark:bg-secondary-900 shadow-xs">
            <twig:RncpField :form="form.codeRNCP" :parcoursId="parcours.id" />
        </div>

        {{ form_end(form) }}
    </div>
</turbo-frame>
