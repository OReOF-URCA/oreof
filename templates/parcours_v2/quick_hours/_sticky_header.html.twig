<div class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-secondary-200 shadow-sm px-4 py-2.5">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
        <div class="flex items-center gap-3">
            <a href="{{ path('parcours_v2_modifier', { parcours: parcours.id }) }}"
               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-secondary-700 hover:bg-secondary-100 border border-secondary-300 transition-colors">
                <i class="fal fa-arrow-left"></i> Retour au parcours
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-secondary-500 uppercase tracking-wider">{{ formation.display }}</span>
                    <span class="text-secondary-300">•</span>
                    <h1 class="text-base font-black text-secondary-900 leading-tight">
                        {{ parcours.libelle }}
                    </h1>
                </div>
                <div class="text-[11px] text-secondary-500 font-medium">
                    Modalités : <span class="font-bold text-secondary-700">{{ parcours.modalitesEnseignement.libelle() }}</span>
                </div>
            </div>
        </div>

        {# Sélecteur de version de référence #}
        <div class="flex items-center gap-2">
            <label for="referenceVersionSelect" class="text-xs font-bold text-secondary-600 flex items-center gap-1.5">
                <i class="fal fa-history text-indigo-600"></i> Réf. comparative :
            </label>
            <select id="referenceVersionSelect"
                    class="text-xs font-medium rounded-lg border-secondary-300 bg-secondary-50 text-secondary-800 py-1.5 px-2.5 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer shadow-sm"
                    data-action="change->parcours--quick-hours-grid#changeReference">
                {% if referenceOptions is empty %}
                    <option value="">Aucune référence disponible</option>
                {% else %}
                    {% for opt in referenceOptions %}
                        <option value="{{ opt.id }}" {% if selectedRef == opt.id or (selectedRef is empty and opt.isDefault) %}selected{% endif %}>
                            {{ opt.label }}
                        </option>
                    {% endfor %}
                {% endif %}
            </select>
        </div>
    </div>

    {# Barre d'écarts / Mémoire du stock (Sticky Delta Buffer) #}
    <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-secondary-100 text-xs">
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-black uppercase tracking-wider text-secondary-500 flex items-center gap-1">
                <i class="fal fa-layer-group text-secondary-400"></i> Écarts cumulés :
            </span>

            <span data-parcours--quick-hours-grid-target="stockCmPres" class="inline-flex"></span>
            <span data-parcours--quick-hours-grid-target="stockTdPres" class="inline-flex"></span>
            <span data-parcours--quick-hours-grid-target="stockTpPres" class="inline-flex"></span>
            <span data-parcours--quick-hours-grid-target="stockTePres" class="inline-flex"></span>

            {% if modalite != null and modalite.value != 0 %}
                <span data-parcours--quick-hours-grid-target="stockCmDist" class="inline-flex"></span>
                <span data-parcours--quick-hours-grid-target="stockTdDist" class="inline-flex"></span>
                <span data-parcours--quick-hours-grid-target="stockTpDist" class="inline-flex"></span>
            {% endif %}

            <div class="h-4 w-px bg-secondary-300 mx-1"></div>

            <span class="font-bold text-secondary-700">Total global :</span>
            <span data-parcours--quick-hours-grid-target="stockTotalGlobal" class="inline-flex font-black"></span>
        </div>

        {# Buffer & Point de repère temporaire #}
        <div class="flex items-center gap-2 bg-secondary-50 px-2.5 py-1 rounded-lg border border-secondary-200">
            <span class="text-[11px] font-semibold text-secondary-600">Solde repère :</span>
            <span data-parcours--quick-hours-grid-target="stockTargetBalance" class="font-black text-xs px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                0h
            </span>
            <button type="button"
                    class="px-2 py-0.5 text-[11px] font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded border border-indigo-200 transition"
                    data-action="click->parcours--quick-hours-grid#setTargetReference"
                    title="Prendre l'état actuel comme point zéro pour mesurer un ajustement">
                <i class="fal fa-flag"></i> Poser repère
            </button>
            <button type="button"
                    class="px-1.5 py-0.5 text-[11px] text-secondary-500 hover:text-rose-600 hover:bg-rose-50 rounded transition"
                    data-action="click->parcours--quick-hours-grid#resetTargetReference"
                    title="Réinitialiser le repère">
                <i class="fal fa-undo"></i>
            </button>
        </div>
    </div>
</div>
