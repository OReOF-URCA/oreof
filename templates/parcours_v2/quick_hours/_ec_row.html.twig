{% set elem = ec.elementConstitutif %}
{% set h = ec.heuresEctsEc %}

{# Recherche de la référence correspondante #}
{% set refEc = null %}
{% if referenceData.ecs['id_' ~ elem.id] is defined %}
    {% set refEc = referenceData.ecs['id_' ~ elem.id] %}
{% elseif elem.code is not empty and referenceData.ecs['code_' ~ elem.code|trim|upper] is defined %}
    {% set refEc = referenceData.ecs['code_' ~ elem.code|trim|upper] %}
{% elseif elem.libelle is not empty and referenceData.ecs['libelle_' ~ elem.libelle|trim|lower] is defined %}
    {% set refEc = referenceData.ecs['libelle_' ~ elem.libelle|trim|lower] %}
{% endif %}

{% set refEcts = refEc ? (refEc.ects ?? 0) : 0 %}
{% set refCmP = refEc ? refEc.cmPres : 0 %}
{% set refTdP = refEc ? refEc.tdPres : 0 %}
{% set refTpP = refEc ? refEc.tpPres : 0 %}
{% set refTeP = refEc ? refEc.tePres : 0 %}
{% set refCmD = refEc ? refEc.cmDist : 0 %}
{% set refTdD = refEc ? refEc.tdDist : 0 %}
{% set refTpD = refEc ? refEc.tpDist : 0 %}
{% set refGlobal = refEc ? refEc.totalGlobal : 0 %}

{% set curEcts = h ? h.ects : (elem.ects ?? 0) %}
{% set curCmP = h ? h.cmPres : 0 %}
{% set curTdP = h ? h.tdPres : 0 %}
{% set curTpP = h ? h.tpPres : 0 %}
{% set curTeP = h ? h.tePres : 0 %}
{% set curCmD = h ? h.cmDist : 0 %}
{% set curTdD = h ? h.tdDist : 0 %}
{% set curTpD = h ? h.tpDist : 0 %}
{% set curGlobal = curCmP + curTdP + curTpP + curCmD + curTdD + curTpD %}
{% set deltaGlobal = curGlobal - refGlobal %}

{% set isParcoursProprietaire = elem.ficheMatiere == null or elem.ficheMatiere.parcours == null or elem.ficheMatiere.parcours.id == parcours.id %}
{% set isVolumesImposes = elem.ficheMatiere != null and elem.ficheMatiere.volumesHorairesImpose %}
{% set isHeuresSpecifiques = elem.heuresSpecifiques %}
{% set isSansHeure = elem.sansHeure %}
{% set isAttached = elem.ficheMatiere != null and elem.ficheMatiere.parcours != null and elem.ficheMatiere.parcours.id != parcours.id %}
{% set isLocked = isVolumesImposes or (isAttached and not isHeuresSpecifiques) %}

<tr data-parcours--quick-hours-grid-target="ecRow"
    data-ec-id="{{ elem.id }}"
    data-ue-id="{{ ue.ue.id }}"
    data-semestre-id="{{ semestre.semestre.id }}"
    data-annee-id="{{ annee is defined and annee ? annee.id : (semestre.semestreParcours and semestre.semestreParcours.annee ? semestre.semestreParcours.annee.id : 0) }}"
    data-ref-ects="{{ refEcts }}"
    data-current-ects="{{ curEcts }}"
    data-ref-cm-pres="{{ refCmP }}"
    data-ref-td-pres="{{ refTdP }}"
    data-ref-tp-pres="{{ refTpP }}"
    data-ref-te-pres="{{ refTeP }}"
    data-ref-cm-dist="{{ refCmD }}"
    data-ref-td-dist="{{ refTdD }}"
    data-ref-tp-dist="{{ refTpD }}"
    data-ref-global="{{ refGlobal }}"
    data-current-total-global="{{ curGlobal }}"
    data-current-delta-global="{{ deltaGlobal }}"
    class="border-b border-secondary-100 hover:bg-indigo-50/30 transition-colors text-xs {% if isSansHeure %}bg-secondary-50/60 opacity-80{% endif %}">

    {# Code & Titre EC #}
    <td class="py-2.5 px-3 align-middle font-medium text-secondary-800 min-w-[220px]">
        <div class="flex items-center gap-2">
            <span class="font-black px-1.5 py-0.5 bg-indigo-100 text-indigo-800 rounded text-[11px] shrink-0">
                {{ elem.code ?: 'EC' }}
            </span>
            <span class="font-semibold text-secondary-800 truncate max-w-[200px]" title="{{ elem.display }}">
                {{ elem.display }}
            </span>
        </div>

        <div class="flex items-center gap-2 mt-1 flex-wrap text-[10px]">
            {% if elem.natureUeEc != null %}
                <span class="text-secondary-500 font-semibold">{{ elem.natureUeEc.libelle }}</span>
            {% endif %}

            {% if isVolumesImposes %}
                <span class="text-amber-700 bg-amber-100 px-1.5 py-0.2 rounded font-bold inline-flex items-center gap-1">
                    <i class="fas fa-lock text-[9px]"></i> Imposé
                </span>
            {% elseif isAttached %}
                <label class="inline-flex items-center gap-1 cursor-pointer text-indigo-600 hover:text-indigo-800 font-bold bg-indigo-50 px-1.5 py-0.2 rounded">
                    <input type="checkbox"
                           class="js-heures-specifiques-checkbox h-3 w-3 text-indigo-600 rounded"
                           {% if isHeuresSpecifiques %}checked{% endif %}
                           data-action="change->parcours--quick-hours-grid#toggleHeuresSpecifiques">
                    Spécifique
                </label>
            {% endif %}

            <label class="inline-flex items-center gap-1 cursor-pointer text-secondary-500 hover:text-secondary-700">
                <input type="checkbox"
                       class="js-sans-heure-checkbox h-3 w-3 text-secondary-600 rounded"
                       {% if isSansHeure %}checked{% endif %}
                       data-action="change->parcours--quick-hours-grid#toggleSansHeure">
                Sans heure
            </label>
        </div>
    </td>

    {# ECTS #}
    <td class="py-1 px-1.5 align-middle text-center w-16">
        <input type="number"
               step="0.5"
               min="0"
               data-field="ects"
               value="{{ curEcts }}"
               {% if isVolumesImposes %}disabled{% endif %}
               data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
               class="w-full text-center py-1 px-1 text-xs font-bold rounded border border-indigo-200 bg-indigo-50/40 text-indigo-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-secondary-100 disabled:text-secondary-400">
        <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
            réf: {{ refEcts|number_format(1, ',', '') }}
        </div>
    </td>

    {# CM Présentiel #}
    <td class="py-1 px-1.5 align-middle text-center w-16">
        <input type="number"
               step="0.5"
               min="0"
               data-field="cmPres"
               value="{{ curCmP }}"
               {% if isLocked or isSansHeure %}disabled{% endif %}
               data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
               class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-secondary-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-secondary-100 disabled:text-secondary-400">
        <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
            réf: {{ refCmP|number_format(1, ',', '') }}
        </div>
    </td>

    {# TD Présentiel #}
    <td class="py-1 px-1.5 align-middle text-center w-16">
        <input type="number"
               step="0.5"
               min="0"
               data-field="tdPres"
               value="{{ curTdP }}"
               {% if isLocked or isSansHeure %}disabled{% endif %}
               data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
               class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-secondary-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-secondary-100 disabled:text-secondary-400">
        <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
            réf: {{ refTdP|number_format(1, ',', '') }}
        </div>
    </td>

    {# TP Présentiel #}
    <td class="py-1 px-1.5 align-middle text-center w-16">
        <input type="number"
               step="0.5"
               min="0"
               data-field="tpPres"
               value="{{ curTpP }}"
               {% if isLocked or isSansHeure %}disabled{% endif %}
               data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
               class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-secondary-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-secondary-100 disabled:text-secondary-400">
        <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
            réf: {{ refTpP|number_format(1, ',', '') }}
        </div>
    </td>

    {# TE #}
    <td class="py-1 px-1.5 align-middle text-center w-16">
        <input type="number"
               step="0.5"
               min="0"
               data-field="tePres"
               value="{{ curTeP }}"
               {% if isLocked or isSansHeure %}disabled{% endif %}
               data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
               class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-secondary-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 disabled:bg-secondary-100 disabled:text-secondary-400">
        <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
            réf: {{ refTeP|number_format(1, ',', '') }}
        </div>
    </td>

    {# Colonnes Distanciel si applicable #}
    {% if modalite != null and modalite.value != 0 %}
        {# CM Distanciel #}
        <td class="py-1 px-1.5 align-middle text-center w-16 bg-primary-50/20">
            <input type="number"
                   step="0.5"
                   min="0"
                   data-field="cmDist"
                   value="{{ curCmD }}"
                   {% if isLocked or isSansHeure %}disabled{% endif %}
                   data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
                   class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-primary-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 disabled:bg-secondary-100 disabled:text-secondary-400">
            <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
                réf: {{ refCmD|number_format(1, ',', '') }}
            </div>
        </td>

        {# TD Distanciel #}
        <td class="py-1 px-1.5 align-middle text-center w-16 bg-primary-50/20">
            <input type="number"
                   step="0.5"
                   min="0"
                   data-field="tdDist"
                   value="{{ curTdD }}"
                   {% if isLocked or isSansHeure %}disabled{% endif %}
                   data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
                   class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-primary-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 disabled:bg-secondary-100 disabled:text-secondary-400">
            <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
                réf: {{ refTdD|number_format(1, ',', '') }}
            </div>
        </td>

        {# TP Distanciel #}
        <td class="py-1 px-1.5 align-middle text-center w-16 bg-primary-50/20">
            <input type="number"
                   step="0.5"
                   min="0"
                   data-field="tpDist"
                   value="{{ curTpD }}"
                   {% if isLocked or isSansHeure %}disabled{% endif %}
                   data-action="input->parcours--quick-hours-grid#onInput keydown->parcours--quick-hours-grid#onKeyDown"
                   class="w-full text-center py-1 px-1 text-xs font-semibold rounded border border-primary-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 disabled:bg-secondary-100 disabled:text-secondary-400">
            <div class="text-[9px] text-secondary-400 font-medium mt-0.5">
                réf: {{ refTpD|number_format(1, ',', '') }}
            </div>
        </td>
    {% endif %}

    {# Total EC #}
    <td class="py-2.5 px-2 align-middle text-center font-black text-secondary-900 w-16">
        <span data-parcours--quick-hours-grid-target="ecTotal">
            {{ curGlobal|number_format(1, ',', '') }}h
        </span>
        <div class="text-[9px] text-secondary-400 font-medium">
            réf: {{ refGlobal|number_format(1, ',', '') }}h
        </div>
    </td>

    {# Écart / Delta #}
    <td class="py-2.5 px-2 align-middle text-center w-20">
        <span data-parcours--quick-hours-grid-target="ecDelta">
            {% if deltaGlobal == 0 %}
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-secondary-100 text-secondary-600">0h</span>
            {% elseif deltaGlobal > 0 %}
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">+{{ deltaGlobal|number_format(1, ',', '') }}h</span>
            {% else %}
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">{{ deltaGlobal|number_format(1, ',', '') }}h</span>
            {% endif %}
        </span>
    </td>

    {# Statut Sauvegarde #}
    <td class="py-2.5 px-2 align-middle text-center w-10">
        <span data-parcours--quick-hours-grid-target="ecStatus">
            <i class="fal fa-circle-check text-secondary-300 text-xs"></i>
        </span>
    </td>
</tr>

{# Si EC enfants (EC à choix) #}
{% for ece in ec.elementsConstitutifsEnfants %}
    {{ include('parcours_v2/quick_hours/_ec_row.html.twig', {
        annee: annee,
        ec: ece,
        ue: ue,
        semestre: semestre,
        referenceData: referenceData,
        modalite: modalite,
        parcours: parcours
    }) }}
{% endfor %}
