{% form_theme form 'communs/form_theme_v2.html.twig' %}

<div class="space-y-4 text-text">

    {# 1. Bannière d'information #}
    <div class="rounded-xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-800 dark:bg-primary-950/40">
        <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/60 dark:text-primary-300">
                <twig:UX:Icon name="icon:duplicate" class="h-5 w-5" />
            </div>
            <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-sm font-bold text-primary-950 dark:text-primary-100">
                        {{ 'parcours_v2.modal_dupliquer.duplication_du_parcours'|trans({}, 'modal') }}
                    </h3>
                    <twig:Badge variant="info" size="sm" label="{{ 'parcours_v2.modal_dupliquer.copie_integrale'|trans({}, 'modal') }}" />
                </div>
                <p class="text-xs text-primary-800 dark:text-primary-200 leading-relaxed">
                    {{ 'parcours_v2.modal_dupliquer.vous_vous_appretez_a_dupliquer_le'|trans({}, 'modal') }} <strong>« {{ parcours.libelle }} »</strong> {{ 'parcours_v2.modal_dupliquer.au_sein_de_la_mention'|trans({}, 'modal') }}
                    <strong>{{ formation ? formation.displayLong : 'Non rattachée' }}</strong>.
                </p>
            </div>
        </div>
    </div>

    {# 2. Compteurs synthétiques de la maquette #}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <div class="rounded-xl border border-secondary-200 bg-surface p-2.5 text-center shadow-xs dark:border-secondary-700">
            <span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_dupliquer.semestres'|trans({}, 'modal') }}</span>
            <span class="text-lg font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.nbSemestres }}</span>
        </div>
        <div class="rounded-xl border border-secondary-200 bg-surface p-2.5 text-center shadow-xs dark:border-secondary-700">
            <span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_dupliquer.ues'|trans({}, 'modal') }}</span>
            <span class="text-lg font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.nbUes }}</span>
        </div>
        <div class="rounded-xl border border-secondary-200 bg-surface p-2.5 text-center shadow-xs dark:border-secondary-700">
            <span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_dupliquer.elements_ec'|trans({}, 'modal') }}</span>
            <span class="text-lg font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.nbEcs }}</span>
        </div>
        <div class="rounded-xl border border-secondary-200 bg-surface p-2.5 text-center shadow-xs dark:border-secondary-700">
            <span class="block text-xs text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_dupliquer.fiches_matieres'|trans({}, 'modal') }}</span>
            <span class="text-lg font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.nbFichesMatieres }}</span>
        </div>
    </div>

    {# 3. Avertissements sur dépendances / mutualisations le cas échéant #}
    {% if analysis.hasWarnings %}
        <div class="space-y-2">
            {% for warning in analysis.warnings %}
                <div class="rounded-xl border border-warning-200 bg-warning-50 p-3 text-xs dark:border-warning-800 dark:bg-warning-900/30">
                    <div class="flex items-start gap-2.5 text-warning-900 dark:text-warning-100">
                        <twig:UX:Icon name="icon:warning" class="h-4 w-4 shrink-0 text-warning-600 dark:text-warning-400 mt-0.5" />
                        <div>
                            <span class="font-semibold">{{ warning.titre }} :</span>
                            <span>{{ warning.description }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# 4. Formulaire de configuration avec le thème V2 #}
    <form id="modal_dupliquer_form" action="{{ path('parcours_v2_dupliquer_post', {parcours: parcours.id, from: from|default(null)}) }}" method="post" class="space-y-4 pt-1">
        {% if form._token is defined %}{{ form_row(form._token) }}{% endif %}

        {{ form_row(form.nouveauLibelle) }}

        {{ form_row(form.nouveauSigle) }}

        <div class="rounded-xl border border-secondary-200 bg-secondary-50/50 p-4 dark:border-secondary-700 dark:bg-secondary-800/30 space-y-3">
            <span class="block text-xs font-bold text-secondary-800 dark:text-secondary-200 uppercase tracking-wide">{{ 'parcours_v2.modal_dupliquer.options_de_recopie'|trans({}, 'modal') }}</span>

            {{ form_row(form.dupliquerFichesMatieres) }}
            {{ form_row(form.dupliquerContacts) }}
            {{ form_row(form.conserverResponsables) }}
        </div>

        {# 5. Informations sur ce qui repart à zéro #}
        <div class="rounded-xl border border-secondary-200 bg-surface p-3 text-xs dark:border-secondary-700">
            <span class="block font-semibold text-secondary-900 dark:text-secondary-100 mb-1.5 flex items-center gap-1.5">
                <twig:UX:Icon name="icon:info" class="h-3.5 w-3.5 text-secondary-500" />
                {{ 'parcours_v2.modal_dupliquer.rappel_sur_le_nouveau_parcours'|trans({}, 'modal') }}
            </span>
            <ul class="list-disc list-inside space-y-1 text-secondary-600 dark:text-secondary-400 text-[11px]">
                <li>{{ 'parcours_v2.modal_dupliquer.le_statut_sera_reinitialise_en_cours'|trans({}, 'modal') }} <strong>0.1</strong>.</li>
                <li>{{ 'parcours_v2.modal_dupliquer.les_validations_officielles_anterieures_cfvu_et'|trans({}, 'modal') }}</li>
                <li>{{ 'parcours_v2.modal_dupliquer.le_parcours_d_origine_reste_inchange'|trans({}, 'modal') }}</li>
            </ul>
        </div>
    </form>
</div>
