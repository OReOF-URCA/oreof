{% extends 'base.html.twig' %}
{% set formation = parcours.formation %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @layer components {
            .is-chosen {
                @apply ring-2 ring-indigo-400;
            }

            .is-ghost {
                @apply opacity-50;
            }

            .is-dragging {
                @apply cursor-grabbing;
            }
        }
    </style>
{% endblock %}

{% set header_title %}
    {% if parcours.parcoursParent == null %}
        Parcours <strong>{{ parcours.libelle }} {{ parcours.typeParcours|badgeTypeParcours }}</strong>
    {% else %}
        Option <strong>{{ parcours.libelle }}</strong> (parcours <strong>{{ parcours.parcoursParent.libelle }}</strong>)
    {% endif %}
{% endset %}

{% block bouton_header %}
    <twig:Button
            href="{{ path('parcours_v2_voir', {parcours:parcours.id}) }}"
            variant="info"
            icon="icon:info"
            label="Voir la fiche descriptive"
            tooltip="Voir la fiche descriptive"
    />

    <twig:Button
            href="{{ path('formation_v2_voir', {slug:formation.slug}) }}"
            variant="success"
            icon="icon:arrow-left"
            label="Retour à la formation"
            tooltip="Retour à la formation"
    />
{% endblock %}


{% block breadcrumb %}
    {{ include('communs/_breadcrumb.html.twig', {liens:[
        {href: path('app_formation_index'), title: 'Liste des formations'},
        {href: path('formation_v2_voir', {slug:formation.slug}), title:'Formation :  ' ~ formation.display},
        {title: header_title|raw, href: path('parcours_v2_voir', {parcours: parcours.id})},
        {title: 'Modifier'}
    ]}) }}
{% endblock %}

{% block content %}

    <div id="parcours_header_component">
    <twig:ParcoursHeader parcoursId="{{ parcours.id }}" formationId="{{ parcours.formation.id }}"/>
    </div>

    <div class="flex">
        <aside class="w-72 bg-white rounded-md shadow-md border-secondary-200 flex flex-col p-3 space-y-8">
            <nav class="flex-1 space-y-1">
                <p class="text-[10px] font-black text-secondary-400 uppercase mb-4 tracking-widest px-3">Configuration
                    Parcours</p>

                <div class="p-6 bg-gray-200" id="pecent_completude">{# a mettre à jour avec turbo #}
                    {% set percent = parcours.remplissage.calcul() %}
                    {% set percentColor = parcours.remplissage.isFull() == true ? 'green' : 'orange' %}
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-secondary-500">Complétude Parcours</span>
                        <span class="text-xs font-bold text-{{ percentColor }}-600 italic">{{ percent|number_format(2) }}%</span>
                    </div>
                    <div class="w-full h-1 bg-secondary-700 rounded-full overflow-hidden">
                        <div class="bg-{{ percentColor }}-500 h-full w-[{{ percent|number_format(0) }}%]"></div>
                    </div>
                    {% if parcours.remplissage.isFull() == false %}
                        <twig:Button
                                data-action="click->modalturbo#open"
                                data-turbo="true"
                                href="{{ path('app_parcours_state', {parcours: parcours.id})
                                }) }}"
                                data-size="lg"
                                variant="success"
                                :soft="false"
                                :outline="true"
                                size="sm"
                                icon="icon:check"
                                label="Vérifier la saisie"
                                tooltip="{{ 'verifier.la.saisie.parcours.infobulle'|trans({}, 'process') }}"
                                extraClass="mt-2 !p-0 !h-auto border-0 bg-transparent text-success-600 hover:text-success-700 hover:bg-transparent shadow-none"
                        />
                    {% endif %}
                </div>

                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'presentation_formation' }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab">
                    <span class="flex items-center gap-3">
                        Présentation formation
                    </span>
                </a>

                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'presentation' }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab">
                    <span class="flex items-center gap-3">
                        Présentation parcours
                    </span>
                    <span id="tab_badge_presentation">
                      {{ include('communs/_badge.html.twig', { tabKey: 'presentation', status: tabStates['presentation'].status ?? 'red' }) }}
                    </span>
                </a>


                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'descriptif' }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab">
                    <span class="flex items-center gap-3">
                        Descriptif
                        </span>
                    <span id="tab_badge_descriptif">
                      {{ include('communs/_badge.html.twig', { tabKey: 'descriptif', status: tabStates['descriptif'].status ?? 'red' }) }}
                    </span>
                </a>

                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_competences_index', { parcours: parcours.id }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab"
                >
                    <span class="flex items-center gap-3">
                        Compétences
                    </span>
                    <span class="w-2 h-2 bg-{{ parcours.colorStep(3) }}-500 rounded-full"></span>
                </a>

                <a
                        href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'maquette' }) }}"
                        data-turbo-frame="tab-content"
                        data-turbo-action="advance"
                        data-tabs-target="tab"
                        class="nav-link active w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold transition group">
                    <span class="flex items-center gap-3">
                        Structure Maquette
                    </span>
                    <span id="tab_badge_maquette">
                      {{ include('communs/_badge.html.twig', { tabKey: 'maquette', status: tabStates['maquette'].status ?? 'red' }) }}
                    </span>
                </a>

                <turbo-frame id="sidebar-tree" class="space-y-2">
                    {{ include('parcours_v2/_sideBarStructure.html.twig') }}
                </turbo-frame>

                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'admission' }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab"
                >
                    <span class="flex items-center gap-3">
                        Admission & inscription
                        </span>
                    <span id="tab_badge_admission">
                      {{ include('communs/_badge.html.twig', { tabKey: 'admission', status: tabStates['admission'].status ?? 'red' }) }}
                    </span>
                </a>

                <a class="nav-link w-full flex items-center justify-between p-3 rounded-2xl text-sm font-bold text-secondary-500 hover:bg-white transition group"
                   href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'et_apres' }) }}"
                   data-turbo-frame="tab-content"
                   data-turbo-action="advance"
                   data-tabs-target="tab">
                    <span class="flex items-center gap-3">
                        Et après...
                        </span>
                    <span id="tab_badge_et_apres">
                      {{ include('communs/_badge.html.twig', { tabKey: 'et_apres', status: tabStates['et_apres'].status ?? 'red' }) }}
                    </span>
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="pt-8">
                        <a class="w-full flex items-center gap-3 p-3 rounded-2xl text-sm font-bold text-secondary-400 hover:text-secondary-800 transition"
                           href="{{ path('parcours_v2_tabs', { parcours: parcours.id, tab: 'configuration' }) }}"
                           data-turbo-frame="tab-content"
                           data-turbo-action="advance"
                           data-tabs-target="tab">
                        <span>
                        <i class="fal fa-cogs"></i> Configuration Admin.
                            </span>
                        </a>
                    </div>
                {% endif %}
            </nav>
        </aside>

        <div class="p-3 flex-1 overflow-y-auto bg-white ms-2 rounded-md shadow-md border-secondary-200 flex flex-col">
            <turbo-frame
                    id="tab-content"
            >
                {% if tab is defined %}
                    {% include 'parcours_v2/tabs/_' ~ tab ~ '.html.twig' %}
                {% else %}
                    <div>Sélectionnez un onglet.</div>
                {% endif %}

            </turbo-frame>
        </div>
    </div>
{% endblock %}
