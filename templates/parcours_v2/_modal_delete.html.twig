<div class="space-y-4 text-text">

    {# 1. Bannière d'avertissement rouge #}
    <div class="rounded-xl border border-danger-200 bg-danger-50 p-4 dark:border-danger-800 dark:bg-danger-900/30">
        <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-danger-100 text-danger-700 dark:bg-danger-800 dark:text-danger-200">
                <twig:UX:Icon name="icon:warning" class="h-5 w-5" />
            </div>
            <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-sm font-bold text-danger-900 dark:text-danger-100">
                        {{ 'parcours_v2.modal_delete.suppression_definitive_et_irreversible'|trans({}, 'modal') }}
                    </h3>
                    <twig:Badge variant="danger" size="sm" label="{{ 'parcours_v2.modal_delete.admin_exclusivement'|trans({}, 'modal') }}" />
                </div>
                <p class="text-xs text-danger-800 dark:text-danger-200 leading-relaxed">
                    {{ 'parcours_v2.modal_delete.cette_action_detruira_definitivement_le_parcours'|trans({}, 'modal') }} <strong>« {{ parcours.libelle }} »</strong> {{ 'parcours_v2.modal_delete.en_base_de_donnees_elle_doit'|trans({}, 'modal') }} <strong>{{ 'parcours_v2.modal_delete.erreurs_de_creation_ou_de_recopie'|trans({}, 'modal') }}</strong>.
                </p>
            </div>
        </div>
    </div>

    {# 2. Contexte : Formation parente #}
    <div class="rounded-xl border border-secondary-200 bg-secondary-50/50 p-3 text-xs dark:border-secondary-700 dark:bg-secondary-800/40">
        <div class="flex items-center justify-between gap-2">
            <span class="text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_delete.formation_rattachee'|trans({}, 'modal') }}</span>
            <span class="font-semibold text-secondary-900 dark:text-secondary-100">
                {{ formation ? formation.displayLong : 'Non rattachée' }}
            </span>
        </div>
    </div>

    {# 3. Alertes structurelles (seul parcours ou parcours par défaut) #}
    {% if analysis.isSeulParcoursDeLaFormation %}
        <div class="rounded-xl border border-warning-200 bg-warning-50 p-3 text-xs text-warning-800 dark:border-warning-800 dark:bg-warning-900/30 dark:text-warning-200 flex items-center gap-2.5">
            <twig:UX:Icon name="icon:warning" class="h-4 w-4 shrink-0 text-warning-600 dark:text-warning-300" />
            <span><strong>{{ 'parcours_v2.modal_delete.attention'|trans({}, 'modal') }}</strong> {{ 'parcours_v2.modal_delete.ce_parcours_est_l_unique_parcours'|trans({}, 'modal') }}</span>
        </div>
    {% endif %}

    {% if analysis.isParcoursDefaut %}
        <div class="rounded-xl border border-warning-200 bg-warning-50 p-3 text-xs text-warning-800 dark:border-warning-800 dark:bg-warning-900/30 dark:text-warning-200 flex items-center gap-2.5">
            <twig:UX:Icon name="icon:warning" class="h-4 w-4 shrink-0 text-warning-600 dark:text-warning-300" />
            <span><strong>{{ 'parcours_v2.modal_delete.attention'|trans({}, 'modal') }}</strong> {{ 'parcours_v2.modal_delete.ce_parcours_est_configure_comme_le'|trans({}, 'modal') }}</span>
        </div>
    {% endif %}

    {# 4. Dépendances partagées #}
    {% if analysis.hasSharedDependencies %}
        <div class="rounded-xl border border-danger-200 bg-surface p-4 shadow-xs dark:border-danger-800 space-y-3">
            <div class="flex items-center gap-2 text-danger-700 dark:text-danger-300 text-sm font-bold">
                <twig:UX:Icon name="icon:warning" class="h-4 w-4" />
                <span>{{ 'delete.dependances_partagees_detectees'|trans({'%count%': analysis.sharedDependenciesCount}, 'modal') }}</span>
            </div>
            <p class="text-xs text-secondary-500 dark:text-secondary-400">
                {{ 'parcours_v2.modal_delete.certains_elements_associes_sont_lies_a'|trans({}, 'modal') }}
            </p>

            <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                {% for dep in analysis.sharedDependencies %}
                    <div class="rounded-lg border p-2.5 text-xs {{ dep.severity == 'danger' ? 'border-danger-200 bg-danger-50 dark:border-danger-800 dark:bg-danger-900/20' : 'border-warning-200 bg-warning-50 dark:border-warning-800 dark:bg-warning-900/20' }}">
                        <div class="font-semibold text-secondary-900 dark:text-secondary-100 flex items-center gap-1.5">
                            <twig:Badge variant="{{ dep.severity }}" size="sm" label="{{ dep.titre }}" />
                        </div>
                        <p class="mt-1 text-secondary-700 dark:text-secondary-300 leading-snug">
                            {{ dep.description }}
                        </p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="rounded-xl border border-success-200 bg-success-50 p-3 text-xs text-success-800 dark:border-success-800 dark:bg-success-900/30 dark:text-success-200 flex items-center gap-2.5">
            <twig:UX:Icon name="icon:check" class="h-4 w-4 shrink-0 text-success-600 dark:text-success-300" />
            <span><strong>{{ 'parcours_v2.modal_delete.aucune_dependance_partagee'|trans({}, 'modal') }}</strong> {{ 'parcours_v2.modal_delete.ce_parcours_est_isole_la_suppression'|trans({}, 'modal') }}</span>
        </div>
    {% endif %}

    {# 5. Résumé des éléments internes qui seront supprimés #}
    <div class="rounded-xl border border-secondary-200 bg-surface p-3.5 dark:border-secondary-700">
        <div class="text-xs font-bold uppercase tracking-wider text-secondary-500 dark:text-secondary-400 mb-2">
            {{ 'parcours_v2.modal_delete.elements_internes_detruits_en_cascade'|trans({}, 'modal') }}
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
            <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.annees|default(0) }}</div>
                <div class="text-[11px] text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_delete.annees'|trans({}, 'modal') }}</div>
            </div>
            <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.semestres_parcours|default(0) }}</div>
                <div class="text-[11px] text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_delete.semestres'|trans({}, 'modal') }}</div>
            </div>
            <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.fiches_matieres|default(0) }}</div>
                <div class="text-[11px] text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_delete.fiches_mat'|trans({}, 'modal') }}</div>
            </div>
            <div class="rounded-lg bg-secondary-50 p-2 dark:bg-secondary-800">
                <div class="text-base font-bold text-secondary-900 dark:text-secondary-100">{{ analysis.internalElementsCount.blocs_competences|default(0) }}</div>
                <div class="text-[11px] text-secondary-500 dark:text-secondary-400">{{ 'parcours_v2.modal_delete.blocs_comp'|trans({}, 'modal') }}</div>
            </div>
        </div>
    </div>

    {# 6. Formulaire de confirmation #}
    <form id="modal_form" action="{{ path('parcours_v2_supprimer_post', {parcours: parcours.id}) }}" method="post" class="space-y-3.5 pt-2">
        <input type="hidden" name="_token" value="{{ csrf_token('parcours_delete_' ~ parcours.id) }}">

        {% if analysis.hasSharedDependencies %}
            <div class="rounded-xl border border-danger-200 bg-danger-50 p-3 dark:border-danger-800 dark:bg-danger-900/30">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input
                        type="checkbox"
                        name="force"
                        value="1"
                        required
                        class="mt-0.5 h-4 w-4 rounded border-danger-300 text-danger-600 focus:ring-danger-500 cursor-pointer"
                    >
                    <span class="text-xs font-semibold text-danger-900 dark:text-danger-200">
                        {{ 'parcours_v2.modal_delete.je_confirme_avoir_verifie_les_dependances'|trans({}, 'modal') }}
                    </span>
                </label>
            </div>
        {% endif %}

        <div>
            <label for="confirmation_text" class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-300 mb-1">
                {{ 'parcours_v2.modal_delete.saisissez_le_libelle_du_parcours_ou'|trans({}, 'modal') }} <span class="text-danger-600">*</span>
            </label>
            <div class="text-[11px] text-secondary-500 dark:text-secondary-400 mb-1.5">
                {{ 'parcours_v2.modal_delete.texte_attendu'|trans({}, 'modal') }} <code class="rounded bg-secondary-100 px-1 py-0.5 font-mono font-bold text-danger-700 dark:bg-secondary-800 dark:text-danger-300">{{ parcours.libelle }}</code> {{ 'parcours_v2.modal_delete.ou'|trans({}, 'modal') }} <code class="rounded bg-secondary-100 px-1 py-0.5 font-mono font-bold text-danger-700 dark:bg-secondary-800 dark:text-danger-300">{{ 'parcours_v2.modal_delete.supprimer'|trans({}, 'modal') }}</code>
            </div>
            <input
                type="text"
                name="confirmation_text"
                id="confirmation_text"
                required
                autocomplete="off"
                placeholder="{{ parcours.libelle }}"
                class="w-full rounded-xl border border-secondary-300 bg-white px-3.5 py-2.5 text-sm font-medium text-secondary-900 shadow-sm transition placeholder:text-secondary-400 focus:border-danger-500 focus:outline-none focus:ring-2 focus:ring-danger-500/20 dark:border-secondary-600 dark:bg-secondary-900 dark:text-secondary-100"
            >
        </div>
    </form>

</div>
