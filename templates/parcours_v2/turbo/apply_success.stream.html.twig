<turbo-stream action="replace" target="parcours_header_component">
    <template>
        <div id="parcours_header_component">
            <twig:ParcoursHeader
                    parcoursId="{{ dpeParcours.parcours.id }}"
                    formationId="{{ dpeParcours.parcours.formation.id }}"
            />
        </div>
    </template>
</turbo-stream>

{# Boutons de la page « voir » : dépendent de l'état du DPE. Sans effet si la cible est absente (page « modifier »). #}
<turbo-stream action="replace" target="parcours_voir_actions">
    <template>
        {{ include('parcours_v2/_voir_actions.html.twig', {parcours: dpeParcours.parcours, dpeParcours: dpeParcours}) }}
    </template>
</turbo-stream>

{{ include('_ui/_toast.stream.html.twig', { message: ('toast.'~transition~'.'~type~'.success')|trans({},'process'), undo: null, type: 'success' }) }}

{{ include('_ui/_force_close_modal.html.twig') }}

{% if type == 'reouvrir' or transition starts with 'reouvrir' or transition starts with 'rouvrir' %}
    <turbo-stream action="append" target="flash_toasts">
        <template>
            <script>
                (function () {
                    const targetUrl = "{{ path('parcours_v2_modifier', {parcours: dpeParcours.parcours.id}) }}";
                    if (window.Turbo && typeof window.Turbo.visit === 'function') {
                        window.Turbo.visit(targetUrl, {action: 'advance'});
                    } else {
                        window.location.href = targetUrl;
                    }
                })();
            </script>
        </template>
    </turbo-stream>
{% endif %}

