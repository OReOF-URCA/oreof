<turbo-stream action="prepend" target="modal_body">
    <template>
        <div class="mb-4 rounded-xl border border-danger-200 bg-danger-50 p-3 text-sm text-danger-800 dark:border-danger-800/70 dark:bg-danger-500/10 dark:text-danger-300"
             role="alert">
            <div class="flex items-start gap-2">
                {{ ux_icon('icon:danger', {class: 'mt-0.5 h-4 w-4 shrink-0'}) }}
                <div>
                    <p class="font-semibold">L’opération n’a pas pu être enregistrée.</p>
                    <p class="mt-1">{{ message|default('Une erreur inattendue est survenue.') }}</p>
                </div>
            </div>
        </div>
    </template>
</turbo-stream>

{{ include('_ui/_toast.stream.html.twig', {
    message: message|default(('toast.'~transition~'.'~type~'.danger')|trans({}, 'process')),
    undo: null,
    type: 'danger'
}) }}
