<turbo-stream action="append" target="flash_toasts">
    <template>
        <script>
            if (window.Turbo && typeof window.Turbo.visit === 'function') {
                window.Turbo.visit("{{ redirectUrl }}", { action: 'advance' });
            } else {
                window.location.href = "{{ redirectUrl }}";
            }
        </script>
    </template>
</turbo-stream>

{{ include('_ui/_toast.stream.html.twig', {
    message: toastMessage|default('Le parcours a été dupliqué avec succès.'),
    closeModal: true,
    toast_type: 'success'
}) }}
