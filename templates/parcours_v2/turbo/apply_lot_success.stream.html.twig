{{ include('_ui/_toast.stream.html.twig', {
    message: ('toast.' ~ transition ~ '.' ~ type ~ '.success')|trans({}, 'process') ~ ' (' ~ count ~ ')',
    undo: null,
    type: 'success'
}) }}

<turbo-stream action="update" target="modal_title">
    <template>
        <div class="app-modal-title">Traitement en lot terminé</div>
        <div class="app-modal-subtitle">{{ count }} parcours traité{{ count > 1 ? 's' : '' }}</div>
    </template>
</turbo-stream>

<turbo-stream action="update" target="modal_body">
    <template>
        <div class="space-y-3">
            <p class="text-sm text-slate-700 dark:text-slate-200">
                Le traitement <span class="font-semibold">{{ transition }}</span>
                a été appliqué sur {{ count }} parcours.
            </p>

            {% if processedParcours is defined and processedParcours is not empty %}
                <div class="max-h-72 overflow-auto rounded-xl border border-slate-200 dark:border-slate-700">
                    <ul class="divide-y divide-slate-200 text-sm dark:divide-slate-700">
                        {% for item in processedParcours %}
                            <li class="space-y-1 px-3 py-2">
                                <p class="font-medium text-slate-900 dark:text-slate-100">{{ item.parcours }}</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">{{ item.formation }}</p>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </template>
</turbo-stream>

<turbo-stream action="update" target="modal_footer">
    <template>
        <div class="app-modal-footer-actions">
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary"
                    data-action="modalturbo#close">
                Fermer
            </button>
        </div>
    </template>
</turbo-stream>

<turbo-stream action="append" target="modal_control">
    <template>
        <script data-turbo-eval="true">
          window.dispatchEvent(new CustomEvent('validation:bulk-success', {
            detail: { count: {{ count }} }
          }))
        </script>
    </template>
</turbo-stream>

