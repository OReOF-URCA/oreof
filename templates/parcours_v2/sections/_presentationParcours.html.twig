{% set dtClass = 'text-[11px] font-black uppercase tracking-wide text-primary-500 dark:text-primary-300' %}
{% set ddClass = 'mt-2 text-sm leading-relaxed text-secondary-700 dark:text-secondary-400' %}
{% set blockClass = 'rounded-xl border border-secondary-200 dark:border-secondary-700 bg-bg p-4' %}
{% set badgeOkClass = 'inline-flex items-center rounded-full bg-primary-100 dark:bg-primary-800 px-2.5 py-1 text-xs font-bold text-primary-700 dark:text-primary-400' %}
{% set badgeWarnClass = 'inline-flex items-center rounded-full bg-warning-100 dark:bg-warning-800 px-2.5 py-1 text-xs font-bold text-warning-700 dark:text-warning-400' %}

<div class="space-y-4">
    <dl class="space-y-4">
        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Organisation de la formation</dt>
            <dd class="{{ ddClass }}">{{ parcours.contenuFormation|printTexte }}</dd>
        </div>
            {% if stringDifferencesParcours.presentationParcoursContenuFormation is defined %}
                {{ include('communs/_comparaison_versioning_no_button.html.twig',
                    {
                        textDifferences: stringDifferencesParcours.presentationParcoursContenuFormation,
                        idCollapse: 'diffGlobalParcours'
                    }
                ) }}
            {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Objectifs du parcours</dt>
            <dd class="{{ ddClass }}">{{ parcours.objectifsParcours|printTexte }}</dd>
        </div>
        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Mots clés du parcours</dt>
            <dd class="{{ ddClass }}">{{ parcours.motsCles|printTexte }}</dd>
        </div>
            {% if stringDifferencesParcours.presentationParcoursObjectifsParcours is defined %}
                {{ include('communs/_comparaison_versioning_no_button.html.twig',
                    {
                        textDifferences: stringDifferencesParcours.presentationParcoursObjectifsParcours,
                        idCollapse: 'diffGlobalParcours'
                    }
                ) }}
            {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Résultats attendus du parcours</dt>
            <dd class="{{ ddClass }}">{{ parcours.resultatsAttendus|printTexte }}</dd>
        </div>
            {% if stringDifferencesParcours.presentationParcoursResultatsAttendus is defined %}
                {{ include('communs/_comparaison_versioning_no_button.html.twig',
                    {
                        textDifferences: stringDifferencesParcours.presentationParcoursResultatsAttendus,
                        idCollapse: 'diffGlobalParcours'
                    }
                ) }}
            {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Rythme de formation</dt>
            <dd class="mt-1">
                {% if parcours.rythmeFormation != null %}
                    <span class="{{ badgeOkClass }}">
                    {{ parcours.rythmeFormation.libelle }}
                </span>
                {% else %}
                    <span class="{{ badgeWarnClass }}">
                    Non précisé
                </span>
                {% endif %}
            </dd>
        </div>
            {% if stringDifferencesParcours.rythmeFormationParcours is defined %}
                {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                    textDifferences: stringDifferencesParcours.rythmeFormationParcours,
                    idCollapse: 'diffGlobalParcours'
                }) }}
            {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Précisions sur le rythme de formation</dt>
            <dd class="{{ ddClass }}">
                {% if parcours.rythmeFormationTexte != null and parcours.rythmeFormationTexte != '' %}
                    {{ parcours.rythmeFormationTexte|printTexte }}
                {% else %}
                    <span class="{{ badgeWarnClass }}">
                    Non précisé
                </span>
                {% endif %}
            </dd>
        </div>

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Logos du parcours</dt>
            <dd class="{{ ddClass }}">
                {% set logos = parcours.logosNormalized %}
                {% if logos|length > 0 %}
                    <div class="flex flex-wrap items-center gap-4 mt-2">
                        {% for logo in logos %}
                            <div class="flex flex-col items-center p-2.5 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-white dark:bg-secondary-800 shadow-sm hover:shadow transition">
                                {% if logo.url %}
                                    <a href="{{ logo.url }}" target="_blank" rel="noopener noreferrer"
                                       class="flex flex-col items-center group text-center"
                                       title="Ouvrir le lien web : {{ logo.url }}">
                                        <img src="{{ asset('uploads/logos/' ~ logo.filename) }}" alt="Logo du parcours"
                                             class="max-h-16 max-w-28 object-contain">
                                        <span class="text-[11px] text-primary-600 dark:text-primary-400 group-hover:underline flex items-center gap-1 mt-1.5 truncate max-w-28 font-medium">
                                            <twig:UX:Icon name="icon:link" class="w-3 h-3 inline shrink-0"/>
                                            <span class="truncate">{{ logo.url|replace({'https://': '', 'http://': ''}) }}</span>
                                        </span>
                                    </a>
                                {% else %}
                                    <img src="{{ asset('uploads/logos/' ~ logo.filename) }}" alt="Logo du parcours"
                                         class="max-h-16 max-w-28 object-contain">
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <span class="{{ badgeWarnClass }}">
                        Aucun logo
                    </span>
                {% endif %}
            </dd>
        </div>
    </dl>
</div>
