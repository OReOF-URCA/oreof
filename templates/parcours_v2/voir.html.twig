{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% if cssDiff is defined and cssDiff is not empty %}
        <style>
            {{ cssDiff|raw }}
            {{ include('communs/versioning_view_style.html.twig') }}
        </style>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if (canSeeDifferences ?? false) == true %}
        <script src="{{ asset('versioning/display_differences.js') }}"></script>
    {% endif %}
{% endblock %}

{% set header_title %}
    {% if parcours.parcoursParent == null %}
        Parcours
        <strong>{{ parcours.libelle }}{% set typeParcoursBadge = parcours.typeParcours|badgeTypeParcours %}{% if typeParcoursBadge is not null %} {{ component('Badge', { dto: typeParcoursBadge }) }}{% endif %}</strong>
    {% else %}
        Option <strong>{{ parcours.libelle }}</strong> (parcours <strong>{{ parcours.parcoursParent.libelle }}</strong>)
    {% endif %}
{% endset %}

{% block bouton_header %}
    <div class="flex flex-wrap gap-2 justify-start lg:justify-end">
        {% if (is_granted('EDIT', {route: 'app_parcours', subject: dpeParcours})
            or is_granted('EDIT', {route: 'app_formation', subject: dpeParcours})
            or is_granted('EDIT', {route: 'app_composante', subject: dpeParcours})
            or is_granted('EDIT', {route: 'app_etbalissement', subject: dpeParcours})
            or is_granted('ROLE_ADMIN')) and isOuvert(dpeParcours) %}
            <twig:Button
                    href="{{ path('parcours_v2_modifier', {parcours: parcours.id}) }}"
                    variant="warning"
                    :soft="false"
                    :outline="true"
                    size="sm"
                    icon="icon:edit"
                    label="Modifier le parcours"
                    tooltip="Modifier le parcours"
            />
        {% endif %}
    </div>
{% endblock %}

{% block content %}

    <div id="parcours_header_component">
        <twig:ParcoursHeader parcoursId="{{ parcours.id }}" formationId="{{ parcours.formation.id }}"/>
    </div>

    {% if (canSeeDifferences ?? false) and displayComparaison in ['diffGlobalParcours', 'diffGlobalParcoursCampagne'] %}
        {% set isCampagne = displayComparaison == 'diffGlobalParcoursCampagne' %}
        {% set diffCount = isCampagne ? (diffCountCampagne ?? 0) : (diffCountLastVersion ?? 0) %}
        {% set modeTitle = isCampagne ? "Comparaison avec l'année précédente (campagne N-1)" : "Comparaison avec la dernière version validée" %}

        <div class="mb-4 rounded-2xl border p-4 shadow-sm transition {{ diffCount > 0 ? 'border-info-300 bg-info-50/90 text-info-950 dark:border-info-700 dark:bg-info-950/40 dark:text-info-100' : 'border-secondary-300 bg-secondary-50 text-secondary-800 dark:border-secondary-700 dark:bg-secondary-800/60 dark:text-secondary-200' }}">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start sm:items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl {{ diffCount > 0 ? 'bg-info-100 text-info-700 dark:bg-info-900/50 dark:text-info-300' : 'bg-secondary-200 text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300' }}">
                        {{ ux_icon('ph:not-equals-bold', {class: 'h-5 w-5'}) }}
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-black uppercase tracking-wider text-info-700 dark:text-info-300">Mode Comparaison Actif</span>
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ diffCount > 0 ? 'bg-info-200 text-info-800 dark:bg-info-900/80 dark:text-info-200' : 'bg-secondary-200 text-secondary-700 dark:bg-secondary-700 dark:text-secondary-300' }}">
                                {{ diffCount }} champ{{ diffCount > 1 ? 's' : '' }} avec modification{{ diffCount > 1 ? 's' : '' }}
                            </span>
                        </div>
                        <p class="text-sm font-semibold mt-0.5">
                            {{ modeTitle }}
                        </p>
                        <p class="text-xs opacity-80 mt-0.5">
                            {% if diffCount > 0 %}
                                Les modifications sont surlignées dans les blocs descriptifs ci-dessous (<span class="font-semibold text-success-700 dark:text-success-300">texte vert</span> = ajouts, <span class="font-semibold text-danger-700 dark:text-danger-300 line-through">texte rouge barré</span> = suppressions).
                            {% else %}
                                <strong>Aucune modification détectée</strong> : la saisie actuelle est strictement identique à la version de référence comparée.
                            {% endif %}
                        </p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2 self-end sm:self-center shrink-0">
                    {% if not isCampagne %}
                        <a href="{{ path('parcours_v2_voir', {parcours: parcours.id, optionDisplay: 'diffGlobalParcoursCampagne'}) }}"
                           class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                            {{ ux_icon('icon:calendar', {class: 'h-3.5 w-3.5 text-info-500'}) }}
                            <span>Comparer avec N-1</span>
                        </a>
                    {% else %}
                        <a href="{{ path('parcours_v2_voir', {parcours: parcours.id, optionDisplay: 'diffGlobalParcours'}) }}"
                           class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                            {{ ux_icon('mdi:history', {class: 'h-3.5 w-3.5 text-info-500'}) }}
                            <span>Comparer avec version validée</span>
                        </a>
                    {% endif %}
                    <a href="{{ path('parcours_v2_voir', {parcours: parcours.id}) }}"
                       class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-300 bg-white px-3 py-1.5 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 hover:text-secondary-900 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700">
                        {{ ux_icon('icon:close', {class: 'h-3.5 w-3.5'}) }}
                        <span>Quitter</span>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="flex" data-controller="scroll-spy">
        <aside class="app-scrollspy-aside w-72 flex flex-col p-3 space-y-8">
            <div class="sticky top-[calc(var(--page-header-offset,4rem)+0.5rem)] space-y-8">
                <div class="h-[calc(100vh-var(--page-header-offset,4rem)-1rem)] overflow-y-scroll">
                    <p class="app-scrollspy-section-title">Navigation</p>
                    <nav class="space-y-1">
                        <a href="#identite_formation" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Identité de la formation
                        </a>

                        <a href="#presentation" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Présentation de la formation
                        </a>

                        <a href="#descriptif" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Descriptif de la formation
                        </a>

                        <a href="#presentation_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Présentation du parcours
                        </a>

                        <a href="#descriptif_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Descriptif du parcours
                        </a>


                        <a href="#localisation_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Localisation
                        </a>

                        <a href="#competences_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Compétences Acquises
                        </a>

                        <a href="#structure_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Structure & maquette
                        </a>
                        <a href="#admission_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Admission
                        </a>

                        <a href="#inscription_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Inscription
                        </a>

                        <a href="#et_apres_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Et après...
                        </a>

                        <a href="#contacts_{{ parcours.id }}" data-scroll-spy-target="link"
                           class="app-scrollspy-link">
                            Contacts pédagogiques
                        </a>
                    </nav>
                </div>

                {% set valideLheo = lheoXML.isValidLheo(parcours) %}
                {% set percent = parcours.remplissage.calcul() %}
                {% set isFull = parcours.remplissage.isFull() == true %}
                {% set color = isFull and valideLheo ? 'green' : 'orange' %}

                <div class="rounded-md p-6 text-white shadow-xl {% if color == 'green' %}bg-green-600 shadow-green-100 dark:shadow-green-950/30{% else %}bg-orange-600 shadow-orange-100 dark:shadow-orange-950/30{% endif %}">
                    <p class="text-[10px] font-black uppercase opacity-60 mb-2">Statut Global</p>
                    <p class="text-sm font-bold leading-tight">
                        {% if lheoXML.isValidLheo(parcours) %}
                            Le parcours est prêt pour la publication LHEO.
                        {% else %}
                            Le parcours est invalide LHEO, publication impossible
                        {% endif %}
                    </p>
                    <div class="mt-4 w-full bg-indigo-400/30 h-1.5 rounded-full overflow-hidden">
                        <div class="w-[{{ percent }}%] h-full bg-white"></div>
                    </div>
                </div>
            </div>
        </aside>
        <div class="ps-3 flex-1 overflow-y-auto flex flex-col pt-0">
            {% if (parcours.descriptifHautPage != '' and parcours.descriptifHautPage != null)  or
                (parcours.descriptifBasPage != '' and parcours.descriptifBasPage != null) or
                (parcours.descriptifHautPageAutomatique != '' and parcours.descriptifHautPageAutomatique != null) %}
                <section data-scroll-spy-target="section"
                         class="app-section-card"
                         id="presentation_complementaire">
                    {{ include('communs/_header_show.html.twig', {
                        title: 'Informations complémentaires (affichées sur le site institutionnel)',
                        icon: 'ph:info-light',
                        color: 'indigo'
                    }) }}

                    <dl class="space-y-4 text-sm text-secondary-700 dark:text-secondary-200">
                        {% if (parcours.descriptifHautPageAutomatique != '' and parcours.descriptifHautPageAutomatique != null) %}
                            <div class="space-y-2">
                                <dt class="text-xs font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500">
                                    Texte haut de page (automatique)
                                </dt>
                                <dd class="leading-7 text-secondary-700 dark:text-secondary-200">{{ parcours.descriptifHautPageAutomatique|raw }}</dd>
                            </div>
                        {% endif %}
                        {% if (parcours.descriptifHautPage != '' and parcours.descriptifHautPage != null) %}
                            <div class="space-y-2">
                                <dt class="text-xs font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500">
                                    Texte haut de page
                                </dt>
                                <dd class="leading-7 text-secondary-700 dark:text-secondary-200">{{ parcours.descriptifHautPage|raw }}</dd>
                            </div>
                        {% endif %}
                        {% if (parcours.descriptifBasPage != '' and parcours.descriptifBasPage != null) %}
                            <div class="space-y-2">
                                <dt class="text-xs font-black uppercase tracking-[0.18em] text-secondary-400 dark:text-secondary-500">
                                    Texte bas de page
                                </dt>
                                <dd class="leading-7 text-secondary-700 dark:text-secondary-200">{{ parcours.descriptifBasPage|raw }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </section>
            {% endif %}

            {{ include('typeDiplome/'~constant('TEMPLATE_FOLDER', typeD)~'/_show_parcours.html.twig') }}
        </div>
    </div>
{% endblock %}
