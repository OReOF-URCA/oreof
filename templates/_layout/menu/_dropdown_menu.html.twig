<div class="relative h-full flex items-center" data-controller="navbar-dropdown" data-turbo-prefetch="false"
     data-action="mouseenter->navbar-dropdown#open mouseleave->navbar-dropdown#close click@window->navbar-dropdown#close">
    {% if item.route %}
        <a href="{{ path(item.route, item.routeParams) }}"
           data-turbo-prefetch="false"
           class="topbar-link">
            {{ item.label|trans({}, 'menu') }}
            {% if item.children is not empty %}
                <svg class="ml-1 w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M19 9l-7 7-7-7"></path>
                </svg>
            {% endif %}
        </a>
    {% else %}
        <span class="topbar-link cursor-default">
            {{ item.label|trans({}, 'menu') }}
            {% if item.children is not empty %}
                <svg class="ml-1 w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M19 9l-7 7-7-7"></path>
                </svg>
            {% endif %}
        </span>
    {% endif %}

    {% if item.children is not empty %}
        <div data-navbar-dropdown-target="content"
             class="hidden absolute left-0 top-full pt-1 w-48 z-50">
            <div class="bg-surface border border-secondary-200 dark:border-secondary-700 rounded-lg shadow-xl py-2">
                {% for child in item.children %}
                    <a href="{{ path(child.route, child.routeParams) }}"
                       data-turbo-prefetch="false"
                       class="block px-4 py-2 text-sm hover:bg-primary-50 dark:hover:bg-primary-800 transition">
                        {{ child.label|trans({}, 'menu') }}
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>

