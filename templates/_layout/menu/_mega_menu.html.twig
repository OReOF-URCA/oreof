{% set disclosureId = 'nav-disclosure-' ~ random() %}
{% set columns = {} %}

{% for child in item.children %}
    {% set column = child.column ?? 'menu.column.default' %}
    {% set columns = columns|merge({
        (column): (columns[column]|default([]))|merge([child])
    }) %}
{% endfor %}

<div class="static h-full flex items-center" data-controller="navbar-dropdown" data-turbo-prefetch="false"
     data-action="pointerenter->navbar-dropdown#open pointerleave->navbar-dropdown#close click@window->navbar-dropdown#close focusin->navbar-dropdown#focusIn focusout->navbar-dropdown#focusOut keydown->navbar-dropdown#keydown">
    {% if item.route %}
        <a href="{{ path(item.route, item.routeParams) }}"
           data-turbo-prefetch="false"
           class="topbar-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
            {{ item.label|trans({}, 'menu') }}
        </a>
    {% endif %}
    {% if item.children is not empty %}
        <twig:Button type="button" variant="secondary" size="sm"
                     extraClass="topbar-link !border-transparent !bg-transparent !shadow-none !px-1.5"
                     dataAction="click->navbar-dropdown#toggle"
                     data-navbar-dropdown-target="trigger"
                     aria-expanded="false"
                     aria-controls="{{ disclosureId }}"
                     aria-label="Afficher ou masquer les liens : {{ item.label|trans({}, 'menu') }}">
            {% if not item.route %}{{ item.label|trans({}, 'menu') }}{% endif %}
            <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 9l-7 7-7-7"></path>
            </svg>
        </twig:Button>
    {% elseif not item.route %}
        <span class="topbar-link">{{ item.label|trans({}, 'menu') }}</span>
    {% endif %}

    {% if item.children is not empty %}
    <div id="{{ disclosureId }}" data-navbar-dropdown-target="content"
         class="hidden absolute inset-x-0 top-full bg-surface border-b border-secondary-200 dark:border-secondary-700 shadow-2xl overflow-hidden z-50">
        <div class="max-w-7xl mx-auto grid grid-cols-{{ columns|length }} gap-8 p-8">
            {% for columnLabel, children in columns %}
                <div>
                    <h3 class="text-xs font-semibold text-text uppercase tracking-wider mb-4">
                        {{ columnLabel|trans({}, 'menu') }}
                    </h3>

                    <ul class="space-y-3">
                        {% for child in children %}
                            <li>
                                <a href="{{ path(child.route, child.routeParams) }}"
                                   data-turbo-prefetch="false"
                                   class="text-sm text-text hover:text-primary">
                                    {{ child.label|trans({}, 'menu') }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
