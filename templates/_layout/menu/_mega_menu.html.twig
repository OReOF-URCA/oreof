{% set columns = {} %}

{% for child in item.children %}
    {% set column = child.column ?? 'menu.column.default' %}
    {% set columns = columns|merge({
        (column): (columns[column]|default([]))|merge([child])
    }) %}
{% endfor %}

<div class="static" data-controller="navbar-dropdown"
     data-action="click@window->navbar-dropdown#close">
    <button data-action="click->navbar-dropdown#toggle"
            class="flex items-center text-text hover:text-primary px-3 py-2 text-sm font-medium">
        <a href="{{ path(item.route, item.routeParams) }}">
            {{ item.label|trans({}, 'menu') }}
        </a>
        <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>

    <div data-navbar-dropdown-target="content"
         class="hidden absolute inset-x-0 top-16 bg-surface border-b border-secondary-200 dark:border-secondary-700 shadow-2xl overflow-hidden">
        <div class="max-w-7xl mx-auto grid grid-cols-{{ columns|length }} gap-8 p-8">
            {% for columnLabel, children in columns %}
                <div>
                    <h3 class="text-xs font-semibold text-text uppercase tracking-wider mb-4">
                        {{ columnLabel|trans({}, 'menu') }}
                    </h3>

                    <ul class="space-y-3">
                        {% for child in children %}
                            <li>
                                <a href="{{ path(child.route, child.routeParams) }}"
                                   class="text-sm text-text hover:text-primary">
                                    {{ child.label|trans({}, 'menu') }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
