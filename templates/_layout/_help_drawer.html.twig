{# templates/_layout/_help_drawer.html.twig #}

{# Paramètres optionnels :
   - help_route : clé d'aide à utiliser à la place de la route courante (ex. « erreur » pour les pages d'erreur) ;
   - embedded   : true sur les pages publiques (base-speciale) : pas de bouton flottant, le contrôleur
                  Stimulus `help-drawer` est posé par la page, le panneau est toujours disponible. #}
{% set embedded = embedded|default(false) %}
{% set current_route = help_route|default(app.request.attributes.get('_route', '')) %}
{% set current_help = get_page_help(current_route) %}

{# N'affiche le FAB / offcanvas que si une aide existe pour la page ou si l'utilisateur est admin #}
{% if current_help or is_granted('ROLE_ADMIN') or embedded %}

    {% if not embedded %}<div data-controller="help-drawer" data-action="keydown@window->help-drawer#onEscape">{% endif %}

        {% if not embedded %}
        <div id="help-fab-container" class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 w-fit z-[65]">
            <button id="helpFabToggle" class="shadow-lg rounded-full flex items-center justify-center w-14 h-14 text-white focus:outline-none focus:ring-2 focus:ring-offset-2 hover:opacity-95 transition cursor-pointer" type="button" title="Aide de la page" aria-expanded="false" aria-controls="helpOffcanvas" aria-label="Ouvrir l'aide" data-action="click->help-drawer#toggle" style="background-color: {{ current_help ? 'var(--semantic-primary)' : 'var(--semantic-warning)' }};">
                <twig:UX:Icon name="icon:question" class="w-7 h-7 text-white" />
            </button>
        </div>
        {% endif %}

        <div id="helpBackdrop" class="fixed inset-0 bg-black/40 hidden z-[60]" aria-hidden="true" data-action="click->help-drawer#onBackdropClick"></div>

        <aside id="helpOffcanvas" class="fixed right-0 top-0 h-full w-80 sm:w-[28rem] transform translate-x-full transition-transform duration-300 ease-in-out bg-white border-l border-none shadow-lg z-[70] flex flex-col dark:bg-secondary-900 dark:border-secondary-700" aria-hidden="true" role="dialog" aria-labelledby="helpOffcanvasTitle">

            {# Poignée ancrée sur la hauteur RÉELLE du panneau (et non sur son contenu scrollable
               ci-dessous), pour qu'elle reste visible sur toute la hauteur même quand l'aide
               défile. #}
            <div id="helpResizeHandle" class="hidden sm:flex items-center justify-center absolute left-0 top-0 z-10 h-full w-2.5 -ml-0.5 cursor-ew-resize group" title="Redimensionner le panneau d'aide" aria-hidden="true" data-action="mousedown->help-drawer#startResize">
                <div class="absolute inset-y-0 left-0.5 w-1.5 rounded-full bg-secondary-300 group-hover:bg-primary-400 group-active:bg-primary-500 transition-colors dark:bg-secondary-600"></div>
                <div class="relative flex items-center justify-center h-9 w-3.5 rounded-full bg-secondary-300 text-secondary-600 shadow-sm opacity-80 group-hover:opacity-100 group-hover:bg-primary-500 group-hover:text-white group-active:bg-primary-600 transition-colors dark:bg-secondary-600 dark:text-secondary-200">
                    <twig:UX:Icon name="ph:dots-six-vertical-bold" class="w-3 h-3" />
                </div>
            </div>

            {# En-tête : hors de la zone scrollable ci-dessous, donc toujours visible (équivalent
               d'un sticky top, mais fiable même si le contenu défile beaucoup). #}
            <div class="shrink-0 p-4 flex items-center justify-between" style="background-color: {{ current_help ? 'var(--semantic-primary)' : 'var(--semantic-warning)' }}; color: white;">
                <h5 id="helpOffcanvasTitle" class="mb-0 flex items-center gap-2 text-sm font-semibold">
                    <twig:UX:Icon name="icon:question" class="w-4 h-4" />
                    <span>{{ current_help ? current_help.title : 'Aide' }}</span>
                </h5>
                <div class="flex items-center gap-3 shrink-0">
                    {% if current_help and app.user %}
                        <a href="{{ path('app_help_view', {'id': current_help.id}) }}" target="_blank" rel="noopener" class="text-white/90 hover:text-white focus:outline-none" title="Ouvrir cette aide dans un nouvel onglet (pratique sur un second écran)" aria-label="Ouvrir l'aide dans un nouvel onglet">
                            <twig:UX:Icon name="material-symbols:open-in-new" class="w-4 h-4" />
                        </a>
                    {% endif %}
                    <button id="helpOffcanvasClose" class="text-white text-2xl leading-none focus:outline-none cursor-pointer" type="button" aria-label="Fermer l'aide" data-action="click->help-drawer#close">&times;</button>
                </div>
            </div>

            {# Seule cette zone défile : le header au-dessus et la poignée restent fixes. #}
            <div class="flex-1 overflow-y-auto p-4 text-secondary-700 dark:text-secondary-200">
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="flex flex-wrap items-center gap-2 mb-4 pb-3 border-b border-secondary-200 dark:border-secondary-700">
                        {% if current_help %}
                            <twig:Button
                                    href="{{ path('app_help_edit', {'id': current_help.id}) }}"
                                    variant="primary"
                                    size="sm"
                                    icon="mingcute:pencil-line"
                                    label="Modifier"
                            />
                        {% else %}
                            <twig:Button
                                    href="{{ path('app_help_new', {'route': current_route}) }}"
                                    variant="success"
                                    size="sm"
                                    icon="ph:plus-light"
                                    label="Créer"
                            />
                        {% endif %}

                        <twig:Button
                                href="{{ path('app_help_index') }}"
                                variant="warning"
                                size="sm"
                                icon="material-symbols:list-rounded"
                                label="Gérer"
                        />

                        <code class="bg-secondary-100 text-secondary-800 px-2 py-1 rounded border shadow-sm text-sm dark:bg-secondary-800 dark:text-secondary-200 dark:border-secondary-secondary">{{ current_route }}</code>
                    </div>
                {% endif %}

                {# CONTENU DE L'AIDE #}
                <div>
                    {% include 'help/_content.html.twig' with { help: current_help } %}
                </div>
            </div>
        </aside>

    {% if not embedded %}</div>{% endif %}

{% endif %}