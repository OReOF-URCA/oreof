<!-- Nav Content Start -->
<nav class="bg-surface border-b border-secondary-200 dark:border-secondary-700 sticky top-0 z-50 shadow-sm" data-turbo-prefetch="false">
    <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">

            <div class="flex items-center space-x-8 h-full">
                <div class="flex items-center font-bold text-primary text-xl tracking-tight gap-2">
                    <img src="{{ asset('Logo/Logo.svg', 'image_package') }}" alt="Logo ORéOF" class="h-8 w-auto block">

                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="text-danger whitespace-nowrap">/ Adm.</span>
                    {% endif %}
                </div>

                <div class="hidden md:flex items-center space-x-4 h-full">
                    <a href="{{ path('app_homepage') }}"
                       class="text-text hover:text-primary px-3 py-2 text-sm font-medium transition">{{ 'menu.tableau_de_bord'|trans({}, 'menu') }}</a>

                    {% for item in main_menu() %}
                        {% include '_layout/menu/_topbar_item.html.twig' with {
                            item: item
                        } only %}
                    {% endfor %}
                </div>
            </div>

            {# Menu aligné droite #}
            <div class="flex items-center space-x-6">

                <button
                        type="button"
                        data-action="click->navigation-palette#open"
                        class="hidden lg:flex items-center gap-2 rounded-lg border border-secondary-200 bg-white/80 px-3 py-1.5 text-sm text-secondary-500 shadow-sm hover:border-primary-300 hover:text-primary dark:border-secondary-700 dark:bg-secondary-900 dark:text-secondary-300"
                >
                    <twig:UX:Icon name="mdi:magnify" class="h-4 w-4"/>
                    <span>Accès rapide</span>
                    <span class="ml-2 flex items-center gap-1">
                        <kbd class="rounded border border-secondary-200 bg-secondary-50 px-1.5 py-0.5 text-[11px] dark:border-secondary-700 dark:bg-secondary-800">Ctrl/⌘</kbd>
                        <kbd class="rounded border border-secondary-200 bg-secondary-50 px-1.5 py-0.5 text-[11px] dark:border-secondary-700 dark:bg-secondary-800">K</kbd>
                    </span>
                </button>

                {# Replaced legacy inline search with notifications / action icons component (Tailwind) #}
                {{ component('notifications', {
                    user: app.user,
                    formation: formation is defined ? formation : null,
                    parcours: parcours is defined ? parcours : null
                }) }}

                {# Menu Campagne collecte #}
                <div class="relative" data-controller="navbar-dropdown"
                     data-action="click@window->navbar-dropdown#close">
                    <button data-action="click->navbar-dropdown#toggle"
                            class="flex items-center bg-primary-50 dark:bg-primary-800 text-primary px-3 py-1.5 rounded-lg text-xs font-bold border border-primary-100 dark:text-primary-400 dark:border-primary-300 hover:bg-primary-100 dark:hover:bg-primary-700 transition">
                        <span class="mr-1">{{ user_data.campagneCollecte != null ? user_data.campagneCollecte.libelle|trim|raw : 'erreur' }}</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div data-navbar-dropdown-target="content"
                         class="hidden border-secondary-200 dark:border-secondary-700 absolute right-0 mt-2 w-32 bg-surface border rounded-lg shadow-lg z-50">
                        {% for dpe in user_data.dpes %}
                            <a href="{{ path('app_switch_dpe', {id: dpe.id}) }}"
                               class="block px-4 py-2 text-xs {% if dpe.id == user_data.campagneCollecte.id %}text-primary bg-primary-50 font-bold{% else %}hover:bg-secondary-50 hover:dark:bg-secondary-800{% endif %}">{{ dpe.libelle }}</a>
                        {% endfor %}
                    </div>
                </div>
                {# Fin Menu Campagne collecte #}

                {# Menu User #}
                <div class="relative" data-controller="navbar-dropdown"
                     data-action="click@window->navbar-dropdown#close">
                    <button data-action="click->navbar-dropdown#toggle"
                            class="flex items-center focus:outline-none">
                        <div class="h-9 w-9 rounded-full bg-primary flex items-center justify-center text-white text-sm font-bold ring-2 ring-offset-2 ring-transparent hover:ring-primary-500 transition-all">
                            {{ app.user.avatarInitiales }}
                        </div>
                    </button>
                    <div data-navbar-dropdown-target="content"
                         class="hidden absolute right-0 mt-2 w-56 bg-surface border border-secondary-200 dark:border-secondary-700 rounded-xl shadow-2xl py-2 overflow-hidden">
                        <div class="px-4 py-3 border-b border-secondary-100 dark:border-secondary-700">
                            <p class="text-sm font-bold text-text">{{ app.user.display }}</p>
                            <p class="text-xs text-secondary-500 truncate">{{ app.user.email }}</p>
                        </div>
                        <a href="{{ path('app_user_mes_informations') }}"
                           class="flex items-center px-4 py-2 text-sm text-text hover:bg-secondary-50 dark:hover:bg-secondary-800">
                            <svg class="w-4 h-4 mr-3 text-text" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            Mes informations
                        </a>
                        <a href="{{ path('app_user_mes_notifications') }}"
                           class="flex items-center px-4 py-2 text-sm text-text hover:bg-secondary-50 dark:hover:bg-secondary-800">
                            <svg class="w-4 h-4 mr-3 text-text" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            Mes notifications
                        </a>
                        {#                                    <button type="button" #}
                        {#                                            class="w-100 text-start bg-transparent border-0 p-0" #}
                        {#                                            data-action="click->theme#toggle" #}
                        {#                                            title="Basculer entre mode clair et mode sombre" #}
                        {#                                    > #}
                        {#                                        <i class="fas fa-circle-half-stroke"></i> #}
                        {#                                        <span data-theme-target="label">Basculer le thème</span> #}
                        {#                                    </button> #}
                        {#                                {% if is_granted('ROLE_ADMIN') %} #}
                        {#                                    <li> #}
                        {#                                        <a href="{{ path('i18n_toggle_keys') }}"> #}
                        {#                                            {{ app.session.get('i18n_keys') ? '🔤 Mode clés: ON' : '🔤 Mode clés: OFF' }} #}
                        {#                                        </a> #}
                        {#                                    </li> #}
                        {#                                {% endif %} #}
                        <a href="{{ path('app_accessibilite') }}"
                           class="flex items-center px-4 py-2 text-sm text-text hover:bg-secondary-50 dark:hover:bg-secondary-800"
                           data-turbo="true"
                           data-action="click->modalturbo#open">
                            <svg class="w-4 h-4 mr-3 text-text" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            Parametres & accessibilite
                        </a>
                        <hr class="my-1 border-secondary-100 dark:border-secondary-700">
                        <a href="{{ path('app_logout') }}"
                           class="flex items-center px-4 py-2 text-sm text-danger hover:bg-danger-50 dark:hover:bg-danger-800">
                            <svg class="w-4 h-4 mr-3 text-danger dark:text-danger-300" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            Déconnexion
                        </a>
                    </div>
                </div>
                {# Fin Menu User #}
            </div>
            {# Fin Menu aligné droite #}
        </div>
    </div>
</nav>
<!-- Nav Content End -->


