{# templates/_layout/_translations_drawer.html.twig #}
{% if is_granted('ROLE_ADMIN') and is_key_mode_enabled() %}
    {% set translations_by_domain = page_translations() %}
    {% set total_keys = page_translations_count() %}
    {% set is_keys_on = is_key_mode_enabled() %}

    <div data-controller="page-translations-drawer" data-action="keydown@window->page-translations-drawer#onEscape">

        {# ── Bouton Flottant (FAB) ── #}
        <div id="page-translations-fab-container" class="fixed right-6 sm:right-8 w-fit z-[65]" style="bottom: 5.5rem;">
            <button
                    id="pageTranslationsFabToggle"
                    type="button"
                    class="relative shadow-lg rounded-full flex items-center justify-center w-14 h-14 bg-indigo-600 hover:bg-indigo-700 text-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2 transition cursor-pointer"
                    title="Traductions et textes de la page"
                    aria-expanded="false"
                    aria-controls="pageTranslationsOffcanvas"
                    aria-label="Ouvrir le panneau des traductions de la page"
                    data-action="click->page-translations-drawer#toggle"
            >
                <twig:UX:Icon name="icon:translate" class="w-6 h-6 text-white"/>
                {% if total_keys > 0 %}
                    <span class="absolute -top-1 -right-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-danger-500 px-1 text-[11px] font-bold text-white shadow-sm ring-2 ring-white dark:ring-secondary-900">
                        {{ total_keys }}
                    </span>
                {% endif %}
            </button>
        </div>

        {# ── Backdrop ── #}
        <div id="pageTranslationsBackdrop" class="fixed inset-0 bg-black/40 hidden z-[60]" aria-hidden="true"
             data-action="click->page-translations-drawer#onBackdropClick"></div>

        {# ── Tiroir / Offcanvas ── #}
        <aside
                id="pageTranslationsOffcanvas"
                class="fixed right-0 top-0 h-full w-[22rem] sm:w-[32rem] max-w-[90vw] transform translate-x-full transition-transform duration-300 ease-in-out bg-white border-l border-secondary-200 shadow-2xl z-[70] flex flex-col dark:bg-secondary-900 dark:border-secondary-700"
                aria-hidden="true"
                role="dialog"
                aria-labelledby="pageTranslationsTitle"
        >
            {# Poignée de redimensionnement #}
            <div id="pageTranslationsResizeHandle"
                 class="hidden sm:flex items-center justify-center absolute left-0 top-0 z-10 h-full w-2.5 -ml-0.5 cursor-ew-resize group"
                 title="Redimensionner le panneau" aria-hidden="true"
                 data-action="mousedown->page-translations-drawer#startResize">
                <div class="absolute inset-y-0 left-0.5 w-1.5 rounded-full bg-secondary-300 group-hover:bg-primary-400 group-active:bg-primary-500 transition-colors dark:bg-secondary-600"></div>
                <div class="relative flex items-center justify-center h-9 w-3.5 rounded-full bg-secondary-300 text-secondary-600 shadow-sm opacity-80 group-hover:opacity-100 group-hover:bg-primary-500 group-hover:text-white group-active:bg-primary-600 transition-colors dark:bg-secondary-600 dark:text-secondary-200">
                    <twig:UX:Icon name="ph:dots-six-vertical-bold" class="w-3 h-3"/>
                </div>
            </div>

            {# En-tête fixe #}
            <div class="shrink-0 p-4 border-b border-secondary-200 bg-secondary-50 dark:bg-secondary-800 dark:border-secondary-700">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-900/60 dark:text-primary-300">
                            <twig:UX:Icon name="icon:translate" class="w-4 h-4"/>
                        </div>
                        <div>
                            <h5 id="pageTranslationsTitle"
                                class="text-sm font-bold text-secondary-900 dark:text-secondary-100">
                                Textes de la page
                            </h5>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400">
                                <span data-page-translations-drawer-target="countBadge">{{ total_keys }}</span> clé(s)
                                détectée(s)
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        {# Bascule rapide mode clés #}
                        <a
                                href="{{ path('i18n_toggle_keys') }}"
                                class="inline-flex items-center gap-1 rounded-md border px-2 py-1 text-xs font-semibold transition {{ is_keys_on ? 'border-warning-400 bg-warning-50 text-warning-700 dark:bg-warning-900/40 dark:text-warning-300' : 'border-secondary-200 bg-white text-secondary-600 hover:bg-secondary-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300' }}"
                                title="{{ is_keys_on ? 'Désactiver le mode clés' : 'Activer le mode clés visuel' }}"
                        >
                            <span class="text-[10px]">🔤</span>
                            <span>{{ is_keys_on ? 'Clés : ON' : 'Clés : OFF' }}</span>
                        </a>

                        <a
                                href="{{ path('translations_index') }}"
                                target="_blank"
                                rel="noopener"
                                class="rounded-md p-1 text-secondary-400 hover:bg-secondary-200 hover:text-secondary-700 dark:hover:bg-secondary-700 dark:hover:text-secondary-200 transition"
                                title="Ouvrir la gestion globale des traductions"
                                aria-label="Gestion globale des traductions"
                        >
                            <twig:UX:Icon name="ph:arrow-square-out-light" class="w-4 h-4"/>
                        </a>

                        <button
                                id="pageTranslationsClose"
                                class="rounded-md p-1 text-secondary-400 hover:bg-secondary-200 hover:text-secondary-700 dark:hover:bg-secondary-700 dark:hover:text-secondary-200 text-xl leading-none transition cursor-pointer"
                                type="button"
                                aria-label="Fermer le panneau"
                                data-action="click->page-translations-drawer#close"
                        >
                            &times;
                        </button>
                    </div>
                </div>

                {# Barre de recherche rapide #}
                <div class="mt-3">
                    <div class="relative">
                        <input
                                data-page-translations-drawer-target="searchInput"
                                data-action="input->page-translations-drawer#filter"
                                type="text"
                                placeholder="Filtrer une clé ou un texte..."
                                class="w-full rounded-lg border border-secondary-300 bg-white px-3 py-1.5 pl-8 text-xs text-secondary-800 placeholder:text-secondary-400 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-900 dark:text-secondary-100"
                        />
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-secondary-400">
                            <twig:UX:Icon name="icon:search" class="w-3.5 h-3.5"/>
                        </div>
                    </div>
                </div>

                {# Filtres par domaine #}
                {% if translations_by_domain|length > 1 %}
                    <div class="mt-2.5 flex flex-wrap gap-1.5">
                        <button
                                type="button"
                                data-page-translations-drawer-target="domainFilter"
                                data-domain="all"
                                data-action="click->page-translations-drawer#selectDomain"
                                class="rounded-md border border-primary bg-primary px-2 py-0.5 text-[11px] font-semibold text-white transition cursor-pointer"
                        >
                            Tous ({{ total_keys }})
                        </button>
                        {% for domain, keys in translations_by_domain %}
                            <button
                                    type="button"
                                    data-page-translations-drawer-target="domainFilter"
                                    data-domain="{{ domain }}"
                                    data-action="click->page-translations-drawer#selectDomain"
                                    class="rounded-md border border-secondary-200 bg-white px-2 py-0.5 text-[11px] font-medium text-secondary-700 hover:bg-secondary-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700 transition cursor-pointer"
                            >
                                {{ domain }} ({{ keys|length }})
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {# Contenu défilant #}
            <div class="flex-1 overflow-y-auto p-4 space-y-3" data-page-translations-drawer-target="itemList">
                {% if total_keys == 0 %}
                    <div class="rounded-xl border border-dashed border-secondary-300 p-6 text-center text-secondary-500 dark:border-secondary-700 dark:text-secondary-400">
                        <twig:UX:Icon name="icon:info" class="mx-auto h-8 w-8 text-secondary-400 mb-2"/>
                        <p class="text-sm font-medium">Aucun texte dynamique détecté sur cette page.</p>
                    </div>
                {% else %}
                    {% for domain, keys in translations_by_domain %}
                        {% for key, info in keys %}
                            {% set filename = info.filename %}
                            <div
                                    data-page-translations-drawer-target="item"
                                    data-translation-key="{{ key }}"
                                    data-translation-domain="{{ domain }}"
                                    data-original-value="{{ info.value|e('html_attr') }}"
                                    data-save-url="{{ path('translations_save_one', {filename: filename}) }}"
                                    class="group rounded-xl border border-secondary-200 bg-white p-3 shadow-xs transition hover:border-primary-300 hover:shadow-sm dark:border-secondary-700 dark:bg-secondary-800/80 dark:hover:border-secondary-600"
                            >
                                {# Métadonnées de la clé #}
                                <div class="flex items-center justify-between gap-2 mb-1.5">
                                    <div class="flex items-center gap-1.5 min-w-0">
                                        <span class="rounded bg-secondary-100 px-1.5 py-0.5 text-[10px] font-semibold text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300 shrink-0">
                                            {{ domain }}
                                        </span>
                                        <button
                                                type="button"
                                                class="font-mono text-xs font-semibold text-secondary-800 dark:text-secondary-200 truncate select-all hover:text-primary-600 dark:hover:text-primary-400 text-left"
                                                title="Cliquer pour copier la clé"
                                                data-key="{{ key }}"
                                                data-action="click->page-translations-drawer#copyKey"
                                        >
                                            {{ key }}
                                        </button>
                                    </div>
                                    <div class="flex items-center gap-1 shrink-0">
                                        <a
                                                href="{{ path('translations_edit', {filename: filename}) }}"
                                                target="_blank"
                                                rel="noopener"
                                                class="rounded p-1 text-secondary-400 hover:text-primary-600 transition"
                                                title="Ouvrir le fichier {{ filename }}"
                                        >
                                            <twig:UX:Icon name="ph:file-text-light" class="w-3.5 h-3.5"/>
                                        </a>
                                    </div>
                                </div>

                                {# Mode Affichage du texte #}
                                <div data-role="value-display-box" class="space-y-2">
                                    <div class="rounded-lg bg-secondary-50 p-2.5 text-xs text-secondary-800 dark:bg-secondary-900/70 dark:text-secondary-200 whitespace-pre-wrap break-words leading-relaxed font-normal">
                                        <span data-role="value-display">{{ info.value }}</span>
                                    </div>
                                    <div class="flex justify-end">
                                        <button
                                                type="button"
                                                data-action="click->page-translations-drawer#edit"
                                                class="inline-flex items-center gap-1 rounded-md border border-secondary-200 bg-white px-2 py-1 text-xs font-medium text-secondary-700 hover:bg-secondary-50 hover:text-primary-700 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:bg-secondary-700 transition cursor-pointer"
                                        >
                                            <twig:UX:Icon name="icon:edit" class="w-3 h-3"/>
                                            <span>Modifier</span>
                                        </button>
                                    </div>
                                </div>

                                {# Mode Édition du texte #}
                                <div data-role="value-edit-box" class="hidden space-y-2">
                                    <textarea
                                            data-role="value-input"
                                            rows="3"
                                            class="w-full rounded-lg border border-primary-400 bg-white p-2 text-xs text-secondary-800 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-primary-500 dark:bg-secondary-900 dark:text-secondary-100"
                                    >{{ info.value }}</textarea>
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button
                                                type="button"
                                                data-action="click->page-translations-drawer#cancel"
                                                class="rounded-md border border-secondary-300 bg-white px-2.5 py-1 text-xs font-medium text-secondary-600 hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-700 dark:text-secondary-200 transition cursor-pointer"
                                        >
                                            Annuler
                                        </button>
                                        <button
                                                type="button"
                                                data-role="save-btn"
                                                data-action="click->page-translations-drawer#save"
                                                class="inline-flex items-center gap-1 rounded-md border border-success-400 bg-success-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-success-700 shadow-xs transition cursor-pointer disabled:opacity-50"
                                        >
                                            <twig:UX:Icon name="icon:save" class="w-3 h-3"/>
                                            <span>Enregistrer</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endfor %}
                {% endif %}
            </div>
        </aside>
    </div>
{% endif %}
