{% set items = breadcrumbs() %}

{% if items|length > 1 %}
    <nav aria-label="Fil d'Ariane" class="pt-0">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm">
            {% for item in items %}
                <li class="flex items-center gap-2">
                    {% if not loop.first %}
                        <span class="text-secondary-400">/</span>
                    {% endif %}

                    {% if not loop.last and item.route %}
                        <a
                                href="{{ path(item.route, item.routeParams) }}"
                                class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-secondary-500 transition hover:bg-secondary-100 hover:text-secondary-700 dark:text-secondary-400 dark:hover:bg-secondary-800 dark:hover:text-secondary-200"
                        >
                            {% if item.icon %}
                                <twig:UX:Icon :name="item.icon" class="h-4 w-4" aria-hidden="true"/>
                            {% endif %}
                            {{ item.label|trans({}, 'menu') }}
                        </a>
                    {% else %}
                        <span class="rounded-md bg-secondary-100 px-2 py-1 font-semibold text-secondary-700 dark:bg-secondary-800 dark:text-secondary-200"
                              aria-current="page">
                            {{ item.label|trans({}, 'menu') }}
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
