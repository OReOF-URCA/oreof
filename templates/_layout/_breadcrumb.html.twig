{% set items = breadcrumbs() %}

{% if items|length > 1 %}
    <twig:Breadcrumb>
        <twig:Breadcrumb:List>
            {% for item in items %}
                {% if not loop.first %}
                    <twig:Breadcrumb:Separator />
                {% endif %}

                <twig:Breadcrumb:Item>
                    {% if loop.last %}
                        <twig:Breadcrumb:Page>
                            {{ item.label|trans({}, 'menu') }}
                        </twig:Breadcrumb:Page>
                    {% elseif item.route %}
                        <twig:Breadcrumb:Link href="{{ path(item.route, item.routeParams) }}">
                            {% if item.icon %}
                                <twig:UX:Icon :name="item.icon" class="h-4 w-4 group-data-[stuck=true]:h-3.5 group-data-[stuck=true]:w-3.5" aria-hidden="true" />
                            {% endif %}
                            {{ item.label|trans({}, 'menu') }}
                        </twig:Breadcrumb:Link>
                    {% else %}
                        <span class="rounded-md px-2 py-1 text-secondary-500 group-data-[stuck=true]:px-1.5 group-data-[stuck=true]:py-0.5 dark:text-secondary-400">
                            {{ item.label|trans({}, 'menu') }}
                        </span>
                    {% endif %}
                </twig:Breadcrumb:Item>
            {% endfor %}
        </twig:Breadcrumb:List>
    </twig:Breadcrumb>
{% endif %}
