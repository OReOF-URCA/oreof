{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .comp-collapsed {
            display: none !important;
        }
    </style>
{% endblock %}

{% block bouton_header %}
    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button href="{{ path('app_formation_new', { redirect: composante ? 'app_offre_composante_index' : 'app_offre_index', composante: composante ? composante.id : null }) }}"
                     variant="success" class="mr-2">
            Créer une formation
        </twig:Button>
        <twig:Button href="{{ path('offre_v2_configurer_dates') }}"
                     data-turbo="true"
                     data-action="click->modalturbo#open"
                     variant="secondary" class="mr-2">
            Dates de collecte
        </twig:Button>
    {% endif %}
        <twig:Button href="#" variant="secondary" class="mr-2">
            Exporter Excel
        </twig:Button>
     {% if is_granted('ROLE_ADMIN') %}
        <twig:Button href="#" variant="primary">
            Générer les annexes CA
        </twig:Button>
     {% endif %}
{% endblock %}

{% block content %}
    <turbo-frame id="offre_table">
        {% if campagne and not campagne.isPeriodActive() %}
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 flex items-start gap-3 mb-4">
                <div class="text-xl">⚠️</div>
                <div>
                    <h3 class="font-semibold text-red-900">La campagne de collecte est fermée</h3>
                    <p class="mt-1">
                        {% if campagne.dateOuvertureDpe and date() < campagne.dateOuvertureDpe %}
                            Elle ouvrira le {{ campagne.dateOuvertureDpe|date('d/m/Y à H:i') }}.
                        {% elseif campagne.dateClotureDpe and date() > campagne.dateClotureDpe %}
                            Elle a fermé le {{ campagne.dateClotureDpe|date('d/m/Y à H:i') }}.
                        {% else %}
                            Elle n'est pas ouverte actuellement.
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            En tant qu'administrateur, vous pouvez exceptionnellement modifier les capacités.
                        {% else %}
                            Les modifications sont désactivées.
                        {% endif %}
                    </p>
                </div>
            </div>
        {% endif %}
        
        {% set formUrl = composante ? path('app_offre_composante_index', {composante: composante.id}) : path('app_offre_index') %}
        <form method="get" action="{{ formUrl }}" data-turbo-frame="offre_table" class="space-y-6">
            <!-- KPI -->
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-6">
                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">Formations</p>
                    <p class="mt-2 text-3xl font-bold">{{ tabStatistiques.nbFormations }}</p>
                </div>

                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">Parcours</p>
                    <p class="mt-2 text-3xl font-bold">{{ tabStatistiques.nbParcours }}</p>
                </div>

                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">Ouverts</p>
                    <p class="mt-2 text-3xl font-bold text-green-700">{{ tabStatistiques.nbParcoursOuvert }}</p>
                </div>

                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">Capacité</p>
                    <p class="mt-2 text-3xl font-bold text-green-700">{{ tabStatistiques.capacite }}</p>
                </div>

                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">À confirmer</p>
                    <p class="mt-2 text-3xl font-bold text-amber-600">{{ tabStatistiques.nbAConfirmer }}</p>
                </div>

                <div class="rounded-xl border bg-white p-4 shadow-sm">
                    <p class="text-sm text-slate-500">Anomalies</p>
                    <p class="mt-2 text-3xl font-bold text-red-600">{{ tabStatistiques.nbAnomalies }}</p>
                </div>
            </div>

            <!-- Filters -->
            <div class="rounded-xl border bg-white p-4 shadow-sm">
                <div class="grid gap-4 md:grid-cols-12">
                    <div class="{% if composante %}md:col-span-5{% else %}md:col-span-3{% endif %}">
                        <input name="q" value="{{ filters.q|default('') }}" class="rounded-lg border px-3 py-2 text-sm w-full" placeholder="Rechercher une formation…" oninput="this.form.requestSubmit()">
                    </div>

                    {% if not composante %}
                        <div class="md:col-span-2">
                            <select name="comp" class="rounded-lg border px-3 py-2 text-sm w-full" onchange="this.form.requestSubmit()">
                                <option value="">Toutes les composantes</option>
                                {% for compItem in composantes %}
                                    <option value="{{ compItem.id }}" {% if filters.comp|default('') == compItem.id %}selected{% endif %}>{{ compItem.libelle }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <div class="md:col-span-2">
                        <select name="type" class="rounded-lg border px-3 py-2 text-sm w-full" onchange="this.form.requestSubmit()">
                            <option value="">Tous les diplômes</option>
                            {% for typeDiplome in typesDiplome %}
                                <option value="{{ typeDiplome.id }}" {% if filters.type|default('') == typeDiplome.id %}selected{% endif %}>{{ typeDiplome.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <select name="plateforme" class="rounded-lg border px-3 py-2 text-sm w-full" onchange="this.form.requestSubmit()">
                            <option value="">Toutes les plateformes</option>
                            {% for plateforme in plateformes %}
                                <option value="{{ plateforme.id }}" {% if filters.plateforme|default('') == plateforme.id %}selected{% endif %}>{{ plateforme.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <select name="statut" class="rounded-lg border px-3 py-2 text-sm w-full" onchange="this.form.requestSubmit()">
                            <option value="">Tous les statuts</option>
                            <option value="Brouillon" {% if filters.statut|default('') == 'Brouillon' %}selected{% endif %}>Brouillon</option>
                            <option value="Validé composante" {% if filters.statut|default('') == 'Validé composante' %}selected{% endif %}>Validé composante</option>
                            <option value="Validé central" {% if filters.statut|default('') == 'Validé central' %}selected{% endif %}>Validé central</option>
                            <option value="Anomalie" {% if filters.statut|default('') == 'Anomalie' %}selected{% endif %}>Anomalie</option>
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        <a href="{{ formUrl }}" data-turbo-frame="offre_table" class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 hover:bg-red-100 px-3 py-2 text-sm font-semibold text-red-700 transition-colors w-full text-center">
                            Effacer
                        </a>
                    </div>
                </div>
            </div>

            <!-- Alertes -->
            {% if tabStatistiques.allAnomalies|length > 0 %}
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
                    <div class="flex items-start gap-3">
                        <div class="text-xl">⚠️</div>
                        <div class="w-full">
                            <h2 class="font-semibold text-amber-900">{{ tabStatistiques.allAnomalies|length }} point{{ tabStatistiques.allAnomalies|length > 1 ? 's' : '' }} à vérifier</h2>
                            <ul class="mt-2 list-disc pl-5 text-sm text-amber-800 space-y-1 max-h-40 overflow-y-auto">
                                {% for anomaly in tabStatistiques.allAnomalies %}
                                    <li>{{ anomaly }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Table -->
            <div class="overflow-hidden rounded-xl border bg-white shadow-sm">
                <!-- Table Controls -->
                <div class="flex flex-wrap items-center justify-between gap-4 bg-slate-50/70 px-4 py-3 border-b border-slate-200 text-sm">
                    <div class="font-semibold text-slate-700">
                        Offre de formation {% if composante %}— <span class="text-primary font-bold">{{ composante.libelle }}</span>{% endif %}
                    </div>
                    <div class="flex items-center gap-4 text-xs font-medium">
                        {% if not composante %}
                            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg p-1 shadow-sm">
                                <span class="text-slate-400 px-1.5 font-normal">Composantes:</span>
                                <button type="button" onclick="toggleAllComposantes(true)" class="px-2 py-1 hover:bg-slate-50 text-indigo-600 rounded font-semibold transition-colors">Déplier tout</button>
                                <button type="button" onclick="toggleAllComposantes(false)" class="px-2 py-1 hover:bg-slate-50 text-slate-600 rounded font-semibold transition-colors">Replier tout</button>
                            </div>
                        {% endif %}
                        <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg p-1 shadow-sm">
                            <span class="text-slate-400 px-1.5 font-normal">Parcours:</span>
                            <button type="button" onclick="toggleAllParcours(true)" class="px-2 py-1 hover:bg-slate-50 text-indigo-600 rounded font-semibold transition-colors">Déplier tout</button>
                            <button type="button" onclick="toggleAllParcours(false)" class="px-2 py-1 hover:bg-slate-50 text-slate-600 rounded font-semibold transition-colors">Replier tout</button>
                        </div>
                    </div>
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-4 py-3">Formation</th>
                        <th class="px-4 py-3">Composante</th>
                        <th class="px-4 py-3">Parcours / année</th>
                        <th class="px-4 py-3">Ouvert</th>
                        <th class="px-4 py-3">Plateformes</th>
                        <th class="px-4 py-3 text-right">Capacité</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                    </thead>

                    <tbody class="divide-y">
                    {% for compName, compGroup in groupedFormations %}
                        {% set compId = loop.index %}

                        <!-- Group Composante -->
                        <tr class="bg-slate-100 hover:bg-slate-200/80 cursor-pointer select-none transition-colors border-t border-slate-200"
                            onclick="document.querySelectorAll('.comp-{{ compId }}-row').forEach(row => row.classList.toggle('comp-collapsed')); this.querySelector('.comp-chevron').classList.toggle('rotate-90');">
                            <td colspan="3" class="px-4 py-3 font-semibold text-slate-700">
                                <div class="flex items-center gap-2">
                                    <svg class="comp-chevron h-4 w-4 text-slate-500 transform transition-transform duration-200 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                    </svg>
                                    <span class="font-bold text-slate-900">{{ compGroup.libelle }}</span>
                                    <span class="text-xs font-normal text-slate-500 ml-1">({{ compGroup.nbFormations }} formation{{ compGroup.nbFormations > 1 ? 's' : '' }} · {{ compGroup.nbParcours }} parcours)</span>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs text-slate-700 font-medium">
                                    {{ compGroup.nbParcoursOuvert }}/{{ compGroup.nbParcours }} ouverts
                                </span>
                            </td>
                            <td class="px-4 py-3">&nbsp;</td>
                            <td class="px-4 py-3 text-right font-bold text-slate-800">{{ compGroup.capacite }}</td>
                            <td class="px-4 py-3">&nbsp;</td>
                            <td class="px-4 py-3">&nbsp;</td>
                        </tr>

                        {% for forma in compGroup.formations %}
                            {% set formation = forma.formation %}
                            {% set formationOuverte = forma.isOuverte %}
                            <tr class="hover:bg-slate-50 comp-{{ compId }}-row composante-child-row transition-all duration-150">
                                <td class="px-4 py-3">
                                    <div class="font-medium text-slate-900">
                                        {{ formation.display }}
                                        {% if forma.anomalies|length > 0 %}
                                            <span class="inline-flex items-center text-red-600 ml-1 cursor-help animate-pulse" title="{{ forma.anomalies|join('\n') }}">⚠️</span>
                                        {% endif %}
                                    </div>
                                    <div class="text-xs text-slate-500">{{ formation.typeDiplome ? formation.typeDiplome.libelle : '' }}</div>
                                </td>
                                <td class="px-4 py-3 text-slate-600">
                                    {{ formation.composantePorteuse ? formation.composantePorteuse.libelle : '' }}
                                </td>

                                <td class="px-4 py-3 text-slate-400">({{ forma.parcoursData|length }} parcours)</td>
                                <td class="px-4 py-3">
                                    <span class="rounded-full bg-{{ formationOuverte ? 'green' : 'red' }}-100 px-2 py-1 text-xs text-{{ formationOuverte ? 'green' : 'red' }}-700 font-semibold">
                                        {{ formationOuverte ? 'Oui' : 'Non' }}
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex gap-1 flex-wrap">
                                        {% set typeDiplId = formation.typeDiplome ? formation.typeDiplome.id : null %}
                                        {% if typeDiplId and tpaByTypeDiplome[typeDiplId] is defined %}
                                            {% for tpa in tpaByTypeDiplome[typeDiplId] %}
                                                {% if tpa.plateforme and tpa.plateforme.active %}
                                                   <twig:Badge :variant="tpa.plateforme.color" :label="tpa.plateforme.code" />
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right font-semibold text-slate-800">{{ forma.capacite }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex gap-1 flex-wrap">
                                        {% set renderedStates = [] %}
                                        {% for dpePar in forma.dpeParcours %}
                                            {% set state = (dpePar.etatValidation|keys)|first|default('initialisation_dpe') %}
                                            {% if state not in renderedStates %}
                                                {% set renderedStates = renderedStates|merge([state]) %}
                                                {% for badge in dpePar.etatValidation|badgeDpeDto %}
                                                    <twig:Badge :variant="badge.variant" :label="badge.label" />
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if forma.dpeParcours|length == 0 %}
                                            <span class="text-xs text-slate-400">Non initialisé</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <twig:Button variant="primary" class="mr-2"
                                                 href="{{ path('offre_v2_configurer', { slug: formation.slug }) }}"
                                                 data-turbo-frame="_top"
                                    >
                                        Configurer
                                    </twig:Button>
                                </td>
                            </tr>
                            {% for parcoursId, pd in forma.parcoursData %}
                                {% set parcours = pd.parcours %}
                                {% set parcoursCapacite = pd.capacite %}
                                {% set isParcoursOuvert = pd.isOuvert %}
                                {% set dpeParc = pd.dpeParcours %}
                                <tr class="bg-slate-50/50 hover:bg-slate-100/80 transition-colors cursor-pointer select-none border-t border-slate-100 comp-{{ compId }}-row composante-child-row"
                                    {% if pd.annees|length > 0 %}
                                    onclick="document.querySelectorAll('.parcours-{{ parcours.id }}-row').forEach(row => row.classList.toggle('hidden')); this.querySelector('.chevron-icon').classList.toggle('rotate-90');"
                                    {% endif %}
                                >
                                    <td>&nbsp;</td>
                                    <td class="px-4 py-3 text-slate-500 font-medium">
                                        {{ pd.composanteLibelle }}
                                    </td>
                                    <td class="px-4 py-3 font-semibold text-slate-700">
                                        <div class="flex items-center gap-2">
                                            {% if pd.annees|length > 0 %}
                                                <svg class="chevron-icon h-4 w-4 text-slate-400 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                                </svg>
                                            {% endif %}
                                            <span>{{ parcours.libelle }}</span>
                                            <span class="text-xs font-normal text-slate-400">({{ pd.annees|length }} année{{ pd.annees|length > 1 ? 's' : '' }})</span>
                                            {% set parcAnomalies = forma.parcoursAnomalies[parcours.id]|default([]) %}
                                            {% if parcAnomalies|length > 0 %}
                                                <span class="inline-flex items-center text-red-600 ml-1 cursor-help animate-pulse" title="{{ parcAnomalies|join('\n') }}">⚠️</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="rounded-full bg-{{ isParcoursOuvert ? 'green' : 'red' }}-100 px-2 py-1 text-xs text-{{ isParcoursOuvert ? 'green' : 'red' }}-700 font-medium">
                                            {{ isParcoursOuvert ? 'Oui' : 'Non' }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">&nbsp;</td>
                                    <td class="px-4 py-3 text-right font-semibold text-slate-700">{{ parcoursCapacite }}</td>
                                    <td class="px-4 py-3">
                                        {% if dpeParc %}
                                            <div class="flex gap-1 flex-wrap">
                                                {% for badge in dpeParc.etatValidation|badgeDpeDto %}
                                                    <twig:Badge :variant="badge.variant" :label="badge.label" />
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            &nbsp;
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3">&nbsp;</td>
                                </tr>
                                {% for annee in pd.annees %}
                                    <tr class="parcours-{{ parcours.id }}-row parcours-child-row hover:bg-slate-50/80 hidden transition-all border-t border-slate-100 comp-{{ compId }}-row composante-child-row">
                                        <td>&nbsp;</td>
                                        <td>&nbsp;</td>
                                        <td class="px-4 py-3 pl-8 text-slate-600 font-medium">
                                            Année {{ annee.ordre }} {# todo: préciser si tronc commun ? #}
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="rounded-full bg-{{ annee.isOuvert ? 'green' : 'red' }}-100 px-2 py-1 text-xs text-{{ annee.isOuvert ? 'green' : 'red' }}-700 font-medium">
                                                {{ annee.isOuvert ? 'Oui' : 'Non' }}
                                            </span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="flex gap-1 flex-wrap">
                                                {% set typeDiplId = formation.typeDiplome ? formation.typeDiplome.id : null %}
                                                {% if typeDiplId and tpaByTypeDiplome[typeDiplId] is defined %}
                                                    {% for tpa in tpaByTypeDiplome[typeDiplId] %}
                                                        {% if tpa.plateforme and tpa.plateforme.active and tpa.annees and annee.ordre in tpa.annees %}
                                                            <twig:Badge :variant="tpa.plateforme.color" :label="tpa.plateforme.code" />
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-right font-medium text-slate-700">{{ annee.capaciteAccueil|default(0) }}</td>
                                        <td class="px-4 py-3">
                                            {% if dpeParc %}
                                                <div class="flex gap-1 flex-wrap">
                                                    {% for badge in dpeParc.etatValidation|badgeDpeDto %}
                                                        <twig:Badge :variant="badge.variant" :label="badge.label" />
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                &nbsp;
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            {#                                    <button class="text-sm font-medium text-indigo-600">Ouvrir</button> #}
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </form>
    </turbo-frame>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function toggleAllComposantes(expand) {
            document.querySelectorAll('.composante-child-row').forEach(row => {
                if (expand) {
                    row.classList.remove('comp-collapsed');
                } else {
                    row.classList.add('comp-collapsed');
                }
            });
            document.querySelectorAll('.comp-chevron').forEach(icon => {
                if (expand) {
                    icon.classList.add('rotate-90');
                } else {
                    icon.classList.remove('rotate-90');
                }
            });
        }

        function toggleAllParcours(expand) {
            document.querySelectorAll('.parcours-child-row').forEach(row => {
                if (expand) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
            document.querySelectorAll('.chevron-icon').forEach(icon => {
                if (expand) {
                    icon.classList.add('rotate-90');
                } else {
                    icon.classList.remove('rotate-90');
                }
            });
        }
    </script>
{% endblock %}
