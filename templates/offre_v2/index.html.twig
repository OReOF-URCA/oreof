{% extends 'base.html.twig' %}

{% block bouton_header %}
    <twig:Button href="{{ composante ? path('offre_v2_statistiques_composante', { composante: composante.id }) : path('offre_v2_statistiques') }}"
                 variant="secondary" class="mr-2"
                 icon="icon:chart">
        Statistiques & Synthèse
    </twig:Button>

    {% if is_granted('ROLE_ADMIN') %}
        <twig:Button href="{{ path('app_formation_new', { redirect: composante ? 'app_offre_composante_index' : 'app_offre_index', composante: composante ? composante.id : null }) }}"
                     variant="success" class="mr-2">
            Créer une formation
        </twig:Button>
        <twig:Button href="{{ path('offre_v2_configurer_dates') }}"
                     data-turbo="true"
                     data-turbo-stream="true"
                     data-action="click->modalturbo#open"
                     variant="secondary" class="mr-2">
            Dates de collecte
        </twig:Button>
    {% endif %}
        
    {% if is_granted('ROLE_ADMIN') or (composante and is_granted('MANAGE', {route: 'app_composante', subject: composante})) %}
        <twig:Button href="{{ composante ? path('offre_v2_composante_modal_annexes_ca', { composante: composante.id }) : path('offre_v2_modal_annexes_ca') }}"
                     data-turbo="true"
                     data-turbo-stream="true"
                     data-action="click->modalturbo#open"
                     variant="primary">
            Générer les annexes CA
        </twig:Button>
    {% endif %}
{% endblock %}

{% block content %}
    <turbo-frame id="offre_table">
        <!-- Navigation par onglets -->
        <div class="mb-4 border-b border-secondary-200 dark:border-secondary-700">
            <nav class="-mb-px flex space-x-6" aria-label="Sections de l'offre">
                <a href="{{ composante ? path('app_offre_composante_index', {composante: composante.id}) : path('app_offre_index') }}"
                   class="inline-flex items-center gap-2 border-b-2 border-primary-500 pb-3 text-sm font-semibold text-primary-600 dark:text-primary-400">
                    <twig:UX:Icon name="icon:layers" class="h-4 w-4" />
                    Tableau de l'offre
                </a>
                <a href="{{ composante ? path('offre_v2_statistiques_composante', {composante: composante.id}) : path('offre_v2_statistiques') }}"
                   data-turbo-frame="_top"
                   class="inline-flex items-center gap-2 border-b-2 border-transparent pb-3 text-sm font-medium text-secondary-500 hover:border-secondary-300 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200">
                    <twig:UX:Icon name="icon:chart" class="h-4 w-4" />
                    Statistiques & Synthèse des places
                </a>
            </nav>
        </div>

        {% set moduleStatus = module_status('offre_formation', campagne) %}
        {% set timelineStep = campagne ? campagne.timelineDateForModule('offre_formation') : null %}
        {% set dateDebut = timelineStep ? (timelineStep.dateDebut ?? timelineStep.date) : (campagne ? campagne.dateOuvertureDpe : null) %}
        {% set dateFin = timelineStep ? timelineStep.date : (campagne ? campagne.dateClotureDpe : null) %}
        {% set heureFin = timelineStep ? timelineStep.heure : null %}

        <!-- Dates de collecte et Statut -->
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-secondary-200 bg-surface px-4 py-3 shadow-xs dark:border-secondary-700 dark:bg-secondary-800">
            <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{ moduleStatus.isOpen ? 'bg-success-100 text-success-700 dark:bg-success-900/40 dark:text-success-300' : (dateDebut or dateFin ? 'bg-secondary-100 text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300' : 'bg-warning-100 text-warning-700 dark:bg-warning-900/40 dark:text-warning-300') }}">
                    <twig:UX:Icon name="icon:calendar" class="h-5 w-5" />
                </div>
                <div>
                    <div class="text-xs font-medium text-secondary-500 dark:text-secondary-400 uppercase tracking-wider">
                        Période de collecte de l'offre
                    </div>
                    <div class="text-sm font-semibold text-secondary-900 dark:text-secondary-100 flex items-center gap-2 flex-wrap">
                        {% if dateDebut or dateFin %}
                            <span>
                                {% if dateDebut %}Du <strong>{{ dateDebut|date('d/m/Y') }}</strong>{% endif %}
                                {% if dateFin %} au <strong>{{ dateFin|date('d/m/Y') }}</strong>{% if heureFin %} à {{ heureFin|date('H:i') }}{% endif %}{% endif %}
                            </span>
                        {% else %}
                            <span class="text-warning-700 dark:text-warning-300 font-medium">Non configurée dans la timeline</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2">
                {% if moduleStatus.isOpen %}
                    <twig:Badge variant="success" label="Collecte ouverte" icon="icon:check" />
                {% elseif moduleStatus.nextOpeningDate %}
                    <twig:Badge variant="warning" label="{{ 'Ouverture le ' ~ moduleStatus.nextOpeningDate|date('d/m/Y') }}" icon="icon:clock" />
                {% elseif dateFin and date() > dateFin %}
                    <twig:Badge variant="danger" label="Collecte clôturée" icon="icon:lock" />
                {% elseif not dateDebut and not dateFin %}
                    <twig:Badge variant="warning" label="Dates non définies" icon="icon:warning" />
                {% else %}
                    <twig:Badge variant="secondary" label="Non ouverte" icon="icon:lock" />
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <twig:Button href="{{ path('offre_v2_configurer_dates') }}"
                                 size="xs"
                                 variant="secondary"
                                 data-turbo="true"
                                 data-turbo-stream="true"
                                 data-action="click->modalturbo#open"
                                 icon="icon:edit"
                                 label="Modifier les dates"
                    />
                {% endif %}
            </div>
        </div>

        {% if not campagne %}
            <twig:alerte type="warning" class="mb-4">
                <h3 class="font-semibold">Aucune campagne de collecte active</h3>
                <p class="mt-1 text-sm">Veuillez sélectionner ou configurer une campagne de collecte par défaut.</p>
            </twig:alerte>
        {% elseif campagne.timelineDates is empty or moduleStatus.allSteps is empty %}
            <twig:alerte type="warning" class="mb-4">
                <h3 class="font-semibold">Aucune période de collecte configurée</h3>
                <p class="mt-1 text-sm">
                    La campagne « {{ campagne.libelle }} » ne comporte pas encore d'étape de saisie pour l'offre de formation dans sa timeline.
                    {% if is_granted('ROLE_ADMIN') %}
                        Cliquez sur <strong>« Modifier les dates »</strong> ou <strong>« Dates de collecte »</strong> pour définir les dates de début et de fin.
                    {% else %}
                        Veuillez contacter l'administrateur pour ouvrir la campagne.
                    {% endif %}
                </p>
            </twig:alerte>
        {% elseif not moduleStatus.isOpen %}
            <twig:alerte type="danger" class="mb-4">
                <h3 class="font-semibold">La campagne de collecte est fermée</h3>
                <p class="mt-1 text-sm">
                    {{ moduleStatus.message }}
                    {% if is_granted('ROLE_ADMIN') %}
                        En tant qu'administrateur, vous pouvez exceptionnellement modifier les capacités et les paramètres.
                    {% else %}
                        Les modifications sont désactivées.
                    {% endif %}
                </p>
            </twig:alerte>
        {% endif %}
        
        {% set formUrl = composante ? path('app_offre_composante_index', {composante: composante.id}) : path('app_offre_index') %}
        <form method="get" action="{{ formUrl }}" data-turbo-frame="offre_table" data-turbo-action="replace" class="space-y-6"
              data-controller="auto-submit">
            <!-- KPI -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
                <twig:Kpi
                    title="Formations"
                    value="{{ tabStatistiques.nbFormations }}"
                    variant="default"
                    icon="icon:graduation"
                    help="Nombre total de formations (mentions) affichées selon les filtres sélectionnés."
                />

                <twig:Kpi
                    title="Parcours"
                    value="{{ tabStatistiques.nbParcours }}"
                    variant="default"
                    icon="icon:layers"
                    help="Nombre total de parcours de formation recensés pour ces formations."
                />

                <twig:Kpi
                    title="Ouverts"
                    value="{{ tabStatistiques.nbParcoursOuvert }}"
                    variant="success"
                    icon="icon:check-circle"
                    help="Nombre de parcours ouverts au recrutement et à la formation pour cette campagne."
                />

                <twig:Kpi
                    title="Non ouverts"
                    value="{{ tabStatistiques.nbParcoursNonOuvert }}"
                    variant="{{ tabStatistiques.nbParcoursNonOuvert > 0 ? 'danger' : 'secondary' }}"
                    icon="icon:danger"
                    help="Parcours non ouverts ou fermés définitivement : non-ouverture, attente SES/CFVU ou fermeture définitive."
                >
                    {% if tabStatistiques.nbParcoursNonOuvert > 0 %}
                        <div class="mt-2 space-y-1 border-t border-secondary-200/60 pt-1.5 text-[11px] text-secondary-600 dark:border-secondary-700/60 dark:text-secondary-400">
                           
                            {% if tabStatistiques.nbNonOuverture > 0 %}
                                <div class="flex items-center justify-between gap-1">
                                    <span class="truncate">Attente SES :</span>
                                    <span class="font-semibold text-warning-700 dark:text-warning-300">{{ tabStatistiques.nbNonOuverture }}</span>
                                </div>
                            {% endif %}
                            {% if tabStatistiques.nbFermetureDefinitive > 0 %}
                                <div class="flex items-center justify-between gap-1">
                                    <span class="truncate">Fermeture déf. :</span>
                                    <span class="font-semibold text-danger-700 dark:text-danger-300">{{ tabStatistiques.nbFermetureDefinitive }}</span>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </twig:Kpi>

                <twig:Kpi
                    title="Places plateformes"
                    value="{{ tabStatistiques.capacitePlateformes|default(0) }}"
                    unit="places"
                    variant="info"
                    icon="icon:users"
                    help="Somme des places d'admission proposées sur les plateformes pour les formations et parcours ouverts."
                />

                <twig:Kpi
                    title="À confirmer"
                    value="{{ tabStatistiques.nbAConfirmer }}"
                    variant="{{ tabStatistiques.nbAConfirmer > 0 ? 'warning' : 'secondary' }}"
                    icon="icon:clock"
                    help="Parcours ouverts dont le workflow de validation n'a pas encore atteint l'état validé CFVU ou publié."
                />

                <twig:Kpi
                    title="Anomalies"
                    value="{{ tabStatistiques.nbAnomalies }}"
                    variant="{{ tabStatistiques.nbAnomalies > 0 ? 'danger' : 'secondary' }}"
                    icon="{{ tabStatistiques.nbAnomalies > 0 ? 'icon:warning' : 'icon:check-circle' }}"
                    help="Nombre d'alertes ou blocages détectés sur les parcours et paramétrages des plateformes."
                />
            </div>

            <!-- Filters -->
            <div class="rounded-xl border bg-surface p-4 shadow-sm">
                <div class="grid gap-4 md:grid-cols-12">
                    <div class="{% if composante %}md:col-span-5{% else %}md:col-span-3{% endif %}">
                        <input type="search" name="q" value="{{ filters.q|default('') }}" class="rounded-lg border px-3 py-2 text-sm w-full" placeholder="Rechercher une formation…" aria-label="Rechercher une formation ou un parcours" autocomplete="off" data-action="input->auto-submit#debouncedSubmit">
                    </div>

                    {% if not composante %}
                        <div class="md:col-span-2">
                            <select name="comp" class="app-filter-select rounded-lg border px-3 py-2 text-sm w-full" data-action="change->auto-submit#submit" {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                                <option value="">Toutes les composantes</option>
                                {% for compItem in composantes %}
                                    <option value="{{ compItem.id }}" {% if filters.comp|default('') == compItem.id %}selected{% endif %}>{{ compItem.libelle }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <div class="md:col-span-2">
                        <select name="type" class="app-filter-select rounded-lg border px-3 py-2 text-sm w-full" data-action="change->auto-submit#submit" {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                            <option value="">Tous les diplômes</option>
                            {% for typeDiplome in typesDiplome %}
                                <option value="{{ typeDiplome.id }}" {% if filters.type|default('') == typeDiplome.id %}selected{% endif %}>{{ typeDiplome.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <select name="plateforme" class="app-filter-select rounded-lg border px-3 py-2 text-sm w-full" data-action="change->auto-submit#submit" {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                            <option value="">Toutes les plateformes</option>
                            {% for plateforme in plateformes %}
                                <option value="{{ plateforme.id }}" {% if filters.plateforme|default('') == plateforme.id %}selected{% endif %}>{{ plateforme.libelle }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="md:col-span-2">
                        <select name="statut" class="app-filter-select rounded-lg border px-3 py-2 text-sm w-full" data-action="change->auto-submit#submit" {{ stimulus_controller('symfony/ux-autocomplete/autocomplete') }}>
                            <option value="">Tous les statuts</option>
                            {% for etatValeur, etatLibelle in {'brouillon': 'Brouillon', 'soumis_ses': 'Soumis Scolarité', 'soumis_cfvu': 'Soumis CFVU', 'attente_pv': 'Validé CFVU (attente PV)', 'publie': 'Publié'} %}
                                <option value="{{ etatValeur }}" {% if filters.statut|default('') == etatValeur %}selected{% endif %}>{{ etatLibelle }}</option>
                            {% endfor %}
                            <option value="Anomalie" {% if filters.statut|default('') == 'Anomalie' %}selected{% endif %}>Anomalie</option>
                        </select>
                    </div>

                    <div class="md:col-span-1">
                        {% set resetUrl = composante ? path('app_offre_composante_index', {composante: composante.id, reset: 1}) : path('app_offre_index', {reset: 1}) %}
                        <a href="{{ resetUrl }}" data-turbo-frame="offre_table" data-turbo-action="replace" class="inline-flex items-center justify-center rounded-lg border border-danger-200 bg-danger-50 hover:bg-danger-100 px-3 py-2 text-sm font-semibold text-danger-700 transition-colors w-full text-center dark:border-danger-700 dark:bg-danger-900/30 dark:text-danger-300">
                            Effacer
                        </a>
                    </div>
                </div>
            </div>

            <!-- Alertes -->
            {% if tabStatistiques.allAnomalies|length > 0 %}
                <twig:alerte type="warning">
                    <h2 class="font-semibold">{{ tabStatistiques.allAnomalies|length }} point{{ tabStatistiques.allAnomalies|length > 1 ? 's' : '' }} à vérifier</h2>
                    <ul class="mt-2 list-disc pl-5 text-sm space-y-1 max-h-40 overflow-y-auto">
                        {% for anomaly in tabStatistiques.allAnomalies %}
                            <li>{{ anomaly }}</li>
                        {% endfor %}
                    </ul>
                </twig:alerte>
            {% endif %}

            {% set defaultCollapseComposante = not composante and is_granted('ROLE_ADMIN') %}
            {% set defaultCollapseFormation = composante is not null %}

            <!-- Table -->
            <div class="overflow-hidden rounded-xl border bg-surface shadow-sm" data-controller="offre-table"
                 data-offre-table-annees-url-value="{{ path('offre_v2_annees_parcours') }}"
                 data-offre-table-user-id-value="{{ app.user ? app.user.id : '' }}"
                 data-offre-table-context-value="{{ composante ? 'dpe_' ~ composante.id : 'admin' }}">
                <!-- Table Controls -->
                <div class="flex flex-wrap items-center justify-between gap-4 bg-secondary-50/70 px-4 py-3 border-b border-secondary-200 text-sm dark:border-secondary-700 dark:bg-secondary-800/70">
                    <div class="font-semibold text-secondary-700 dark:text-secondary-100">
                        Offre de formation {% if composante %}— <span class="text-primary font-bold">{{ composante.libelle }}</span>{% endif %}
                    </div>
                    <div class="flex items-center gap-4 text-xs font-medium flex-wrap">
                        {% if not composante %}
                            <div class="flex items-center gap-1.5 bg-surface border border-secondary-200 rounded-lg p-1 shadow-sm dark:border-secondary-700">
                                <span class="text-secondary-400 px-1.5 font-normal">Composantes:</span>
                                <button type="button" data-action="offre-table#expandComposantes" class="px-2 py-1 hover:bg-secondary-50 text-primary-600 rounded font-semibold transition-colors dark:text-primary-400 cursor-pointer">Déplier tout</button>
                                <button type="button" data-action="offre-table#collapseComposantes" class="px-2 py-1 hover:bg-secondary-50 text-secondary-600 rounded font-semibold transition-colors cursor-pointer">Replier tout</button>
                            </div>
                        {% endif %}
                        <div class="flex items-center gap-1.5 bg-surface border border-secondary-200 rounded-lg p-1 shadow-sm dark:border-secondary-700">
                            <span class="text-secondary-400 px-1.5 font-normal">Mentions:</span>
                            <button type="button" data-action="offre-table#expandFormations" class="px-2 py-1 hover:bg-secondary-50 text-primary-600 rounded font-semibold transition-colors dark:text-primary-400 cursor-pointer">Déplier tout</button>
                            <button type="button" data-action="offre-table#collapseFormations" class="px-2 py-1 hover:bg-secondary-50 text-secondary-600 rounded font-semibold transition-colors cursor-pointer">Replier tout</button>
                        </div>
                        <div class="flex items-center gap-1.5 bg-surface border border-secondary-200 rounded-lg p-1 shadow-sm dark:border-secondary-700">
                            <span class="text-secondary-400 px-1.5 font-normal">Années:</span>
                            <button type="button" data-action="offre-table#expandParcours" class="px-2 py-1 hover:bg-secondary-50 text-primary-600 rounded font-semibold transition-colors dark:text-primary-400 cursor-pointer">Déplier tout</button>
                            <button type="button" data-action="offre-table#collapseParcours" class="px-2 py-1 hover:bg-secondary-50 text-secondary-600 rounded font-semibold transition-colors cursor-pointer">Replier tout</button>
                        </div>
                    </div>
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-secondary-50 text-left text-xs uppercase text-secondary-500 dark:bg-secondary-800">
                    <tr>
                        <th class="px-4 py-3">Formation</th>
                        <th class="px-4 py-3">Composante</th>
                        <th class="px-4 py-3">Parcours / année</th>
                        <th class="px-4 py-3">Ouvert</th>
                        <th class="px-4 py-3">Plateformes</th>
                        <th class="px-4 py-3 text-right">Places plateformes</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                    </thead>

                    {% for compName, compGroup in groupedFormations %}
                    {# Un tbody par composante : data-collapsed (posé par offre-table) masque ses lignes enfants. #}
                    <tbody class="group" data-offre-table-target="composante" data-composante-id="{{ compGroup.composante ? compGroup.composante.id : loop.index }}" {% if defaultCollapseComposante %}data-collapsed{% endif %}>
                        <!-- Group Composante -->
                        <tr class="bg-secondary-200/70 transition-colors border-t border-secondary-300 dark:border-secondary-600 dark:bg-secondary-700/80">
                            <td colspan="3" class="px-4 py-3 font-semibold text-secondary-700 dark:text-secondary-100">
                                <button type="button"
                                        class="group/toggle flex w-full items-center gap-2 text-left cursor-pointer rounded focus-visible:outline-2 focus-visible:outline-primary-500"
                                        data-action="offre-table#toggleComposante"
                                        aria-expanded="{{ defaultCollapseComposante ? 'false' : 'true' }}">
                                    <svg class="h-4 w-4 text-secondary-500 transition-transform duration-200 group-aria-expanded/toggle:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                    </svg>
                                    <span class="font-bold text-secondary-900 dark:text-secondary-100">{{ compGroup.libelle }}</span>
                                    <span class="text-xs font-normal text-secondary-500 ml-1">({{ compGroup.nbFormations }} formation{{ compGroup.nbFormations > 1 ? 's' : '' }} · {{ compGroup.nbParcours }} parcours)</span>
                                </button>
                            </td>
                            <td class="px-4 py-3">
                                <twig:Badge variant="secondary" label="{{ compGroup.nbParcoursOuvert }}/{{ compGroup.nbParcours }} ouverts" />
                            </td>
                            <td class="px-4 py-3">&nbsp;</td>
                            <td class="px-4 py-3 text-right font-bold text-secondary-800 dark:text-secondary-100">{{ compGroup.capacitePlateformes|default(0) }}</td>
                            <td class="px-4 py-3">
                                {% set canManageComp = compGroup.composante and (is_granted('ROLE_ADMIN') or is_granted('ROLE_SES') or is_granted('MANAGE', {route: 'app_composante', subject: compGroup.composante})) %}
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <twig:Badge variant="{{ compGroup.nbPv == compGroup.nbFormations and compGroup.nbFormations > 0 ? 'success' : (compGroup.nbPv > 0 ? 'warning' : 'secondary') }}"
                                                label="{{ compGroup.nbPv }}/{{ compGroup.nbFormations }} PV"
                                                icon="ph:file"
                                                href="{{ canManageComp ? path('offre_v2_composante_documents_modal', { composante: compGroup.composante.id }) : null }}"
                                                data-turbo="{{ canManageComp ? 'true' : null }}"
                                                data-turbo-stream="{{ canManageComp ? 'true' : null }}"
                                                data-action="{{ canManageComp ? 'click->modalturbo#open' : null }}"
                                                title="{{ canManageComp ? 'Gérer les PV de la composante' : null }}"
                                    />
                                    <twig:Badge variant="{{ compGroup.nbNote == compGroup.nbFormations and compGroup.nbFormations > 0 ? 'primary' : (compGroup.nbNote > 0 ? 'warning' : 'secondary') }}"
                                                label="{{ compGroup.nbNote }}/{{ compGroup.nbFormations }} Notes"
                                                icon="ph:file-pdf"
                                                href="{{ canManageComp ? path('offre_v2_composante_documents_modal', { composante: compGroup.composante.id }) : null }}"
                                                data-turbo="{{ canManageComp ? 'true' : null }}"
                                                data-turbo-stream="{{ canManageComp ? 'true' : null }}"
                                                data-action="{{ canManageComp ? 'click->modalturbo#open' : null }}"
                                                title="{{ canManageComp ? 'Gérer les notes explicatives de la composante' : null }}"
                                    />
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                    {% if canManageComp %}
                                        <twig:Button size="sm"
                                                     variant="secondary"
                                                     icon="ph:file-plus"
                                                     label="PV / Notes"
                                                     href="{{ path('offre_v2_composante_documents_modal', { composante: compGroup.composante.id }) }}"
                                                     data-turbo="true"
                                                     data-turbo-stream="true"
                                                     data-turbo-frame="_top"
                                                     data-action="click->modalturbo#open"
                                                     title="Déposer ou modifier les PV et notes explicatives de la composante"
                                        />
                                    {% endif %}

                                    {% if compGroup.composante and compGroup.transitions|length > 0 %}
                                        {% for transition in compGroup.transitions %}
                                            <twig:Button size="sm"
                                                         :soft="false"
                                                         :variant="transition.metadata.btn|default('') == 'success' ? 'success' : (transition.metadata.btn|default('') == 'warning' ? 'warning' : 'primary')"
                                                         :icon="transition.metadata.icon|default('')"
                                                         :label="transition.metadata.label|default(transition.name)|trans({}, 'process')"
                                                         href="{{ path('offre_v2_composante_valider', {
                                                             composante: compGroup.composante.id,
                                                             transition: transition.name
                                                         }) }}"
                                                         data-turbo="true"
                                                         data-turbo-stream="true"
                                                         data-turbo-frame="_top"
                                                         data-action="click->modalturbo#open"
                                                         title="{{ transition.metadata.label|default(transition.name)|trans({}, 'process') }}"
                                             />
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>

                        {% for forma in compGroup.formations %}
                            {% set formation = forma.formation %}
                            {% set formationOuverte = forma.isOuverte %}
                            <!-- Ligne Mention (Formation) -->
                            <tr class="bg-secondary-100/80 hover:bg-secondary-100 transition-all duration-150 border-t border-secondary-200 group-data-[collapsed]:hidden dark:bg-secondary-800/80 dark:hover:bg-secondary-800 dark:border-secondary-700">
                                <td class="px-4 py-3">
                                    <div class="font-semibold text-secondary-900 dark:text-secondary-100 flex items-center gap-1.5 flex-wrap">
                                        {% if forma.parcoursData|length > 0 %}
                                            <button type="button"
                                                    class="group/formation-toggle inline-flex items-center gap-2 text-left cursor-pointer rounded focus-visible:outline-2 focus-visible:outline-primary-500 font-semibold text-secondary-900 dark:text-secondary-100"
                                                    data-action="offre-table#toggleFormation"
                                                    data-formation-id="{{ formation.id }}"
                                                    aria-expanded="{{ defaultCollapseFormation ? 'false' : 'true' }}">
                                                <svg class="h-4 w-4 text-secondary-500 transition-transform duration-200 group-aria-expanded/formation-toggle:rotate-90 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                                </svg>
                                                <span>{{ formation.display }}</span>
                                                <span class="text-xs font-normal text-secondary-500">({{ forma.parcoursData|length }} parcours)</span>
                                            </button>
                                        {% else %}
                                            <span>{{ formation.display }}</span>
                                        {% endif %}
                                        {% if forma.anomalies|length > 0 %}
                                            <a href="{{ path('offre_v2_formation_synthese_modal', { formation: formation.id }) }}"
                                               data-turbo="true"
                                               data-turbo-stream="true"
                                               data-action="click->modalturbo#open"
                                               class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[10px] font-bold bg-danger-100 text-danger-800 border border-danger-200 hover:bg-danger-200 transition-colors dark:bg-danger-900/40 dark:text-danger-300 dark:border-danger-700 cursor-pointer"
                                               title="{{ forma.anomalies|length }} point(s) à vérifier : cliquer pour voir le détail"
                                            >
                                                <twig:UX:Icon name="icon:warning" class="size-3" />
                                                <span>{{ forma.anomalies|length }} alerte{{ forma.anomalies|length > 1 ? 's' : '' }}</span>
                                            </a>
                                        {% else %}
                                            <span class="inline-flex items-center gap-0.5 rounded px-1.5 py-0.5 text-[10px] font-semibold bg-success-50 text-success-700 border border-success-200/80 dark:bg-success-900/30 dark:text-success-300 dark:border-success-700" title="Aucune anomalie détectée">
                                                ✓ Conforme
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="text-xs text-secondary-500 flex items-center gap-1.5 flex-wrap mt-0.5">
                                        <span>{{ formation.typeDiplome ? formation.typeDiplome.libelle : '' }}</span>
                                        {% set tcs = formation.troncsCommuns %}
                                        {% set totalParcours = forma.parcoursData|length %}
                                        {% if tcs is not empty %}
                                            {% for tc in tcs %}
                                                {% set isAll = (totalParcours > 0 and (tc.parcours|default([]))|length >= totalParcours) %}
                                                {% set nbParc = (tc.parcours|default([]))|length %}
                                                <span class="inline-flex items-center gap-1 rounded bg-primary-50 px-1.5 py-0.5 text-[11px] font-semibold text-primary-700 border border-primary-200/80 dark:border-primary-700 dark:bg-primary-900/30 dark:text-primary-300"
                                                      title="{{ tc.nom }} : {% if isAll %}Tous les parcours ({{ totalParcours }}){% else %}{{ nbParc }}/{{ totalParcours }} parcours{% endif %} sur {{ (tc.annees|default([]))|length > 1 ? 'les Années' : 'l\'Année' }} {{ (tc.annees|default([]))|join(', ') }}"
                                                >
                                                    <twig:UX:Icon name="ph:users-three-bold" class="h-3 w-3" />
                                                    <span>{{ tc.nom }} (Année{{ (tc.annees|default([]))|length > 1 ? 's' : '' }} {{ (tc.annees|default([]))|join(', ') }}{% if not isAll %} · {{ nbParc }}/{{ totalParcours }} parc.{% endif %})</span>
                                                </span>
                                            {% endfor %}
                                        {% endif %}
                                        {% if forma.portails is defined and forma.portails is not empty %}
                                            {% for portailData in forma.portails %}
                                                {% set isAllPortail = (totalParcours > 0 and portailData.parcoursIds|length >= totalParcours) %}
                                                {% set nbParcPortail = portailData.parcoursIds|length %}
                                                <span class="inline-flex items-center gap-1 rounded bg-warning-50 px-1.5 py-0.5 text-[11px] font-semibold text-warning-800 border border-warning-200/80 dark:border-warning-700 dark:bg-warning-900/30 dark:text-warning-300"
                                                      title="Portail « {{ portailData.libelle }} » : {% if isAllPortail %}Tous les parcours ({{ totalParcours }}){% else %}{{ nbParcPortail }}/{{ totalParcours }} parcours{% endif %} sur {{ portailData.annees|length > 1 ? 'les Années' : 'l\'Année' }} {{ portailData.annees|join(', ') }}"
                                                >
                                                    <twig:UX:Icon name="ph:circles-three-bold" class="h-3 w-3" />
                                                    <span>{{ portailData.libelle }} (Année{{ portailData.annees|length > 1 ? 's' : '' }} {{ portailData.annees|join(', ') }}{% if not isAllPortail %} · {{ nbParcPortail }}/{{ totalParcours }} parc.{% endif %})</span>
                                                </span>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-secondary-600">
                                    {{ formation.composantePorteuse ? formation.composantePorteuse.libelle : '' }}
                                </td>

                                <td class="px-4 py-3 text-secondary-500 font-medium">({{ forma.parcoursData|length }} parcours)</td>
                                <td class="px-4 py-3">
                                    <twig:Badge variant="{{ formationOuverte ? 'success' : 'danger' }}" label="{{ formationOuverte ? 'Oui' : 'Non' }}" />
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex gap-1 flex-wrap items-center">
                                        {% for pStatut in forma.plateformesStatuts|default([]) %}
                                            {% set plat = pStatut.plateforme %}
                                            {% if pStatut.active %}
                                                <twig:Badge :variant="plat.color|default('primary')"
                                                            :label="plat.code"
                                                            title="{{ plat.libelle }} : active sur la formation"
                                                />
                                            {% elseif pStatut.hasCapaciteInactive %}
                                                <twig:Badge variant="warning"
                                                            icon="ph:warning"
                                                            :label="plat.code"
                                                            title="{{ plat.libelle }} : plateforme inactive mais capacité renseignée ({{ pStatut.capaciteInactive }})"
                                                />
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right font-bold text-secondary-900 dark:text-secondary-100">{{ forma.capacitePlateformes|default(0) }}</td>
                                <td class="px-4 py-3">
                                    <div class="flex gap-1.5 flex-wrap items-center">
                                        {{ include('offre_v2/_etat_offre_badge.html.twig', {etat: forma.etatValidation|keys|first}) }}<br>

                                        <!-- PV & Note Badges -->
                                        {% if forma.hasPv and forma.pvDoc %}
                                            <twig:Badge variant="success"
                                                        label="PV"
                                                        icon="ph:file"
                                                        href="{{ path('app_upload_download', {context: 'conseils', filename: forma.pvDoc.filename, originalName: forma.pvDoc.originalFilename}) }}"
                                                        target="_blank"
                                                        title="PV : {{ forma.pvDoc.originalFilename }} (déposé le {{ forma.pvDoc.uploadedAt|date('d/m/Y') }})"
                                            />
                                        {% else %}
                                            <twig:Badge variant="secondary"
                                                        label="Sans PV"
                                                        title="PV non déposé"
                                            />
                                        {% endif %}

                                        {% if forma.hasNote and forma.noteDoc %}
                                            <twig:Badge variant="primary"
                                                        label="Note"
                                                        icon="ph:file-pdf"
                                                        href="{{ path('app_upload_download', {context: 'conseils', filename: forma.noteDoc.filename, originalName: forma.noteDoc.originalFilename}) }}"
                                                        target="_blank"
                                                        title="Note explicative : {{ forma.noteDoc.originalFilename }} (déposée le {{ forma.noteDoc.uploadedAt|date('d/m/Y') }})"
                                            />
                                        {% else %}
                                            <twig:Badge variant="secondary"
                                                        label="Sans Note"
                                                        title="Note explicative non déposée"
                                            />
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                        <twig:Button variant="success"
                                                     size="sm"
                                                     href="{{ path('offre_v2_formation_synthese_modal', { formation: formation.id }) }}"
                                                     data-turbo="true"
                                                     data-turbo-stream="true"
                                                     data-action="click->modalturbo#open"
                                                     icon="ph:check"
                                                     title="Vérification rapide et contrôle des informations saisies"
                                        >
                                            Vérification
                                        </twig:Button>
                                        <twig:Button variant="primary"
                                                     size="sm"
                                                     href="{{ path('offre_v2_configurer', { slug: formation.slug }) }}"
                                                     data-turbo-frame="_top"
                                        >
                                            Configurer
                                        </twig:Button>
                                        {{ component('dropdown_actions', {
                                            label: 'Actions',
                                            labelSrOnly: true,
                                            help: 'Actions pour la formation',
                                            icon: 'icon:ellipsis-vertical',
                                            items: [
                                                {
                                                    label: 'Voir la fiche',
                                                    icon: 'icon:info',
                                                    url: path('formation_v2_voir', {slug: formation.slug}),
                                                    target: '_blank'
                                                },
                                                {
                                                    label: 'Gérer PV & Note',
                                                    icon: 'ph:file-text',
                                                    url: path('offre_v2_formation_documents_modal', {formation: formation.id}),
                                                    modal: true,
                                                    disabled: not (is_granted('ROLE_ADMIN') or is_granted('ROLE_SES') or (formation.composantePorteuse and is_granted('MANAGE', {route: 'app_composante', subject: formation.composantePorteuse}))),
                                                    help: not (is_granted('ROLE_ADMIN') or is_granted('ROLE_SES') or (formation.composantePorteuse and is_granted('MANAGE', {route: 'app_composante', subject: formation.composantePorteuse}))) ? 'Action réservée aux gestionnaires' : null
                                                },
                                                {
                                                    label: 'Modifier',
                                                    icon: 'ph:arrows-left-right-light',
                                                    url: path('app_formation_edit_modal', {slug: formation.slug}),
                                                    modal: true,
                                                    disabled: not is_granted('ROLE_ADMIN'),
                                                    help: not is_granted('ROLE_ADMIN') ? 'Action réservée aux administrateurs' : null
                                                },
                                                {
                                                    label: 'Supprimer',
                                                    icon: 'icon:delete',
                                                    color: 'danger',
                                                    url: path('formation_v2_supprimer', {formation: formation.id}),
                                                    modal: true,
                                                    disabled: not is_granted('ROLE_ADMIN'),
                                                    help: not is_granted('ROLE_ADMIN') ? 'Action réservée aux administrateurs' : null
                                                }
                                            ]
                                        }) }}
                                    </div>
                                </td>
                            </tr>
                            {% for parcoursId, pd in forma.parcoursData %}
                                {% set parcours = pd.parcours %}
                                {% set parcoursCapacite = pd.capacitePlateformes|default(0) %}
                                {% set isParcoursOuvert = pd.isOuvert %}
                                {% set dpeParc = pd.dpeParcours %}
                                {# Lignes d'années chargées à la demande (offre-table → offre_v2_annees_parcours), insérées après cette ligne. #}
                                <tr id="offre-parcours-{{ parcours.id }}"
                                    data-formation-parcours="{{ formation.id }}"
                                    class="bg-surface hover:bg-secondary-50/70 transition-colors group-data-[collapsed]:hidden dark:bg-surface dark:hover:bg-secondary-800/40 {{ defaultCollapseFormation ? 'hidden' : '' }}">
                                    <td>&nbsp;</td>
                                    <td class="px-4 py-3 text-secondary-500 font-medium">
                                        {{ pd.composanteLibelle }}
                                    </td>
                                    <td class="px-4 py-3 font-semibold text-secondary-700 dark:text-secondary-100">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            {% if pd.annees|length > 0 %}
                                                <button type="button"
                                                        class="group/toggle inline-flex items-center gap-2 text-left cursor-pointer rounded focus-visible:outline-2 focus-visible:outline-primary-500"
                                                        data-action="offre-table#toggleParcours"
                                                        data-parcours-id="{{ parcours.id }}"
                                                        aria-expanded="false">
                                                    <svg class="h-4 w-4 text-secondary-400 transition-transform duration-200 group-aria-expanded/toggle:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                                    </svg>
                                                    <span>{{ parcours.libelle }}
                                                        {% if parcours.typeParcours is not null and parcours.typeParcours.value != 'classique' %}
                                                            <twig:Badge label="{{ parcours.typeParcours.getLabel() }}" variant="{{ parcours.typeParcours.getColor() }}" size="sm"/>
                                                        {% endif %}
                                                    </span>
                                                </button>
                                            {% else %}
                                                <span>{{ parcours.libelle }}</span>
                                            {% endif %}
                                            {% set parcoursVille = parcours.ville ?? parcours.localisation %}
                                            {% if parcoursVille %}
                                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-secondary-600 bg-secondary-100 dark:bg-secondary-800 dark:text-secondary-300 px-1.5 py-0.5 rounded-md" title="Lieu d'enseignement : {{ parcoursVille.libelle }}">
                                                    <twig:UX:Icon name="ph:map-pin" class="h-3 w-3 text-secondary-400" />
                                                    {{ parcoursVille.libelle }}
                                                </span>
                                            {% endif %}
                                            <span class="text-xs font-normal text-secondary-400">({{ pd.annees|length }} année{{ pd.annees|length > 1 ? 's' : '' }})</span>
                                            {% set parcAnomalies = forma.parcoursAnomalies[parcours.id]|default([]) %}
                                            {% if parcAnomalies|length > 0 %}
                                                <a href="{{ path('offre_v2_formation_synthese_modal', { formation: formation.id }) }}"
                                                   data-turbo="true"
                                                   data-turbo-stream="true"
                                                   data-action="click->modalturbo#open"
                                                   class="inline-flex items-center text-danger-600 hover:text-danger-800 ml-1 cursor-pointer dark:text-danger-400"
                                                   title="{{ parcAnomalies|join('\n') }} (Cliquer pour voir la synthèse)"
                                                >⚠️</a>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <twig:Badge variant="{{ isParcoursOuvert ? 'success' : 'danger' }}" label="{{ isParcoursOuvert ? 'Oui' : 'Non' }}" />
                                    </td>
                                    <td class="px-4 py-3">&nbsp;</td>
                                    <td class="px-4 py-3 text-right font-semibold text-secondary-700 dark:text-secondary-100">{{ parcoursCapacite }}</td>
                                    <td class="px-4 py-3">
                                        <div class="flex gap-1.5 flex-wrap items-center">
                                            <!-- PV & Note Badges pour le parcours (hérités de sa formation) -->
                                            {% if forma.hasPv and forma.pvDoc %}
                                                <twig:Badge variant="success"
                                                            label="PV"
                                                            icon="ph:file"
                                                            href="{{ path('app_upload_download', {context: 'conseils', filename: forma.pvDoc.filename, originalName: forma.pvDoc.originalFilename}) }}"
                                                            target="_blank"
                                                            title="PV : {{ forma.pvDoc.originalFilename }} (déposé le {{ forma.pvDoc.uploadedAt|date('d/m/Y') }})"
                                                />
                                            {% else %}
                                                <twig:Badge variant="secondary"
                                                            label="Sans PV"
                                                            title="PV non déposé"
                                                />
                                            {% endif %}

                                            {% if forma.hasNote and forma.noteDoc %}
                                                <twig:Badge variant="primary"
                                                            label="Note"
                                                            icon="ph:file-pdf"
                                                            href="{{ path('app_upload_download', {context: 'conseils', filename: forma.noteDoc.filename, originalName: forma.noteDoc.originalFilename}) }}"
                                                            target="_blank"
                                                            title="Note explicative : {{ forma.noteDoc.originalFilename }} (déposée le {{ forma.noteDoc.uploadedAt|date('d/m/Y') }})"
                                                />
                                            {% else %}
                                                <twig:Badge variant="secondary"
                                                            label="Sans Note"
                                                            title="Note explicative non déposée"
                                                />
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                            {{ component('dropdown_actions', {
                                                label: 'Actions',
                                                labelSrOnly: true,
                                                help: 'Actions pour le parcours',
                                                icon: 'icon:ellipsis-vertical',
                                                items: [
                                                    {
                                                        label: 'Voir la fiche',
                                                        icon: 'icon:info',
                                                        url: path('parcours_v2_voir', {parcours: parcours.id}),
                                                        target: '_blank'
                                                    },
                                                    {
                                                        label: 'Déplacer',
                                                        icon: 'ph:arrows-left-right-light',
                                                        url: path('parcours_ses_deplacer', {parcours: parcours.id}),
                                                        modal: true,
                                                        disabled: not is_granted('ROLE_ADMIN'),
                                                        help: not is_granted('ROLE_ADMIN') ? 'Action réservée aux administrateurs' : null
                                                    },
                                                    {
                                                        label: 'Supprimer',
                                                        icon: 'icon:delete',
                                                        color: 'danger',
                                                        url: path('parcours_v2_supprimer', {parcours: parcours.id}),
                                                        modal: true,
                                                        disabled: not is_granted('ROLE_ADMIN'),
                                                        help: not is_granted('ROLE_ADMIN') ? 'Action réservée aux administrateurs' : null
                                                    }
                                                ]
                                            }) }}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                    {% endfor %}
                </table>
            </div>
        </form>
    </turbo-frame>
{% endblock %}
