{% extends 'base.html.twig' %}

{% set header_title = "Configurer la formation : "~formation.displayLong %}
{% set header_description = "Paramètrer les plateformes d'admissions, les capacités et les ouvertures." %}
{% set typeDiplome = formation.typeDiplome %}
{% set is_ses_or_admin = is_granted('ROLE_SES') or is_granted('ROLE_ADMIN') %}
{% set is_brouillon = dpeFormation and dpeFormation.etatValidation.brouillon is defined %}
{% set is_period_active = campagne and campagne.isPeriodActive() %}

{% set can_edit = is_ses_or_admin or (is_brouillon and is_period_active) %}

{% block bouton_header %}
    {% if can_edit %}
        <twig:Button variant="success"
                     href="{{ path('offre_v2_parcours_modal_add', {slug: formation.slug}) }}"
                     dataAction="click->modalturbo#open"
                     icon="icon:add"
        >
            Ajouter un parcours
        </twig:Button>
    {% endif %}
    {% set composantePorteuse = formation.composantePorteuse %}
    <twig:Button variant="primary" href="{{ is_granted('ROLE_ADMIN') or not composantePorteuse ? path('app_offre_index') : path('app_offre_composante_index', { composante: composantePorteuse.id }) }}"
                 icon="icon:arrow-left"
    >
        Retour à la liste des offres
    </twig:Button>
{% endblock %}

{% block content %}
    {% if not can_edit %}
        <div class="rounded-lg border border-danger-200 bg-danger-50 p-2.5 text-xs text-danger-800 flex items-center gap-2.5 mb-3 shadow-xs dark:bg-danger-900/30 dark:text-danger-300 dark:border-danger-700">
            <span class="text-base shrink-0">⚠️</span>
            <div class="flex-1">
                {% if campagne and not campagne.isPeriodActive() %}
                    <strong>Campagne fermée :</strong>
                    {% if campagne.dateOuvertureDpe and date() < campagne.dateOuvertureDpe %}
                        Ouverture le {{ campagne.dateOuvertureDpe|date('d/m/Y à H:i') }}.
                    {% elseif campagne.dateClotureDpe and date() > campagne.dateClotureDpe %}
                        Clôturée le {{ campagne.dateClotureDpe|date('d/m/Y à H:i') }}.
                    {% endif %}
                    Modifications désactivées.
                {% elseif not is_brouillon %}
                    <strong>Offre transmise :</strong> En cours d'instruction, modifications désactivées.
                {% endif %}
            </div>
        </div>
    {% elseif is_ses_or_admin %}
        {% if (campagne and not campagne.isPeriodActive()) or not is_brouillon %}
            <div class="rounded-lg border border-primary-200 bg-primary-50 p-2.5 text-xs text-primary-800 flex items-center gap-2.5 mb-3 shadow-xs dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                <span class="text-base shrink-0">ℹ️</span>
                <div class="flex-1">
                    <strong>Mode d'édition Scolarité Centrale :</strong> Vous conservez le droit d'éditer les capacités en tant que gestionnaire SES/Admin.
                </div>
            </div>
        {% endif %}
    {% endif %}

    <form action="{{ path('offre_v2_sauvegarder', { slug: formation.slug }) }}" method="POST"
          data-controller="autosave-capacites"
          data-autosave-capacites-url-value="{{ path('offre_v2_sauvegarder', { slug: formation.slug }) }}"
          class="space-y-4"
    >
        <input type="hidden" name="_token" value="{{ csrf_token('offre_v2_configurer_' ~ formation.id) }}">

        <!-- KPI Globaux -->
        <div id="configurer_global_stats" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 mb-4">
            <twig:Kpi
                title="Parcours ouverts"
                value="{{ tabStatistiques.nbParcoursOuvert }}"
                total="{{ formation.parcours|length }}"
                variant="success"
                icon="icon:check-circle"
            />

            <twig:Kpi
                title="Plateformes"
                value="{{ plateformes|length }}"
                unit="active{{ plateformes|length > 1 ? 's' : '' }}"
                variant="primary"
                icon="icon:globe"
            />

            <twig:Kpi
                title="Capacité totale"
                value="{{ tabStatistiques.capacite }}"
                unit="places"
                variant="info"
                icon="icon:users"
            />

            <twig:Kpi
                title="Anomalies"
                value="{{ anomalies|length }}"
                variant="{{ anomalies|length > 0 ? 'warning' : 'secondary' }}"
                icon="{{ anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
            />
        </div>

        <twig:Card extraClass="mb-4"
                   title="Contrôle avant transmission"
        >
            <div id="configurer_global_warnings" class="mt-2 text-xs">
                {% if anomalies is empty %}
                    <div class="rounded-lg bg-success-50 dark:bg-success-900/30 px-3 py-2 text-success-800 dark:text-success-300 flex items-center gap-2">
                        <span>✓</span>
                        <span>Les informations et capacités de la formation sont complètes. Aucune anomalie détectée.</span>
                    </div>
                {% else %}
                    <div class="rounded-lg bg-warning-50 dark:bg-warning-900/30 p-3 text-warning-900 dark:text-warning-200 border border-warning-200 dark:border-warning-700">
                        <div class="font-semibold flex items-center gap-1.5 mb-1 text-warning-800 dark:text-warning-300">
                            <span>⚠</span>
                            <span>{{ anomalies|length }} anomalie{{ anomalies|length > 1 ? 's' : '' }} détectée{{ anomalies|length > 1 ? 's' : '' }} :</span>
                        </div>
                        <ul class="list-disc list-inside space-y-0.5 text-warning-800 dark:text-warning-300 ml-1">
                            {% for anomaly in anomalies %}
                                <li>{{ anomaly.message }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>

            <!-- État de validation de l'offre & documents -->
            {% set activeState = dpeFormation.etatValidation|keys|first %}
            {% set pvDocs = formation.documentConseils|filter(d => d.type == 'pv') %}
            {% set noteDocs = formation.documentConseils|filter(d => d.type == 'note_explicative') %}
            <div class="mt-3 flex items-center justify-between border-t border-secondary-200 dark:border-secondary-700 pt-3 flex-wrap gap-2 text-xs">
                <div class="flex items-center gap-2 text-secondary-600 dark:text-secondary-300 flex-wrap">
                    <span class="font-semibold text-secondary-800 dark:text-secondary-100">Statut :</span>
                    {% if activeState == 'brouillon' %}
                        <span class="inline-flex items-center rounded-md bg-secondary-100 px-2 py-0.5 text-xs font-medium text-secondary-600 ring-1 ring-inset ring-secondary-500/10 dark:bg-secondary-900/30 dark:text-secondary-300 dark:ring-secondary-700">Brouillon</span>
                    {% elseif activeState == 'soumis_ses' %}
                        <span class="inline-flex items-center rounded-md bg-warning-50 px-2 py-0.5 text-xs font-medium text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700">Soumis Scolarité (SES)</span>
                    {% elseif activeState == 'soumis_cfvu' %}
                        <span class="inline-flex items-center rounded-md bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-700 ring-1 ring-inset ring-primary-700/10 dark:bg-primary-900/30 dark:text-primary-300 dark:ring-primary-700">Soumis CFVU</span>
                    {% elseif activeState == 'attente_pv' %}
                        <span class="inline-flex items-center rounded-md bg-warning-50 px-2 py-0.5 text-xs font-medium text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700">CFVU validé (Attente PV)</span>
                    {% elseif activeState == 'publie' %}
                        <span class="inline-flex items-center rounded-md bg-success-50 px-2 py-0.5 text-xs font-medium text-success-700 ring-1 ring-inset ring-success-600/20 dark:bg-success-900/30 dark:text-success-300 dark:ring-success-700">Publié</span>
                    {% endif %}

                    {% if dpeFormation.laissezPasser %}
                        <span class="text-warning-700 bg-warning-50 rounded-md px-2 py-0.5 border border-warning-200 inline-flex items-center gap-1 dark:bg-warning-900/30 dark:text-warning-300 dark:border-warning-700">
                            <span>⚠️ Laissez-passer : <strong>{{ dpeFormation.laissezPasser }}</strong></span>
                        </span>
                    {% endif %}

                    {% if pvDocs is not empty or noteDocs is not empty %}
                        {% for doc in pvDocs %}
                            <a class="inline-flex items-center gap-1 text-primary-600 hover:underline bg-primary-50 px-2 py-0.5 rounded-md dark:bg-primary-900/30 dark:text-primary-300" target="_blank" href="{{ path('app_upload_download', {context: 'conseils', filename: doc.filename, originalName: doc.originalFilename}) }}">
                                📄 PV : {{ doc.originalFilename }}
                            </a>
                        {% endfor %}
                        {% for doc in noteDocs %}
                            <a class="inline-flex items-center gap-1 text-primary-600 hover:underline bg-primary-50 px-2 py-0.5 rounded-md dark:bg-primary-900/30 dark:text-primary-300" target="_blank" href="{{ path('app_upload_download', {context: 'conseils', filename: doc.filename, originalName: doc.originalFilename}) }}">
                                📄 Note : {{ doc.originalFilename }}
                            </a>
                        {% endfor %}
                    {% endif %}
                </div>

                <div class="flex items-center gap-3">
                    <div data-autosave-capacites-target="status" class="text-xs font-semibold flex items-center gap-1 opacity-0 transition-opacity duration-300">
                    </div>

                    {% if can_edit %}
                        <button type="submit" class="rounded-lg border border-secondary-200 px-3 py-1.5 text-xs font-medium hover:bg-secondary-50 cursor-pointer dark:border-secondary-700 dark:bg-secondary-900 dark:hover:border-secondary-300 dark:hover:text-secondary-100">
                            Sauvegarder en brouillon
                        </button>
                    {% else %}
                        <span class="text-xs text-secondary-500 italic">
                            Modifications désactivées
                        </span>
                    {% endif %}
                </div>
            </div>
        </twig:Card>

        <!-- Configuration du Tronc commun -->
        <twig:Card extraClass="mb-4"
                   title="Tronc commun de la formation"
        >
            <input type="hidden" name="has_tronc_commun_config" value="1">
            <div id="configurer_tronc_commun_block">
                <p class="text-xs text-secondary-600 dark:text-secondary-300 mb-3">
                    Cochez les années communes à l'ensemble des parcours de cette mention / formation. Lorsqu'une année est déclarée en tronc commun, ses capacités d'accueil, régimes d'inscription et plateformes de recrutement sont automatiquement synchronisés entre les parcours.
                </p>
                <div class="flex items-center gap-2.5 flex-wrap">
                    {% for anneeOrdre in formation.anneesOrdres %}
                        {% set isTc = formation.isAnneeTroncCommun(anneeOrdre) %}
                        <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border {{ isTc ? 'bg-primary-600 border-primary-600 text-white shadow-xs font-semibold' : 'bg-surface border-secondary-300 text-secondary-700 hover:bg-secondary-50 font-medium dark:bg-secondary-900 dark:text-secondary-300 dark:border-secondary-500 dark:hover:border-secondary-300 dark:hover:text-secondary-100' }} transition-colors cursor-pointer text-xs select-none">
                            <input type="checkbox"
                                   name="tronc_commun_annee_{{ anneeOrdre }}"
                                   value="1"
                                   {{ isTc ? 'checked' : '' }}
                                   {{ not can_edit ? 'disabled' : '' }}
                                   class="rounded text-primary-600 focus:ring-primary-500 dark:text-primary-400">
                            <span>{{ typeDiplome.libelleCourt|default('Année') }} {{ anneeOrdre }} (Tronc commun)</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
        </twig:Card>


        <div class="app-tabs mt-6" data-controller="tabs" data-tabs-active-tab-class="app-tab-active active">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
                <div class="app-tabs-list flex-wrap overflow-visible gap-1.5" role="tablist" aria-label="Parcours de la formation">
                    {% for parcours in formation.parcours %}
                        {% set statP = tabStatistiques['parcours'][parcours.id] ?? null %}
                        {% set dpe = parcours.getDpeParcours()|filter(d => d.campagneCollecte == campagne)|first %}
                        {% set currentEtat = dpe ? dpe.getEtatReconduction().value : 'OUVERT' %}
                        {% set isParcoursFerme = currentEtat == 'NON_OUVERTURE' or currentEtat == 'NON_OUVERTURE_SES' or currentEtat == 'NON_OUVERTURE_CFVU' or currentEtat == 'FERMETURE_DEFINITIVE' %}

                        <button type="button"
                                id="tab-parcours-{{ parcours.id }}"
                                class="app-tab gap-2 cursor-pointer {% if loop.first %}app-tab-active active{% endif %}"
                                role="tab"
                                aria-selected="{{ loop.first ? 'true' : 'false' }}"
                                aria-controls="panel-parcours-{{ parcours.id }}"
                                tabindex="{{ loop.first ? '0' : '-1' }}"
                                data-tabs-target="tab"
                                data-action="click->tabs#change"
                                data-tab-id="parcours-{{ parcours.id }}"
                        >
                            <twig:UX:Icon name="icon:layers" class="size-4" />
                            <span>{{ parcours.libelle }}</span>
                            {% if isParcoursFerme %}
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-danger-100 text-danger-700 dark:bg-danger-900/60 dark:text-danger-300">
                                    Fermé
                                </span>
                            {% endif %}
                            {% if statP and statP.anomalies|length > 0 %}
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-warning-500 text-white shadow-xs" title="{{ statP.anomalies|length }} anomalie(s)">
                                    {{ statP.anomalies|length }}
                                </span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>

                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-200 bg-surface px-3.5 py-2 text-xs font-semibold text-secondary-600 hover:bg-secondary-50 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300 dark:hover:bg-secondary-700 shadow-xs transition cursor-pointer"
                        data-action="click->tabs#toggleDetails"
                >
                    <twig:UX:Icon name="icon:chevron-down" class="h-4 w-4 transition-transform duration-200" data-toggle-icon="true" />
                    <span data-toggle-label="true">Tout déplier / replier</span>
                </button>
            </div>

            <div>
                {% for parcours in formation.parcours %}
                    <div id="panel-parcours-{{ parcours.id }}"
                         data-tabs-target="panel"
                         data-panel-id="parcours-{{ parcours.id }}"
                         class="{% if not loop.first %}hidden{% endif %}"
                         role="tabpanel"
                         aria-labelledby="tab-parcours-{{ parcours.id }}"
                         data-parcours-id="{{ parcours.id }}"
                    >
                        {% set statParcours = tabStatistiques['parcours'][parcours.id] %}
                        <twig:Card extraClass="mb-4">
                            <twig:block name="title">
                                {{ include('offre_v2/_parcours_title_area.html.twig', {
                                    parcours: parcours,
                                    campagne: campagne,
                                    can_edit: can_edit
                                }) }}
                            </twig:block>
                            <twig:block name="actions">
                                {% set dpe = parcours.getDpeParcours()|filter(d => d.campagneCollecte == campagne)|first %}
                                {% set currentEtat = dpe ? dpe.getEtatReconduction().value : 'OUVERT' %}
                                <span id="parcours_{{ parcours.id }}_badge" class="mr-2">
                                    {% set isParcoursFerme = currentEtat == 'NON_OUVERTURE' or currentEtat == 'NON_OUVERTURE_SES' or currentEtat == 'NON_OUVERTURE_CFVU' or currentEtat == 'FERMETURE_DEFINITIVE' %}
                                    {% if currentEtat == 'FERMETURE_DEFINITIVE' %}
                                        <twig:Badge variant="danger" label="Fermeture définitive" />
                                    {% elseif isParcoursFerme %}
                                        <twig:Badge variant="danger" label="Non ouvert" />
                                    {% else %}
                                        <twig:Badge variant="success" label="Ouvert" />
                                    {% endif %}
                                </span>
                                <label for="parcours-{{ parcours.id }}" class="cursor-pointer"></label>
                                <select class="rounded-lg border bg-surface text-text px-3 py-2 text-sm disabled:bg-secondary-100 disabled:text-secondary-500 dark:border-secondary-600 dark:bg-secondary-900/30"
                                        id="parcours-{{ parcours.id }}"
                                        name="parcours_{{ parcours.id }}_reconduction"
                                        {{ not can_edit ? 'disabled' : '' }}
                                >
                                    <option value="OUVERT" {% if currentEtat == 'OUVERT' or currentEtat == 'CREATION' or currentEtat == 'MODIFICATION' or currentEtat == 'MODIFICATION_INTITULE' or currentEtat == 'MODIFICATION_PARCOURS' or currentEtat == 'MODIFICATION_TEXTE' or currentEtat == 'MODIFICATION_MCCC' or currentEtat == 'MODIFICATION_MCCC_TEXTE' %}selected{% endif %}>Ouvert</option>
                                    <option value="NON_OUVERTURE" {% if currentEtat == 'NON_OUVERTURE' or currentEtat == 'NON_OUVERTURE_SES' or currentEtat == 'NON_OUVERTURE_CFVU' or currentEtat == 'ATTENTE' %}selected{% endif %}>Non ouvert</option>
                                    <option value="FERMETURE_DEFINITIVE" {% if currentEtat == 'FERMETURE_DEFINITIVE' %}selected{% endif %}>Fermeture définitive</option>
                                </select>
                            </twig:block>
                            <!-- Parcours -->
                            <article>
                                <div id="parcours_{{ parcours.id }}_stats" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                                    <twig:Kpi
                                        title="Années ouvertes"
                                        value="{{ statParcours.nbAnneesOuvertes }}"
                                        total="{{ statParcours.nbAnnees }}"
                                        variant="success"
                                        icon="icon:check-circle"
                                    />

                                    <twig:Kpi
                                        title="Plateformes"
                                        value="{{ statParcours.nbPlateformesActives }}"
                                        unit="active{{ statParcours.nbPlateformesActives > 1 ? 's' : '' }}"
                                        variant="primary"
                                        icon="icon:globe"
                                    />

                                    <twig:Kpi
                                        title="Capacité totale"
                                        value="{{ statParcours.capacite }}"
                                        unit="places"
                                        variant="info"
                                        icon="icon:users"
                                    />

                                    <twig:Kpi
                                        title="Anomalies"
                                        value="{{ statParcours.anomalies|length }}"
                                        variant="{{ statParcours.anomalies|length > 0 ? 'warning' : 'secondary' }}"
                                        icon="{{ statParcours.anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
                                    />
                                </div>

                                <!-- Années du parcours -->
                                <div class="mt-5 space-y-4">
                                    {% for annee in parcours.annees %}
                                        {{ include('offre_v2/_configurer_annee.html.twig', {
                                            'annee': annee,
                                            'parcours': parcours,
                                            'formation': formation,
                                            'typeDiplome': typeDiplome,
                                            'comparaison': comparaison,
                                            'plateformes': plateformes
                                        }) }}
                                    {% endfor %}
                                </div>
                            </article>
                        </twig:Card>
                    </div>
                {% endfor %}
            </div>
        </div>
    </form>

    <!-- Historique des validations documentaires (PV & Notes) -->
    {% if formation.historiqueFormations is not empty %}
        <twig:Card extraClass="mt-6" title="Historique des validations documentaires (PV & Notes)">
            <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
                <table class="w-full text-sm text-left rtl:text-right text-secondary-500 dark:text-secondary-400">
                    <thead class="text-xs text-secondary-700 uppercase bg-secondary-50 dark:bg-secondary-700 dark:text-secondary-400">
                        <tr>
                            <th scope="col" class="px-6 py-3">Date</th>
                            <th scope="col" class="px-6 py-3">Étape / Décision</th>
                            <th scope="col" class="px-6 py-3">Fichiers associés</th>
                            <th scope="col" class="px-6 py-3">Commentaire</th>
                            <th scope="col" class="px-6 py-3">Par</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for histo in formation.historiqueFormations|sort((a, b) => b.created <=> a.created) %}
                            <tr class="bg-surface border-b dark:bg-secondary-800 dark:border-secondary-700 hover:bg-secondary-50 dark:hover:bg-secondary-600">
                                <td class="px-6 py-4 font-medium text-secondary-900 whitespace-nowrap dark:text-white">
                                    {{ histo.created|date('d/m/Y H:i') }}
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                                        {% if histo.etat == 'valide' %}bg-success-50 text-success-700 ring-1 ring-inset ring-success-600/20 dark:bg-success-900/30 dark:text-success-300 dark:ring-success-700
                                        {% elseif histo.etat == 'refuse' %}bg-danger-50 text-danger-700 ring-1 ring-inset ring-danger-600/20 dark:bg-danger-900/30 dark:text-danger-300 dark:ring-danger-700
                                        {% elseif histo.etat == 'reserve' %}bg-warning-50 text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700
                                        {% else %}bg-secondary-50 text-secondary-700 ring-1 ring-inset ring-secondary-600/10 dark:bg-secondary-900/30 dark:text-secondary-300 dark:ring-secondary-700{% endif %}">
                                        {{ (histo.etape)|trans({}, 'process')|default(histo.etape) }} ({{ histo.etat }})
                                    </span>
                                </td>
                                <td class="px-6 py-4 space-y-1">
                                    {% if histo.documentPv %}
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <span class="text-secondary-500 font-semibold">📄 PV :</span>
                                            <a class="text-primary-600 hover:underline font-semibold dark:text-primary-400" target="_blank" href="{{ path('app_upload_download', {context: 'conseils', filename: histo.documentPv.filename, originalName: histo.documentPv.originalFilename}) }}">
                                                {{ histo.documentPv.originalFilename }}
                                            </a>
                                        </div>
                                    {% endif %}
                                    {% if histo.documentNote %}
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <span class="text-secondary-500 font-semibold">📄 Note :</span>
                                            <a class="text-primary-600 hover:underline font-semibold dark:text-primary-400" target="_blank" href="{{ path('app_upload_download', {context: 'conseils', filename: histo.documentNote.filename, originalName: histo.documentNote.originalFilename}) }}">
                                                {{ histo.documentNote.originalFilename }}
                                            </a>
                                        </div>
                                    {% endif %}
                                    {% if not histo.documentPv and not histo.documentNote and histo.complements.laisserPasser is defined %}
                                        <span class="text-warning-700 dark:text-warning-100 italic text-xs">Laissez-passer : {{ histo.complements.laisserPasser }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 max-w-xs truncate" title="{{ histo.commentaire }}">
                                    {{ histo.commentaire|default('-') }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {{ histo.user ? histo.user.display : 'Système' }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card>
    {% endif %}
{% endblock %}

