{% set isDocumentsOnly = isDocumentsOnly|default(false) %}
{% set hasUpload = meta.hasUpload|default(false) %}
{% set hasUploadNote = meta.hasUploadNote|default(false) %}
{% set formAction = actionUrl is defined and actionUrl is not empty
    ? actionUrl
    : (transition is defined and transition is not empty
        ? path('offre_v2_composante_valider', { composante: composante.id, transition: transition })
        : '') %}

<form id="modal_form"
      action="{{ formAction }}"
      method="post"
      enctype="multipart/form-data"
      class="space-y-5"
>
    <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenName|default('offre_v2_valider_' ~ composante.id)) }}">

    <!-- Alerte informative -->
    <twig:alerte type="{{ isRefuse ? 'warning' : 'info' }}">
        <p class="text-xs opacity-90">
            {% if isRefuse %}
                {{ 'offre_v2.modal_validation_composante.selectionnez_les_formations_et_parcours_a'|trans({}, 'modal') }}
            {% elseif isDocumentsOnly %}
                {{ 'offre_v2.modal_validation_composante.selectionnez_les_formations_de_la_composante'|trans({}, 'modal') }}
            {% else %}
                {{ 'offre_v2.modal_validation_composante.selectionnez_les_formations_et_parcours_de'|trans({}, 'modal') }}
            {% endif %}
        </p>
    </twig:alerte>

    <!-- Sélection des Formations & Parcours -->
    <div class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-secondary-200 dark:border-secondary-700 pb-2">
            <div>
                <h4 class="text-sm font-bold text-secondary-800 dark:text-secondary-100 uppercase tracking-wide">
                    {{ 'offre_v2.modal_validation_composante.formations_parcours_composante'|trans({}, 'modal') }}
                </h4>
                <span class="text-xs text-secondary-500">
                    {{ 'offre_v2.modal_validation_composante.cochez_les_elements_concernes_par_cette'|trans({}, 'modal') }}
                </span>
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold">
                <button type="button"
                        onclick="document.querySelectorAll('.parcours-checkbox').forEach(cb => cb.checked = true); document.querySelectorAll('.formation-checkbox').forEach(cb => cb.checked = true);"
                        class="text-primary-600 hover:text-primary-800 hover:underline cursor-pointer dark:text-primary-400 dark:hover:text-primary-300">
                    {{ 'offre_v2.modal_validation_composante.tout_cocher'|trans({}, 'modal') }}
                </button>
                <span class="text-secondary-300">|</span>
                <button type="button"
                        onclick="document.querySelectorAll('.parcours-checkbox').forEach(cb => cb.checked = false); document.querySelectorAll('.formation-checkbox').forEach(cb => cb.checked = false);"
                        class="text-secondary-500 hover:text-secondary-700 hover:underline cursor-pointer">
                    {{ 'offre_v2.modal_validation_composante.tout_decocher'|trans({}, 'modal') }}
                </button>
                <span class="text-secondary-300">|</span>
                {% if isDocumentsOnly %}
                    <button type="button"
                            onclick="document.querySelectorAll('.formation-checkbox').forEach(cb => { cb.checked = (cb.dataset.hasPv === '0'); const fId = cb.dataset.formationId; document.querySelectorAll('.parcours-of-formation-' + fId).forEach(pcb => pcb.checked = cb.checked); });"
                            class="text-warning-700 dark:text-warning-300 hover:underline cursor-pointer">
                        {{ 'offre_v2.modal_validation_composante.sans_pv'|trans({}, 'modal') }}
                    </button>
                    <span class="text-secondary-300">|</span>
                    <button type="button"
                            onclick="document.querySelectorAll('.formation-checkbox').forEach(cb => { cb.checked = (cb.dataset.hasNote === '0'); const fId = cb.dataset.formationId; document.querySelectorAll('.parcours-of-formation-' + fId).forEach(pcb => pcb.checked = cb.checked); });"
                            class="text-warning-700 dark:text-warning-300 hover:underline cursor-pointer">
                        {{ 'offre_v2.modal_validation_composante.sans_note'|trans({}, 'modal') }}
                    </button>
                {% else %}
                    <button type="button"
                            onclick="document.querySelectorAll('.parcours-checkbox').forEach(cb => cb.checked = (cb.dataset.conforme === '1')); syncFormationsCheckboxes();"
                            class="text-success-700 dark:text-success-100 hover:text-success-800 hover:underline cursor-pointer dark:hover:text-success-300">
                        {{ 'offre_v2.modal_validation_composante.cocher_les_conformes'|trans({}, 'modal') }}
                    </button>
                {% endif %}
            </div>
        </div>

        <div class="max-h-72 overflow-y-auto space-y-3 pr-1 border border-secondary-200 dark:border-secondary-700 rounded-xl p-3 bg-secondary-50/50 dark:bg-secondary-900/30">
            {% for fId, fData in formationsData %}
                {% set formation = fData.formation %}
                <div class="rounded-lg border border-secondary-200 dark:border-secondary-700 bg-surface p-3 shadow-xs space-y-2">
                    <!-- Formation Header -->
                    <div class="flex items-start justify-between gap-2 border-b border-secondary-100 dark:border-secondary-700 pb-2">
                        <label class="flex items-center gap-2.5 cursor-pointer font-bold text-secondary-900 dark:text-secondary-100 text-sm">
                            <input type="checkbox"
                                   name="formations[]"
                                   value="{{ formation.id }}"
                                   checked
                                   data-formation-id="{{ formation.id }}"
                                   data-has-pv="{{ fData.hasPv|default(false) ? '1' : '0' }}"
                                   data-has-note="{{ fData.hasNote|default(false) ? '1' : '0' }}"
                                   class="formation-checkbox h-4 w-4 rounded border-secondary-300 dark:border-secondary-700 text-primary-600 focus:ring-primary-500 cursor-pointer dark:text-primary-400"
                                   onchange="document.querySelectorAll('.parcours-of-formation-{{ formation.id }}').forEach(cb => cb.checked = this.checked);"
                            >
                            <span>{{ formation.displayLong }}</span>
                        </label>
                        <div class="flex items-center gap-2 shrink-0">
                            {% if isDocumentsOnly %}
                                {% if fData.hasPv|default(false) %}
                                    <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-semibold bg-success-50 text-success-700 border border-success-200 dark:bg-success-900/30 dark:text-success-300 dark:border-success-700">{{ 'offre_v2.modal_validation_composante.pv_ok'|trans({}, 'modal') }}</span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-semibold bg-secondary-100 text-secondary-600 border border-secondary-200 dark:bg-secondary-800 dark:text-secondary-400">{{ 'offre_v2.modal_validation_composante.sans_pv'|trans({}, 'modal') }}</span>
                                {% endif %}
                                {% if fData.hasNote|default(false) %}
                                    <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-semibold bg-primary-50 text-primary-700 border border-primary-200 dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">{{ 'offre_v2.modal_validation_composante.note_ok'|trans({}, 'modal') }}</span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-semibold bg-secondary-100 text-secondary-600 border border-secondary-200 dark:bg-secondary-800 dark:text-secondary-400">{{ 'offre_v2.modal_validation_composante.sans_note'|trans({}, 'modal') }}</span>
                                {% endif %}
                            {% else %}
                                {% if fData.hasAnomalies %}
                                    <span class="inline-flex items-center gap-1 rounded-md bg-warning-50 dark:bg-warning-900/30 px-2 py-0.5 text-xs font-semibold text-warning-800 dark:text-warning-300 border border-warning-200 dark:border-warning-700" title="{{ fData.anomaliesCount }} anomalie(s) détectée(s)">
                                        {{ 'offre_v2.modal_validation_composante.anomalies_a_verifier'|trans({'%count%': fData.anomaliesCount}, 'modal') }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 rounded-md bg-success-50 dark:bg-success-900/30 px-2 py-0.5 text-xs font-semibold text-success-700 dark:text-success-300 border border-success-200 dark:border-success-700">
                                        {{ 'offre_v2.modal_validation_composante.conforme'|trans({}, 'modal') }}
                                    </span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <!-- Parcours List -->
                    <div class="space-y-1.5 pl-6">
                        {% for pData in fData.parcoursList %}
                            {% set parcours = pData.parcours %}
                            <div class="flex flex-wrap items-center justify-between gap-2 p-1.5 rounded-md hover:bg-secondary-50 text-xs">
                                <label class="flex items-center gap-2 cursor-pointer font-medium text-secondary-700 dark:text-secondary-100">
                                    <input type="checkbox"
                                           name="parcours[]"
                                           value="{{ parcours.id }}"
                                           checked
                                           data-conforme="{{ pData.isConforme ? '1' : '0' }}"
                                           data-formation-id="{{ formation.id }}"
                                           class="parcours-checkbox parcours-of-formation-{{ formation.id }} h-3.5 w-3.5 rounded border-secondary-300 dark:border-secondary-700 text-primary-600 focus:ring-primary-500 cursor-pointer dark:text-primary-400"
                                           onchange="syncFormationCheckbox({{ formation.id }});"
                                    >
                                    <span>{{ parcours.libelle }}</span>
                                    <span class="rounded-full bg-{{ pData.isOuvert ? 'success' : 'danger' }}-50 dark:bg-{{ pData.isOuvert ? 'success' : 'danger' }}-900/30 px-1.5 py-0.5 text-[10px] font-semibold text-{{ pData.isOuvert ? 'success' : 'danger' }}-700 dark:text-{{ pData.isOuvert ? 'success' : 'danger' }}-300 border border-{{ pData.isOuvert ? 'success' : 'danger' }}-200 dark:border-{{ pData.isOuvert ? 'success' : 'danger' }}-700">
                                        {{ pData.isOuvert ? 'Ouvert' : 'Fermé' }}
                                    </span>
                                </label>

                                <div class="flex items-center gap-2">
                                    <span class="text-secondary-500 font-medium">{{ 'offre_v2.modal_validation_composante.capacite'|trans({}, 'modal') }} <strong>{{ pData.capacite }}</strong></span>
                                    {% if pData.isConforme %}
                                        <span class="inline-flex items-center gap-0.5 text-success-700 dark:text-success-100 font-semibold text-[11px]">
                                            {{ 'offre_v2.modal_validation_composante.donnees_ok'|trans({}, 'modal') }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-0.5 text-warning-700 dark:text-warning-100 font-semibold text-[11px] cursor-help" title="{{ pData.anomalies|join('\n') }}">
                                            ⚠️ {{ 'offre_v2.modal_validation_composante.anomalies'|trans({'%count%': pData.anomalies|length}, 'modal') }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {% if not isRefuse %}
        <!-- Ligne 1 : PV & Date de validation côte à côte -->
        <div class="grid gap-4 md:grid-cols-2 border-t border-secondary-200 dark:border-secondary-700 pt-4">
            <!-- Procès-Verbal (PV) -->
            <div class="space-y-2 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50/50 dark:bg-secondary-900/30 p-3.5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <label class="text-xs font-bold text-secondary-800 dark:text-secondary-100 uppercase tracking-wide flex items-center gap-1.5">
                            <span>📄</span>
                            <span>{{ 'offre_v2.modal_validation_composante.proces_verbal_pv'|trans({}, 'modal') }}</span>
                        </label>
                        <twig:Badge size="sm"
                                    :variant="hasUpload ? 'danger' : 'secondary'"
                                    :label="isDocumentsOnly ? 'Optionnel' : (hasUpload ? 'Requis sauf laissez-passer' : 'Optionnel')"
                        />
                    </div>

                    {% if existingPvs|length > 0 or isDocumentsOnly %}
                        <div class="mb-2">
                            <label for="pv_id" class="block text-[11px] font-medium text-secondary-500 mb-1">
                                {{ isDocumentsOnly ? 'Action pour le PV :' : 'Choisir un PV :' }}
                            </label>
                            <select name="pv_id" id="pv_id"
                                    onchange="updatePvVisibility();"
                                    class="app-filter-select w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface px-3 py-2 text-xs text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500 cursor-pointer">
                                {% if isDocumentsOnly %}
                                    <option value="">{{ 'offre_v2.modal_validation_composante.ne_pas_modifier_le_pv'|trans({}, 'modal') }}</option>
                                    <option value="__upload__">{{ 'offre_v2.modal_validation_composante.modifier_deposer_une_nouvelle_pj_pdf'|trans({}, 'modal') }}</option>
                                    <option value="__remove__">{{ 'offre_v2.modal_validation_composante.retirer_dissocier_le_pv_actuel'|trans({}, 'modal') }}</option>
                                {% else %}
                                    <option value="">{{ 'offre_v2.modal_validation_composante.televerser_une_nouvelle_pj_pdf'|trans({}, 'modal') }}</option>
                                {% endif %}
                                {% if existingPvs|length > 0 %}
                                    <optgroup label="{{ 'offre_v2.modal_validation_composante.ou_reutiliser_un_pv_deja_depose'|trans({}, 'modal') }}">
                                        {% for pv in existingPvs %}
                                            <option value="{{ pv.id }}">{{ 'offre_v2.modal_formation_documents.fichier_du'|trans({'%fichier%': pv.originalFilename, '%date%': pv.uploadedAt|date('d/m/Y')}, 'modal') }}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endif %}
                            </select>
                        </div>
                    {% endif %}
                </div>

                <div id="pv_file_input_wrapper" class="space-y-1.5 p-2.5 rounded-lg border border-primary-200 dark:border-primary-800 bg-primary-50/30 dark:bg-primary-950/20" style="{{ isDocumentsOnly ? 'display: none;' : '' }}">
                    <label for="file" class="block text-[11px] font-semibold text-primary-900 dark:text-primary-200">
                        {{ existingPvs|length > 0 or isDocumentsOnly ? 'Sélectionner le nouveau fichier PDF du PV (PJ) :' : 'Téléverser le fichier PDF :' }}
                    </label>
                    <input type="file" name="file" id="file" accept="application/pdf"
                           class="w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface p-1.5 text-xs text-secondary-700 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:text-primary-300">
                </div>
            </div>

            <!-- Date de validation -->
            <div class="space-y-2 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50/50 dark:bg-secondary-900/30 p-3.5 flex flex-col justify-between">
                <div>
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                        <label for="date" class="text-xs font-bold text-secondary-800 dark:text-secondary-100 uppercase tracking-wide flex items-center gap-1.5">
                            <span>📅</span>
                            <span>{{ 'offre_v2.modal_validation_composante.date_de_decision_conseil'|trans({}, 'modal') }}</span>
                        </label>
                        <twig:Badge size="sm" variant="danger" label="{{ 'offre_v2.modal_validation_composante.requis'|trans({}, 'modal') }}" />
                    </div>
                    <p class="text-[11px] text-secondary-500">
                        {{ 'offre_v2.modal_validation_composante.date_d_effet_ou_date_de'|trans({}, 'modal') }}
                    </p>
                </div>

                <div class="space-y-1">
                    <label for="date" class="block text-[11px] font-medium text-secondary-500">
                        {{ 'offre_v2.modal_validation_composante.selectionner_la_date'|trans({}, 'modal') }}
                    </label>
                    <input type="date"
                           name="date"
                           id="date"
                           value="{{ 'now'|date('Y-m-d') }}"
                           required
                           class="w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface p-2 text-xs font-semibold text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500">
                </div>
            </div>
        </div>

        {% if not isDocumentsOnly %}
            <!-- Ligne 2 : Laissez-passer optionnel -->
            <div class="rounded-xl border border-warning-200 dark:border-warning-700 bg-warning-50/50 dark:bg-warning-900/30 p-3.5 space-y-2">
                <label class="flex items-center gap-2.5 cursor-pointer font-bold text-warning-900 dark:text-warning-100 text-xs uppercase tracking-wide">
                    <input type="checkbox"
                           name="laisserPasser"
                           id="laisserPasser"
                           value="1"
                           onchange="document.getElementById('laisser_passer_justif_wrapper').style.display = this.checked ? 'block' : 'none';"
                           class="h-4 w-4 rounded border-warning-300 text-warning-600 focus:ring-warning-500 cursor-pointer dark:text-warning-400">
                    <span>{{ 'offre_v2.modal_validation_composante.demander_activer_un_laissez_passer_exceptionnel'|trans({}, 'modal') }}</span>
                </label>
                <div id="laisser_passer_justif_wrapper" style="display: none;" class="space-y-1 pt-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <label for="laisserPasserJustif" class="block text-[11px] font-medium text-warning-800 dark:text-warning-100">
                            {{ 'offre_v2.modal_validation_composante.justification_du_laissez_passer_pv_differe'|trans({}, 'modal') }}
                        </label>
                        <twig:Badge size="sm" variant="danger" label="{{ 'offre_v2.modal_validation_composante.requis'|trans({}, 'modal') }}" />
                    </div>
                    <input type="text"
                           name="laisserPasserJustif"
                           id="laisserPasserJustif"
                           placeholder="{{ 'offre_v2.modal_validation_composante.ex_pv_en_cours_de_signature'|trans({}, 'modal') }}"
                           class="w-full rounded-lg border border-warning-300 dark:border-secondary-600 bg-surface p-2 text-xs text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-warning-500 focus:ring-warning-500">
                </div>
            </div>
        {% endif %}

        <!-- Ligne 3 : Note explicative (obligatoire) -->
        <div class="space-y-2 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-secondary-50/50 dark:bg-secondary-900/30 p-3.5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <label class="text-xs font-bold text-secondary-800 dark:text-secondary-100 uppercase tracking-wide flex items-center gap-1.5">
                        <span>📝</span>
                        <span>{{ 'offre_v2.modal_validation_composante.note_explicative'|trans({}, 'modal') }}</span>
                    </label>
                    <twig:Badge size="sm"
                                :variant="hasUploadNote ? 'danger' : 'secondary'"
                                :label="isDocumentsOnly ? 'Optionnel' : (hasUploadNote ? 'Requis' : 'Optionnel')"
                    />
                </div>
                <a href="{{ asset('modeles/note_explicative.docx') }}" target="_blank" class="text-[11px] font-semibold text-primary-600 hover:underline dark:text-primary-400">
                    {{ 'offre_v2.modal_validation_composante.modele_docx'|trans({}, 'modal') }}
                </a>
            </div>

            {% if existingNotes|length > 0 or isDocumentsOnly %}
                <div>
                    <label for="note_id" class="block text-[11px] font-medium text-secondary-500 mb-1">
                        {{ isDocumentsOnly ? 'Action pour la Note :' : 'Choisir une Note :' }}
                    </label>
                    <select name="note_id" id="note_id"
                            onchange="updateNoteVisibility();"
                            class="app-filter-select w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface px-3 py-2 text-xs text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500 cursor-pointer">
                        {% if isDocumentsOnly %}
                            <option value="">{{ 'offre_v2.modal_validation_composante.ne_pas_modifier_la_note'|trans({}, 'modal') }}</option>
                            <option value="__upload__">{{ 'offre_v2.modal_validation_composante.modifier_deposer_une_nouvelle_note_pdf'|trans({}, 'modal') }}</option>
                            <option value="__remove__">{{ 'offre_v2.modal_validation_composante.retirer_dissocier_la_note_actuelle'|trans({}, 'modal') }}</option>
                        {% else %}
                            <option value="">{{ 'offre_v2.modal_validation_composante.televerser_une_nouvelle_note_pdf'|trans({}, 'modal') }}</option>
                        {% endif %}
                        {% if existingNotes|length > 0 %}
                            <optgroup label="{{ 'offre_v2.modal_validation_composante.ou_reutiliser_une_note_deja_deposee'|trans({}, 'modal') }}">
                                {% for note in existingNotes %}
                                    <option value="{{ note.id }}">{{ 'offre_v2.modal_formation_documents.fichier_du'|trans({'%fichier%': note.originalFilename, '%date%': note.uploadedAt|date('d/m/Y')}, 'modal') }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endif %}
                    </select>
                </div>
            {% endif %}

            <div id="note_file_input_wrapper" class="space-y-1.5 p-2.5 rounded-lg border border-primary-200 dark:border-primary-800 bg-primary-50/30 dark:bg-primary-950/20" style="{{ isDocumentsOnly ? 'display: none;' : '' }}">
                <label for="fileNote" class="block text-[11px] font-semibold text-primary-900 dark:text-primary-200">
                    {{ existingNotes|length > 0 or isDocumentsOnly ? 'Sélectionner le nouveau fichier PDF de la Note (PJ) :' : 'Téléverser le fichier PDF :' }}
                </label>
                <input type="file" name="fileNote" id="fileNote" accept="application/pdf"
                       class="w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface p-1.5 text-xs text-secondary-700 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:text-primary-300">
            </div>
        </div>
    {% else %}
        <!-- Si refus : Date de décision -->
        <div class="border-t border-secondary-200 dark:border-secondary-700 pt-4">
            <div class="mb-1 flex flex-wrap items-center gap-2">
                <label for="date" class="block text-xs font-bold text-secondary-700 dark:text-secondary-100 uppercase tracking-wide">
                    {{ 'offre_v2.modal_validation_composante.date_de_decision'|trans({}, 'modal') }}
                </label>
                <twig:Badge size="sm" variant="danger" label="{{ 'offre_v2.modal_validation_composante.requis'|trans({}, 'modal') }}" />
            </div>
            <input type="date"
                   name="date"
                   id="date"
                   value="{{ 'now'|date('Y-m-d') }}"
                   required
                   class="w-full max-w-xs rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface p-2 text-xs font-semibold text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500">
        </div>
    {% endif %}

    <!-- Ligne 4 : Commentaire libre -->
    <div class="border-t border-secondary-200 dark:border-secondary-700 pt-4">
        <div class="mb-1 flex flex-wrap items-center gap-2">
            <label for="commentaire" class="block text-xs font-bold text-secondary-700 dark:text-secondary-100 uppercase tracking-wide">
                {{ isRefuse ? 'Motif du retour / modifications demandées :' : (isDocumentsOnly ? 'Commentaire / Justification (optionnel) :' : 'Commentaire / Remarques (optionnel) :') }}
            </label>
            <twig:Badge size="sm"
                        :variant="isRefuse ? 'danger' : 'secondary'"
                        :label="isRefuse ? 'Requis' : 'Optionnel'"
            />
        </div>
        <textarea name="commentaire"
                  id="commentaire"
                  rows="2"
                  {{ isRefuse ? 'required' : '' }}
                  placeholder="{{ isRefuse ? 'Précisez les corrections attendues...' : (isDocumentsOnly ? 'Ex : Remplacement du PV suite à commission du...' : 'Ajouter une observation...') }}"
                  class="w-full rounded-lg border border-secondary-300 dark:border-secondary-600 bg-surface p-2 text-xs text-secondary-800 dark:text-secondary-100 shadow-xs focus:border-primary-500 focus:ring-primary-500"></textarea>
    </div>

    {# Collé en bas de la zone défilante : reste visible au-dessus du bouton Enregistrer #}
    <div id="offre_validation_errors" aria-live="assertive" class="sticky bottom-0 z-10"></div>
</form>

<script>
    function updatePvVisibility() {
        const pvSelect = document.getElementById('pv_id');
        const pvWrapper = document.getElementById('pv_file_input_wrapper');
        if (!pvWrapper) return;
        if (!pvSelect) {
            pvWrapper.style.display = 'block';
            return;
        }
        const isDocOnly = {{ isDocumentsOnly ? 'true' : 'false' }};
        if (isDocOnly) {
            pvWrapper.style.display = (pvSelect.value === '__upload__') ? 'block' : 'none';
        } else {
            pvWrapper.style.display = (!pvSelect.value || pvSelect.value === '__upload__') ? 'block' : 'none';
        }
    }

    function updateNoteVisibility() {
        const noteSelect = document.getElementById('note_id');
        const noteWrapper = document.getElementById('note_file_input_wrapper');
        if (!noteWrapper) return;
        if (!noteSelect) {
            noteWrapper.style.display = 'block';
            return;
        }
        const isDocOnly = {{ isDocumentsOnly ? 'true' : 'false' }};
        if (isDocOnly) {
            noteWrapper.style.display = (noteSelect.value === '__upload__') ? 'block' : 'none';
        } else {
            noteWrapper.style.display = (!noteSelect.value || noteSelect.value === '__upload__') ? 'block' : 'none';
        }
    }

    // Initialisation
    updatePvVisibility();
    updateNoteVisibility();

    function syncFormationCheckbox(formationId) {
        const parcoursCbs = document.querySelectorAll('.parcours-of-formation-' + formationId);
        const formationCb = document.querySelector('input[data-formation-id="' + formationId + '"].formation-checkbox');
        if (!formationCb || parcoursCbs.length === 0) return;
        let anyChecked = false;
        parcoursCbs.forEach(cb => { if (cb.checked) anyChecked = true; });
        formationCb.checked = anyChecked;
    }

    function syncFormationsCheckboxes() {
        document.querySelectorAll('.formation-checkbox').forEach(fCb => {
            const fId = fCb.dataset.formationId;
            syncFormationCheckbox(fId);
        });
    }
</script>
