{# Recharge uniquement le tableau de l'offre (le toast, hors du frame, reste affiché). #}
<turbo-stream action="append" target="modal_control">
    <template>
        <script data-turbo-eval="true">
          (function () {
            var frame = document.getElementById('offre_table');
            if (frame) {
              frame.src = window.location.href;
            } else if (window.Turbo) {
              window.Turbo.visit(window.location.href, { action: 'replace' });
            }
          })();
        </script>
    </template>
</turbo-stream>
