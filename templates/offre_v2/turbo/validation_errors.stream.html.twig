<turbo-stream action="update" target="offre_validation_errors">
    <template>
        <div data-controller="form-errors" data-form-error-summary tabindex="-1" role="region" aria-label="Points à corriger" class="rounded-xl bg-surface shadow-lg">
        <twig:alerte type="danger">
            <p class="text-sm font-semibold">{{ title }}</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-4 text-xs">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </twig:alerte>
        </div>
    </template>
</turbo-stream>

{{ include('_ui/_toast.stream.html.twig', { message: title, toast_type: 'danger', undo: null }) }}
