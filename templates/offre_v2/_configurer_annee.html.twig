{# can_edit vient de la page (configurer.html.twig) ; repli pour les flux Turbo qui ne le transmettent pas #}
{% set can_edit = can_edit is defined ? can_edit : (is_granted('ROLE_SES') or (campagne and campagne.isPeriodActive())) %}
{% set forma = formation|default(parcours.formation) %}
{% set isTroncCommun = forma ? forma.isAnneeTroncCommun(annee.ordre) : false %}
{% set isCapaciteNulle = annee.isOuvert and (annee.capaciteAccueil is null or annee.capaciteAccueil <= 0) %}
{% set hasActiveReqPlatWithoutCap = false %}
{% for plat in plateformes|filter(p => annee.ordre in p.annees) %}
    {% set isReq = annee.ordre in (plat.anneesCapaciteRequise ?? []) %}
    {% set pParam = annee.admissionPlateformeParametres|filter(param => param.campagne == campagne and param.plateforme and param.plateforme.id == plat.id)|first %}
    {% if isReq and pParam and pParam.active %}
        {% set hasCap = (pParam.capaciteGlobale > 0 or pParam.capaciteFi > 0 or pParam.capaciteAlternance > 0 or pParam.capaciteSpecifique > 0) %}
        {% if not hasCap %}
            {% set hasActiveReqPlatWithoutCap = true %}
        {% endif %}
    {% endif %}
{% endfor %}
{% set isAnneeWarning = annee.isOuvert and (isCapaciteNulle or hasActiveReqPlatWithoutCap) %}
<div id="annee_{{ annee.id }}_container" data-annee-ordre="{{ annee.ordre }}" data-is-tronc-commun="{{ isTroncCommun ? '1' : '0' }}">
    {% if annee.isOuvert %}
        {% if comparaison[parcours.id] is defined and comparaison[parcours.id][annee.ordre] is defined %}
            {% set anneeCourante = comparaison[parcours.id][annee.ordre].anneeCourante %}
            {% set anneeComparaison = comparaison[parcours.id][annee.ordre] %}
            <!-- Année {{ anneeComparaison.numeroAnnee }} -->
            <details class="group rounded-xl border {{ isAnneeWarning ? 'border-warning-300 bg-warning-50/20 dark:bg-warning-900/10 dark:border-warning-700/80' : (isTroncCommun ? 'border-primary-300 bg-primary-50/30 shadow-xs ring-1 ring-primary-200 dark:bg-primary-900/20 dark:ring-primary-700/60 dark:border-primary-700' : 'border-secondary-200 bg-surface dark:bg-secondary-900/30 dark:border-secondary-700') }} p-4 transition-all">
                <summary class="cursor-pointer list-none select-none flex items-center justify-between gap-3 flex-wrap">
                    <div class="inline-flex items-center gap-2.5 flex-wrap">
                        <span class="inline-flex items-center justify-center h-5 w-5 rounded-md bg-secondary-100 text-secondary-500 group-open:rotate-90 transition-transform dark:bg-secondary-800 dark:text-secondary-400">
                            <twig:UX:Icon name="icon:chevron-right" class="h-3.5 w-3.5" />
                        </span>
                        <span class="font-bold text-secondary-900 dark:text-secondary-100 text-base">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        {% if isTroncCommun %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 border border-primary-200 shadow-xs dark:bg-primary-900/40 dark:text-primary-300 dark:border-primary-700">
                                <twig:UX:Icon name="ph:users-three-bold" class="h-3.5 w-3.5" />
                                Tronc commun
                            </span>
                        {% endif %}
                        <twig:Badge variant="success" label="Ouverte"/>
                        <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                            {% for reg in annee.regimeInscription %}
                                {% set regVal = reg.value|default(reg) %}
                                {% set badgeVariant = 'info' %}
                                {% set badgeIcon = 'ph:graduation-cap' %}
                                {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                                    {% set badgeVariant = 'warning' %}
                                    {% set badgeIcon = 'ph:briefcase' %}
                                {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                                    {% set badgeVariant = 'secondary' %}
                                    {% set badgeIcon = 'ph:chalkboard-teacher' %}
                                {% elseif 'initiale' in regVal|lower %}
                                    {% set badgeVariant = 'primary' %}
                                    {% set badgeIcon = 'ph:student' %}
                                {% endif %}
                                <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                            {% endfor %}
                        </span>
                    </div>

                    {{ include('offre_v2/_annee_capacite_summary.html.twig', {
                        'annee': annee,
                        'parcours': parcours,
                        'formation': formation,
                        'campagne': campagne,
                        'comparaison': comparaison,
                        'plateformes': plateformes
                    }) }}
                </summary>

                {% if isTroncCommun %}
                    <div class="mt-3 flex items-center gap-2 rounded-lg bg-primary-100/70 px-3 py-1.5 text-xs text-primary-900 border border-primary-200 dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                        <twig:UX:Icon name="ph:info-bold" class="h-4 w-4 text-primary-600 shrink-0 dark:text-primary-400" />
                        <span><strong>Année en tronc commun :</strong> Les ouvertures, régimes, capacités et plateformes sont automatiquement synchronisés sur l'ensemble des parcours.</span>
                    </div>
                {% endif %}

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Ouverture de l'année</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" data-tc-field="isOuvert" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Non</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-secondary-500">
                                Année précédente : <span class="font-medium">{{ anneeComparaison.anneePrecedente.isOuvert ? 'Ouverte' : 'Fermée' }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Capacité globale d'accueil</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" data-tc-field="capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-secondary-500">
                                Année précédente : <span class="font-medium">{{ anneeComparaison.anneePrecedente.capaciteAccueil }}</span>
                                {% set diff = annee.capaciteAccueil - anneeComparaison.anneePrecedente.capaciteAccueil %}
                                {% if diff != 0 %}
                                    <span class="ml-1 {% if diff > 0 %}text-success-600 dark:text-success-400{% else %}text-danger-600 dark:text-danger-400{% endif %}">
                                        ({{ diff > 0 ? '+' : '' }}{{ diff }})
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Régimes d'inscription (Chips compacts) -->
                <div class="mt-4 p-3.5 rounded-xl border border-secondary-200 bg-secondary-50/50 dark:border-secondary-700 dark:bg-secondary-900/30">
                    <input type="hidden" name="annee_{{ annee.id }}_regime_present" value="1">
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-2.5">
                        <span class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Régimes d'inscription proposés :</span>
                        <span class="text-[11px] text-secondary-500">Cochez les modalités applicables pour cette année</span>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        {% for regimeEnum in enum('App\\Enums\\RegimeInscriptionEnum').cases %}
                            {% set isChecked = annee.hasRegimeInscription(regimeEnum) %}
                            {% set regVal = regimeEnum.value %}
                            <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs cursor-pointer transition select-none
                                {{ isChecked 
                                    ? 'bg-primary-50 border-primary-300 text-primary-900 shadow-xs dark:bg-primary-900/50 dark:border-primary-600 dark:text-primary-200 font-semibold' 
                                    : 'bg-surface border-secondary-200 text-secondary-600 hover:bg-secondary-100/60 dark:bg-secondary-800 dark:border-secondary-700 dark:text-secondary-300 dark:hover:bg-secondary-700 font-medium' }}">
                                <input type="checkbox"
                                       name="annee_{{ annee.id }}_regimeInscription[]"
                                       value="{{ regVal }}"
                                       data-tc-field="regime_{{ regVal }}"
                                       {{ isChecked ? 'checked' : '' }}
                                       {{ not can_edit ? 'disabled' : '' }}
                                       class="h-3.5 w-3.5 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-900 cursor-pointer">
                                <span>{{ regVal }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <!-- Plateformes et capacités -->
                <div class="mt-4 rounded-xl border border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                    <h5 class="text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-300">Plateformes et capacités</h5>

                    {% set anneePlateformes = plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                    {% if anneePlateformes is not empty %}
                        <div class="mt-3 space-y-4">
                            {% for plateforme in anneePlateformes %}
                                {% set pCode = plateforme.code|lower %}
                                {% set plateformeCourante = anneeCourante.plateformes|filter(p => p.code == plateforme.code)|first %}
                                {% set plateformePrecedente = anneeComparaison.anneePrecedente ? anneeComparaison.anneePrecedente.plateformes|filter(p => p.code == plateforme.code)|first : null %}
                                {% set isCapaciteRequise = annee.ordre in (plateforme.anneesCapaciteRequise ?? []) %}
                                {% set isCapaciteSpecifique = annee.ordre in (plateforme.anneesCapaciteSpecifique ?? []) %}
                                {% set hasChamps = plateforme.hasDefinitionChamps ?? false %}

                                <div class="overflow-hidden rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface">
                                    <table class="w-full text-sm">
                                        <thead class="bg-secondary-50 text-left text-xs uppercase text-secondary-500 dark:bg-secondary-900/30">
                                        <tr>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.libelle')|trans|default(plateforme.libelle) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.active')|trans|default('Active') }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_globale')|trans|default(('plateforme.' ~ pCode ~ '.globale')|trans|default('Globale')) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_classique')|trans|default(('plateforme.' ~ pCode ~ '.classique')|trans|default('Classique')) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_alternance')|trans|default(('plateforme.' ~ pCode ~ '.alternance')|trans|default('Alternance')) }}</th>
                                            {% if isCapaciteSpecifique %}
                                                <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_specifique')|trans|default(('plateforme.' ~ pCode ~ '.specifique')|trans|default('Spécifique')) }}</th>
                                            {% endif %}
                                            {% if hasChamps %}
                                                <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.champs_specifiques')|trans|default('Champs spécifiques') }}</th>
                                            {% endif %}
                                        </tr>
                                        </thead>
                                        <tbody class="divide-y">
                                        <tr>
                                            <td class="px-4 py-3 font-medium">
                                                <div class="flex items-center gap-2 flex-wrap">
                                                    {% if plateforme.color %}
                                                        <span class="inline-flex items-center gap-2">
                                                            <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                            {{ plateforme.libelle }}
                                                        </span>
                                                    {% else %}
                                                        <span>{{ plateforme.libelle }}</span>
                                                    {% endif %}
                                                    {% if isCapaciteRequise %}
                                                        <span class="inline-flex items-center rounded-md bg-warning-50 px-1.5 py-0.5 text-[10px] font-semibold text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700" title="Capacité obligatoire pour cette année">
                                                            Capacité requise
                                                        </span>
                                                    {% else %}
                                                        <span class="inline-flex items-center rounded-md bg-secondary-100 px-1.5 py-0.5 text-[10px] font-medium text-secondary-500 ring-1 ring-inset ring-secondary-500/10 dark:bg-secondary-900/30 dark:ring-secondary-700" title="Capacité optionnelle pour cette année">
                                                            Optionnelle
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <input type="checkbox"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_active"
                                                       {% if plateformeCourante and plateformeCourante.parametre.active %}checked{% endif %}
                                                       class="h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 cursor-pointer">
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteGlobale : '' }}"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_globale"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                                {% if plateformePrecedente and plateformePrecedente.parametre %}
                                                    <div class="mt-1 text-xs text-secondary-500">
                                                        N-1 : {{ plateformePrecedente.parametre.capaciteGlobale }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteFi : '' }}"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_classique"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                                {% if plateformePrecedente and plateformePrecedente.parametre %}
                                                    <div class="mt-1 text-xs text-secondary-500">
                                                        N-1 : {{ plateformePrecedente.parametre.capaciteFi }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteAlternance : '' }}"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_alternance"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                                {% if plateformePrecedente and plateformePrecedente.parametre %}
                                                    <div class="mt-1 text-xs text-secondary-500">
                                                        N-1 : {{ plateformePrecedente.parametre.capaciteAlternance }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                            {% if isCapaciteSpecifique %}
                                                <td class="px-4 py-3">
                                                    <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteSpecifique : '' }}"
                                                           name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                           data-tc-field="plateforme_{{ plateforme.id }}_specifique"
                                                           class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                           type="number"
                                                           min="0">
                                                    {% if plateformePrecedente and plateformePrecedente.parametre %}
                                                        <div class="mt-1 text-xs text-secondary-500">
                                                            N-1 : {{ plateformePrecedente.parametre.capaciteSpecifique }}
                                                        </div>
                                                    {% endif %}
                                                </td>
                                            {% endif %}
                                            {% if hasChamps %}
                                                <td class="px-4 py-3">
                                                    <button type="button"
                                                            class="rounded bg-primary-100 px-2 py-1 text-xs text-primary-700 hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-300 dark:hover:border-primary-300 dark:hover:text-primary-100"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                </td>
                                            {% endif %}
                                        </tr>
                                        <tr class="bg-secondary-50/40 dark:bg-secondary-900/30">
                                            <td class="px-4 py-2.5 border-b border-secondary-200/60 dark:border-secondary-700" colspan="{{ 5 + (isCapaciteSpecifique ? 1 : 0) + (hasChamps ? 1 : 0) }}">
                                                <div class="space-y-1">
                                                    <div class="flex justify-between items-center mb-1">
                                                        <label for="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                               class="text-[12px] font-black text-secondary-500 uppercase">
                                                            {{ ('plateforme.' ~ pCode ~ '.remarques')|trans|default('Remarques / Précisions (' ~ plateforme.libelle ~ ')') }}
                                                        </label>
                                                    </div>
                                                    <input id="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           value="{{ plateformeCourante ? plateformeCourante.parametre.remarques : '' }}"
                                                           name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           data-tc-field="plateforme_{{ plateforme.id }}_remarques"
                                                           placeholder="Ex. : Sous réserve de validation, alternance uniquement, etc."
                                                           class="w-full p-2 bg-surface text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-primary-50 focus:border-primary-500 outline-none transition-all shadow-sm placeholder:text-secondary-400 text-xs dark:border-secondary-600 dark:text-secondary-100"
                                                           type="text">
                                                    <p class="text-[11px] text-secondary-400 italic mt-1 pl-1 flex items-start gap-2">
                                                        <span class="flex-shrink-0 w-4 h-4 bg-secondary-200 dark:bg-secondary-700 text-secondary-500 flex items-center justify-center text-[10px] rounded-full">
                                                            <twig:UX:Icon name="icon:info"/>
                                                        </span>
                                                        <span>Cette remarque sera reprise dans les exports Excel (annexes CA) pour cette plateforme et cette année.</span>
                                                    </p>
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mt-3 text-sm text-secondary-500">Aucune plateforme d'admission n'est configurée pour ce type de diplôme.</p>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% else %}
            <!-- Année ouverte sans comparaison N-1 -->
            <details class="group rounded-xl border {{ isAnneeWarning ? 'border-warning-300 bg-warning-50/20 dark:bg-warning-900/10 dark:border-warning-700/80' : (isTroncCommun ? 'border-primary-300 bg-primary-50/30 shadow-xs ring-1 ring-primary-200 dark:bg-primary-900/20 dark:ring-primary-700/60 dark:border-primary-700' : 'border-secondary-200 bg-surface dark:bg-secondary-900/30 dark:border-secondary-700') }} p-4 transition-all">
                <summary class="cursor-pointer list-none select-none flex items-center justify-between gap-3 flex-wrap">
                    <div class="inline-flex items-center gap-2.5 flex-wrap">
                        <span class="inline-flex items-center justify-center h-5 w-5 rounded-md bg-secondary-100 text-secondary-500 group-open:rotate-90 transition-transform dark:bg-secondary-800 dark:text-secondary-400">
                            <twig:UX:Icon name="icon:chevron-right" class="h-3.5 w-3.5" />
                        </span>
                        <span class="font-bold text-secondary-900 dark:text-secondary-100 text-base">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        {% if isTroncCommun %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 border border-primary-200 shadow-xs dark:bg-primary-900/40 dark:text-primary-300 dark:border-primary-700">
                                <twig:UX:Icon name="ph:users-three-bold" class="h-3.5 w-3.5" />
                                Tronc commun
                            </span>
                        {% endif %}
                        <twig:Badge variant="success" label="Ouverte"/>
                        <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                            {% for reg in annee.regimeInscription %}
                                {% set regVal = reg.value|default(reg) %}
                                {% set badgeVariant = 'info' %}
                                {% set badgeIcon = 'ph:graduation-cap' %}
                                {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                                    {% set badgeVariant = 'warning' %}
                                    {% set badgeIcon = 'ph:briefcase' %}
                                {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                                    {% set badgeVariant = 'secondary' %}
                                    {% set badgeIcon = 'ph:chalkboard-teacher' %}
                                {% elseif 'initiale' in regVal|lower %}
                                    {% set badgeVariant = 'primary' %}
                                    {% set badgeIcon = 'ph:student' %}
                                {% endif %}
                                <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                            {% endfor %}
                        </span>
                    </div>

                    {{ include('offre_v2/_annee_capacite_summary.html.twig', {
                        'annee': annee,
                        'parcours': parcours,
                        'formation': formation,
                        'campagne': campagne,
                        'comparaison': comparaison,
                        'plateformes': plateformes
                    }) }}
                </summary>

                {% if isTroncCommun %}
                    <div class="mt-3 flex items-center gap-2 rounded-lg bg-primary-100/70 px-3 py-1.5 text-xs text-primary-900 border border-primary-200 dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                        <twig:UX:Icon name="ph:info-bold" class="h-4 w-4 text-primary-600 shrink-0 dark:text-primary-400" />
                        <span><strong>Année en tronc commun :</strong> Les ouvertures, régimes, capacités et plateformes sont synchronisés sur l'ensemble des parcours.</span>
                    </div>
                {% endif %}

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Ouverture de l'année</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" data-tc-field="isOuvert" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Fermée</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Capacité globale d'accueil</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" data-tc-field="capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                    </div>
                </div>

                <!-- Régimes d'inscription (Chips compacts) -->
                <div class="mt-4 p-3.5 rounded-xl border border-secondary-200 bg-secondary-50/50 dark:border-secondary-700 dark:bg-secondary-900/30">
                    <input type="hidden" name="annee_{{ annee.id }}_regime_present" value="1">
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-2.5">
                        <span class="text-xs font-semibold text-secondary-700 dark:text-secondary-200">Régimes d'inscription proposés :</span>
                        <span class="text-[11px] text-secondary-500">Cochez les modalités applicables pour cette année</span>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        {% for regimeEnum in enum('App\\Enums\\RegimeInscriptionEnum').cases %}
                            {% set isChecked = annee.hasRegimeInscription(regimeEnum) %}
                            {% set regVal = regimeEnum.value %}
                            <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs cursor-pointer transition select-none
                                {{ isChecked 
                                    ? 'bg-primary-50 border-primary-300 text-primary-900 shadow-xs dark:bg-primary-900/50 dark:border-primary-600 dark:text-primary-200 font-semibold' 
                                    : 'bg-surface border-secondary-200 text-secondary-600 hover:bg-secondary-100/60 dark:bg-secondary-800 dark:border-secondary-700 dark:text-secondary-300 dark:hover:bg-secondary-700 font-medium' }}">
                                <input type="checkbox"
                                       name="annee_{{ annee.id }}_regimeInscription[]"
                                       value="{{ regVal }}"
                                       data-tc-field="regime_{{ regVal }}"
                                       {{ isChecked ? 'checked' : '' }}
                                       {{ not can_edit ? 'disabled' : '' }}
                                       class="h-3.5 w-3.5 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-900 cursor-pointer">
                                <span>{{ regVal }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                    <h5 class="text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-300">Plateformes et capacités</h5>

                    {% set anneePlateformes = plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                    {% if anneePlateformes is not empty %}
                        <div class="mt-3 space-y-4">
                            {% for plateforme in anneePlateformes %}
                                {% set pCode = plateforme.code|lower %}
                                {% set isCapaciteRequise = annee.ordre in (plateforme.anneesCapaciteRequise ?? []) %}
                                {% set isCapaciteSpecifique = annee.ordre in (plateforme.anneesCapaciteSpecifique ?? []) %}
                                {% set hasChamps = plateforme.hasDefinitionChamps ?? false %}

                                <div class="overflow-hidden rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface">
                                    <table class="w-full text-sm">
                                        <thead class="bg-secondary-50 text-left text-xs uppercase text-secondary-500 dark:bg-secondary-900/30">
                                        <tr>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.libelle')|trans|default(plateforme.libelle) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.active')|trans|default('Active') }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_globale')|trans|default(('plateforme.' ~ pCode ~ '.globale')|trans|default('Globale')) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_classique')|trans|default(('plateforme.' ~ pCode ~ '.classique')|trans|default('Classique')) }}</th>
                                            <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_alternance')|trans|default(('plateforme.' ~ pCode ~ '.alternance')|trans|default('Alternance')) }}</th>
                                            {% if isCapaciteSpecifique %}
                                                <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.capacite_specifique')|trans|default(('plateforme.' ~ pCode ~ '.specifique')|trans|default('Spécifique')) }}</th>
                                            {% endif %}
                                            {% if hasChamps %}
                                                <th class="px-4 py-3">{{ ('plateforme.' ~ pCode ~ '.champs_specifiques')|trans|default('Champs spécifiques') }}</th>
                                            {% endif %}
                                            <th class="px-4 py-3">Validité</th>
                                        </tr>
                                        </thead>
                                        <tbody class="divide-y">
                                        <tr>
                                            <td class="px-4 py-3 font-medium">
                                                <div class="flex items-center gap-2 flex-wrap">
                                                    {% if plateforme.color %}
                                                        <span class="inline-flex items-center gap-2">
                                                            <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                            {{ plateforme.libelle }}
                                                        </span>
                                                    {% else %}
                                                        <span>{{ plateforme.libelle }}</span>
                                                    {% endif %}
                                                    {% if isCapaciteRequise %}
                                                        <span class="inline-flex items-center rounded-md bg-warning-50 px-1.5 py-0.5 text-[10px] font-semibold text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700" title="Capacité obligatoire pour cette année">
                                                            Capacité requise
                                                        </span>
                                                    {% else %}
                                                        <span class="inline-flex items-center rounded-md bg-secondary-100 px-1.5 py-0.5 text-[10px] font-medium text-secondary-500 ring-1 ring-inset ring-secondary-500/10 dark:bg-secondary-900/30 dark:ring-secondary-700" title="Capacité optionnelle pour cette année">
                                                            Optionnelle
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <input type="checkbox"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_active"
                                                       checked>
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value=""
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_globale"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value=""
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_classique"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                            </td>
                                            <td class="px-4 py-3">
                                                <input value="0"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_alternance"
                                                       class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                       type="number"
                                                       min="0">
                                            </td>
                                            {% if isCapaciteSpecifique %}
                                                <td class="px-4 py-3">
                                                    <input value="0"
                                                           name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                           data-tc-field="plateforme_{{ plateforme.id }}_specifique"
                                                           class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                           type="number"
                                                           min="0">
                                                </td>
                                            {% endif %}
                                            {% if hasChamps %}
                                                <td class="px-4 py-3">
                                                    <button type="button"
                                                            class="rounded bg-primary-100 px-2 py-1 text-xs text-primary-700 hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-300 dark:hover:border-primary-300 dark:hover:text-primary-100"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                </td>
                                            {% endif %}
                                            <td class="px-4 py-3">
                                                <span class="rounded-full bg-secondary-100 px-2 py-1 text-xs text-secondary-700 dark:bg-secondary-900/30 dark:text-secondary-300">À valider</span>
                                            </td>
                                        </tr>
                                        <tr class="bg-secondary-50/40 dark:bg-secondary-900/30">
                                            <td class="px-4 py-2.5 border-b border-secondary-200/60 dark:border-secondary-700" colspan="{{ 6 + (isCapaciteSpecifique ? 1 : 0) + (hasChamps ? 1 : 0) }}">
                                                <div class="space-y-1">
                                                    <div class="flex justify-between items-center mb-1">
                                                        <label for="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                               class="text-[12px] font-black text-secondary-500 uppercase">
                                                            {{ ('plateforme.' ~ pCode ~ '.remarques')|trans|default('Remarques / Précisions (' ~ plateforme.libelle ~ ')') }}
                                                        </label>
                                                    </div>
                                                    <input id="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           value=""
                                                           name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           data-tc-field="plateforme_{{ plateforme.id }}_remarques"
                                                           placeholder="Ex. : Sous réserve de validation, alternance uniquement, etc."
                                                           class="w-full p-2 bg-surface text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-primary-50 focus:border-primary-500 outline-none transition-all shadow-sm placeholder:text-secondary-400 text-xs dark:border-secondary-600 dark:text-secondary-100"
                                                           type="text">
                                                    <p class="text-[11px] text-secondary-400 italic mt-1 pl-1 flex items-start gap-2">
                                                        <span class="flex-shrink-0 w-4 h-4 bg-secondary-200 dark:bg-secondary-700 text-secondary-500 flex items-center justify-center text-[10px] rounded-full">
                                                            <twig:UX:Icon name="icon:info"/>
                                                        </span>
                                                        <span>Cette remarque sera reprise dans les exports Excel (annexes CA) pour cette plateforme et cette année.</span>
                                                    </p>
                                                </div>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="mt-3 rounded-xl border border-dashed border-secondary-200 bg-secondary-50 p-4 text-center text-sm text-secondary-500 dark:bg-secondary-900/30 dark:border-secondary-700">
                            Aucune plateforme d'admission n'est configurée pour ce type de diplôme.
                            <br>
                            <a href="{{ path('app_type_diplome_edit', {id: formation.typeDiplome.id}) }}"
                               class="mt-2 inline-block text-primary-600 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300">
                                Configurer les plateformes →
                            </a>
                        </div>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% endif %}
    {% else %}
        <!-- Année fermée -->
        <details class="group rounded-xl border {{ isTroncCommun ? 'border-primary-300 bg-primary-50/20 dark:bg-primary-900/20 dark:border-primary-700' : 'bg-secondary-50 dark:bg-secondary-900/30 border-secondary-200 dark:border-secondary-700' }} p-4 opacity-80 transition-all">
            <summary class="cursor-pointer list-none select-none flex items-center justify-between gap-3 flex-wrap">
                <div class="inline-flex items-center gap-2.5 flex-wrap">
                    <span class="inline-flex items-center justify-center h-5 w-5 rounded-md bg-secondary-100 text-secondary-500 group-open:rotate-90 transition-transform dark:bg-secondary-800 dark:text-secondary-400">
                        <twig:UX:Icon name="icon:chevron-right" class="h-3.5 w-3.5" />
                    </span>
                    <span class="font-bold text-secondary-700 dark:text-secondary-100 text-base">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                    {% if isTroncCommun %}
                        <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 border border-primary-200 shadow-xs dark:bg-primary-900/40 dark:text-primary-300 dark:border-primary-700">
                            <twig:UX:Icon name="ph:users-three-bold" class="h-3.5 w-3.5" />
                            Tronc commun
                        </span>
                    {% endif %}
                    <twig:Badge variant="danger" label="Fermée"/>
                    <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                        {% for reg in annee.regimeInscription %}
                            {% set regVal = reg.value|default(reg) %}
                            {% set badgeVariant = 'info' %}
                            {% set badgeIcon = 'ph:graduation-cap' %}
                            {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                                {% set badgeVariant = 'warning' %}
                                {% set badgeIcon = 'ph:briefcase' %}
                            {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                                {% set badgeVariant = 'secondary' %}
                                {% set badgeIcon = 'ph:chalkboard-teacher' %}
                            {% elseif 'initiale' in regVal|lower %}
                                {% set badgeVariant = 'primary' %}
                                {% set badgeIcon = 'ph:student' %}
                            {% endif %}
                            <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                        {% endfor %}
                    </span>
                </div>

                <div class="inline-flex items-center gap-2 text-xs text-secondary-500">
                    <span class="italic">Année fermée (0 place)</span>
                </div>
            </summary>

            <div class="mt-4 rounded-xl border border-dashed border-secondary-200 bg-surface p-4 text-sm text-secondary-500 dark:border-secondary-700">
                Les plateformes et capacités sont désactivées tant que cette année est fermée.
                <input type="hidden" name="annee_{{ annee.id }}_isOuvert" value="0">
                {% if can_edit %}
                    {% if parcours.isOuvert() %}
                        <button type="button"
                                class="mt-2 inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-2 text-xs font-semibold text-white hover:bg-primary-700 cursor-pointer shadow-xs transition"
                                data-action="click->autosave-capacites#ouvrirAnnee"
                                data-autosave-capacites-annee-param="{{ annee.id }}"
                        >
                            Ouvrir l'année
                        </button>
                    {% else %}
                        <p class="mt-1 text-xs text-warning-600 dark:text-warning-400">Le parcours doit être ouvert pour pouvoir ouvrir cette année.</p>
                    {% endif %}
                {% endif %}
            </div>
        </details>
    {% endif %}
</div>
