<div id="annee_{{ annee.id }}_container">
    {% set can_edit = is_granted('ROLE_ADMIN') or (campagne and campagne.isPeriodActive()) %}
    {% if annee.isOuvert %}
        {% if comparaison[parcours.id] is defined and comparaison[parcours.id][annee.ordre] is defined %}
            {% set anneeCourante = comparaison[parcours.id][annee.ordre].anneeCourante %}
            {% set anneeComparaison = comparaison[parcours.id][annee.ordre] %}
            <!-- Année {{ anneeComparaison.numeroAnnee }} -->
            <details open class="rounded-xl border border-indigo-200 bg-indigo-50/30 p-4">
                <summary class="cursor-pointer">
                    <div class="inline-flex items-center gap-2">
                        <span class="font-semibold">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        <span class="rounded-full bg-indigo-100 px-2 py-1 text-xs text-indigo-700">
                            Année commune
                        </span>
                        <twig:Badge variant="success" label="Ouverte"/>
                    </div>
                </summary>

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-sm font-medium">Ouverture</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 text-sm">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Fermée</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-slate-500">
                                Année précédente : <span
                                        class="font-medium">{{ anneeComparaison.anneePrecedente.isOuvert ? 'Ouverte' : 'Fermée' }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-sm font-medium">Capacité globale</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 text-sm">
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-slate-500">
                                Année précédente : <span
                                        class="font-medium">{{ anneeComparaison.anneePrecedente.capaciteAccueil }}</span>
                                {% set diff = annee.capaciteAccueil - anneeComparaison.anneePrecedente.capaciteAccueil %}
                                {% if diff != 0 %}
                                    <span class="ml-1 {% if diff > 0 %}text-green-600{% else %}text-red-600{% endif %}">
                                        ({{ diff > 0 ? '+' : '' }}{{ diff }})
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-4 rounded-xl border bg-white p-4">
                    <h5 class="font-semibold">Plateformes et capacités</h5>

                    {% if plateformes is not empty %}
                        <div class="mt-3 overflow-hidden rounded-xl border">
                            <table class="w-full text-sm">
                                <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
                                <tr>
                                    <th class="px-4 py-3">Plateforme</th>
                                    <th class="px-4 py-3">Active</th>
                                    <th class="px-4 py-3">Globale</th>
                                    <th class="px-4 py-3">Classique</th>
                                    <th class="px-4 py-3">Alternance</th>
                                    <th class="px-4 py-3">Spécifique</th>
                                    {% if plateformes|filter(p => p.definitionChamps is not empty)|length > 0 %}
                                        <th class="px-4 py-3">Champs spécifiques</th>
                                    {% endif %}
                                    <th class="px-4 py-3">Validité</th>
                                </tr>
                                </thead>
                                <tbody class="divide-y">
                                {% for plateforme in plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                                    {% set plateformeCourante = anneeCourante.plateformes|filter(p => p.code == plateforme.code)|first %}
                                    {% set plateformePrecedente = anneeComparaison.anneePrecedente ? anneeComparaison.anneePrecedente.plateformes|filter(p => p.code == plateforme.code)|first : null %}
                                    <tr>
                                        <td class="px-4 py-3 font-medium">
                                            {% if plateforme.color %}
                                                <span class="inline-flex items-center gap-2">
                                                    <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                    {{ plateforme.libelle }}
                                                </span>
                                            {% else %}
                                                {{ plateforme.libelle }}
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="checkbox"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                   {% if plateformeCourante and plateformeCourante.parametre.active %}checked{% endif %}>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteGlobale : '' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-slate-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteGlobale ?? '-') : '-' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteFi : '' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-slate-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteFi ?? '-') : '-' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? (plateformeCourante.parametre.capaciteAlternance ?? '0') : '0' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-slate-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteAlternance ?? '0') : '0' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? (plateformeCourante.parametre.capaciteSpecifique ?? '0') : '0' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-slate-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteSpecifique ?? '0') : '0' }}</div>
                                        </td>
                                        {% if plateformes|filter(p => p.definitionChamps is not empty)|length > 0 %}
                                            <td class="px-4 py-3">
                                                {% if plateforme.definitionChamps is not empty %}
                                                    <button type="button"
                                                            class="rounded bg-indigo-100 px-2 py-1 text-xs text-indigo-700 hover:bg-indigo-200"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                {% else %}
                                                    <span class="text-slate-400">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        <td class="px-4 py-3">
                                            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700">À valider</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="mt-3 text-sm text-slate-500">Aucune plateforme d'admission n'est
                            configurée pour ce type de diplôme.</p>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% else %}
            <!-- Année ouverte -->
            <details open class="rounded-xl border border-indigo-200 bg-indigo-50/30 p-4">
                <summary class="cursor-pointer">
                    <div class="inline-flex items-center gap-2">
                        <span class="font-semibold">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        <span class="rounded-full bg-indigo-100 px-2 py-1 text-xs text-indigo-700">
                            Année commune
                        </span>
                        <twig:Badge variant="success" label="Ouverte"/>
                    </div>
                </summary>

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-sm font-medium">Ouverture</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 text-sm">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Fermée</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-sm font-medium">Capacité globale</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 text-sm">
                    </div>
                </div>

                <div class="mt-4 rounded-xl border bg-white p-4">
                    <h5 class="font-semibold">Plateformes et capacités</h5>

                    {% if plateformes is not empty %}
                        <div class="mt-3 overflow-hidden rounded-xl border">
                            <table class="w-full text-sm">
                                <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
                                <tr>
                                    <th class="px-4 py-3">Plateforme</th>
                                    <th class="px-4 py-3">Active</th>
                                    <th class="px-4 py-3">Globale</th>
                                    <th class="px-4 py-3">Classique</th>
                                    <th class="px-4 py-3">Alternance</th>
                                    <th class="px-4 py-3">Spécifique</th>
                                    {% if plateformes|filter(p => p.definitionChamps is not empty)|length > 0 %}
                                        <th class="px-4 py-3">Champs spécifiques</th>
                                    {% endif %}
                                    <th class="px-4 py-3">Validité</th>
                                </tr>
                                </thead>
                                <tbody class="divide-y">
                                {% for plateforme in plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                                    <tr>
                                        <td class="px-4 py-3 font-medium">
                                            {% if plateforme.color %}
                                                <span class="inline-flex items-center gap-2">
                                                    <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                    {{ plateforme.libelle }}
                                                </span>
                                            {% else %}
                                                {{ plateforme.libelle }}
                                            {% endif %}
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="checkbox"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                   checked>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value=""
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value=""
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="0"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="0"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                   class="w-20 rounded border px-2 py-1"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        {% if plateformes|filter(p => p.definitionChamps is not empty)|length > 0 %}
                                            <td class="px-4 py-3">
                                                {% if plateforme.definitionChamps is not empty %}
                                                    <button type="button"
                                                            class="rounded bg-indigo-100 px-2 py-1 text-xs text-indigo-700 hover:bg-indigo-200"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                {% else %}
                                                    <span class="text-slate-400">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        <td class="px-4 py-3">
                                            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700">À valider</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="mt-3 rounded-xl border border-dashed bg-slate-50 p-4 text-center text-sm text-slate-500">
                            Aucune plateforme d'admission n'est configurée pour ce type de diplôme.
                            <br>
                            <a href="{{ path('app_type_diplome_edit', {id: formation.typeDiplome.id}) }}"
                               class="mt-2 inline-block text-indigo-600 hover:text-indigo-800">
                                Configurer les plateformes →
                            </a>
                        </div>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% endif %}
    {% else %}
        <details class="rounded-xl border bg-slate-50 p-4 opacity-80">
            <summary class="cursor-pointer">
                <div class="inline-flex items-center gap-2">
                    <span class="font-semibold">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                    <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700">
                        Année propre au parcours
                    </span>
                    <twig:Badge variant="danger" label="Fermée"/>
                </div>
            </summary>

            <div class="mt-4 rounded-xl border border-dashed bg-white p-4 text-sm text-slate-500">
                Les plateformes et capacités sont désactivées tant que cette année est fermée.
                <input type="hidden" name="annee_{{ annee.id }}_isOuvert" value="0">
                {% if can_edit %}
                    {% if parcours.isOuvert() %}
                        <button type="button"
                                class="mt-2 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white hover:bg-indigo-700 cursor-pointer"
                                data-action="click->autosave-capacites#ouvrirAnnee"
                                data-autosave-capacites-annee-param="{{ annee.id }}"
                        >
                            Ouvrir l'année
                        </button>
                    {% else %}
                        Le parcours est fermé
                    {% endif %}
                {% endif %}
            </div>
        </details>
    {% endif %}
</div>
