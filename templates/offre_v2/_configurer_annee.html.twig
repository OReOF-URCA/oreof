{# can_edit vient de la page (configurer.html.twig) ; repli pour les flux Turbo qui ne le transmettent pas #}
{% set can_edit = can_edit is defined ? can_edit : (is_granted('ROLE_SES') or (campagne and campagne.isPeriodActive())) %}
{% set forma = formation|default(parcours.formation) %}
{% set isTroncCommun = forma ? forma.isAnneeTroncCommun(annee.ordre) : false %}
<div id="annee_{{ annee.id }}_container" data-annee-ordre="{{ annee.ordre }}" data-is-tronc-commun="{{ isTroncCommun ? '1' : '0' }}">
    {% if annee.isOuvert %}
        {% if comparaison[parcours.id] is defined and comparaison[parcours.id][annee.ordre] is defined %}
            {% set anneeCourante = comparaison[parcours.id][annee.ordre].anneeCourante %}
            {% set anneeComparaison = comparaison[parcours.id][annee.ordre] %}
            <!-- Année {{ anneeComparaison.numeroAnnee }} -->
            <details open class="rounded-xl border {{ isTroncCommun ? 'border-primary-400 bg-primary-50/40 shadow-xs ring-1 ring-primary-200 dark:bg-primary-900/30 dark:ring-primary-700' : 'border-secondary-200 bg-secondary-50/30 dark:bg-secondary-900/30 dark:border-secondary-700' }} p-4 transition-all">
                <summary class="cursor-pointer">
                    <div class="inline-flex items-center gap-2 flex-wrap">
                        <span class="font-bold text-secondary-900 dark:text-secondary-100">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        {% if isTroncCommun %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 border border-primary-200 shadow-xs dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                                <twig:UX:Icon name="ph:users-three-bold" class="h-3.5 w-3.5" />
                                Tronc commun
                            </span>
                        {% endif %}
                        <twig:Badge variant="success" label="Ouverte"/>
                        <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                            {% for reg in annee.regimeInscription %}
                                {% set regVal = reg.value|default(reg) %}
                                {% set badgeVariant = 'info' %}
                                {% set badgeIcon = 'ph:graduation-cap' %}
                                {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                                    {% set badgeVariant = 'warning' %}
                                    {% set badgeIcon = 'ph:briefcase' %}
                                {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                                    {% set badgeVariant = 'secondary' %}
                                    {% set badgeIcon = 'ph:chalkboard-teacher' %}
                                {% elseif 'initiale' in regVal|lower %}
                                    {% set badgeVariant = 'primary' %}
                                    {% set badgeIcon = 'ph:student' %}
                                {% endif %}
                                <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                            {% endfor %}
                        </span>
                    </div>
                </summary>

                {% if isTroncCommun %}
                    <div class="mt-3 flex items-center gap-2 rounded-lg bg-primary-100/70 px-3 py-1.5 text-xs text-primary-900 border border-primary-200 dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                        <twig:UX:Icon name="ph:info-bold" class="h-4 w-4 text-primary-600 shrink-0 dark:text-primary-400" />
                        <span><strong>Année en tronc commun :</strong> Les ouvertures, capacités et plateformes sont synchronisées sur l'ensemble des parcours.</span>
                    </div>
                {% endif %}

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-sm font-medium">Ouverture</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" data-tc-field="isOuvert" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Non</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-secondary-500">
                                Année précédente : <span
                                        class="font-medium">{{ anneeComparaison.anneePrecedente.isOuvert ? 'Ouverte' : 'Fermée' }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-sm font-medium">Capacité globale</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" data-tc-field="capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                        {% if anneeComparaison.anneePrecedente %}
                            <div class="mt-1 text-xs text-secondary-500">
                                Année précédente : <span
                                        class="font-medium">{{ anneeComparaison.anneePrecedente.capaciteAccueil }}</span>
                                {% set diff = annee.capaciteAccueil - anneeComparaison.anneePrecedente.capaciteAccueil %}
                                {% if diff != 0 %}
                                    <span class="ml-1 {% if diff > 0 %}text-success-600 dark:text-success-400{% else %}text-danger-600 dark:text-danger-400{% endif %}">
                                        ({{ diff > 0 ? '+' : '' }}{{ diff }})
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Régimes d'inscription -->
                <div class="mt-4 rounded-xl border border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                    <input type="hidden" name="annee_{{ annee.id }}_regime_present" value="1">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <h5 class="font-semibold text-text">Régimes d'inscription</h5>
                            <p class="text-xs text-secondary-500 mt-0.5">Modalités d'inscription proposées pour cette année.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
                        {% for regimeEnum in enum('App\\Enums\\RegimeInscriptionEnum').cases %}
                            {% set isChecked = annee.hasRegimeInscription(regimeEnum) %}
                            <label class="flex items-center gap-2.5 p-2.5 rounded-lg border border-secondary-200 bg-secondary-50/50 hover:bg-secondary-100/70 dark:border-secondary-700 dark:bg-secondary-900/40 dark:hover:bg-secondary-800 transition cursor-pointer text-xs select-none">
                                <input type="checkbox"
                                       name="annee_{{ annee.id }}_regimeInscription[]"
                                       value="{{ regimeEnum.value }}"
                                       data-tc-field="regime_{{ regimeEnum.name }}"
                                       {{ isChecked ? 'checked' : '' }}
                                       {{ not can_edit ? 'disabled' : '' }}
                                       class="h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500 dark:border-secondary-600 dark:bg-secondary-900 cursor-pointer"
                                >
                                <span class="font-medium text-secondary-800 dark:text-secondary-200">
                                    {{ regimeEnum.value }}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                    <h5 class="font-semibold">Plateformes et capacités</h5>

                    {% if plateformes is not empty %}
                        <div class="mt-3 overflow-hidden rounded-xl border border-secondary-200 dark:border-secondary-700">
                            <table class="w-full text-sm">
                                <thead class="bg-secondary-50 text-left text-xs uppercase text-secondary-500 dark:bg-secondary-900/30">
                                <tr>
                                    <th class="px-4 py-3">Plateforme</th>
                                    <th class="px-4 py-3">Active</th>
                                    <th class="px-4 py-3">Globale</th>
                                    <th class="px-4 py-3">Classique</th>
                                    <th class="px-4 py-3">Alternance</th>
                                    <th class="px-4 py-3">Spécifique</th>
                                    {% if plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 %}
                                        <th class="px-4 py-3">Champs spécifiques</th>
                                    {% endif %}
                                </tr>
                                </thead>
                                <tbody class="divide-y">
                                {% for plateforme in plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                                    {% set plateformeCourante = anneeCourante.plateformes|filter(p => p.code == plateforme.code)|first %}
                                    {% set plateformePrecedente = anneeComparaison.anneePrecedente ? anneeComparaison.anneePrecedente.plateformes|filter(p => p.code == plateforme.code)|first : null %}
                                    {% set isCapaciteRequise = annee.ordre in (plateforme.anneesCapaciteRequise ?? []) %}
                                    <tr>
                                        <td class="px-4 py-3 font-medium">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                {% if plateforme.color %}
                                                    <span class="inline-flex items-center gap-2">
                                                        <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                        {{ plateforme.libelle }}
                                                    </span>
                                                {% else %}
                                                    <span>{{ plateforme.libelle }}</span>
                                                {% endif %}
                                                {% if isCapaciteRequise %}
                                                    <span class="inline-flex items-center rounded-md bg-warning-50 px-1.5 py-0.5 text-[10px] font-semibold text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700" title="Capacité obligatoire pour cette année">
                                                        Capacité requise
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center rounded-md bg-secondary-100 px-1.5 py-0.5 text-[10px] font-medium text-secondary-500 ring-1 ring-inset ring-secondary-500/10 dark:bg-secondary-900/30 dark:ring-secondary-700" title="Capacité optionnelle pour cette année">
                                                        Optionnelle
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="checkbox"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_active"
                                                   {% if plateformeCourante and plateformeCourante.parametre.active %}checked{% endif %}>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteGlobale : '' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_globale"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-secondary-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteGlobale ?? '-') : '-' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? plateformeCourante.parametre.capaciteFi : '' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_classique"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-secondary-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteFi ?? '-') : '-' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? (plateformeCourante.parametre.capaciteAlternance ?? '0') : '0' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_alternance"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-secondary-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteAlternance ?? '0') : '0' }}</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="{{ plateformeCourante ? (plateformeCourante.parametre.capaciteSpecifique ?? '0') : '0' }}"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_specifique"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                            <div class="text-xs text-secondary-400">Préc: {{ plateformePrecedente ? (plateformePrecedente.parametre.capaciteSpecifique ?? '0') : '0' }}</div>
                                        </td>
                                        {% if plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 %}
                                            <td class="px-4 py-3">
                                                {% if plateforme.hasDefinitionChamps ?? false %}
                                                    <button type="button"
                                                            class="rounded bg-primary-100 px-2 py-1 text-xs text-primary-700 hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-300 dark:hover:border-primary-300 dark:hover:text-primary-100"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                {% else %}
                                                    <span class="text-secondary-400">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}

                                    </tr>
                                    <tr class="bg-secondary-50/40 dark:bg-secondary-900/30">
                                        <td class="px-4 py-2.5 border-b border-secondary-200/60 dark:border-secondary-700" colspan="{{ plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 ? 7 : 6 }}">
                                            <div class="space-y-1">
                                                <div class="flex justify-between items-center mb-1">
                                                    <label for="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           class="text-[12px] font-black text-secondary-500 uppercase">
                                                        Remarques / Précisions ({{ plateforme.libelle }})
                                                    </label>
                                                </div>
                                                <input id="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                       value="{{ plateformeCourante ? (plateformeCourante.parametre.remarques ?? '') : '' }}"
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_remarques"
                                                       placeholder="Ex. : Sous réserve de validation, alternance uniquement, etc."
                                                       class="w-full p-2 bg-surface text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-primary-50 focus:border-primary-500 outline-none transition-all shadow-sm placeholder:text-secondary-400 text-xs dark:border-secondary-600 dark:text-secondary-100"
                                                       type="text">
                                                <p class="text-[11px] text-secondary-400 italic mt-1 pl-1 flex items-start gap-2">
                                                    <span class="flex-shrink-0 w-4 h-4 bg-secondary-200 dark:bg-secondary-700 text-secondary-500 flex items-center justify-center text-[10px] rounded-full">
                                                        <twig:UX:Icon name="icon:info"/>
                                                    </span>
                                                    <span>Cette remarque sera reprise dans les exports Excel (annexes CA) pour cette plateforme et cette année.</span>
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="mt-3 text-sm text-secondary-500">Aucune plateforme d'admission n'est
                            configurée pour ce type de diplôme.</p>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% else %}
            <!-- Année ouverte -->
            <details open class="rounded-xl border border-primary-200 bg-primary-50/30 p-4 dark:bg-primary-900/30 dark:border-primary-700">
                <summary class="cursor-pointer">
                    <div class="inline-flex items-center gap-2">
                        <span class="font-semibold">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                        <span class="rounded-full bg-primary-100 px-2 py-1 text-xs text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
                            Année commune
                        </span>
                        <twig:Badge variant="success" label="Ouverte"/>
                    </div>
                </summary>

                <fieldset {{ not can_edit ? 'disabled' : '' }} class="contents">

                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div>
                        <label for="annee_{{ annee.id }}_isOuvert" class="text-sm font-medium">Ouverture</label>
                        <select id="annee_{{ annee.id }}_isOuvert" name="annee_{{ annee.id }}_isOuvert" data-tc-field="isOuvert" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                            <option value="1" {% if annee.isOuvert %}selected{% endif %}>Ouverte</option>
                            <option value="0" {% if not annee.isOuvert %}selected{% endif %}>Fermée</option>
                            <option value="to_confirm">À confirmer</option>
                        </select>
                    </div>

                    <div>
                        <label for="annee_{{ annee.id }}_capaciteAccueil" class="text-sm font-medium">Capacité globale</label>
                        <input id="annee_{{ annee.id }}_capaciteAccueil" name="annee_{{ annee.id }}_capaciteAccueil" data-tc-field="capaciteAccueil" value="{{ annee.capaciteAccueil }}"
                               type="number" min="0" class="mt-1 w-full rounded-lg border bg-surface px-3 py-2 text-sm text-text dark:border-secondary-600">
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                    <h5 class="font-semibold">Plateformes et capacités</h5>

                    {% if plateformes is not empty %}
                        <div class="mt-3 overflow-hidden rounded-xl border border-secondary-200 dark:border-secondary-700">
                            <table class="w-full text-sm">
                                <thead class="bg-secondary-50 text-left text-xs uppercase text-secondary-500 dark:bg-secondary-900/30">
                                <tr>
                                    <th class="px-4 py-3">Plateforme</th>
                                    <th class="px-4 py-3">Active</th>
                                    <th class="px-4 py-3">Globale</th>
                                    <th class="px-4 py-3">Classique</th>
                                    <th class="px-4 py-3">Alternance</th>
                                    <th class="px-4 py-3">Spécifique</th>
                                    {% if plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 %}
                                        <th class="px-4 py-3">Champs spécifiques</th>
                                    {% endif %}
                                    <th class="px-4 py-3">Validité</th>
                                </tr>
                                </thead>
                                <tbody class="divide-y">
                                {% for plateforme in plateformes|filter(plateforme => annee.ordre in plateforme.annees) %}
                                    {% set isCapaciteRequise = annee.ordre in (plateforme.anneesCapaciteRequise ?? []) %}
                                    <tr>
                                        <td class="px-4 py-3 font-medium">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                {% if plateforme.color %}
                                                    <span class="inline-flex items-center gap-2">
                                                        <span class="h-2.5 w-2.5 rounded-full bg-{{ plateforme.color }}-500"></span>
                                                        {{ plateforme.libelle }}
                                                    </span>
                                                {% else %}
                                                    <span>{{ plateforme.libelle }}</span>
                                                {% endif %}
                                                {% if isCapaciteRequise %}
                                                    <span class="inline-flex items-center rounded-md bg-warning-50 px-1.5 py-0.5 text-[10px] font-semibold text-warning-800 ring-1 ring-inset ring-warning-600/20 dark:bg-warning-900/30 dark:text-warning-300 dark:ring-warning-700" title="Capacité obligatoire pour cette année">
                                                        Capacité requise
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center rounded-md bg-secondary-100 px-1.5 py-0.5 text-[10px] font-medium text-secondary-500 ring-1 ring-inset ring-secondary-500/10 dark:bg-secondary-900/30 dark:ring-secondary-700" title="Capacité optionnelle pour cette année">
                                                        Optionnelle
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input type="checkbox"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_active"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_active"
                                                   checked>
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value=""
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_globale"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_globale"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value=""
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_classique"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_classique"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="0"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_alternance"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_alternance"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        <td class="px-4 py-3">
                                            <input value="0"
                                                   name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_specifique"
                                                   data-tc-field="plateforme_{{ plateforme.id }}_specifique"
                                                   class="w-20 rounded border bg-surface text-text px-2 py-1 dark:border-secondary-600"
                                                   type="number"
                                                   min="0">
                                        </td>
                                        {% if plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 %}
                                            <td class="px-4 py-3">
                                                {% if plateforme.hasDefinitionChamps ?? false %}
                                                    <button type="button"
                                                            class="rounded bg-primary-100 px-2 py-1 text-xs text-primary-700 hover:bg-primary-200 dark:bg-primary-900 dark:text-primary-300 dark:hover:border-primary-300 dark:hover:text-primary-100"
                                                            onclick="alert('Modal champs spécifiques pour {{ plateforme.libelle }}')">
                                                        <i class="fas fa-edit"></i> Configurer
                                                    </button>
                                                {% else %}
                                                    <span class="text-secondary-400">-</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        <td class="px-4 py-3">
                                            <span class="rounded-full bg-secondary-100 px-2 py-1 text-xs text-secondary-700 dark:bg-secondary-900/30 dark:text-secondary-300">À valider</span>
                                        </td>
                                    </tr>
                                    <tr class="bg-secondary-50/40 dark:bg-secondary-900/30">
                                        <td class="px-4 py-2.5 border-b border-secondary-200/60 dark:border-secondary-700" colspan="{{ plateformes|filter(p => p.hasDefinitionChamps ?? false)|length > 0 ? 8 : 7 }}">
                                            <div class="space-y-1">
                                                <div class="flex justify-between items-center mb-1">
                                                    <label for="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                           class="text-[12px] font-black text-secondary-500 uppercase">
                                                        Remarques / Précisions ({{ plateforme.libelle }})
                                                    </label>
                                                </div>
                                                <input id="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                       value=""
                                                       name="annee_{{ annee.id }}_plateforme_{{ plateforme.id }}_remarques"
                                                       data-tc-field="plateforme_{{ plateforme.id }}_remarques"
                                                       placeholder="Ex. : Sous réserve de validation, alternance uniquement, etc."
                                                       class="w-full p-2 bg-surface text-secondary-800 border border-secondary-200 rounded-sm font-medium focus:ring-4 focus:ring-primary-50 focus:border-primary-500 outline-none transition-all shadow-sm placeholder:text-secondary-400 text-xs dark:border-secondary-600 dark:text-secondary-100"
                                                       type="text">
                                                <p class="text-[11px] text-secondary-400 italic mt-1 pl-1 flex items-start gap-2">
                                                    <span class="flex-shrink-0 w-4 h-4 bg-secondary-200 dark:bg-secondary-700 text-secondary-500 flex items-center justify-center text-[10px] rounded-full">
                                                        <twig:UX:Icon name="icon:info"/>
                                                    </span>
                                                    <span>Cette remarque sera reprise dans les exports Excel (annexes CA) pour cette plateforme et cette année.</span>
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="mt-3 rounded-xl border border-dashed border-secondary-200 bg-secondary-50 p-4 text-center text-sm text-secondary-500 dark:bg-secondary-900/30 dark:border-secondary-700">
                            Aucune plateforme d'admission n'est configurée pour ce type de diplôme.
                            <br>
                            <a href="{{ path('app_type_diplome_edit', {id: formation.typeDiplome.id}) }}"
                               class="mt-2 inline-block text-primary-600 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300">
                                Configurer les plateformes →
                            </a>
                        </div>
                    {% endif %}
                </div>
                </fieldset>
            </details>
        {% endif %}
    {% else %}
        <details class="rounded-xl border {{ isTroncCommun ? 'border-primary-300 bg-primary-50/20 dark:bg-primary-900/30 dark:border-primary-700' : 'bg-secondary-50 dark:bg-secondary-900/30 border-secondary-200 dark:border-secondary-700' }} p-4 opacity-80">
            <summary class="cursor-pointer">
                <div class="inline-flex items-center gap-2 flex-wrap">
                    <span class="font-semibold text-secondary-700 dark:text-secondary-100">{{ typeDiplome.libelleCourt }} {{ annee.ordre }}</span>
                    {% if isTroncCommun %}
                        <span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-semibold text-primary-800 border border-primary-200 shadow-xs dark:bg-primary-900/30 dark:text-primary-300 dark:border-primary-700">
                            <twig:UX:Icon name="ph:users-three-bold" class="h-3.5 w-3.5" />
                            Tronc commun
                        </span>
                    {% endif %}
                    <twig:Badge variant="danger" label="Fermée"/>
                    <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                        {% for reg in annee.regimeInscription %}
                            {% set regVal = reg.value|default(reg) %}
                            {% set badgeVariant = 'info' %}
                            {% set badgeIcon = 'ph:graduation-cap' %}
                            {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                                {% set badgeVariant = 'warning' %}
                                {% set badgeIcon = 'ph:briefcase' %}
                            {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                                {% set badgeVariant = 'secondary' %}
                                {% set badgeIcon = 'ph:chalkboard-teacher' %}
                            {% elseif 'initiale' in regVal|lower %}
                                {% set badgeVariant = 'primary' %}
                                {% set badgeIcon = 'ph:student' %}
                            {% endif %}
                            <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                        {% endfor %}
                    </span>
                </div>
            </summary>

            <div class="mt-4 rounded-xl border border-dashed border-secondary-200 bg-surface p-4 text-sm text-secondary-500 dark:border-secondary-700">
                Les plateformes et capacités sont désactivées tant que cette année est fermée.
                <input type="hidden" name="annee_{{ annee.id }}_isOuvert" value="0">
                {% if can_edit %}
                    {% if parcours.isOuvert() %}
                        <button type="button"
                                class="mt-2 inline-flex items-center gap-2 rounded-lg bg-primary-600 px-3 py-2 text-xs font-semibold text-white hover:bg-primary-700 cursor-pointer"
                                data-action="click->autosave-capacites#ouvrirAnnee"
                                data-autosave-capacites-annee-param="{{ annee.id }}"
                        >
                            Ouvrir l'année
                        </button>
                    {% else %}
                        Le parcours est fermé
                    {% endif %}
                {% endif %}
            </div>
        </details>
    {% endif %}
</div>
