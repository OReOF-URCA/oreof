<table data-xls-sheet="{{ (type_diplome ? 'eCandidat - ' ~ (type_diplome.libelleCourt|default(type_diplome.libelle)) : 'eCandidat')|slice(0, 31) }}">
    <thead>
        <tr>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Composante</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Type de Diplôme</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Mention</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Parcours</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Type de Parcours</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Lieu</th>

            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveau de formation</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Ouverture {{ annee_n_1 }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Intégration eCandidat {{ annee_n_1 }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Capacité eCandidat {{ annee_n_1 }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Ouverture {{ annee_n }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Intégration eCandidat {{ annee_n }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="right">Capacité {{ annee_n }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Remarques</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                <td data-xls-border="thin" data-xls-align="left">{{ row.composante }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.diplome }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.mention }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.parcours }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.type_parcours }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.lieu }}</td>
                <td data-xls-border="thin" data-xls-align="center" data-xls-type="number">{{ row.niveau }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.ouverture_n_1 }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.integration_ecandidat_n_1 }}</td>
                <td data-xls-border="thin" data-xls-align="right" data-xls-type="number">{{ row.capacite_n_1 }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.ouverture_n }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.integration_ecandidat_n }}</td>
                <td data-xls-border="thin" data-xls-align="right" data-xls-type="number">{{ row.capacite_n }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.remarques }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="14" data-xls-align="center">Aucune donnée disponible</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
