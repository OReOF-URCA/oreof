<table data-xls-sheet="{{ nom_onglet|default((type_diplome ? 'Parcoursup - ' ~ (type_diplome.libelleCourt|default(type_diplome.libelle)) : 'Parcoursup')|slice(0, 31)) }}" data-xls-autosize="true">
    <thead>
        {% include 'offre_v2/export/_header_annexe.html.twig' with {nb_cols: 14} %}
        <tr>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Composante</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Type de Diplôme</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveau</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Mention</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Parcours</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Régime d'inscription</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Lieu</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Année ouverte</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Plateforme proposée</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Statut</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Type recrutement</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="right">Capacité d'accueil {{ annee_n_1 }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="right">Capacité d'accueil {{ annee_n }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Remarques</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                <td data-xls-border="thin" data-xls-align="left">{{ row.composante }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.diplome }}</td>
                <td data-xls-border="thin" data-xls-align="center" data-xls-type="number">{{ row.niveau }}</td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.mention.isDifferent is defined and row.mention.isDifferent() %}
                        {% if row.mention.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.mention.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.mention.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.mention.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.mention }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.parcours.new is defined and row.parcours.new is not empty %}
                        {% if row.parcours.isDifferent is defined and row.parcours.isDifferent() %}
                            {% if row.parcours.original is not empty %}
                                <s data-xls-font-color="#DC2626">{{ row.parcours.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.parcours.new }}</b>
                            {% else %}
                                <b data-xls-font-color="#16A34A">{{ row.parcours.new }}</b>
                            {% endif %}
                        {% else %}
                            {{ row.parcours }}
                        {% endif %}
                    {% elseif row.parcours is not empty and row.parcours.new is not defined %}
                        {{ row.parcours }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.type_parcours.isDifferent is defined and row.type_parcours.isDifferent() %}
                        {% if row.type_parcours.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.type_parcours.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.type_parcours.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.type_parcours.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.type_parcours }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.lieu }}</td>
                <td data-xls-border="thin" data-xls-align="center">
                    {% if row.annee_ouverte.isDifferent is defined and row.annee_ouverte.isDifferent() %}
                        {% if row.annee_ouverte.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.annee_ouverte.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.annee_ouverte.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.annee_ouverte.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.annee_ouverte }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="center">
                    {% if row.plateforme_proposee.isDifferent is defined and row.plateforme_proposee.isDifferent() %}
                        {% if row.plateforme_proposee.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.plateforme_proposee.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.plateforme_proposee.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.plateforme_proposee.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.plateforme_proposee }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.statut }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.type_recrutement }}</td>
                <td data-xls-border="thin" data-xls-align="right" data-xls-type="number">{{ row.capacite_n_1 }}</td>
                <td data-xls-border="thin" data-xls-align="right" data-xls-type="number">{{ row.capacite_n }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.remarques }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13" data-xls-align="center">Aucune donnée disponible</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
