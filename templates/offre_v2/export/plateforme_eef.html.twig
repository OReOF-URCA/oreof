<table data-xls-sheet="{{ nom_onglet|default((type_diplome ? 'EeF - ' ~ (type_diplome.libelleCourt|default(type_diplome.libelle)) : 'Offre EEF')|slice(0, 31)) }}" data-xls-autosize="true">
    <thead>
        {% include 'offre_v2/export/_header_annexe.html.twig' with {nb_cols: 18} %}
        <tr>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Composante</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Type de Diplôme</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveau</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Mention</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Parcours</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Régime d'inscription</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Lieu</th>


            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Saisie</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">N°</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Etat compo.</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Mise à jour tarif</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Etat du PV</th>

            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveaux ouverts URCA {{ annee_universitaire }}</th>

            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Ouverture {{ annee_universitaire }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveaux ouverts EEF {{ annee_universitaire }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="right">Droits différenciés {{ annee_universitaire }}</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="center">Niveau de français requis</th>
            <th data-xls-bg-color="#1B365D" data-xls-font-color="#FFFFFF" data-xls-font-bold="true" data-xls-border="thin" data-xls-align="left">Remarques</th>
        </tr>
    </thead>
    <tbody>
        {% for row in rows %}
            <tr>
                <td data-xls-border="thin" data-xls-align="left">{{ row.composante }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.diplome }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.niveau }}</td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.mention.isDifferent is defined and row.mention.isDifferent() %}
                        {% if row.mention.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.mention.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.mention.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.mention.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.mention }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.parcours.new is defined and row.parcours.new is not empty %}
                        {% if row.parcours.isDifferent is defined and row.parcours.isDifferent() %}
                            {% if row.parcours.original is not empty %}
                                <s data-xls-font-color="#DC2626">{{ row.parcours.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.parcours.new }}</b>
                            {% else %}
                                <b data-xls-font-color="#16A34A">{{ row.parcours.new }}</b>
                            {% endif %}
                        {% else %}
                            {{ row.parcours }}
                        {% endif %}
                    {% elseif row.parcours is not empty and row.parcours.new is not defined %}
                        {{ row.parcours }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">
                    {% if row.type_parcours.isDifferent is defined and row.type_parcours.isDifferent() %}
                        {% if row.type_parcours.original is not empty %}
                            <s data-xls-font-color="#DC2626">{{ row.type_parcours.original }}</s><br/><b data-xls-font-color="#16A34A">{{ row.type_parcours.new }}</b>
                        {% else %}
                            <b data-xls-font-color="#16A34A">{{ row.type_parcours.new }}</b>
                        {% endif %}
                    {% else %}
                        {{ row.type_parcours }}
                    {% endif %}
                </td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.lieu }}</td>

                <td data-xls-border="thin" data-xls-align="center">{{ row.saisie }}</td>
                <td data-xls-border="thin" data-xls-align="center" data-xls-type="number">{{ row.numero }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.etat_compo }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.maj_tarif }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.etat_pv }}</td>

                <td data-xls-border="thin" data-xls-align="center">{{ row.niveaux_urca }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.ouverture }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.niveaux_eef }}</td>
                <td data-xls-border="thin" data-xls-align="right" data-xls-type="number">{{ row.droits_differencies }}</td>
                <td data-xls-border="thin" data-xls-align="center">{{ row.niveau_francais }}</td>
                <td data-xls-border="thin" data-xls-align="left">{{ row.remarques }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="17" data-xls-align="center">Aucune donnée disponible</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
