<div class="p-1">
    <div class="mb-5 rounded-xl border border-secondary-200 bg-secondary-50/50 p-3.5 dark:border-secondary-700 dark:bg-secondary-800/40 space-y-2">
        <div>
            <div class="text-xs font-semibold text-secondary-500 uppercase tracking-wider dark:text-secondary-400">Formation</div>
            <div class="font-semibold text-secondary-900 dark:text-secondary-100 text-sm">
                {{ formation.displayLong }}
            </div>
        </div>
        <div>
            <div class="text-xs font-semibold text-secondary-500 uppercase tracking-wider dark:text-secondary-400">Parcours</div>
            <div class="font-semibold text-secondary-900 dark:text-secondary-100 text-sm">
                {{ parcours.libelle }}
            </div>
        </div>
        {% if anneesExistantes is not empty %}
            <div>
                <div class="text-xs font-semibold text-secondary-500 uppercase tracking-wider dark:text-secondary-400">Années actuelles</div>
                <div class="mt-1 flex items-center gap-1.5 flex-wrap">
                    {% for ord in anneesExistantes %}
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-secondary-200 text-secondary-800 dark:bg-secondary-700 dark:text-secondary-200">
                            {{ typeDiplome ? typeDiplome.libelleCourt : 'Année' }} {{ ord }}
                        </span>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="text-xs text-secondary-500 dark:text-secondary-400 italic">
                Ce parcours ne dispose d'aucune année pour le moment.
            </div>
        {% endif %}
    </div>

    {% if ordresDisponibles is empty %}
        <div class="rounded-xl border border-secondary-200 bg-secondary-50/70 p-4 text-sm text-secondary-800 dark:border-secondary-700 dark:bg-secondary-800/40 dark:text-secondary-200">
            <div class="flex items-center gap-2 font-semibold">
                <twig:UX:Icon name="icon:check-circle" class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                <span>Toutes les années autorisées sont déjà créées</span>
            </div>
            <p class="mt-1.5 text-xs text-secondary-600 dark:text-secondary-400">
                Toutes les années prévues pour ce type de diplôme
                {% if typeDiplome %}({{ typeDiplome.libelleCourt }} {{ ordresPossibles|first }} à {{ ordresPossibles|last }}){% endif %}
                ont déjà été ajoutées à ce parcours. Aucune année supplémentaire ne peut être créée.
            </p>
        </div>
    {% else %}
        <form id="modal_form" action="{{ path('offre_v2_annee_modal_add_sauvegarder', {parcours: parcours.id}) }}" method="post" class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('annee_add_' ~ parcours.id) }}">

            <div>
                <label for="annee_ordre" class="block text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-300 mb-1.5">
                    Numéro / Ordre de l'année dans le parcours <span class="text-red-500">*</span>
                </label>

                <select name="ordre" id="annee_ordre" required class="w-full rounded-xl border border-secondary-300 bg-white px-3.5 py-2.5 text-sm font-medium text-secondary-900 shadow-sm transition focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 dark:border-secondary-600 dark:bg-secondary-900 dark:text-secondary-100">
                    {% for i in ordresPossibles %}
                        {% set isExisting = i in anneesExistantes %}
                        {% set isSelect = i in ordresDisponibles and i == ordresDisponibles|first %}
                        <option value="{{ i }}" {{ isExisting ? 'disabled' : '' }} {{ isSelect ? 'selected' : '' }}>
                            {{ typeDiplome ? typeDiplome.libelleCourt : 'Année' }} {{ i }} (Ordre {{ i }}){% if isExisting %} — Déjà présente{% endif %}
                        </option>
                    {% endfor %}
                </select>

                <p class="mt-2 text-xs text-secondary-500 dark:text-secondary-400">
                    Seules les années autorisées pour {{ typeDiplome ? typeDiplome.libelleCourt : 'ce diplôme' }} (semestres {{ parcours.semestreDebut }} à {{ parcours.semestreFin }}) peuvent être créées.
                </p>
            </div>
        </form>
    {% endif %}
</div>

