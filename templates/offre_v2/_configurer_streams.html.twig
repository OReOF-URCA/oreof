{% set typeDiplome = formation.typeDiplome %}
<turbo-stream action="replace" target="configurer_global_stats">
    <template>
        <div id="configurer_global_stats" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 mb-4">
            <twig:Kpi
                title="Parcours ouverts"
                value="{{ tabStatistiques.nbParcoursOuvert }}"
                total="{{ formation.parcours|length }}"
                variant="success"
                icon="icon:check-circle"
                help="Nombre de parcours de cette formation ouverts au recrutement."
            />

            <twig:Kpi
                title="Plateformes"
                value="{{ plateformes|length }}"
                unit="active{{ plateformes|length > 1 ? 's' : '' }}"
                variant="primary"
                icon="icon:globe"
                help="Plateformes d'admission actives configurées pour ce type de diplôme."
            />

            <twig:Kpi
                title="Capacité totale"
                value="{{ tabStatistiques.capacite }}"
                unit="places"
                variant="info"
                icon="icon:users"
                help="Somme des capacités d'accueil de la formation (ou somme des parcours ouverts)."
            />

            <twig:Kpi
                title="Anomalies"
                value="{{ anomalies|length }}"
                variant="{{ anomalies|length > 0 ? 'warning' : 'secondary' }}"
                icon="{{ anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
                help="Alertes de cohérence (capacités manquantes, paramétrages incomplets)."
            />
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_global_warnings">
    <template>
        <div id="configurer_global_warnings" class="mt-2 text-xs">
            {% if anomalies is empty %}
                <div class="rounded-lg bg-success-50 dark:bg-success-900/30 px-3 py-2 text-success-800 dark:text-success-300 flex items-center gap-2">
                    <span>✓</span>
                    <span>Les informations et capacités de la formation sont complètes. Aucune anomalie détectée.</span>
                </div>
            {% else %}
                <div class="rounded-lg bg-warning-50 dark:bg-warning-900/30 p-3 text-warning-900 dark:text-warning-200 border border-warning-200 dark:border-warning-700">
                    <div class="font-semibold flex items-center gap-1.5 mb-1 text-warning-800 dark:text-warning-300">
                        <span>⚠</span>
                        <span>{{ anomalies|length }} anomalie{{ anomalies|length > 1 ? 's' : '' }} détectée{{ anomalies|length > 1 ? 's' : '' }} :</span>
                    </div>
                    <ul class="list-disc list-inside space-y-0.5 text-warning-800 dark:text-warning-300 ml-1">
                        {% for anomaly in anomalies %}
                            <li>{{ anomaly.message }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_mutualisation_block">
    <template>
        {{ include('offre_v2/_configurer_mutualisation_block.html.twig', {
            formation: formation,
            typeDiplome: formation.typeDiplome,
            can_edit: true,
            portailsCampagne: portailsCampagne|default([]),
            formationsCampagneData: formationsCampagneData|default([]),
            formationsCampagneObjets: formationsCampagneObjets|default([]),
            active_tab: active_mutualisation_tab|default('troncs-communs')
        }) }}
    </template>
</turbo-stream>

{% for parcours in formation.parcours %}
    {% set statParcours = tabStatistiques['parcours'][parcours.id] %}
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_stats">
        <template>
            <div id="parcours_{{ parcours.id }}_stats" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                <twig:Kpi
                    title="Années ouvertes"
                    value="{{ statParcours.nbAnneesOuvertes }}"
                    total="{{ statParcours.nbAnnees }}"
                    variant="success"
                    icon="icon:check-circle"
                />

                <twig:Kpi
                    title="Plateformes"
                    value="{{ statParcours.nbPlateformesActives }}"
                    unit="active{{ statParcours.nbPlateformesActives > 1 ? 's' : '' }}"
                    variant="primary"
                    icon="icon:globe"
                />

                <twig:Kpi
                    title="Capacité totale"
                    value="{{ statParcours.capacite }}"
                    unit="places"
                    variant="info"
                    icon="icon:users"
                />

                <twig:Kpi
                    title="Anomalies"
                    value="{{ statParcours.anomalies|length }}"
                    variant="{{ statParcours.anomalies|length > 0 ? 'warning' : 'secondary' }}"
                    icon="{{ statParcours.anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
                />
            </div>
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_badge">
        <template>
            <span id="parcours_{{ parcours.id }}_badge" class="mr-2">
                {% set dpe = parcours.getDpeParcours()|filter(d => d.campagneCollecte == campagne)|first %}
                {% set categorieOuverture = dpe and dpe.etatReconduction ? dpe.etatReconduction.categorieOuverture.value : 'OUVERT' %}
                {% if categorieOuverture == 'FERMETURE_DEFINITIVE' %}
                    <twig:Badge variant="danger" label="Fermeture définitive" />
                {% elseif categorieOuverture == 'NON_OUVERTURE' %}
                    <twig:Badge variant="danger" label="Non ouvert" />
                {% else %}
                    <twig:Badge variant="success" label="Ouvert" />
                {% endif %}
            </span>
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="tab-parcours-{{ parcours.id }}-badges">
        <template>
            <span id="tab-parcours-{{ parcours.id }}-badges" class="inline-flex items-center gap-1.5">
                {{ include('offre_v2/_parcours_tab_badges.html.twig', {
                    parcours: parcours,
                    statP: statParcours,
                    campagne: campagne
                }) }}
            </span>
        </template>
    </turbo-stream>
{% endfor %}

{% for parcours in formation.parcours %}
    {% for annee in parcours.annees %}
        <turbo-stream action="replace" target="annee_{{ annee.id }}_regime_badges">
            <template>
                <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                    {% for reg in annee.regimeInscription %}
                        {% set regVal = reg.value|default(reg) %}
                        {% set badgeVariant = 'info' %}
                        {% set badgeIcon = 'ph:graduation-cap' %}
                        {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                            {% set badgeVariant = 'warning' %}
                            {% set badgeIcon = 'ph:briefcase' %}
                        {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                            {% set badgeVariant = 'secondary' %}
                            {% set badgeIcon = 'ph:chalkboard-teacher' %}
                        {% elseif 'initiale' in regVal|lower %}
                            {% set badgeVariant = 'primary' %}
                            {% set badgeIcon = 'ph:student' %}
                        {% endif %}
                        <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                    {% endfor %}
                </span>
            </template>
        </turbo-stream>
        <turbo-stream action="replace" target="annee_{{ annee.id }}_capacite_summary">
            <template>
                {{ include('offre_v2/_annee_capacite_summary.html.twig', {
                    'annee': annee,
                    'parcours': parcours,
                    'formation': formation,
                    'campagne': campagne,
                    'comparaison': comparaison,
                    'plateformes': plateformes
                }) }}
            </template>
        </turbo-stream>
    {% endfor %}
{% endfor %}

{% if changedYears is defined %}
    {% for anneeId, _ in changedYears %}
        {# Trouver l'année correspondante dans la formation/parcours #}
        {% set matchedAnnee = null %}
        {% set matchedParcours = null %}
        {% for p in formation.parcours %}
            {% for a in p.annees %}
                {% if a.id == anneeId %}
                    {% set matchedAnnee = a %}
                    {% set matchedParcours = p %}
                {% endif %}
            {% endfor %}
        {% endfor %}

        {% if matchedAnnee and matchedParcours %}
            <turbo-stream action="replace" target="annee_{{ matchedAnnee.id }}_container">
                <template>
                    {{ include('offre_v2/_configurer_annee.html.twig', {
                        'annee': matchedAnnee,
                        'parcours': matchedParcours,
                        'formation': formation,
                        'typeDiplome': typeDiplome,
                        'comparaison': comparaison,
                        'plateformes': plateformes,
                        'portailsCampagne': portailsCampagne|default([])
                    }) }}
                </template>
            </turbo-stream>
        {% endif %}
    {% endfor %}
{% endif %}
