{% set typeDiplome = formation.typeDiplome %}
<turbo-stream action="replace" target="configurer_global_stats">
    <template>
        <div id="configurer_global_stats" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 mb-4">
            <twig:Kpi
                title="Parcours ouverts"
                value="{{ tabStatistiques.nbParcoursOuvert }}"
                total="{{ formation.parcours|length }}"
                variant="success"
                icon="icon:check-circle"
            />

            <twig:Kpi
                title="Plateformes"
                value="{{ plateformes|length }}"
                unit="active{{ plateformes|length > 1 ? 's' : '' }}"
                variant="primary"
                icon="icon:globe"
            />

            <twig:Kpi
                title="Capacité totale"
                value="{{ tabStatistiques.capacite }}"
                unit="places"
                variant="info"
                icon="icon:users"
            />

            <twig:Kpi
                title="Anomalies"
                value="{{ anomalies|length }}"
                variant="{{ anomalies|length > 0 ? 'warning' : 'secondary' }}"
                icon="{{ anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
            />
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_global_warnings">
    <template>
        <div id="configurer_global_warnings" class="mt-4 space-y-3 text-sm">
            {% if anomalies is empty %}
                <div class="rounded-xl bg-success-50 dark:bg-success-900/30 p-3 text-success-800 dark:text-success-300">
                    ✓ Les informations et capacités de la formation sont complètes. Aucune anomalie détectée.
                </div>
            {% else %}
                {% for anomaly in anomalies %}
                    <div class="rounded-xl bg-warning-50 dark:bg-warning-900/30 p-3 text-warning-800 dark:text-warning-300 flex items-center gap-2">
                        <span>⚠</span>
                        <span>{{ anomaly.message }}</span>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_tronc_commun_block">
    <template>
        <div id="configurer_tronc_commun_block">
            <p class="text-xs text-secondary-600 dark:text-secondary-300 mb-3">
                Cochez les années communes à l'ensemble des parcours de cette mention / formation. Lorsqu'une année est déclarée en tronc commun, ses capacités d'accueil, régimes d'inscription et plateformes de recrutement sont automatiquement synchronisés entre les parcours.
            </p>
            <div class="flex items-center gap-2.5 flex-wrap">
                {% for anneeOrdre in formation.anneesOrdres %}
                    {% set isTc = formation.isAnneeTroncCommun(anneeOrdre) %}
                    <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border {{ isTc ? 'bg-primary-600 border-primary-600 text-white shadow-xs font-semibold' : 'bg-surface border-secondary-300 dark:border-secondary-700 text-secondary-700 dark:text-secondary-100 hover:bg-secondary-50 font-medium' }} transition-colors cursor-pointer text-xs select-none">
                        <input type="checkbox"
                               name="tronc_commun_annee_{{ anneeOrdre }}"
                               value="1"
                               {{ isTc ? 'checked' : '' }}
                               class="rounded text-primary-600 focus:ring-primary-500 dark:text-primary-400">
                        <span>{{ typeDiplome.libelleCourt|default('Année') }} {{ anneeOrdre }} (Tronc commun)</span>
                    </label>
                {% endfor %}
            </div>
        </div>
    </template>
</turbo-stream>

{% for parcours in formation.parcours %}
    {% set statParcours = tabStatistiques['parcours'][parcours.id] %}
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_stats">
        <template>
            <div id="parcours_{{ parcours.id }}_stats" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                <twig:Kpi
                    title="Années ouvertes"
                    value="{{ statParcours.nbAnneesOuvertes }}"
                    total="{{ statParcours.nbAnnees }}"
                    variant="success"
                    icon="icon:check-circle"
                />

                <twig:Kpi
                    title="Plateformes"
                    value="{{ statParcours.nbPlateformesActives }}"
                    unit="active{{ statParcours.nbPlateformesActives > 1 ? 's' : '' }}"
                    variant="primary"
                    icon="icon:globe"
                />

                <twig:Kpi
                    title="Capacité totale"
                    value="{{ statParcours.capacite }}"
                    unit="places"
                    variant="info"
                    icon="icon:users"
                />

                <twig:Kpi
                    title="Anomalies"
                    value="{{ statParcours.anomalies|length }}"
                    variant="{{ statParcours.anomalies|length > 0 ? 'warning' : 'secondary' }}"
                    icon="{{ statParcours.anomalies|length > 0 ? 'icon:warning' : 'icon:check-circle' }}"
                />
            </div>
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_badge">
        <template>
            <span id="parcours_{{ parcours.id }}_badge" class="mr-2">
                {% set dpe = parcours.getDpeParcours()|filter(d => d.campagneCollecte == campagne)|first %}
                {% set currentEtat = dpe ? dpe.getEtatReconduction().value : 'OUVERT' %}
                {% set isParcoursFerme = currentEtat == 'NON_OUVERTURE' or currentEtat == 'NON_OUVERTURE_SES' or currentEtat == 'NON_OUVERTURE_CFVU' or currentEtat == 'FERMETURE_DEFINITIVE' %}
                {% if currentEtat == 'FERMETURE_DEFINITIVE' %}
                    <twig:Badge variant="danger" label="Fermeture définitive" />
                {% elseif isParcoursFerme %}
                    <twig:Badge variant="danger" label="Non ouvert" />
                {% else %}
                    <twig:Badge variant="success" label="Ouvert" />
                {% endif %}
            </span>
        </template>
    </turbo-stream>
{% endfor %}

{% for parcours in formation.parcours %}
    {% for annee in parcours.annees %}
        <turbo-stream action="replace" target="annee_{{ annee.id }}_regime_badges">
            <template>
                <span id="annee_{{ annee.id }}_regime_badges" class="inline-flex items-center gap-1.5 flex-wrap">
                    {% for reg in annee.regimeInscription %}
                        {% set regVal = reg.value|default(reg) %}
                        {% set badgeVariant = 'info' %}
                        {% set badgeIcon = 'ph:graduation-cap' %}
                        {% if 'apprentissage' in regVal|lower or 'alternance' in regVal|lower %}
                            {% set badgeVariant = 'warning' %}
                            {% set badgeIcon = 'ph:briefcase' %}
                        {% elseif 'continue' in regVal|lower or 'contrat' in regVal|lower %}
                            {% set badgeVariant = 'secondary' %}
                            {% set badgeIcon = 'ph:chalkboard-teacher' %}
                        {% elseif 'initiale' in regVal|lower %}
                            {% set badgeVariant = 'primary' %}
                            {% set badgeIcon = 'ph:student' %}
                        {% endif %}
                        <twig:Badge :variant="badgeVariant" :label="regVal" :icon="badgeIcon" />
                    {% endfor %}
                </span>
            </template>
        </turbo-stream>
    {% endfor %}
{% endfor %}

{% if changedYears is defined %}
    {% for anneeId, _ in changedYears %}
        {# Trouver l'année correspondante dans la formation/parcours #}
        {% set matchedAnnee = null %}
        {% set matchedParcours = null %}
        {% for p in formation.parcours %}
            {% for a in p.annees %}
                {% if a.id == anneeId %}
                    {% set matchedAnnee = a %}
                    {% set matchedParcours = p %}
                {% endif %}
            {% endfor %}
        {% endfor %}

        {% if matchedAnnee and matchedParcours %}
            <turbo-stream action="replace" target="annee_{{ matchedAnnee.id }}_container">
                <template>
                    {{ include('offre_v2/_configurer_annee.html.twig', {
                        'annee': matchedAnnee,
                        'parcours': matchedParcours,
                        'formation': formation,
                        'typeDiplome': typeDiplome,
                        'comparaison': comparaison,
                        'plateformes': plateformes
                    }) }}
                </template>
            </turbo-stream>
        {% endif %}
    {% endfor %}
{% endif %}
