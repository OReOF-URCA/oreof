{% set typeDiplome = formation.typeDiplome %}
<turbo-stream action="replace" target="configurer_global_stats">
    <template>
        <div id="configurer_global_stats" class="mt-4 grid gap-3 md:grid-cols-4">
            <div class="rounded-xl bg-green-50 p-3 text-sm text-green-700">
                <div class="text-lg font-bold">{{ tabStatistiques.nbParcoursOuvert }}
                    /{{ formation.parcours|length }}</div>
                parcours ouverts
            </div>

            <div class="rounded-xl bg-indigo-50 p-3 text-sm text-indigo-700">
                <div class="text-lg font-bold">{{ plateformes|length }}</div>
                plateforme{{ plateformes|length > 1 ? 's' : '' }} active{{ plateformes|length > 1 ? 's' : '' }}
            </div>

            <div class="rounded-xl bg-slate-50 p-3 text-sm text-slate-700">
                <div class="text-lg font-bold">{{ tabStatistiques.capacite }}</div>
                capacité
            </div>

            <div class="rounded-xl bg-amber-50 p-3 text-sm text-amber-700">
                <div class="text-lg font-bold">{{ anomalies|length }}</div>
                anomalie{{ anomalies|length > 1 ? 's' : '' }}
            </div>
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_global_warnings">
    <template>
        <div id="configurer_global_warnings" class="mt-4 space-y-3 text-sm">
            {% if anomalies is empty %}
                <div class="rounded-xl bg-green-50 p-3 text-green-800">
                    ✓ Les informations et capacités de la formation sont complètes. Aucune anomalie détectée.
                </div>
            {% else %}
                {% for anomaly in anomalies %}
                    <div class="rounded-xl bg-amber-50 p-3 text-amber-800 flex items-center gap-2">
                        <span>⚠</span>
                        <span>{{ anomaly.message }}</span>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="configurer_tronc_commun_block">
    <template>
        <div id="configurer_tronc_commun_block" class="mt-4 p-3.5 rounded-xl border border-indigo-200 bg-indigo-50/50 text-sm shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2 font-semibold text-indigo-950">
                        <twig:UX:Icon name="ph:users-three-bold" class="h-5 w-5 text-indigo-600" />
                        <span>Tronc commun de la formation</span>
                    </div>
                    <p class="text-xs text-slate-600 mt-0.5">
                        Cochez les années communes à l'ensemble des parcours de cette mention / formation.
                    </p>
                </div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    {% for anneeOrdre in formation.anneesOrdres %}
                        {% set isTc = formation.isAnneeTroncCommun(anneeOrdre) %}
                        <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border {{ isTc ? 'bg-indigo-600 border-indigo-600 text-white shadow-xs font-semibold' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-50 font-medium' }} transition-colors cursor-pointer text-xs select-none">
                            <input type="checkbox"
                                   name="tronc_commun_annee_{{ anneeOrdre }}"
                                   value="1"
                                   {{ isTc ? 'checked' : '' }}
                                   class="rounded text-indigo-600 focus:ring-indigo-500">
                            <span>{{ typeDiplome.libelleCourt|default('Année') }} {{ anneeOrdre }} (Tronc commun)</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
        </div>
    </template>
</turbo-stream>

{% for parcours in formation.parcours %}
    {% set statParcours = tabStatistiques['parcours'][parcours.id] %}
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_stats">
        <template>
            <div id="parcours_{{ parcours.id }}_stats" class="mt-4 grid gap-3 md:grid-cols-4">
                <div class="rounded-xl bg-green-50 p-3 text-sm text-green-700">
                    <div class="text-lg font-bold">{{ statParcours.nbAnneesOuvertes }}
                        /{{ statParcours.nbAnnees }}</div>
                    années ouvertes
                </div>

                <div class="rounded-xl bg-indigo-50 p-3 text-sm text-indigo-700">
                    <div class="text-lg font-bold">{{ statParcours.nbPlateformesActives }}</div>
                    plateforme{{ statParcours.nbPlateformesActives > 1 ? 's' : '' }} active{{ statParcours.nbPlateformesActives > 1 ? 's' : '' }}
                </div>

                <div class="rounded-xl bg-slate-50 p-3 text-sm text-slate-700">
                    <div class="text-lg font-bold">{{ statParcours.capacite }}</div>
                    capacité totale
                </div>

                <div class="rounded-xl bg-amber-50 p-3 text-sm text-amber-700">
                    <div class="text-lg font-bold">{{ statParcours.anomalies|length }}</div>
                    anomalie{{ statParcours.anomalies|length > 1 ? 's' : '' }}
                </div>
            </div>
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="parcours_{{ parcours.id }}_badge">
        <template>
            <span id="parcours_{{ parcours.id }}_badge" class="mr-2">
                {% set dpe = parcours.getDpeParcours()|filter(d => d.campagneCollecte == campagne)|first %}
                {% set currentEtat = dpe ? dpe.getEtatReconduction().value : 'OUVERT' %}
                {% set isParcoursFerme = currentEtat == 'NON_OUVERTURE' or currentEtat == 'NON_OUVERTURE_SES' or currentEtat == 'NON_OUVERTURE_CFVU' or currentEtat == 'FERMETURE_DEFINITIVE' %}
                {% if isParcoursFerme %}
                    <twig:Badge variant="danger" label="Fermé" />
                {% else %}
                    <twig:Badge variant="success" label="Ouvert" />
                {% endif %}
            </span>
        </template>
    </turbo-stream>
{% endfor %}

{% if changedYears is defined %}
    {% for anneeId, _ in changedYears %}
        {# Trouver l'année correspondante dans la formation/parcours #}
        {% set matchedAnnee = null %}
        {% set matchedParcours = null %}
        {% for p in formation.parcours %}
            {% for a in p.annees %}
                {% if a.id == anneeId %}
                    {% set matchedAnnee = a %}
                    {% set matchedParcours = p %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        
        {% if matchedAnnee and matchedParcours %}
            <turbo-stream action="replace" target="annee_{{ matchedAnnee.id }}_container">
                <template>
                    {{ include('offre_v2/_configurer_annee.html.twig', {
                        'annee': matchedAnnee,
                        'parcours': matchedParcours,
                        'formation': formation,
                        'typeDiplome': typeDiplome,
                        'comparaison': comparaison,
                        'plateformes': plateformes
                    }) }}
                </template>
            </turbo-stream>
        {% endif %}
    {% endfor %}
{% endif %}
