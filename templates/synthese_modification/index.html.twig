{% extends 'base.html.twig' %}

{% block bouton_header %}
    <twig:Button
            href="{{ path('app_synthese_modification_export_all') }}"
            variant="outline-info"
            size="sm"
            icon="icon:download"
            label="Récupérer toutes les modifications (PDF)"
            tooltip="Télécharger toutes les modifications"
            extraClass="font-semibold"
    />
    <twig:Button
            href="{{ path('app_conseils_documents_download', { process: 'dpe_parcours' }) }}"
            variant="info"
            size="sm"
            icon="icon:download"
            label="Télécharger les documents (ZIP)"
            tooltip="Télécharger tous les PV et justificatifs pour les modifications de parcours"
            extraClass="font-semibold"
    />
{% endblock %}

{% block content %}
    <div class="app-tabs mb-6">
        <div class="app-tabs-list" role="tablist" aria-label="Synthèse des modifications">
            <a id="tab-modifications"
               class="app-tab gap-2 {% if tab != 'documents' %}app-tab-active active{% endif %}"
               href="{{ path('app_synthese_modification_export_pdf', { tab: 'modifications' }) }}"
               role="tab"
               aria-selected="{{ tab != 'documents' ? 'true' : 'false' }}"
            >
                <twig:UX:Icon name="mdi:file-compare" class="size-4" />
                Liste des modifications
            </a>
            <a id="tab-documents"
               class="app-tab gap-2 {% if tab == 'documents' %}app-tab-active active{% endif %}"
               href="{{ path('app_synthese_modification_export_pdf', { tab: 'documents' }) }}"
               role="tab"
               aria-selected="{{ tab == 'documents' ? 'true' : 'false' }}"
            >
                <twig:UX:Icon name="icon:file-text" class="size-4" />
                Documents du conseil (PV & notes)
            </a>
        </div>
    </div>

    {% if tab != 'documents' %}
        <div class="overflow-hidden rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900 space-y-4">
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm text-secondary-700 dark:text-secondary-200">
                    <thead class="bg-secondary-50 text-left text-xs font-black uppercase tracking-wider text-secondary-500 dark:bg-secondary-800/70 dark:text-secondary-300">
                    <tr>
                        <th class="px-4 py-3">Composante</th>
                        <th class="px-4 py-3">Export</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
                    {% for composante in composantes %}
                        <tr class="align-top hover:bg-secondary-50/70 dark:hover:bg-secondary-800/40">
                            <td class="px-4 py-3 font-medium text-secondary-800 dark:text-secondary-100">{{ composante.libelle }}</td>
                            <td class="px-4 py-3">
                                {% if comp[composante.id] is defined %}
                                    <twig:Button
                                            href="{{ path('app_synthese_modification_export_composante', {composante: composante.id}) }}"
                                            variant="info"
                                            size="sm"
                                            icon="icon:download"
                                            label="Récupérer toutes les modifications de la composante ({{ comp[composante.id] }} parcours)"
                                            tooltip="Télécharger toutes les modifications de la composante {{ composante.libelle }}"
                                            extraClass="font-semibold"
                                    />
                                {% else %}
                                    <span class="text-xs text-secondary-400 dark:text-secondary-500">Aucune modification à exporter</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="space-y-4">
            <div class="rounded-xl border border-info-200 bg-info-50/50 p-4 text-sm text-info-800 dark:border-info-800 dark:bg-info-950/30 dark:text-info-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <twig:UX:Icon name="icon:info" class="size-5 shrink-0 text-info-600 dark:text-info-400" />
                    <span>Retrouvez ici les procès-verbaux et notes justificatives déposés lors des conseils pour les parcours modifiés. Vous pouvez télécharger chaque document individuellement ou récupérer l'archive complète.</span>
                </div>
                <twig:Button
                        href="{{ path('app_conseils_documents_download', { process: 'dpe_parcours' }) }}"
                        variant="info"
                        size="sm"
                        icon="icon:download"
                        label="Télécharger tout (ZIP)"
                        tooltip="Télécharger tous les PV et justificatifs en archive ZIP"
                        extraClass="whitespace-nowrap font-semibold"
                />
            </div>

            {{ include('_ui/_datatable_card.html.twig', { table: documentsTable }) }}
        </div>
    {% endif %}
{% endblock %}
