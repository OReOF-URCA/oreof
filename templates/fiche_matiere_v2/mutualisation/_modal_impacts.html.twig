{% set liaisons = ficheMatiere.ficheMatiereParcours %}
{% if liaisons|length == 0 %}
    <p class="text-muted">{{ 'fiche_matiere_v2.mutualisation.modal_impacts.aucun_parcours_mutualise_n_est_associe'|trans({}, 'modal') }}</p>
{% else %}
    <p class="text-warning fw-bold">
        <i class="fas fa-exclamation-triangle me-1"></i>
        {{ 'fiche_matiere_v2.mutualisation.modal_impacts.avertissement'|trans({'%count%': liaisons|length}, 'modal') }}
    </p>
    <table class="table table-sm table-bordered mt-2">
        <thead class="table-light">
        <tr>
            <th>{{ 'fiche_matiere_v2.mutualisation.modal_impacts.formation'|trans({}, 'modal') }}</th>
            <th>{{ 'fiche_matiere_v2.mutualisation.modal_impacts.parcours'|trans({}, 'modal') }}</th>
            <th>{{ 'fiche_matiere_v2.mutualisation.modal_impacts.responsable_de_parcours'|trans({}, 'modal') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for liaison in liaisons %}
            <tr>
                <td>
                    {{ liaison.parcours is not null and liaison.parcours.formation is not null
                    ? liaison.parcours.formation.display
                    : 'Formation inconnue' }}
                </td>
                <td>
                    {{ liaison.parcours is not null ? liaison.parcours.display ?? liaison.parcours.libelle : 'Parcours inconnu' }}
                </td>
                <td>
                    {% if liaison.parcours is not null and liaison.parcours.respParcours is not null %}
                        {{ liaison.parcours.respParcours.display }}
                        {% if liaison.parcours.respParcours.email is not null %}
                            <br><small class="text-muted">{{ liaison.parcours.respParcours.email }}</small>
                        {% endif %}
                    {% else %}
                        <span class="badge bg-warning text-dark">{{ 'fiche_matiere_v2.mutualisation.modal_impacts.aucun_responsable'|trans({}, 'modal') }}</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <p class="text-danger mt-2">
        <strong>{{ 'fiche_matiere_v2.mutualisation.modal_impacts.cette_action_est_irreversible'|trans({}, 'modal') }}</strong> {{ 'fiche_matiere_v2.mutualisation.modal_impacts.les_responsables_de_ces_parcours_recevront'|trans({}, 'modal') }}
    </p>
{% endif %}
