{% if cssDiff is defined and cssDiff %}
    <style>{{ cssDiff|raw }}</style>
{% endif %}

<div class="space-y-5 text-sm">
    {# ── Barre de contexte & choix de la source de comparaison ── #}
    <div class="grid grid-cols-1 gap-3 rounded-xl border border-secondary-200 bg-secondary-50 p-3.5 sm:grid-cols-4 dark:border-secondary-700 dark:bg-secondary-800">
        <div class="sm:col-span-2">
            <span class="block text-xs font-medium text-secondary-500 dark:text-secondary-400">
                {{ 'fiche_matiere_v2.synthese_modifications.source_reference'|trans({}, 'modal') }}
            </span>
            <span class="font-semibold text-text">{{ report.sourceLabel }}</span>
        </div>
        <div>
            <span class="block text-xs font-medium text-secondary-500 dark:text-secondary-400">
                {{ 'fiche_matiere_v2.synthese_modifications.ecarts_detectes'|trans({}, 'modal') }}
            </span>
            <div class="mt-0.5 flex items-center gap-2">
                <span class="font-semibold text-text">{{ report.countChanges }}</span>
                {% if report.hasChanges %}
                    {% if aiSummary.hasRegulatoryImpact %}
                        <twig:Badge
                                label="{{ 'fiche_matiere_v2.synthese_modifications.impact_reglementaire'|trans({}, 'modal') }}"
                                variant="warning"
                                size="sm"
                                icon="icon:warning"
                        />
                    {% else %}
                        <twig:Badge
                                label="{{ 'fiche_matiere_v2.synthese_modifications.ajustement_descriptif'|trans({}, 'modal') }}"
                                variant="info"
                                size="sm"
                                icon="icon:info"
                        />
                    {% endif %}
                {% endif %}
            </div>
        </div>
        <div>
            <span class="block text-xs font-medium text-secondary-500 dark:text-secondary-400">
                {{ 'fiche_matiere_v2.synthese_modifications.moteur_synthese'|trans({}, 'modal') }}
            </span>
            <div class="mt-0.5">
                <twig:Badge
                        label="{{ aiSummary.providerLabel }}"
                        :variant="aiSummary.isAiGenerated ? 'primary' : 'secondary'"
                        size="sm"
                        icon="icon:star"
                />
            </div>
        </div>
    </div>

    {% if report.hasSnapshotAvailable and report.hasOrigineN1Available %}
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-secondary-200 bg-surface px-3.5 py-2.5 dark:border-secondary-700">
            <span class="text-xs font-medium text-secondary-600 dark:text-secondary-300">
                {{ 'fiche_matiere_v2.synthese_modifications.changer_reference'|trans({}, 'modal') }}
            </span>
            <div class="flex flex-wrap gap-2">
                <twig:Button
                        variant="{{ report.sourceType != 'origine_n1' ? 'primary' : 'secondary' }}"
                        size="sm"
                        :outline="report.sourceType == 'origine_n1'"
                        icon="icon:file-text"
                        label="{{ 'fiche_matiere_v2.synthese_modifications.btn_snapshot_json'|trans({}, 'modal') }}"
                        data-action="click->modalturbo#open"
                        data-turbo="true"
                        href="{{ path('fiche_matiere_v2_synthese_modifications', {slug: ficheMatiere.slug, source: 'snapshot'}) }}"
                />
                <twig:Button
                        variant="{{ report.sourceType == 'origine_n1' ? 'primary' : 'secondary' }}"
                        size="sm"
                        :outline="report.sourceType != 'origine_n1'"
                        icon="icon:timeline"
                        label="{{ 'fiche_matiere_v2.synthese_modifications.btn_origine_n1'|trans({}, 'modal') }}"
                        data-action="click->modalturbo#open"
                        data-turbo="true"
                        href="{{ path('fiche_matiere_v2_synthese_modifications', {slug: ficheMatiere.slug, source: 'origine_n1'}) }}"
                />
            </div>
        </div>
    {% endif %}

    {# ── Encart Synthèse IA / Résumé exécutif ── #}
    <section class="rounded-xl border border-primary-300 bg-primary-50 p-4 shadow-sm dark:border-primary-700 dark:bg-primary-900">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary-100 text-primary-700 dark:bg-primary-800 dark:text-primary-200">
                    {{ ux_icon('icon:star', {class: 'h-4 w-4'}) }}
                </span>
                <h3 class="text-sm font-bold text-primary-900 dark:text-primary-100">
                    {{ 'fiche_matiere_v2.synthese_modifications.titre_synthese'|trans({}, 'modal') }}
                </h3>
            </div>
            {% if report.hasChanges %}
                <twig:Button
                        variant="primary"
                        size="sm"
                        :outline="true"
                        icon="icon:sync"
                        label="{{ 'fiche_matiere_v2.synthese_modifications.regenerer'|trans({}, 'modal') }}"
                        data-action="click->modalturbo#open"
                        data-turbo="true"
                        href="{{ path('fiche_matiere_v2_synthese_modifications', {slug: ficheMatiere.slug, source: selectedSource, refresh: 1}) }}"
                />
            {% endif %}
        </div>

        <p class="leading-relaxed text-primary-900 dark:text-primary-100">
            {{ aiSummary.summary }}
        </p>

        {% if aiSummary.highlights|length > 0 %}
            <ul class="mt-3 space-y-1.5 border-t border-primary-200 pt-3 text-xs text-primary-800 dark:border-primary-700 dark:text-primary-200">
                {% for point in aiSummary.highlights %}
                    <li class="flex items-start gap-2">
                        <span class="mt-0.5 text-primary-600 dark:text-primary-300">•</span>
                        <span>{{ point }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if aiSummary.fallbackReason %}
            <p class="mt-3 border-t border-primary-200 pt-2 text-[11px] text-primary-700 dark:border-primary-800 dark:text-primary-300">
                {{ aiSummary.fallbackReason }}
            </p>
        {% endif %}
    </section>

    {# ── Détail structuré des modifications par catégorie ── #}
    {% if not report.hasReference %}
        {{ component('alerte', {
            type: 'info',
            message: 'fiche_matiere_v2.synthese_modifications.aucune_reference_alerte'|trans({}, 'modal')
        }) }}
    {% elseif not report.hasChanges %}
        {{ component('alerte', {
            type: 'success',
            message: 'fiche_matiere_v2.synthese_modifications.aucun_ecart_alerte'|trans({}, 'modal')
        }) }}
    {% else %}
        <div class="space-y-4">
            {% for category, items in report.changesByCategory %}
                <section class="rounded-xl border border-secondary-200 bg-surface p-4 shadow-sm dark:border-secondary-700">
                    <div class="mb-3 flex items-center justify-between border-b border-secondary-200 pb-2 dark:border-secondary-700">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-secondary-700 dark:text-secondary-200">
                            {{ (items|first).categoryLabel }}
                        </h4>
                        <twig:Badge
                                label="{{ 'fiche_matiere_v2.synthese_modifications.nb_champs'|trans({'%count%': items|length}, 'modal') }}"
                                variant="secondary"
                                size="sm"
                        />
                    </div>

                    <div class="divide-y divide-secondary-200 dark:divide-secondary-700">
                        {% for item in items %}
                            <div class="py-3 first:pt-0 last:pb-0">
                                <div class="mb-1.5 font-semibold text-text">
                                    {{ item.label }}
                                </div>

                                {% if item.htmlDiff %}
                                    <div class="rounded-lg border border-secondary-200 bg-secondary-50 p-3 text-xs leading-relaxed dark:border-secondary-700 dark:bg-secondary-800">
                                        {{ item.htmlDiff|raw }}
                                    </div>
                                    <details class="mt-2 text-xs">
                                        <summary class="cursor-pointer font-medium text-secondary-500 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200">
                                            {{ 'fiche_matiere_v2.synthese_modifications.voir_avant_apres_complet'|trans({}, 'modal') }}
                                        </summary>
                                        <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
                                            <div class="rounded-lg border border-danger-300 bg-danger-50 p-2.5 dark:border-danger-700 dark:bg-danger-900">
                                                <span class="mb-1 block text-[11px] font-bold uppercase text-danger-700 dark:text-danger-300">
                                                    {{ 'fiche_matiere_v2.synthese_modifications.avant'|trans({}, 'modal') }}
                                                </span>
                                                <p class="whitespace-pre-line text-danger-900 dark:text-danger-100">{{ item.before }}</p>
                                            </div>
                                            <div class="rounded-lg border border-success-300 bg-success-50 p-2.5 dark:border-success-700 dark:bg-success-900">
                                                <span class="mb-1 block text-[11px] font-bold uppercase text-success-700 dark:text-success-300">
                                                    {{ 'fiche_matiere_v2.synthese_modifications.apres'|trans({}, 'modal') }}
                                                </span>
                                                <p class="whitespace-pre-line text-success-900 dark:text-success-100">{{ item.after }}</p>
                                            </div>
                                        </div>
                                    </details>
                                {% else %}
                                    <div class="grid grid-cols-1 gap-2 text-xs sm:grid-cols-2">
                                        <div class="rounded-lg border border-danger-300 bg-danger-50 px-3 py-2 dark:border-danger-700 dark:bg-danger-900">
                                            <span class="block text-[10px] font-bold uppercase tracking-wide text-danger-700 dark:text-danger-300">
                                                {{ 'fiche_matiere_v2.synthese_modifications.avant'|trans({}, 'modal') }}
                                            </span>
                                            <span class="font-medium text-danger-900 dark:text-danger-100">{{ item.before }}</span>
                                        </div>
                                        <div class="rounded-lg border border-success-300 bg-success-50 px-3 py-2 dark:border-success-700 dark:bg-success-900">
                                            <span class="block text-[10px] font-bold uppercase tracking-wide text-success-700 dark:text-success-300">
                                                {{ 'fiche_matiere_v2.synthese_modifications.apres'|trans({}, 'modal') }}
                                            </span>
                                            <span class="font-semibold text-success-900 dark:text-success-100">{{ item.after }}</span>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
</div>
