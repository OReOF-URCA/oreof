<div class="space-y-1.5">
    <div class="font-semibold text-secondary-900 dark:text-secondary-100">
        {% if item.formation.mention != null or item.formation.mentionTexte != null %}
            {{ item.formation.display }}
        {% else %}
            <span class="inline-flex rounded-full border border-rose-300 bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700 dark:border-rose-700 dark:bg-rose-950/30 dark:text-rose-300">Non definie</span>
        {% endif %}
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs text-secondary-500 dark:text-secondary-400">
        <span class="inline-flex rounded-full border border-cyan-300 bg-cyan-50 px-2.5 py-0.5 font-semibold text-cyan-700 dark:border-cyan-700 dark:bg-cyan-950/30 dark:text-cyan-300">
            {{ item.formation.typeDiplome|typeDiplome }}
        </span>

        {% if item.formation.hasParcours %}
            <span class="font-medium text-secondary-700 dark:text-secondary-200">{{ item.parcours.libelle }}</span>
            {{ item.parcours.typeParcours|badgeTypeParcours }}
        {% else %}
            <span class="text-secondary-400 dark:text-secondary-500">Sans parcours</span>
        {% endif %}
    </div>
</div>

