<section
        class="space-y-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-5"
        {{ stimulus_controller('validation--bulk-actions', {
            selectionClass: '.validation-dpe-item'
        }) }}
        data-action="change->validation--bulk-actions#refresh check-all:changed@window->validation--bulk-actions#refresh validation:bulk-success@window->validation--bulk-actions#onBulkSuccess submit@document->validation--bulk-actions#submit"
>
    {% if table is not null %}
        {% if oneParcours is defined and oneParcours is not null %}
            <div class="sticky top-2 z-10 rounded-xl border border-indigo-200 bg-indigo-50/95 p-3 backdrop-blur dark:border-indigo-800 dark:bg-indigo-950/40">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700 dark:text-indigo-200">
                        Actions en lot
                        <span class="ml-2 text-[11px] font-normal normal-case" {{ stimulus_target('validation--bulk-actions', 'counter') }}>
                            0 element selectionne
                        </span>
                    </p>
                    <div class="flex flex-wrap gap-2" {{ stimulus_target('validation--bulk-actions', 'actions') }}>
                        {% set prefix = 'parcours' %}
                        {% for key, state in hasTransitions(oneParcours) %}
                            {% for keyTrans, transition in state %}
                                {% set hasMetaForm = transition.meta.form is defined and transition.meta.form.fields is defined and transition.meta.form.fields|length > 0 %}
                                <twig:Button
                                        variant="{{ transition.meta.button_class }}"
                                        size="sm"
                                        tooltip="{{ ('title.validation.' ~ prefix ~ '.' ~ keyTrans)|trans({}, 'process') }}"
                                        dataAction="click->modalturbo#open click->validation--bulk-actions#open"
                                        data-validation--bulk-actions-url-param="{{ path('parcours_process_apply_lot', {transition: keyTrans}) }}"
                                        data-validation--bulk-actions-label-param="{{ ('btn.validation.' ~ prefix ~ '.' ~ keyTrans)|trans({}, 'process') }}"
                                        data-validation--bulk-actions-form-param="{{ hasMetaForm ? 'true' : 'false' }}"
                                        data-validation--bulk-actions-target="trigger"
                                >
                                    <i class="fal {{ transition.meta.button_icon }}"></i>
                                    <span>{{ ('btn.validation.' ~ prefix ~ '.' ~ keyTrans)|trans({}, 'process') }}</span>
                                </twig:Button>
                            {% endfor %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}

        {{ component('DataTable', { config: table }) }}

        <div class="mt-3 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-200" {{ stimulus_target('validation--bulk-actions', 'recap') }}></div>
    {% else %}
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-200">
            Selectionnez une etape de validation pour afficher la liste.
        </div>
    {% endif %}
</section>

