{# templates/help/index.html.twig #}
{% extends 'base.html.twig' %}

{% set header_title %}
    Aide
{% endset %}

{% block header %}Centre d'aide{% endblock %}

{% block breadcrumb %}
    {{ include('communs/_breadcrumb.html.twig', {liens: [
        {title: 'Aide'}
    ]}) }}
{% endblock %}

{% block content %}
<div class="w-full">
    <div class="space-y-4">
        <div class="rounded-2xl border border-secondary-200 bg-surface shadow-sm dark:border-secondary-700">
            <div class="p-6">
                <!-- Search Bar -->
                <div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-4">
                    <div class="relative flex-1">
                            <label for="helpSearch" class="sr-only">Rechercher un tutoriel ou une aide</label>
                        <input type="text"
                               id="helpSearch"
                               class="w-full rounded-lg border border-secondary-200 bg-surface py-2.5 pl-4 pr-4 text-base text-secondary-900 placeholder-secondary-500 transition focus:border-info-400 focus:ring-2 focus:ring-info-100 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-100 dark:placeholder-secondary-400 dark:focus:border-info-400 dark:focus:ring-info-100/20"
                               placeholder="Rechercher un tutoriel ou une aide..."
                               onkeyup="filterHelps()" />
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_help_index') }}"
                           class="inline-flex items-center gap-2 rounded-lg border border-secondary-200 bg-surface px-5 py-2.5 text-base font-semibold text-secondary-600 transition hover:border-secondary-300 hover:text-secondary-900 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-200 dark:hover:border-secondary-500">
                            {{ ux_icon('mdi:cog', {class: 'h-6 w-6'}) }}
                            <span class="hidden sm:inline">Gérer</span>
                        </a>
                    {% endif %}
                </div>

                <!-- Helps List -->
                <div class="space-y-3" id="helpsList">
                    {% for help in helps %}
                        <details class="help-item group rounded-lg border border-secondary-200 bg-secondary-50 transition hover:border-secondary-300 dark:border-secondary-700 dark:bg-secondary-800/50 dark:hover:border-secondary-600"
                                 data-title="{{ help.title|default('')|lower }} {{ help.routeSlug|lower }}">
                            <summary class="flex cursor-pointer select-none items-center justify-between p-5 hover:bg-secondary-100 dark:hover:bg-secondary-800" style="list-style: none;">
                                <span class="flex items-center gap-3">
                                    {{ ux_icon('material-symbols:info-outline', {class: 'h-7 w-7 flex-shrink-0 text-info-600 dark:text-info-400'}) }}
                                    <span class="flex items-center gap-3">
                                        <strong class="text-base text-secondary-900 dark:text-secondary-100">{{ help.title|default(help.routeSlug) }}</strong>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('app_help_edit', {'id': help.id}) }}"
                                               class="inline-flex items-center gap-1 rounded px-2.5 py-1.5 text-sm font-semibold text-info-600 hover:bg-info-50 dark:text-info-400 dark:hover:bg-info-500/20"
                                               onclick="event.stopPropagation();"
                                               title="Modifier">
                                                {{ ux_icon('mingcute:pencil-line', {class: 'h-5 w-5'}) }}
                                            </a>
                                        {% endif %}
                                        {% set previewUrl = previewUrls[help.id] ?? null %}
                                        {% if previewUrl %}
                                            <a href="{{ previewUrl }}"
                                               class="inline-flex items-center gap-1 rounded px-2.5 py-1.5 text-sm font-semibold text-secondary-600 hover:bg-secondary-200 dark:text-secondary-400 dark:hover:bg-secondary-700"
                                               onclick="event.stopPropagation();"
                                               title="Voir la page">
                                                {{ ux_icon('wordpress:external', {class: 'h-5 w-5'}) }}
                                            </a>
                                        {% else %}
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 rounded px-2.5 py-1.5 text-sm font-semibold text-secondary-400 cursor-not-allowed"
                                                    onclick="event.stopPropagation();"
                                                    title="Route avec paramètres obligatoires : aperçu direct indisponible"
                                                    disabled>
                                                {{ ux_icon('icon:external-link', {class: 'h-5 w-5'}) }}
                                            </button>
                                        {% endif %}
                                    </span>
                                </span>
                                {{ ux_icon('icon:chevron-down', {class: 'chevron-icon h-7 w-7 text-secondary-400 transition group-open:rotate-180 dark:text-secondary-500'}) }}
                            </summary>
                            <div class="border-t border-secondary-200 bg-surface p-4 dark:border-secondary-700">
                                <div class="markdown-body app-help-markdown">
                                    {{ help.content|markdown_to_html|parse_embeds }}
                                </div>
                            </div>
                        </details>
                    {% else %}
                        <div class="rounded-lg border border-info-200 bg-info-50 p-6 text-center dark:border-info-800 dark:bg-info-950/30">
                            {{ ux_icon('icon:face-sad', {class: 'mx-auto mb-3 h-14 w-14 text-info-600 dark:text-info-400'}) }}
                            <p class="text-sm text-info-900 dark:text-info-100">Aucune aide enregistrée pour le moment.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function filterHelps() {
    const query = document.getElementById('helpSearch').value.toLowerCase().trim();
    const items = document.querySelectorAll('.help-item');
    items.forEach(item => {
        if (!query) {
            item.style.display = 'block';
            item.style.order = '0';
            return;
        }

        const title = item.getAttribute('data-title');
        const bodyContent = item.querySelector('.markdown-body').textContent.toLowerCase();

        if (title.includes(query)) {
            item.style.display = 'block';
            item.style.order = '1';
        } else if (bodyContent.includes(query)) {
            item.style.display = 'block';
            item.style.order = '2';
        } else {
            item.style.display = 'none';
        }
    });
}
</script>

{% endblock %}
