<div {{ stimulus_controller('parcours--step2', {
    url: path('app_parcours_save', {parcours:parcours.id}),
}) }}>
    {% form_theme form 'communs/form_theme.html.twig' %}
    {{ form_start(form) }}
    {{ form_row(form.modalitesEnseignement) }}
    {{ form_row(form.hasStage) }}
    <div id="blocStage" style="display:{% if parcours.hasStage == null or parcours.hasStage == false %}none{% endif %}">
        {{ form_row(form.nbHeuresStages) }}
        {{ form_row(form.stageText) }}

    </div>
    {{ form_row(form.hasProjet) }}
    <div id="blocProjet" style="display:{% if parcours.hasProjet == null or parcours.hasProjet == false %}none{% endif %}">
        {{ form_row(form.nbHeuresProjet) }}
        {{ form_row(form.projetText) }}

    </div>

    {{ form_row(form.hasMemoire) }}
    <div id="blocMemoire" style="display:{% if parcours.hasMemoire == null or parcours.hasMemoire == false %}none{% endif %}">
        {{ form_row(form.memoireText) }}
    </div>

    {% if typeDiplome != null and typeDiplome.isHasSituationPro %}
        {{ form_row(form.hasSituationPro) }}
        {{ form_row(form.nbHeuresSituationPro) }}
        {{ form_row(form.situationProText) }}
    {% endif %}

{% if form.dureeParcours is defined %}
        <div class="row mb-3">
            {{ form_row(form.dureeParcours) }}
            {{ form_row(form.dureeParcoursUnite) }}
        </div>
    {% endif %}

    {{ form_end(form) }}

    {% if parcours.formation.typeDiplome.classique ?? true %}
    <div class="alert {% if parcours.getEtatStep(2) %}alert-success{% else %}alert-warning{% endif %}" id="alertEtatStructure">
        <input type="checkbox"
               id="etatStructure"
               class="form-check-inline"
               {% if parcours.getEtatStep(2) %}checked{% endif %}
                {{ stimulus_action('parcours--step2', 'etatStep', 'change') }}

        ><label for="etatStructure">
            Cochez cette case si vous avez terminé ...</label>
    </div>
    {% endif %}
</div>
