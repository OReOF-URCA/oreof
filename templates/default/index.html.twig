{% extends 'base.html.twig' %}

{% block content %}
    {#    todo: a revoir sans doute (faux-positif) + mise en fort tailwindcss
{{ component('mutualisation_alerts', { user: app.user }) }} #}

    {{ include('default/_timeLine.html.twig') }}

    {#    {% if is_granted('ROLE_ADMIN') %} #}
    {#        {{ component('stats_block', { #}
    {#            charts: [chart1, chart2, chart3], #}
    {#            titles: ['Formations', 'Statuts', 'Inscriptions'], #}
    {#            collapsible: true #}
    {#        }) }} #}
    {#    {% endif %} #}

    {{ component('actualites') }}

    <div class="app-tabs"
            {{ stimulus_controller('wizard', {
                url:  path('app_homepage_wizard'),
                step: step
            }) }}
    >

        <div class="app-tabs-list" role="tablist" aria-label="Tableau de bord">
            <a id="tab-formation"
               class="app-tab {% if step == 'formation' %}app-tab-active active{% endif %}"
               href="{{ path('app_homepage', { step: 'formation' }) }}"
               role="tab"
               aria-selected="{{ step == 'formation' ? 'true' : 'false' }}"
               aria-controls="step_1"
               tabindex="{{ step == 'formation' ? '0' : '-1' }}"
               data-step="formation"
               data-wizard-target="tab"
                    {{ stimulus_action('wizard', 'changeStep', 'click', {step: 'formation'}) }}
            >
                Diplômes nationaux (DPE: {{ user_data.campagneCollecte.libelle }})
            </a>
            <a id="tab-formation_etablissement"
               class="app-tab {% if step == 'formation_etablissement' %}app-tab-active active{% endif %}"
               href="{{ path('app_homepage', { step: 'formation_etablissement' }) }}"
               role="tab"
               aria-selected="{{ step == 'formation_etablissement' ? 'true' : 'false' }}"
               aria-controls="step_1"
               tabindex="{{ step == 'formation_etablissement' ? '0' : '-1' }}"
               data-step="formation_etablissement"
               data-wizard-target="tab"
                    {{ stimulus_action('wizard', 'changeStep', 'click', {step: 'formation_etablissement'}) }}
            >
                Formations établissements (DPE: {{ user_data.campagneCollecte.libelle }})
            </a>
            <a id="tab-fiche"
               class="app-tab {% if step == 'fiche' %}app-tab-active active{% endif %}"
               href="{{ path('app_homepage', { step: 'fiche' }) }}" role="tab"
               aria-selected="{{ step == 'fiche' ? 'true' : 'false' }}"
               aria-controls="step_1"
               tabindex="{{ step == 'fiche' ? '0' : '-1' }}"
               data-step="fiche"
               data-wizard-target="tab"
                    {{ stimulus_action('wizard', 'changeStep', 'click', {step: 'fiche'}) }}
            >
                Vos fiches EC/matières
            </a>
            {% if canAccessConseilComposante|default(false) %}
                {% set composanteLabel = singleComposante is defined and singleComposante ? 'Conseil : ' ~ singleComposante.libelle : 'Conseil de composante' %}
                <a id="tab-conseil-composante"
                   class="app-tab {% if step == 'conseil_composante' %}app-tab-active active{% endif %}"
                   href="{{ path('app_homepage', { step: 'conseil_composante' }) }}" role="tab"
                   aria-selected="{{ step == 'conseil_composante' ? 'true' : 'false' }}"
                   aria-controls="step_1"
                   tabindex="{{ step == 'conseil_composante' ? '0' : '-1' }}"
                   data-step="conseil_composante"
                   data-wizard-target="tab"
                        {{ stimulus_action('wizard', 'changeStep', 'click', {step: 'conseil_composante'}) }}
                >
                    {{ composanteLabel }} (DPE: {{ user_data.campagneCollecte.libelle }})
                </a>
            {% endif %}
            {% if canAccessCfvu|default(false) %}
                <a id="tab-cfvu"
                   class="app-tab {% if step == 'cfvu' %}app-tab-active active{% endif %}"
                   href="{{ path('app_homepage', { step: 'cfvu' }) }}" role="tab"
                   aria-selected="{{ step == 'cfvu' ? 'true' : 'false' }}"
                   aria-controls="step_1"
                   tabindex="{{ step == 'cfvu' ? '0' : '-1' }}"
                   data-step="cfvu"
                   data-wizard-target="tab"
                        {{ stimulus_action('wizard', 'changeStep', 'click', {step: 'cfvu'}) }}
                >
                    Conseil CFVU (DPE: {{ user_data.campagneCollecte.libelle }})
                </a>
            {% endif %}
        </div>

        <div class="app-tab-panel">
            <turbo-frame id="step_1" class="block min-h-24" role="tabpanel" aria-labelledby="tab-{{ step }}"
                         src="{{ path('app_homepage_wizard', { step: step }) }}" {{ stimulus_target('wizard', 'content') }}>
                <div class="px-3 py-4 text-sm text-secondary">Chargement...</div>
            </turbo-frame>
        </div>
    </div>
{% endblock %}
