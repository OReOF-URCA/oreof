{# Timeline de la campagne de collecte : étapes passées / en cours / à venir. Rendu 100 % serveur (pas de JS).
   Styles : assets/styles/_timeline.scss (classes `app-timeline*`). Variable `campagne` optionnelle. #}
{% set currentCampagne = campagne|default(user_data.campagneCollecte) %}

{% if currentCampagne is not null and currentCampagne.timelineDates is not empty %}
    {% set steps = currentCampagne.timelineDates|filter(event => event.inTimeline == true)|merge([]) %}
    {% set today = 'today'|date('U') %}

    {# Premier passage : état de chaque étape (terminée si sa date de fin est passée) et index de l'étape en cours. #}
    {% set states = [] %}
    {% set currentIndex = -1 %}
    {% for event in steps %}
        {% if event.date|date('U') < today %}
            {% set states = states|merge(['completed']) %}
        {% elseif currentIndex < 0 %}
            {% set currentIndex = loop.index0 %}
            {% set states = states|merge(['current']) %}
        {% else %}
            {% set states = states|merge(['upcoming']) %}
        {% endif %}
    {% endfor %}
    {% set total = steps|length %}
    {% set completedCount = currentIndex < 0 ? total : currentIndex %}
    {% set percent = total > 0 ? (completedCount / total * 100)|round : 0 %}

    <section class="app-timeline-panel" aria-labelledby="timeline-title">
        <header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
            <div class="min-w-0 space-y-1">
                <h2 id="timeline-title" class="text-lg font-bold tracking-tight text-text">
                    Processus de la campagne de collecte des projets de DPE
                </h2>
                <div class="flex flex-wrap items-center gap-2">
                    <twig:Badge :label="currentCampagne.libelle" variant="primary" icon="icon:calendar" />
                    {% if currentIndex < 0 %}
                        <twig:Badge label="Campagne terminée" variant="success" icon="icon:check-circle" />
                    {% elseif completedCount == 0 %}
                        <twig:Badge label="Campagne à venir" variant="secondary" icon="icon:clock" />
                    {% else %}
                        <twig:Badge label="Campagne en cours" variant="info" icon="icon:clock" />
                    {% endif %}
                </div>
            </div>

            <div class="app-progress w-full sm:w-56" role="group" aria-label="Avancement de la campagne">
                <div class="app-progress-header">
                    <span class="app-progress-label">Étapes terminées</span>
                    <span class="app-progress-value">{{ completedCount }} / {{ total }}</span>
                </div>
                <div class="app-progress-track app-progress-track--info"
                     role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}"
                     aria-label="{{ percent }} % des étapes terminées">
                    <span class="app-progress-bar app-progress-bar--info" style="width: {{ percent }}%"></span>
                </div>
            </div>
        </header>

        <ol class="app-timeline" style="--tl-steps: {{ total }}">
            {% for event in steps %}
                {% set state = states[loop.index0] %}
                {% set endTs = event.date|date('U') %}
                {% set daysLeft = ((endTs - today) / 86400)|round %}

                {# Part du segment « cette étape → suivante » déjà écoulée (0 à 1) #}
                {% set progress = 0 %}
                {% if not loop.last %}
                    {% if states[loop.index] == 'completed' %}
                        {% set progress = 1 %}
                    {% elseif state == 'completed' %}
                        {% set span = steps[loop.index].date|date('U') - endTs %}
                        {% set progress = span > 0 ? min(1, max(0, (today - endTs) / span)) : 0 %}
                    {% endif %}
                {% endif %}

                <li class="app-timeline-step app-timeline-step--{{ state }}"
                    style="--tl-progress: {{ progress|round(3) }}"
                    {% if state == 'current' %}aria-current="step"{% endif %}
                    {% if event.description %}title="{{ event.description|striptags|slice(0, 200) }}"{% endif %}>
                    <span class="app-timeline-icon">
                        <twig:UX:Icon :name="event.icone|default('icon:clock')" class="h-5 w-5" aria-hidden="true"/>
                        {% if state == 'completed' %}
                            <span class="app-timeline-check">
                                <twig:UX:Icon name="icon:check" class="h-2.5 w-2.5" aria-hidden="true"/>
                            </span>
                        {% endif %}
                    </span>

                    <div class="app-timeline-body">
                        {% if state == 'current' %}
                            <twig:Badge label="En cours" variant="primary" extraClass="mb-1" />
                        {% endif %}
                        <div class="app-timeline-label">{{ event.libelle }}</div>
                        <div class="app-timeline-dates">
                            {% if event.dateDebut != null %}
                                <span>Début : {{ event.dateDebut|date('d/m/Y') }}</span>
                            {% endif %}
                            <span>Fin : {{ event.date|date('d/m/Y') }}{{ event.heure != null ? ' ' ~ event.heure|date('H:i') : '' }}</span>
                        </div>
                        {% if state == 'current' %}
                            <div class="app-timeline-remaining">
                                {% if daysLeft <= 0 %}Se termine aujourd'hui{% elseif daysLeft == 1 %}Se termine demain{% else %}Se termine dans {{ daysLeft }} jours{% endif %}
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    </section>
{% else %}
    <twig:alerte type="warning" message="Aucune campagne de collecte en cours. Veuillez la configurer." />
{% endif %}
