<!-- Stats Start -->
{% set currentCampagne = campagne|default(user_data.campagneCollecte) %}

{% if currentCampagne is not null and currentCampagne.timelineDates is not empty %}
<section class="space-y-4 timeline-container">
    <div class="flex items-center justify-between">
        <h2 class="text-xl font-black tracking-tight text-text">
            Processus de la campagne de collecte des projets de DPE
            <span class="text-base font-semibold text-secondary">({{ currentCampagne.libelle }})</span>
        </h2>
    </div>

    <div class="overflow-x-auto pb-4">
        <div class="timeline min-w-[700px]">
            <div class="progress-line"></div>
            <div class="today-marker"></div>
            {% set hasCurrent = false %}
            {% for event in currentCampagne.timelineDates|filter(event => event.inTimeline == true) %}
                <div class="timeline-step
                {% if 'now'|date('U') > event.date|date('U') %}completed
                {% else %}
                    {% if not hasCurrent %}current
                    {% set hasCurrent = true %}
                    {% endif %}
                {% endif %}" data-end-date="{{ event.date|date('Y-m-d') }}">
                    <div class="step-icon" tabindex="0">
                        <twig:UX:Icon :name="event.icone|default('icon:clock')" class="w-7 h-7"/>
                    </div>
                    <div class="step-content">
                        <div class="step-label">{{ event.libelle }}</div>
                        <div class="step-dates">
                            {% if event.dateDebut != null %}
                                <span class="step-date">Début: {{ event.dateDebut|date('d/m/Y') }}</span>
                            {% endif %}
                            <span class="step-date">Fin: {{ event.date|date('d/m/Y') }} {{ event.heure != null ? event.heure|date('H:i'): '' }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <script>
          (function () {
            function updateTimelineElements(container) {
              if (!container) return
              const timeline = container.querySelector('.timeline')
              if (!timeline) return
              const progressLine = timeline.querySelector('.progress-line')
              const todayMarker = timeline.querySelector('.today-marker')
              const steps = timeline.querySelectorAll('.timeline-step')

              if (steps.length === 0) return

              const currentIndex = Array.from(steps).findIndex(step => step.classList.contains('current'))

              if (currentIndex >= 0 && steps.length > 1 && progressLine) {
                const progressPercent = (currentIndex / (steps.length - 1)) * 100
                progressLine.style.width = progressPercent + '%'
              } else if (currentIndex < 0 && progressLine) {
                const allCompleted = Array.from(steps).every(step => step.classList.contains('completed'))
                if (allCompleted) {
                  progressLine.style.width = '100%'
                }
              }

              if (!todayMarker) return

              const today = new Date()
              today.setHours(0, 0, 0, 0)

              const stepsData = Array.from(steps).map((step, index) => {
                const endDate = step.getAttribute('data-end-date')
                const rect = step.getBoundingClientRect()
                const timelineRect = timeline.getBoundingClientRect()
                const positionPercent = timelineRect.width > 0
                  ? ((rect.left + rect.width / 2 - timelineRect.left) / timelineRect.width) * 100
                  : 0

                return {
                  endDate: endDate ? new Date(endDate) : null,
                  positionPercent: positionPercent,
                  index: index
                }
              }).filter(data => data.endDate !== null)

              if (stepsData.length === 0) return

              const firstDate = stepsData[0].endDate
              const lastDate = stepsData[stepsData.length - 1].endDate

              if (today < firstDate || today > lastDate) {
                todayMarker.style.display = 'none'
                return
              }

              todayMarker.style.display = 'block'

              let beforeStep = null
              let afterStep = null

              for (let i = 0; i < stepsData.length - 1; i++) {
                if (today >= stepsData[i].endDate && today <= stepsData[i + 1].endDate) {
                  beforeStep = stepsData[i]
                  afterStep = stepsData[i + 1]
                  break
                }
              }

              if (!beforeStep && today <= stepsData[0].endDate) {
                const firstStepDate = stepsData[0].endDate
                const daysDiff = (today - firstDate) / (1000 * 60 * 60 * 24)
                const totalDays = (firstStepDate - firstDate) / (1000 * 60 * 60 * 24) || 1
                const ratio = daysDiff / totalDays
                todayMarker.style.left = (stepsData[0].positionPercent * ratio) + '%'
                return
              }

              if (beforeStep && afterStep) {
                const totalDuration = afterStep.endDate - beforeStep.endDate || 1
                const elapsedDuration = today - beforeStep.endDate
                const ratio = elapsedDuration / totalDuration

                const startPos = beforeStep.positionPercent
                const endPos = afterStep.positionPercent
                const markerPosition = startPos + (endPos - startPos) * ratio

                todayMarker.style.left = markerPosition + '%'
              }
            }

            function initAll() {
              document.querySelectorAll('.timeline-container').forEach(updateTimelineElements)
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', initAll)
            } else {
              initAll()
            }

            document.addEventListener('turbo:load', initAll)
            document.addEventListener('turbo:render', initAll)
            window.addEventListener('resize', initAll)
          })()
        </script>
    </div>
</section>
{% else %}
<twig:alerte type="warning" message="Aucune campagne de collecte en cours. Veuillez la configurer." />
    
{% endif %}
<!-- Stats Start -->
