<div class="space-y-6" {{ stimulus_controller('accessibility') }}>
    <p class="text-sm text-secondary-600 dark:text-secondary-300">
        Ces reglages sont appliques immediatement et memorises sur cet appareil.
    </p>

    <section class="space-y-2">
        <h3 class="text-sm font-semibold text-secondary-900 dark:text-secondary-100">Theme</h3>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setTheme"
                    data-accessibility-theme-param="system">
                Systeme
            </button>
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setTheme"
                    data-accessibility-theme-param="light">
                Clair
            </button>
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setTheme"
                    data-accessibility-theme-param="dark">
                Sombre
            </button>
        </div>
    </section>

    <section class="space-y-2">
        <h3 class="text-sm font-semibold text-secondary-900 dark:text-secondary-100">Police</h3>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setFont"
                    data-accessibility-font-param="default">
                Police standard
            </button>
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setFont"
                    data-accessibility-font-param="dys">
                Police dyslexie
            </button>
        </div>
    </section>

    <section class="space-y-2">
        <h3 class="text-sm font-semibold text-secondary-900 dark:text-secondary-100">Taille du texte</h3>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setSize"
                    data-accessibility-size-param="normal">
                Standard
            </button>
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setSize"
                    data-accessibility-size-param="large">
                Grande
            </button>
            <button type="button"
                    class="app-modal-footer-btn app-modal-footer-btn--secondary justify-center"
                    data-action="click->accessibility#setSize"
                    data-accessibility-size-param="xlarge">
                Tres grande
            </button>
        </div>
    </section>

    <section data-controller="theme" class="mt-8 border-t border-secondary-200 pt-6 dark:border-secondary-700">
        <h3 class="text-base font-semibold text-secondary-800 dark:text-secondary-100 mb-4 flex items-center gap-2">
            Theme
        </h3>

        <div class="flex items-center gap-4">
            {# Thème Normal (Bleu URCA) #}
            <button type="button"
                    data-theme-target="colorButton"
                    data-theme-name="normal"
                    data-action="click->theme#changeColorTheme"
                    class="w-10 h-10 rounded-full bg-[#4f46e5] shadow-sm transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-700 dark:focus:ring-offset-secondary-900"
                    aria-label="Thème par défaut (Bleu)"
                    title="Bleu">
            </button>

            {# Thème Vert #}
            <button type="button"
                    data-theme-target="colorButton"
                    data-theme-name="vert"
                    data-action="click->theme#changeColorTheme"
                    class="w-10 h-10 rounded-full bg-[#11b838] shadow-sm transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-600 dark:focus:ring-offset-secondary-900"
                    aria-label="Thème Vert"
                    title="Vert">
            </button>

            {# Thème Rouge #}
            <button type="button"
                    data-theme-target="colorButton"
                    data-theme-name="rouge"
                    data-action="click->theme#changeColorTheme"
                    class="w-10 h-10 rounded-full bg-[#ed1414] shadow-sm transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 dark:focus:ring-offset-secondary-900"
                    aria-label="Thème Rouge"
                    title="Rouge">
            </button>

            {# Thème Jaune/Ambre #}
            <button type="button"
                    data-theme-target="colorButton"
                    data-theme-name="jaune"
                    data-action="click->theme#changeColorTheme"
                    class="w-10 h-10 rounded-full bg-[#efb00d] shadow-sm transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 dark:focus:ring-offset-secondary-900"
                    aria-label="Thème Jaune"
                    title="Jaune">
            </button>
        </div>
    </section>

    <section class="space-y-3">
        <h3 class="text-sm font-semibold text-secondary-900 dark:text-secondary-100">Lisibilite</h3>
        <label class="flex items-center justify-between gap-3 rounded-lg border border-secondary-200 bg-secondary-50 px-3 py-2 text-sm dark:border-secondary-700 dark:bg-secondary-800/60">
            <span class="font-medium text-secondary-700 dark:text-secondary-200">Mode haut contraste</span>
            <input type="checkbox"
                   class="h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500"
                   data-accessibility-target="contrast"
                   data-action="change->accessibility#toggleContrast">
        </label>
        <label class="flex items-center justify-between gap-3 rounded-lg border border-secondary-200 bg-secondary-50 px-3 py-2 text-sm dark:border-secondary-700 dark:bg-secondary-800/60">
            <span class="font-medium text-secondary-700 dark:text-secondary-200">Reduire les animations</span>
            <input type="checkbox"
                   class="h-4 w-4 rounded border-secondary-300 text-primary-600 focus:ring-primary-500"
                   data-accessibility-target="motion"
                   data-action="change->accessibility#toggleMotion">
        </label>
    </section>

    <div class="flex items-center justify-between gap-3 border-t border-secondary-200 pt-4 dark:border-secondary-700">
        <p class="text-xs text-secondary-500 dark:text-secondary-400">Vous pouvez revenir aux reglages par defaut a tout
            moment.</p>
        <button type="button"
                class="app-modal-footer-btn app-modal-footer-btn--secondary"
                data-action="click->accessibility#reset">
            Reinitialiser
        </button>
    </div>
</div>

