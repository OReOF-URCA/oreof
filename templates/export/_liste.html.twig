<div class="space-y-4 p-4 sm:p-6">
    {% if composante is null %}
        <div class="rounded-xl border border-secondary-200 bg-secondary-50 px-4 py-3 text-sm text-secondary-700 dark:border-secondary-700 dark:bg-secondary-800/50 dark:text-secondary-200">
            Selectionnez une composante pour charger la liste des formations exportables.
        </div>
    {% else %}
        {% set nbExports = dpes|length %}
        <div class="rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-900 dark:border-cyan-800 dark:bg-cyan-950/30 dark:text-cyan-100">
            <strong>{{ nbExports }}</strong> export{{ nbExports > 1 ? 's' : '' }}
            disponible{{ nbExports > 1 ? 's' : '' }}.
        </div>
    {% endif %}

    <div class="overflow-x-auto rounded-xl border border-secondary-200 dark:border-secondary-700" {{ stimulus_controller('check_all') }}>
        <table class="min-w-full text-left text-sm text-secondary-700 dark:text-secondary-200">
            <thead class="bg-secondary-50 text-xs font-semibold uppercase tracking-wide text-secondary-500 dark:bg-secondary-800/70 dark:text-secondary-300">
            <tr>
                <th class="w-10 px-4 py-3">
                    <label class="inline-flex cursor-pointer items-center">
                        <input type="checkbox" id="check-all"
                               class="h-4 w-4 rounded border-secondary-300 text-cyan-600 focus:ring-cyan-500" {{ stimulus_action('check_all', 'checkAll') }}>
                        <span class="sr-only">Tout sélectionner</span>
                    </label>
                </th>
                <th class="px-4 py-3">Type de diplôme</th>
                <th class="px-4 py-3">Libellé formation</th>
                <th class="px-4 py-3">Libellé parcours</th>
                <th class="px-4 py-3">Remplissage</th>
                <th class="px-4 py-3">Etat</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-secondary-200 dark:divide-secondary-700">
            {% for dpe in dpes %}
                {% set parcours = dpe.parcours %}
                {% set formation = parcours.formation %}
                <tr class="align-top hover:bg-secondary-50/70 dark:hover:bg-secondary-800/40">
                    <td class="px-4 py-3">
                        <label class="inline-flex cursor-pointer items-center">
                            <input
                                    {{ stimulus_action('check_all', 'check') }}
                                    type="checkbox"
                                    class="check-all h-4 w-4 rounded border-secondary-300 text-cyan-600 focus:ring-cyan-500"
                                    name="liste[]"
                                    value="{{ dpe.id }}"
                            >
                            <span class="sr-only">Sélectionner l'export {{ dpe.id }}</span>
                        </label>
                    </td>
                    <td class="px-4 py-3">{{ formation.typeDiplome != null ? formation.typeDiplome.libelle : 'Non défini' }}</td>
                    <td class="px-4 py-3 font-medium text-secondary-800 dark:text-secondary-100">{{ formation.display }}</td>
                    <td class="px-4 py-3">
                        {% if parcours.isParcoursDefaut %}
                            <span class="inline-flex rounded-full border border-secondary-200 bg-secondary-50 px-2.5 py-1 text-xs font-semibold text-secondary-600 dark:border-secondary-700 dark:bg-secondary-950/30 dark:text-secondary-300">
                                Sans parcours
                            </span>
                        {% else %}
                            {{ parcours.display }}
                        {% endif %}
                    </td>
                    <td class="px-4 py-3">{{ component('remplissage_progress', { value: parcours.remplissage }) }}</td>
                    <td class="px-4 py-3">{{ include('communs/_badge_collection.html.twig', { badges: dpe.etatValidation|badgeDpeDto }) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6"
                        class="px-4 py-6 text-center text-sm font-medium text-secondary-500 dark:text-secondary-400">
                        Aucune formation
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
