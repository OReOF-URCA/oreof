{% form_theme form 'communs/form_theme_v2.html.twig' %}

<div class="space-y-4">
    {{ component('alerte', {
        type: 'info',
        message: 'export.modal_cfvu_date.info'|trans({}, 'modal')
    }) }}

    {{ form_start(form, {
        attr: (form.vars.attr ?? {})|merge(
            downloadMode|default(false)
                ? {'data-turbo': 'false', 'data-action': 'submit->modalturbo#close'}
                : {}
        )
    }) }}
        {% if downloadMode|default(false) %}
            <input type="hidden" name="download" value="1">
            {% if composanteId is defined and composanteId is not null %}
                <input type="hidden" name="composante" value="{{ composanteId }}">
            {% endif %}
        {% endif %}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
    {{ form_end(form) }}
</div>

