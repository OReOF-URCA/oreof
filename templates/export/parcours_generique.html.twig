{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" href="{{ asset('export-parcours/parcours_generique.css') }}">
{% endblock %}

{% block header %}
    Outil d'export des parcours
{% endblock %}

{% block content %}

    <i id="crossIcon" class="hidden cursor-pointer"><twig:UX:icon name="icon:close" class="w-5 h-5" /></i>

    <div 
        {{ stimulus_controller('export-generique--parcours-search', {
                'searchUrl': path('app_parcours_export_generique_search_by_name'),
                'campagneCollecte': campagneCollecte,
                'downloadParcoursPdfUrl': path('app_parcours_export_generique_download_pdf'),
                'downloadParcoursXlsxUrl': path('app_parcours_export_generique_xlsx'),
                'downloadFicheMatiereXslxUrl': path('fiche_matiere_export_generique_xlsx'),
                'downloadFicheMatierePdfUrl': path('fiche_matiere_export_generique_pdf')
            }) 
        }}
        class="flex flex-row justify-center"
    >
        <div class="flex w-11/12 lg:w-9/12 xl:w-8/12 justify-center">
            <form 
                {{ stimulus_target('export-generique--parcours-search', 'searchForm') }}
                method="get"
                class="w-full"
            >
                <div class="flex flex-row justify-center">
                    <div class="flex w-2/12 mb-2 justify-center">
                        <span class="self-center h-3/4 p-1 text-black font-bold bg-orange-300 text-lg rounded">
                            {{ periodeAnnee }}
                        </span>
                    </div>
                    <div class="flex w-10/12 lg:w-9/12 xl:w-8/12">
                        <div class="flex flex-row w-full justify-center">
                            <!-- 
                            <span class="h-1/2 py-0.5 px-1 self-center text-center text-white rounded bg-blue-400 dark:border-white border-blue-300">
                                Recherche de parcours
                            </span>
                            -->
                            <input 
                                {{ stimulus_target('export-generique--parcours-search', 'searchInput') }}
                                type="text" 
                                class="rounded-3xl w-9/12 p-3.5 border-2 dark:placeholder-white dark:border-white placeholder-gray-700 border-blue-300 mr-8 ml-2 h-14 self-center"
                                placeholder="Rechercher : composante, parcours, sigle, type de diplôme..."
                            >
                        </div>
                    </div>
                    <div 
                        {{ stimulus_action(
                            'export-generique--parcours-search', 
                            'loadResultList',
                            'click'
                            ) 
                        }}
                        class="flex flex-col justify-center text-center mt-2 md:mt-0"
                    >
                        <!-- Icône Rechercher -->
                        <span class="h-4/6 bg-blue-600 text-gray-50 p-1.5 rounded-xl" id="searchButton">
                            <twig:UX:icon name="icon:search" class="w-5 h-5" />
                        </span>
                        
                    </div>
                </div>
                <div class="flex flex-row justify-center my-8">
                    <div class="flex flex-col lg:flex-row text-center">
                        <span 
                            {{ stimulus_target('export-generique--parcours-search', 'selectAllParcoursButton') }}
                            {{ stimulus_action('export-generique--parcours-search', 'selectAllParcours', 'click') }}
                            class="badgeSearchAction my-3 lg:mt-0 px-1.5 py-1 rounded-lg bg-sky-500 text-white dark:bg-purple-700 mx-1"
                        >
                            Sélectionner tous les parcours
                        </span>
                        <span 
                            {{ stimulus_target('export-generique--parcours-search', 'emptySearchListButton') }}
                            {{ stimulus_action('export-generique--parcours-search', 'emptyResultListEvent', 'click') }}
                            class="badgeSearchAction my-3 lg:mt-0 px-1.5 py-1 rounded-lg bg-sky-500 text-white dark:bg-purple-700 mx-1 hidden"
                        >
                            Cacher la liste de recherche
                        </span>
                    </div>
                </div>
                <div class="flex flex-col justify-center mt-4">
                    <div 
                        {{ stimulus_target('export-generique--parcours-search', 'loadingIcon') }}
                        class="flex-12 text-center hidden"
                    >
                        <i class="fa-duotone fa-solid fa-spinner loading-icon"></i>
                    </div>
                    <div 
                        {{ stimulus_target('export-generique--parcours-search', 'searchResult') }}
                        class="self-center w-5/6 lg:w-4/6 result-scrollbar"
                        id="searchResultNode"
                    >

                    </div>
                </div>
                <div 
                    {{ stimulus_target('export-generique--parcours-search', 'selectedParcours') }}
                    class="flex flex-row flex-wrap justify-center mt-3 mb-3"
                >

                </div>

                <div class="flex flex-row justify-center mt-8">
                    <div class="flex flex-wrap justify-center">
                        <span 
                            {{ stimulus_target('export-generique--parcours-search', 'displayDataParcours') }}
                            {{ stimulus_action('export-generique--parcours-search', 'displayParcoursChoices', 'click') }}
                            class="mt-4 bg-blue-500 hover:bg-blue-700 text-white py-1.5 px-2.5 border border-blue-700 rounded-lg ml-3 lg:ml-1.5 cursor-pointer"
                        >
                            Export des Parcours
                        </span>
                        <span 
                            {{ stimulus_target('export-generique--parcours-search', 'displayDataFicheMatiere') }}
                            {{ stimulus_action('export-generique--parcours-search', 'displayFicheMatiereChoices', 'click') }}
                            class="mt-4 bg-blue-500 hover:bg-blue-700 text-white py-1.5 px-2.5 border border-blue-700 rounded-lg ml-3 lg:ml-1.5 cursor-pointer"
                        >
                            Export des Fiches matières
                        </span>
                        <span
                            {{ stimulus_target('export-generique--parcours-search', 'displayDataExportTemplate') }}
                            {{ stimulus_action('export-generique--parcours-search', 'displayExportTemplateChoices', 'click') }}
                            class="mt-4 bg-blue-500 hover:bg-blue-700 text-white py-1.5 px-2.5 border border-blue-700 rounded-lg ml-3 lg:ml-1.5 cursor-pointer"
                        >
                            Format d'export prédéfini
                        </span>
                    </div>
                </div>

                <div class="flex-12">
                    <div class="flex flex-row justify-center">
                        <div class="flex sm:flex-2 md:flex-8 lg:flex-6 justify-center hidden" id="parcoursSelectData">
                            <div class="flex flex-row flex-wrap sm:w-5/6 lg:w-4/6 justify-center mt-4">
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span 
                                        data-export-field="respParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Responsable(s) du parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span 
                                        data-export-field="respFormation"
                                        class="textDivFieldChoice"
                                    >
                                        Responsable(s) de la formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span 
                                        data-export-field="resultatsAttendusParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Résultats attendus du parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span 
                                        data-export-field="objectifsParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Objectifs du parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span 
                                        data-export-field="objectifsFormation"
                                        class="textDivFieldChoice"
                                    >
                                        Objectifs de la formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="competencesAcquises"
                                        class="textDivFieldChoice"
                                    >
                                        Compétences Acquises
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="poursuiteEtudes"
                                        class="textDivFieldChoice"
                                    >
                                        Poursuites d'études
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="contenuParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Contenu du parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="contenuFormation"
                                        class="textDivFieldChoice"
                                    >
                                        Contenu de la formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="debouchesParcours"
                                        class="textDivFieldChoice"
                                    >   
                                        Débouchés
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="localisationParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Localisation du parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="contactsPedagogiques"
                                        class="textDivFieldChoice"
                                    >
                                        Contacts pédagogiques
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="identiteFormation"
                                        class="textDivFieldChoice"
                                    >
                                        Identité de la formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="rythmeFormation"
                                        class="textDivFieldChoice"
                                    >
                                        Rythme de formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="informationsInscription"
                                        class="textDivFieldChoice"
                                    >
                                        Inscription
                                    </span>
                                
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="admissionParcours"
                                        class="textDivFieldChoice"
                                    >
                                        Admission
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="codesRome"
                                        class="textDivFieldChoice"
                                    >
                                        Codes ROME
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="stageInfos"
                                        class="textDivFieldChoice"
                                    >
                                        Stage
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="memoireInfos"
                                        class="textDivFieldChoice"
                                    >
                                        Mémoire
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="projetInfos"
                                        class="textDivFieldChoice"
                                    >
                                        Projet
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="modalitesEnseignement"
                                        class="textDivFieldChoice"
                                    >
                                        Modalités d'enseignement
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="typeDiplome"
                                        class="textDivFieldChoice"
                                    >
                                        Type Diplôme
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="composantePorteuse"
                                        class="textDivFieldChoice"
                                    >
                                        Composante porteuse
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="semestresOuverts"
                                        class="textDivFieldChoice"
                                    >
                                        Semestres ouverts
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="niveauEntree"
                                        class="textDivFieldChoice"
                                    >
                                        Niveau d'entrée
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 divFieldChoice">
                                    <span
                                        data-export-field="niveauSortie"
                                        class="textDivFieldChoice"
                                    >
                                        Niveau de sortie
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-row justify-center">
                        <div class="flex sm:flex-2 md:flex-8 lg:flex-6 justify-center hidden" id="ficheMatiereSelectData">
                            <div class="flex flex-row flex-wrap sm:w-5/6 lg:w-3/6 justify-center mt-4">
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmId"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Identifiant
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmLibelle"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Libellé
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmReferent"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Référent
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmParcoursPorteur"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Parcours porteur
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmFormation"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Formation
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmNbUtilisee"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Nb. utilisations
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 fmDivFieldChoice">
                                    <span
                                        data-export-fm-field="fmIsComplet"
                                        class="fmTextDivFieldChoice"
                                    >
                                        Complet
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-row justify-center">
                        <div class="flex sm:flex-2 md:flex-8 lg:flex-6 justify-center hidden" id="exportTemplateData">
                            <div class="flex flex-row flex-wrap sm:w-5/6 lg:w-3/6 justify-center mt-4">
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateSEIP"
                                        class="textDivExportTemplateData"
                                    >
                                        SEIP
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateFicheParcours"
                                        class="textDivExportTemplateData"
                                    >
                                        Fiche Parcours
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateResponsables"
                                        class="textDivExportTemplateData"
                                    >
                                        Responsables
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateSemestresOuverts"
                                        class="textDivExportTemplateData"
                                    >
                                        Semestres ouverts
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateExportRegime"
                                        class="textDivExportTemplateData"
                                    >
                                        Export régime
                                    </span>                                
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateExportCapApogee"
                                        class="textDivExportTemplateData"
                                        {{ stimulus_controller('tooltip', { placement: 'top' } )}}
                                        title="Cet export n'est disponible qu'au format Excel (Xlsx)"
                                    >
                                        Export Fiabilisation APOGEE
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateExportListeFicheMatiere"
                                        class="textDivExportTemplateData"
                                    >
                                        Liste Fiches Matières
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateExportCARIF"
                                        class="textDivExportTemplateData"
                                    >
                                        Export CARIF
                                    </span>
                                </div>
                                <div class="flex flex-auto mt-2 exportTemplateChoice">
                                    <span
                                        data-export-template="templateExportCFVU"
                                        class="textDivExportTemplateData"
                                    >
                                        Export CFVU
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col justify-center mt-5">
                    <div class="flex flex-col sm:flex-6 md:flex-5 lg:flex-4 xl:flex-3 justify-center">
                        <div
                            {{ stimulus_target('export-generique--parcours-search', 'needParcoursSelect') }} 
                            class="flex flex-auto justify-center hidden mb-5"
                        >
                            <span class="fw-bold text-red-500">
                                Vous devez choisir au moins un parcours
                            <span>
                        </div>
                        <div 
                            {{ stimulus_target('export-generique--parcours-search', 'needDataSelect') }}
                            class="flex flex-auto justify-center mt-2 mb-5 hidden"
                        >
                            <span class="fw-bold text-red-500">
                                Vous devez choisir un type de donnée à exporter
                            </span>
                        </div>
                    </div>                    
                    <div class="flex flex-row justify-center mt-8">
                        <div class="flex justify-center mt-1 mx-2">
                            <span 
                                {{ stimulus_action('export-generique--parcours-search', 'sendExportRequest', 'click', {'type': 'pdf'}) }}
                                class="bg-blue-800 hover:bg-blue-400 text-white py-0.5 px-2.5 border border-gray-600 rounded-lg cursor-pointer text-center" 
                                id="downloadExport"
                            >
                                Télécharger l'export (PDF)
                            </span>
                        </div>
                        <div class="flex justify-center mt-1 mx-2">
                            <span 
                                {{ stimulus_action('export-generique--parcours-search', 'sendExportRequest', 'click', {'type': 'xlsx'}) }}
                                class="bg-blue-800 hover:bg-blue-400 text-white py-0.5 px-2.5 border border-gray-600 rounded-lg cursor-pointer text-center" 
                            >
                                Télécharger l'export (Xlsx)
                            </span>
                        </div>
                    </div>
                    <div class="flex flex-row justify-center my-2">
                        <div class="flex-4 sm:flex-3 md:flex-2 lg:flex-1 text-center">
                            <i 
                                {{ stimulus_controller('tooltip', { placement: 'bottom' }) }}
                                title="S'il y a plus de 50 parcours sélectionnés, l'export vous sera envoyé par e-mail"
                                class="fa-solid fa-circle-info bg-blue text-white rounded text-xl"
                            ></i>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}