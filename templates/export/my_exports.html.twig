{% extends 'base.html.twig' %}
{# deprecated ? #}
{% block bouton_header %}

{% endblock %}

{% block content %}
    <h2>Mes exports</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Type</th>
            <th>Paramètres</th>
            <th>Statut</th>
            <th>Début</th>
            <th>Fin</th>
            <th>Durée (s)</th>
            <th>Fichier</th>
        </tr>
        </thead>
        <tbody>
        {% for job in jobs %}
            <tr>
                <td>{{ job.type }}</td>
                <td>{{ job.parameters|json_encode }}</td>
                <td>{{ component('Badge', { dto: job.status|badgeStatusDto }) }}</td>
                <td>{{ job.startedAt ? job.startedAt|date('Y-m-d H:i:s') : '-' }}</td>
                <td>{{ job.finishedAt ? job.finishedAt|date('Y-m-d H:i:s') : '-' }}</td>
                <td>{{ job.durationSec }}</td>
                <td>
                    {% if job.resultPath %}
                        <a href="{{ asset(job.resultPath) }}" download>Télécharger</a>
                        ({{ job.resultFormat }}, {{ (job.resultSize / 1024)|round }} Ko)
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}

