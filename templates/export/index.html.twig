{% extends 'base.html.twig' %}

{% set frame_id = 'export_formations_frame' %}
{% set selectedComposanteId = composante is defined and composante ? composante.id : null %}
{% set frame_src = selectedComposanteId ? path('app_export_liste', { composante: selectedComposanteId }) : null %}



{% block content %}
    <div
            {{ stimulus_controller('export', {
                listUrl: path('app_export_liste')
            }) }}
            class="space-y-4"
    >
        <template {{ stimulus_target('export', 'pendingStateTemplate') }}>
            {{ include('export/_generation_state.html.twig', {
                state: 'idle',
                message: 'Generation en attente',
                details: 'Selectionnez les formations puis lancez une nouvelle generation.'
            }) }}
        </template>

        {% form_theme form 'communs/form_theme_v2.html.twig' %}
        {{ form_start(form, {
            action: path('app_export_valide'),
            attr: {
                'class': 'space-y-4',
                'data-action': 'turbo:submit-start->export#disableSubmit turbo:submit-end->export#enableSubmit'
            }
        }) }}
            <twig:Card>

                <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
                    <div class="space-y-4">
                        {{ form_row(form.composante) }}
                        {% if not ses is defined or ses == false and isCfvu is defined and isCfvu == false %}
                            <input type="hidden" name="composante" value="{{ composante.id }}">
                        {% endif %}

                        {{ form_row(form.type_document) }}

                        {% if form.date is defined %}
                            {{ form_row(form.date) }}
                        {% endif %}
                    </div>

                    <div class="space-y-4">
                        {% if form.type_document_global is defined %}
                            {{ form_row(form.type_document_global) }}
                        {% endif %}
                    </div>

                    <div class="lg:col-span-2 space-y-4">
                        <div class="flex flex-wrap items-center gap-3">
                            <button type="submit"
                                    {{ stimulus_target('export', 'submit') }}
                                    class="app-btn app-btn-success inline-flex items-center gap-2"
                            >
                                <span aria-hidden="true">+</span>
                                Generer les documents
                            </button>
                        </div>

                        {{ component('alerte', {
                            type: 'info',
                            message: 'Les documents seront generes et un lien de telechargement sera envoye par email',
                            id: 'alerte-success'
                        }) }}
                    </div>
                </div>
            </twig:Card>

            <div id="generation_state" {{ stimulus_target('export', 'generationState') }}>
                {{ include('export/_generation_state.html.twig', {
                    state: 'idle',
                    message: 'Aucune generation en cours',
                    details: 'Lancez un export pour suivre son etat ici.'
                }) }}
            </div>

            <section
                    class="rounded-2xl border border-secondary-200 bg-white shadow-sm dark:border-secondary-700 dark:bg-secondary-900">
                <turbo-frame id="{{ frame_id }}"
                        {{ frame_src ? 'src="' ~ frame_src ~ '"' }}
                        {{ stimulus_target('export', 'frame') }}
                >
                    {{ include('export/_liste.html.twig', { dpes: [], composante: null }) }}
                </turbo-frame>
            </section>
        {{ form_end(form) }}
    </div>
{% endblock %}
