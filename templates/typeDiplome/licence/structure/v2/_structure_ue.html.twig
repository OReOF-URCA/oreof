<div class="flex items-start justify-between gap-4 border-b border-secondary-200 dark:border-secondary-700 bg-bg px-4 py-3 text-[10px] font-bold uppercase tracking-tight text-secondary-400 {% if enfant is defined and enfant %}border-l-4 border-l-amber-300 bg-amber-50/40{% endif %}">
    {% set hasDistancielData = ue.heuresEctsUe.sommeUeTotalDist > 0 %}

    <div class="flex items-center gap-4">
        <div class="flex h-12 min-w-12 items-center justify-center rounded-md {% if enfant is defined and enfant %}bg-warning-600 shadow-warning-100 dark:shadow-warning-800{% else %}bg-primary-600 shadow-primary-100 dark:shadow-primary-800{% endif %} text-white font-black shadow-lg">
            <span>{{ ue.display }}</span>
        </div>

        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-semibold normal-case tracking-normal text-secondary-800 dark:text-secondary-400">
                    {{ ue.ue.libelle }}
                </span>
                {% if ue.raccroche == true %}
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-1 text-[10px] font-black text-amber-700">
                        <i class="fal fa-link"></i> Raccrochée
                    </span>
                {% endif %}
                {% if ue.ue.ueMutualisables|length >0 %}
                    <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 px-2 py-1 text-[10px] font-black text-sky-700"
                          data-controller="tooltip"
                          data-tooltip-placement-value="bottom"
                          title="UE mutualisée">
                        <i class="fal fa-share-nodes"></i> Mutualisée
                    </span>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="rounded-full bg-secondary-200 px-2 py-1 text-[10px] font-semibold text-secondary-500 normal-case">#{{ ue.ue.id }}</span>
                {% endif %}
            </div>

            {% if isVersioning is not defined or isVersioning == false %}
                <p class="mt-1 text-xs font-medium normal-case text-secondary-500">Code Apogée : {{ ue.codeApogee() }}</p>
            {% endif %}
        </div>
    </div>

    <span class="flex flex-wrap items-center justify-end gap-2 text-indigo-600 font-black whitespace-nowrap">
        {% if ue.ue.natureUeEc is defined and ue.ue.natureUeEc != null and ue.ue.natureUeEc.libre == true %}
            <twig:Badge label="UE a choix libre" variant="secondary"/>
        {% endif %}
        {% if ue.uesEnfants|length > 0 %}
            <twig:Badge label="UE a choix restreint : {{ ue.uesEnfants|length }} choix possibles" variant="info"/>
        {% endif %}
        {% if hasDistancielData %}
            <twig:Badge label="Distanciel : {{ ue.heuresEctsUe.sommeUeTotalDist|filtreHeures }} h" variant="warning"/>
        {% endif %}
    </span>
</div>

{% if ue.ue.natureUeEc is defined and ue.ue.natureUeEc != null and ue.ue.natureUeEc.libre == true %}

    {# ---- Cas 1 : UE à choix libre ---- #}
    {% set hasDistancielData = ue.heuresEctsUe.sommeUeTotalDist > 0 %}
    {% if presentiel %}{% set colspan = 4 %}{% elseif distanciel %}{% set colspan = 8 %}{% else %}{% set colspan = 0 %}{% endif %}
    <table class="w-full text-xs">
        <tbody>
        <tr class="ec">
            <td colspan="{{ colspan + 5 }}"
                class="px-4 py-4 text-sm leading-relaxed text-secondary-700 bg-secondary-50/60">{{ ue.ue.descriptionUeLibre }}</td>
        </tr>
        </tbody>
        <tfoot class="text-[10px] font-black uppercase tracking-tighter text-secondary-600 bg-secondary-50/30 border-b border-secondary-100 text-center">
        {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </tfoot>
    </table>

{% elseif ue.uesEnfants|length > 0 %}

    {# ---- Cas 2 : UE à choix restreint — les sous-UEs sont des blocs autonomes ---- #}
    {% for ueE in ue.uesEnfants %}
        {{ include('typeDiplome/licence/structure/v2/_structure_ue.html.twig', {ue: ueE, enfant: true, diffUe: diffUe.uesEnfants[loop.index0] ?? null}) }}
    {% endfor %}

    {# Total de l'UE parente dans son propre tableau (hors des sous-tables) #}
    <table class="w-full text-xs">
        <tfoot class="text-[10px] font-black uppercase tracking-tighter text-secondary-600 bg-secondary-50/30 border-b border-secondary-100 text-center">
        {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </tfoot>
    </table>

{% else %}

    {# ---- Cas 3 : UE normale avec ECs ---- #}
    {% set hasDistancielData = ue.heuresEctsUe.sommeUeTotalDist > 0 %}
    {% set distancielInline = presentiel and (not distanciel) and hasDistancielData %}
    <table class="w-full text-xs bg-white">
        <thead class="text-[10px] font-black uppercase tracking-tighter text-secondary-400 bg-bg border-b border-secondary-100 text-center">
        <tr class="ec">
            <th class="px-5 py-3 text-left w-2/5 font-bold">
                Fiche EC/Matiere
                {% if distancielInline %}
                    <span class="ml-2 inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[9px] font-black text-orange-700">
                        Dist. integre
                    </span>
                {% endif %}
            </th>
            <th class="py-3">MCCC</th>
            <th class="py-3">ECTS</th>
            {% if presentiel %}
                <th class="w-14 py-3 bg-primary-50 dark:bg-primary-800 bg-opacity-30 text-primary dark:text-primary-400">CM</th>
                <th class="w-14 py-3 bg-primary-50 dark:bg-primary-800 bg-opacity-30 text-primary dark:text-primary-400">TD</th>
                <th class="w-14 py-3 bg-primary-50 dark:bg-primary-800 bg-opacity-30 text-primary dark:text-primary-400">TP</th>
                <th class="w-14 py-3 bg-primary-50 dark:bg-primary-800 bg-opacity-30 text-primary dark:text-primary-400">Total Prés.</th>
                <th class="w-14 py-3 bg-primary-50 dark:bg-primary-800 bg-opacity-30 text-primary dark:text-primary-400">TE</th>
            {% endif %}
            {% if distanciel %}
                <th class="w-14 py-3 bg-warning-50 dark:bg-warning-800 bg-opacity-30 text-warning-400 dark:text-warning-300">CM</th>
                <th class="w-14 py-3 bg-warning-50 dark:bg-warning-800 bg-opacity-30 text-warning-400 dark:text-warning-300">TD</th>
                <th class="w-14 py-3 bg-warning-50 dark:bg-warning-800 bg-opacity-30 text-warning-400 dark:text-warning-300">TP</th>
                <th class="w-14 py-3 bg-warning-50 dark:bg-warning-800 bg-opacity-30 text-warning-400 dark:text-warning-300">Total Dis.</th>
            {% endif %}
            {% if parcours.modalitesEnseignement != null and parcours.modalitesEnseignement.value == 1 %}
                <th class="px-5 py-3 text-right text-secondary-900 dark:text-secondary">Total</th>
            {% endif %}
        </tr>
        </thead>
        <tbody class="divide-y divide-secondary-100 dark:divide-secondary-700 dark:border-secondary-700">
        {% for ordEc, ec in ue.elementConstitutifs %}
            {% set indexEc = loop.index0 %}
            {{ include('typeDiplome/licence/structure/v2/_structure_ec.html.twig', {
                ec: ec,
                semestreOrdre: semestreOrdre,
                ecEnfant: false,
                diffEc: diffUe.elementConstitutifs[ordEc] ?? null,
                indexEc: indexEc,
                indexEcEnfant: -1,
                UeDisplay: ue.display,
                distancielAuto: hasDistancielData,
                distancielInline: distancielInline
            }) }}
            {% for ordEce, ece in ec.elementsConstitutifsEnfants %}
                {% set indexEcEnfant = loop.index0 %}
                {{ include('typeDiplome/licence/structure/v2/_structure_ec.html.twig', {
                    ec: ece,
                    semestreOrdre: semestreOrdre,
                    ecEnfant: true,
                    diffEc: diffUe.elementConstitutifs[ordEc].ecEnfants[ordEce] ?? null,
                    indexEc: indexEc,
                    indexEcEnfant: indexEcEnfant,
                    UeDisplay: ue.display,
                    distancielAuto: hasDistancielData,
                    distancielInline: distancielInline
                }) }}
            {% endfor %}
        {% endfor %}
        </tbody>
        <tfoot class="text-[10px] font-black uppercase tracking-tighter text-secondary-600 bg-secondary-50/30 border-b border-secondary-100 text-center">
        {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </tfoot>
    </table>

{% endif %}

