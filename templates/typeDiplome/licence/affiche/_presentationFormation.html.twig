{% set dtClass = 'text-[11px] font-black uppercase tracking-wide text-primary-500 dark:text-primary-300' %}
{% set ddClass = 'mt-2 text-sm leading-relaxed text-secondary-700 dark:text-secondary-400' %}
{% set blockClass = 'rounded-xl border border-secondary-200 dark:border-secondary-700 bg-bg p-4' %}
{% set proseBoxClass = 'mt-2 rounded-xl border border-secondary-200 dark:border-secondary-700 bg-surface px-4 py-3 text-sm leading-relaxed text-secondary-700 dark:text-secondary-300' %}

{% if formation.hasParcours == false %}
    <dl class="space-y-4">
        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Contenu de la formation</dt>
            <dd class="{{ proseBoxClass }}">{{ formation.contenuFormation|raw }}</dd>
        </div>
        {% if stringDifferencesFormation.presentationFormationContenuFormation is defined %}
            {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                textDifferences: stringDifferencesFormation.presentationFormationContenuFormation,
                idCollapse: 'diffGlobalParcours'
            }) }}
        {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Résultats attendus de la formation</dt>
            <dd class="{{ ddClass }}">{{ formation.resultatsAttendus|raw }}</dd>
        </div>
        {% if stringDifferencesFormation.presentationFormationResultatsAttendus is defined %}
            {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                textDifferences: stringDifferencesFormation.presentationFormationResultatsAttendus,
                idCollapse: 'diffGlobalParcours'
            }) }}
        {% endif %}

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Rythme de formation</dt>
            <dd class="{{ ddClass }}">{{ formation.rythmeFormation != null ? formation.rythmeFormation.libelle : 'Non précisé' }}</dd>
        </div>

        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Précisions sur le rythme de formation</dt>
            <dd class="{{ ddClass }}">{{ formation.rythmeFormationTexte|raw }}</dd>
        </div>
    </dl>
{% else %}
    <dl class="space-y-4">
        <div class="{{ blockClass }}">
            <dt class="{{ dtClass }}">Organisation et objectifs de la formation</dt>
            <dd class="{{ proseBoxClass }}">{{ formation.objectifsFormation|raw }}</dd>
        </div>
        {% if stringDifferencesFormation.presentationFormationObjectifsFormation is defined %}
            {{ include('communs/_comparaison_versioning_no_button.html.twig', {
                textDifferences: stringDifferencesFormation.presentationFormationObjectifsFormation,
                idCollapse: 'diffGlobalParcours'
            }) }}
        {% endif %}
    </dl>
{% endif %}

{% if (print is defined and print == false) %}
    {% if formation.isHasParcours == true %}
        <div>
            <h3 class="mt-3 text-[12px] font-black uppercase tracking-wide text-primary-500 dark:text-primary-300">Parcours</h3>
            <div class="w-full overflow-x-auto">
                <table class="w-full min-w-[720px] table-auto divide-y divide-secondary-200 rounded-lg bg-white shadow-sm">
                    <thead class="bg-bg">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">Parcours</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">Statut</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">Fiche</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">Export MCCC
                        </th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">BCC</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold uppercase text-secondary-600 dark:text-secondary-400">Fiches EC /
                            matières
                        </th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-secondary-100 dark:divide-secondary-800 text-sm text-secondary-700 dark:text-secondary-300">
                    {% for parcours in formation.parcours %}
                        <tr class="bg-surface hover:bg-bg">
                            <td class="px-4 py-3">
                                <a href="#presentation_{{ parcours.id }}"
                                   class="inline-flex items-center gap-2 text-secondary-800 dark:text-secondary-300 hover:text-primary-600 dark:hover:text-primary-400">
                                    <span class="font-medium">{{ parcours.libelle }}</span>
                                    <span class="inline-block">{{ component('Badge', { dto: parcours.typeParcours|badgeTypeParcours }) }}</span>
                                </a>
                            </td>
                            <td class="px-4 py-3">
                                {{ component('Badge', { dto: parcours.dpeParcours[0].etatReconduction|badgeTypeModificationDto }) }}
                            </td>
                            <td class="px-4 py-3 text-center">
                                <twig:Button
                                        href="{{ path('parcours_v2_voir', {parcours: parcours.id}) }}"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        variant="info"
                                        size="sm"
                                        icon="icon:info"
                                        label="Fiche descriptive"
                                        tooltip="Voir la fiche descriptive du parcours"
                                />
                            </td>
                            <td class="px-4 py-3 text-center">
                                {{ include('btn/export_mccc.html.twig') }}
                            </td>
                            <td class="px-4 py-3 text-center">
                                {{ component('dropdown_actions', {
                                    label: 'BCC',
                                    help: 'Exports BCC',
                                    icon: 'icon:download',
                                    labelSrOnly: false,
                                    items: [
                                        { label: 'Voir en ligne', icon: 'icon:info', url: path('app_parcours_bcc', {parcours: parcours.id}) },
                                        { label: 'Export des BCC (pdf)', icon: 'icon:download', url: path('app_competence_export_bcc', {parcours: parcours.id}) },
                                        { label: 'Export tableau croise BCC/EC (pdf)', icon: 'icon:download', url: path('app_competence_export_croise', {parcours: parcours.id}) },
                                        { label: 'Export croise global (xlsx)', icon: 'teenyicons:spreadsheet-outline', url: path('app_competence_export_croise_global', {parcours: parcours.id}) }
                                    ]
                                }) }}
                            </td>
                            <td class="px-4 py-3 text-center">
                                {{ component('dropdown_actions', {
                                    label: 'Fiches EC / matieres',
                                    help: 'Exports fiches EC/matieres',
                                    icon: 'icon:download',
                                    labelSrOnly: false,
                                    items: [
                                        { label: 'Version complete (1 pdf)', icon: 'teenyicons:pdf-outline', url: path('fiche_matiere_export_all', {parcours: parcours.id}) },
                                        { label: 'Version zip (1 pdf / fiche)', icon: 'teenyicons:zip-outline', url: path('fiche_matiere_export_zip', {parcours: parcours.id}) }
                                    ]
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="rounded-xl border border-secondary-200 bg-white p-4 shadow-sm">
            <h3 class="text-sm font-semibold text-secondary-800 dark:text-secondary-100">Parcours</h3>
            <p class="mt-1 text-sm text-secondary-600">Il n'y a pas de parcours pour cette formation.</p>
        </div>
    {% endif %}
{% endif %}
