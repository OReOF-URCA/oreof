{% set diffSemestre = diffStructure is defined and diffStructure != null ? diffStructure.semestres[ordre] ?? null : null %}
{% set semEcts = semestre.heuresEctsSemestre.sommeSemestreEcts %}

<div class="relative ml-2 border-l-2 border-secondary-200 pb-8 pl-6 md:ml-6 md:pl-8 dark:border-secondary-700">
    <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-4 border-surface bg-primary-600 shadow-xs"></div>

    {# En-tête du Semestre #}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-600 font-bold text-white shadow-xs">
                S{{ ordre }}
            </span>
            <div>
                <h3 class="text-xl font-bold text-secondary-900 dark:text-white">
                    Semestre {{ ordre }}
                </h3>
                <p class="text-xs text-secondary-500 dark:text-secondary-400">Unités d'enseignement et éléments constitutifs</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold {% if semEcts == 30 %}bg-success-100 text-success-800 dark:bg-success-900/40 dark:text-success-300{% else %}bg-primary-100 text-primary-800 dark:bg-primary-900/40 dark:text-primary-300{% endif %}">
                {{ ux_icon('ph:certificate-bold', {class: 'w-3.5 h-3.5'}) }}
                {{ semEcts }} ECTS
            </span>
            {% if presentiel %}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-secondary-100 px-3 py-1 text-xs font-semibold text-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">
                    {{ ux_icon('ph:clock-bold', {class: 'w-3.5 h-3.5'}) }}
                    {{ semestre.heuresEctsSemestre.sommeSemestreTotalPres|filtreHeures }} h présentielles
                </span>
            {% endif %}
            {% if distanciel or semestre.heuresEctsSemestre.sommeSemestreTotalDist > 0 %}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-warning-100 px-3 py-1 text-xs font-semibold text-warning-800 dark:bg-warning-900/40 dark:text-warning-300">
                    {{ ux_icon('ph:laptop-bold', {class: 'w-3.5 h-3.5'}) }}
                    {{ semestre.heuresEctsSemestre.sommeSemestreTotalDist|filtreHeures }} h distanciel
                </span>
            {% endif %}
        </div>
    </div>

    {# Liste des UEs dans le semestre #}
    <div class="space-y-5">
        {% for ordUe, ue in semestre.ues %}
            <div class="overflow-hidden rounded-2xl border border-secondary-200 bg-surface shadow-xs dark:border-secondary-700">
                {{ include('typeDiplome/licence/structure/v2/_structure_ue.html.twig', {
                    semestreOrdre: ordre,
                    enfant: false,
                    diffUe: diffSemestre != null ? diffSemestre.ues[ordUe] ?? null : null,
                }) }}
            </div>
        {% endfor %}
    </div>

    {# Bilan récapitulatif du semestre #}
    <details class="group mt-6 ml-auto max-w-fit overflow-hidden rounded-2xl border border-secondary-200 bg-surface shadow-md dark:border-secondary-700 dark:bg-secondary-900">
        <summary class="flex cursor-pointer list-none flex-col gap-4 px-5 py-3.5 md:flex-row md:items-center md:justify-between md:gap-6">
            <span class="flex flex-wrap items-center gap-5 text-xs font-bold">
                <span class="rounded-md bg-secondary-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">Total S{{ ordre }}</span>
                {% if presentiel %}
                    <span class="text-center">
                        <span class="block text-[9px] font-bold uppercase text-primary-600 dark:text-primary-400">Présentiel</span>
                        <span class="block text-sm font-black text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreTotalPres|filtreHeures }} h</span>
                    </span>
                {% endif %}
                {% if distanciel or semestre.heuresEctsSemestre.sommeSemestreTotalDist > 0 %}
                    <span class="text-center">
                        <span class="block text-[9px] font-bold uppercase text-warning-600 dark:text-warning-400">Distanciel</span>
                        <span class="block text-sm font-black text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreTotalDist|filtreHeures }} h</span>
                    </span>
                {% endif %}
                <span class="text-center">
                    <span class="block text-[9px] font-bold uppercase text-primary-600 dark:text-primary-400">ECTS</span>
                    <span class="block text-sm font-black text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreEcts }} ECTS</span>
                </span>
            </span>

            <span class="flex items-center gap-4 md:text-right">
                <span>
                    <span class="block text-[9px] font-bold uppercase text-secondary-500 dark:text-secondary-400">Volume semestre</span>
                    <span class="block text-xl font-black italic tracking-tight text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreTotalPresDist|filtreHeures }} h</span>
                    {% if semestre.heuresEctsSemestre.sommeSemestreTePres > 0 %}
                        <span class="mt-0.5 block text-[10px] font-medium text-success-600 dark:text-success-400">+ {{ semestre.heuresEctsSemestre.sommeSemestreTePres|filtreHeures }} h autonomie</span>
                    {% endif %}
                </span>
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-secondary-200 bg-secondary-50 text-secondary-600 transition group-open:rotate-180 dark:border-secondary-700 dark:bg-secondary-800 dark:text-secondary-300">
                    {{ ux_icon('ph:caret-down-bold', {class: 'h-4 w-4'}) }}
                </span>
            </span>
        </summary>

        <div class="border-t border-secondary-200 bg-secondary-50/50 px-5 py-4 dark:border-secondary-700 dark:bg-secondary-950/40">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-primary-200 bg-primary-50/40 p-3.5 dark:border-primary-800 dark:bg-primary-950/20">
                    <p class="text-[10px] font-black uppercase tracking-wider text-primary-700 dark:text-primary-300">Détail présentiel</p>
                    <p class="mt-1 text-lg font-black text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreTotalPres|filtreHeures }} h</p>
                    <div class="mt-3 flex flex-wrap gap-1.5 text-xs font-semibold text-secondary-700 dark:text-secondary-300">
                        <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">CM {{ semestre.heuresEctsSemestre.sommeSemestreCmPres|filtreHeures }} h</span>
                        <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">TD {{ semestre.heuresEctsSemestre.sommeSemestreTdPres|filtreHeures }} h</span>
                        <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">TP {{ semestre.heuresEctsSemestre.sommeSemestreTpPres|filtreHeures }} h</span>
                    </div>
                </div>

                {% if distanciel or semestre.heuresEctsSemestre.sommeSemestreTotalDist > 0 %}
                    <div class="rounded-xl border border-warning-200 bg-warning-50/40 p-3.5 dark:border-warning-800 dark:bg-warning-950/20">
                        <p class="text-[10px] font-black uppercase tracking-wider text-warning-700 dark:text-warning-300">Détail distanciel</p>
                        <p class="mt-1 text-lg font-black text-secondary-900 dark:text-white">{{ semestre.heuresEctsSemestre.sommeSemestreTotalDist|filtreHeures }} h</p>
                        <div class="mt-3 flex flex-wrap gap-1.5 text-xs font-semibold text-secondary-700 dark:text-secondary-300">
                            <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">CM {{ semestre.heuresEctsSemestre.sommeSemestreCmDist|filtreHeures }} h</span>
                            <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">TD {{ semestre.heuresEctsSemestre.sommeSemestreTdDist|filtreHeures }} h</span>
                            <span class="rounded-md bg-surface px-2.5 py-1 shadow-2xs">TP {{ semestre.heuresEctsSemestre.sommeSemestreTpDist|filtreHeures }} h</span>
                        </div>
                    </div>
                {% endif %}

                <div class="rounded-xl border border-secondary-200 bg-surface p-3.5 dark:border-secondary-700">
                    <p class="text-[10px] font-black uppercase tracking-wider text-secondary-600 dark:text-secondary-400">Synthèse ECTS & Volume</p>
                    <p class="mt-1 text-lg font-black text-secondary-900 dark:text-white">{{ semEcts }} ECTS</p>
                    <div class="mt-3 flex flex-wrap gap-1.5 text-xs font-semibold text-secondary-700 dark:text-secondary-300">
                        <span class="rounded-md bg-secondary-100 px-2.5 py-1 dark:bg-secondary-800">Total : {{ semestre.heuresEctsSemestre.sommeSemestreTotalPresDist|filtreHeures }} h</span>
                        {% if semestre.heuresEctsSemestre.sommeSemestreTePres > 0 %}
                            <span class="rounded-md bg-success-50 text-success-700 px-2.5 py-1 dark:bg-success-950/30 dark:text-success-300">+ {{ semestre.heuresEctsSemestre.sommeSemestreTePres|filtreHeures }} h TE</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </details>
</div>
