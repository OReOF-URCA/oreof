{% set hasDistancielData = ue.heuresEctsUe.sommeUeTotalDist > 0 %}
{% set distancielInline = presentiel and (not distanciel) and hasDistancielData %}

{# Bandeau d'en-tête de l'UE #}
<div class="flex flex-wrap items-center justify-between gap-3 border-b border-secondary-200 bg-secondary-50/70 px-5 py-3.5 dark:border-secondary-700 dark:bg-secondary-800/50 {% if enfant is defined and enfant %}border-l-4 border-l-warning-400 bg-warning-50/40 dark:bg-warning-900/30{% endif %}">
    <div class="flex items-center gap-3 min-w-0">
        <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-xl {% if enfant is defined and enfant %}bg-warning-600 text-white{% else %}bg-primary-600 text-white{% endif %} text-xs font-black shadow-xs">
            {{ ue.display }}
        </span>

        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
                <h4 class="text-sm font-bold text-secondary-900 dark:text-white">
                    {{ ue.ue.libelle }}
                </h4>
                {% if ue.raccroche == true %}
                    <span class="inline-flex items-center gap-1 rounded-md bg-warning-100 px-2 py-0.5 text-xs font-semibold text-warning-700 dark:bg-warning-900/30 dark:text-warning-300">
                        {{ ux_icon('ph:link-simple-bold', {class: 'w-3 h-3 text-warning-600'}) }} Raccrochée
                    </span>
                {% endif %}
                {% if ue.ue.ueMutualisables|length > 0 %}
                    <span class="inline-flex items-center gap-1 rounded-md bg-info-100 px-2 py-0.5 text-xs font-semibold text-info-700 dark:bg-info-900/30 dark:text-info-300"
                          title="UE mutualisée">
                        {{ ux_icon('ph:share-network-bold', {class: 'w-3 h-3 text-info-600'}) }} Mutualisée
                    </span>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="rounded-full bg-secondary-200 px-2 py-0.5 text-[10px] font-semibold text-secondary-600 dark:bg-secondary-700 dark:text-secondary-300">#{{ ue.ue.id }}</span>
                {% endif %}
            </div>

            {% if isVersioning is not defined or isVersioning == false and ue.codeApogee() %}
                <p class="mt-0.5 text-xs text-secondary-500 dark:text-secondary-400">Code Apogée : <span class="font-medium text-secondary-700 dark:text-secondary-300">{{ ue.codeApogee() }}</span></p>
            {% endif %}
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
        {% if ue.ue.natureUeEc is defined and ue.ue.natureUeEc != null and ue.ue.natureUeEc.libre == true %}
            <twig:Badge label="Choix libre" variant="secondary" size="sm"/>
        {% endif %}
        {% if ue.uesEnfants|length > 0 %}
            <twig:Badge label="{{ ue.uesEnfants|length }} choix possibles" variant="info" size="sm"/>
        {% endif %}
        {% if hasDistancielData %}
            <twig:Badge label="Distanciel : {{ ue.heuresEctsUe.sommeUeTotalDist|filtreHeures }} h" variant="warning" size="sm"/>
        {% endif %}
        <twig:Badge :label="ue.heuresEctsUe.sommeUeEcts ~ ' ECTS'" variant="primary" size="sm" icon="ph:certificate-bold" />
    </div>
</div>

{% if ue.ue.natureUeEc is defined and ue.ue.natureUeEc != null and ue.ue.natureUeEc.libre == true %}

    {# ---- Cas 1 : UE à choix libre ---- #}
    {% if presentiel %}{% set colspan = 4 %}{% elseif distanciel %}{% set colspan = 8 %}{% else %}{% set colspan = 0 %}{% endif %}
    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
            <tbody>
                <tr class="ec">
                    <td colspan="{{ colspan + 5 }}"
                        class="bg-secondary-50/50 px-5 py-4 text-sm leading-relaxed text-secondary-700 dark:bg-secondary-800/40 dark:text-secondary-200">
                        {{ ue.ue.descriptionUeLibre }}
                    </td>
                </tr>
            </tbody>
            {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </table>
    </div>

{% elseif ue.uesEnfants|length > 0 %}

    {# ---- Cas 2 : UE à choix restreint — les sous-UEs sont des blocs autonomes ---- #}
    <div class="space-y-4 p-4 bg-secondary-50/30 dark:bg-secondary-900/20">
        {% for ueE in ue.uesEnfants %}
            <div class="overflow-hidden rounded-xl border border-secondary-200 bg-surface shadow-2xs dark:border-secondary-700">
                {{ include('typeDiplome/licence/structure/v2/_structure_ue.html.twig', {
                    ue: ueE,
                    enfant: true,
                    diffUe: diffUe.uesEnfants[loop.index0] ?? null
                }) }}
            </div>
        {% endfor %}
    </div>

    {# Total de l'UE parente dans son propre tableau #}
    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
            {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </table>
    </div>

{% else %}

    {# ---- Cas 3 : UE normale avec ECs ---- #}
    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
            <thead>
                <tr class="ec border-b border-secondary-200 bg-secondary-50/50 text-xs font-semibold uppercase tracking-wider text-secondary-600 dark:border-secondary-700 dark:bg-secondary-800/30 dark:text-secondary-400">
                    <th scope="col" class="min-w-[280px] px-5 py-3">
                        Matière (Élément Constitutif)
                        {% if distancielInline %}
                            <span class="ml-2 inline-flex items-center rounded-full bg-warning-100 px-2 py-0.5 text-[10px] font-bold normal-case text-warning-700 dark:bg-warning-900/30 dark:text-warning-300">
                                Dist. intégré
                            </span>
                        {% endif %}
                    </th>
                    <th scope="col" class="min-w-[80px] px-3 py-3 text-center">MCCC</th>
                    <th scope="col" class="min-w-[70px] px-3 py-3 text-center">ECTS</th>
                    {% if presentiel %}
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-primary-700 bg-primary-50/40 dark:bg-primary-950/20 dark:text-primary-300">CM</th>
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-primary-700 bg-primary-50/40 dark:bg-primary-950/20 dark:text-primary-300">TD</th>
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-primary-700 bg-primary-50/40 dark:bg-primary-950/20 dark:text-primary-300">TP</th>
                        <th scope="col" class="w-20 px-2.5 py-3 text-center font-extrabold text-primary-800 bg-primary-100/50 dark:bg-primary-900/30 dark:text-primary-200">Total Prés.</th>
                        <th scope="col" class="w-14 px-2.5 py-3 text-center text-secondary-500 dark:text-secondary-400">TE</th>
                    {% endif %}
                    {% if distanciel %}
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-warning-700 bg-warning-50/40 dark:bg-warning-950/20 dark:text-warning-300">CM</th>
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-warning-700 bg-warning-50/40 dark:bg-warning-950/20 dark:text-warning-300">TD</th>
                        <th scope="col" class="w-14 px-2.5 py-3 text-center font-bold text-warning-700 bg-warning-50/40 dark:bg-warning-950/20 dark:text-warning-300">TP</th>
                        <th scope="col" class="w-20 px-2.5 py-3 text-center font-extrabold text-warning-800 bg-warning-100/50 dark:bg-warning-900/30 dark:text-warning-200">Total Dist.</th>
                    {% endif %}
                    {% if parcours.modalitesEnseignement != null and parcours.modalitesEnseignement.value == 1 %}
                        <th scope="col" class="px-4 py-3 text-right font-extrabold text-secondary-900 dark:text-white">Total</th>
                    {% endif %}
                </tr>
            </thead>

            <tbody class="divide-y divide-secondary-100 dark:divide-secondary-800/70">
                {% for ordEc, ec in ue.elementConstitutifs %}
                    {% set indexEc = loop.index0 %}
                    {{ include('typeDiplome/licence/structure/v2/_structure_ec.html.twig', {
                        ec: ec,
                        semestreOrdre: semestreOrdre,
                        ecEnfant: false,
                        diffEc: diffUe.elementConstitutifs[ordEc] ?? null,
                        indexEc: indexEc,
                        indexEcEnfant: -1,
                        UeDisplay: ue.display,
                        distancielAuto: hasDistancielData,
                        distancielInline: distancielInline
                    }) }}
                    {% for ordEce, ece in ec.elementsConstitutifsEnfants %}
                        {% set indexEcEnfant = loop.index0 %}
                        {{ include('typeDiplome/licence/structure/v2/_structure_ec.html.twig', {
                            ec: ece,
                            semestreOrdre: semestreOrdre,
                            ecEnfant: true,
                            diffEc: diffUe.elementConstitutifs[ordEc].ecEnfants[ordEce] ?? null,
                            indexEc: indexEc,
                            indexEcEnfant: indexEcEnfant,
                            UeDisplay: ue.display,
                            distancielAuto: hasDistancielData,
                            distancielInline: distancielInline
                        }) }}
                    {% endfor %}
                {% endfor %}
            </tbody>

            {% include 'typeDiplome/licence/structure/v2/_structure_ue_tfoot.html.twig' %}
        </table>
    </div>

{% endif %}
