{% set showDistancielInline = distancielInline is defined and distancielInline %}
{% set ecEcts = ec.heuresEctsEc.ects %}

<tr class="ec border-b border-secondary-100 transition-colors hover:bg-secondary-50/80 dark:border-secondary-800 dark:hover:bg-secondary-800/40">
    {# Colonne Matière (EC) #}
    <td class="px-5 py-3.5 align-middle">
        <div class="flex flex-col gap-1.5">
            <div class="flex items-center gap-2.5">
                {% if not ecEnfant %}
                    <span class="inline-flex shrink-0 items-center rounded-lg bg-primary-100 px-2.5 py-1 text-xs font-bold text-primary-700 dark:bg-primary-900/50 dark:text-primary-300">
                        {{ ec.elementConstitutif.code }}
                    </span>
                {% else %}
                    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-primary-200 bg-primary-50 px-2 py-0.5 text-xs font-semibold text-primary-600 dark:border-primary-700 dark:bg-primary-950/40 dark:text-primary-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
                        {{ ec.elementConstitutif.code }}
                    </span>
                {% endif %}

                <div class="min-w-0 flex-1">
                    {% if ec.elementConstitutif.ficheMatiere != null %}
                        <a href="{{ url('fiche_matiere_v2_voir', {slug: ec.elementConstitutif.ficheMatiere.slug}) }}"
                           target="_blank"
                           class="text-sm font-semibold text-secondary-900 hover:text-primary-600 hover:underline dark:text-secondary-100 dark:hover:text-primary-400">
                            <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.libelle|displayDiff : '' }}</span>
                            <span class="show_current">{{ ec.elementConstitutif.ficheMatiere.display }}</span>
                        </a>
                    {% else %}
                        <span class="text-sm font-semibold text-secondary-900 dark:text-secondary-100">
                            <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.libelle|displayDiff : '' }}</span>
                            <span class="show_current">{{ ec.elementConstitutif.libelle }}</span>
                        </span>
                    {% endif %}
                </div>

                {% if ec.elementConstitutif.ficheMatiere != null and app.user != null and
                    is_granted('CAN_PARCOURS_EDIT_MY', ec.elementConstitutif.ficheMatiere) and
                    workflow_can(ec.elementConstitutif.ficheMatiere, 'valider_fiche_compo') %}
                    <a href="{{ url('fiche_matiere_v2_modifier', {slug: ec.elementConstitutif.ficheMatiere.slug}) }}"
                       target="_blank"
                       class="inline-flex shrink-0 items-center rounded-md border border-warning-200 px-2 py-1 text-xs font-semibold text-warning-700 hover:bg-warning-50 dark:border-warning-700 dark:text-warning-300 dark:hover:bg-warning-950/20"
                       title="Modifier la fiche matière">
                        {{ ux_icon('icon:edit', {class: 'h-3.5 w-3.5'}) }}
                    </a>
                {% endif %}
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs">
                {% if isVersioning is not defined or isVersioning == false and ec.elementConstitutif.displayCodeApogee %}
                    <span class="text-secondary-500 dark:text-secondary-400">
                        Code Apogée : <span class="font-medium text-secondary-700 dark:text-secondary-300">{{ ec.elementConstitutif.displayCodeApogee }}</span>
                    </span>
                {% endif %}

                {% if source is defined and source != 'codification' and ec.elementConstitutif.ficheMatiere != null %}
                    {{ include('communs/_badge_collection.html.twig', { badges: ec.elementConstitutif.ficheMatiere.etatFiche|badgeFicheDto }) }}
                {% endif %}

                {% if ec.elementConstitutif.natureUeEc is defined
                    and ec.elementConstitutif.natureUeEc != null
                    and ec.elementConstitutif.natureUeEc.isLibre == true %}
                    <twig:Badge label="Choix libre" variant="success" size="sm"/>
                {% endif %}

                {% if ec.elementsConstitutifsEnfants|length > 0 %}
                    <twig:Badge label="{{ ec.elementsConstitutifsEnfants|length }} choix possibles" variant="info" size="sm"/>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <span class="rounded-full bg-secondary-100 px-2 py-0.5 text-[10px] font-semibold text-secondary-500 dark:bg-secondary-800">#{{ ec.elementConstitutif.id }}</span>
                {% endif %}
            </div>
        </div>
    </td>

    {# Colonne MCCC #}
    <td class="px-3 py-3 text-center align-middle whitespace-nowrap">
        {% set parcoursVersioning = isVersioning is defined and isVersioning == true ? parcoursVersioning ?? null : null %}
        {{ component('badge_mccc', {
            elementConstitutif: ec.elementConstitutif,
            parcours: parcours,
            deplacer: false,
            editable: false,
            ue: ue.ue,
            isVersioning: isVersioning ?? false,
            indexEc: indexEc,
            indexEcEnfant: indexEcEnfant,
            UeDisplay: UeDisplay,
            parcoursVersioning: parcoursVersioning
        }) }}
    </td>

    {# Colonne ECTS #}
    <td class="px-3 py-3 text-center align-middle whitespace-nowrap">
        <span class="show_versioning d-none d-print-none text-xs font-semibold text-secondary-500">{{ diffEc ? diffEc.heuresEctsEc.ects|displayDiff : '' }} ECTS</span>
        {% if ecEcts is not null and ecEcts > 0 %}
            <span class="inline-flex items-center rounded-full bg-primary-100 px-2.5 py-0.5 text-xs font-bold text-primary-800 dark:bg-primary-900/40 dark:text-primary-300">
                {{ ecEcts }} ECTS
            </span>
        {% else %}
            <span class="text-xs font-medium text-secondary-400">—</span>
        {% endif %}
    </td>

    {# Heures Présentielles #}
    {% if presentiel %}
        {% if ec.elementsConstitutifsEnfants|length > 0 %}
            <td colspan="5" class="bg-secondary-50/30 dark:bg-secondary-800/20"></td>
        {% else %}
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-secondary-700 dark:text-secondary-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.cmPres|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.cmPres ? ec.heuresEctsEc.cmPres|filtreHeures : '—' }}</span>
                {% if showDistancielInline and ec.heuresEctsEc.cmDist > 0 %}
                    <div class="mt-0.5 text-[10px] text-warning-700 dark:text-warning-300">
                        <span class="font-bold">Dist.</span> {{ ec.heuresEctsEc.cmDist|filtreHeures }}
                    </div>
                {% endif %}
            </td>
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-secondary-700 dark:text-secondary-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.tdPres|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.tdPres ? ec.heuresEctsEc.tdPres|filtreHeures : '—' }}</span>
                {% if showDistancielInline and ec.heuresEctsEc.tdDist > 0 %}
                    <div class="mt-0.5 text-[10px] text-warning-700 dark:text-warning-300">
                        <span class="font-bold">Dist.</span> {{ ec.heuresEctsEc.tdDist|filtreHeures }}
                    </div>
                {% endif %}
            </td>
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-secondary-700 dark:text-secondary-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.tpPres|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.tpPres ? ec.heuresEctsEc.tpPres|filtreHeures : '—' }}</span>
                {% if showDistancielInline and ec.heuresEctsEc.tpDist > 0 %}
                    <div class="mt-0.5 text-[10px] text-warning-700 dark:text-warning-300">
                        <span class="font-bold">Dist.</span> {{ ec.heuresEctsEc.tpDist|filtreHeures }}
                    </div>
                {% endif %}
            </td>
            <td class="bg-secondary-50/50 px-2.5 py-3 text-center align-middle tabular-nums font-bold text-secondary-900 dark:bg-secondary-800/30 dark:text-white whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.sommeEcTotalPres|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.sommeEcTotalPres ? ec.heuresEctsEc.sommeEcTotalPres|filtreHeures : '—' }}</span>
                {% if showDistancielInline and ec.heuresEctsEc.sommeEcTotalDist > 0 %}
                    <div class="mt-0.5 text-[10px] text-warning-700 dark:text-warning-300">
                        <span class="font-bold">Dist.</span> {{ ec.heuresEctsEc.sommeEcTotalDist|filtreHeures }}
                    </div>
                {% endif %}
            </td>
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-secondary-500 dark:text-secondary-400 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.tePres|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.tePres ? ec.heuresEctsEc.tePres|filtreHeures : '—' }}</span>
            </td>
        {% endif %}
    {% endif %}

    {# Heures Distancielles #}
    {% if distanciel and not showDistancielInline %}
        {% if ec.elementsConstitutifsEnfants|length > 0 %}
            <td colspan="4" class="bg-secondary-50/30 dark:bg-secondary-800/20"></td>
        {% else %}
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-warning-700 dark:text-warning-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.cmDist|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.cmDist ? ec.heuresEctsEc.cmDist|filtreHeures : '—' }}</span>
            </td>
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-warning-700 dark:text-warning-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.tdDist|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.tdDist ? ec.heuresEctsEc.tdDist|filtreHeures : '—' }}</span>
            </td>
            <td class="px-2.5 py-3 text-center align-middle tabular-nums text-warning-700 dark:text-warning-300 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.tpDist|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.tpDist ? ec.heuresEctsEc.tpDist|filtreHeures : '—' }}</span>
            </td>
            <td class="bg-warning-50/50 px-2.5 py-3 text-center align-middle tabular-nums font-bold text-warning-800 dark:bg-warning-950/30 dark:text-warning-200 whitespace-nowrap">
                <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.sommeEcTotalDist|displayDiff : '' }}</span>
                <span class="show_current">{{ ec.heuresEctsEc.sommeEcTotalDist ? ec.heuresEctsEc.sommeEcTotalDist|filtreHeures : '—' }}</span>
            </td>
        {% endif %}
    {% endif %}

    {# Total Présentiel + Distanciel si mixte #}
    {% if parcours.modalitesEnseignement != null and (parcours.modalitesEnseignement.value == 1) %}
        <td class="px-4 py-3 align-middle text-right tabular-nums font-bold text-secondary-900 dark:text-white whitespace-nowrap">
            <span class="show_versioning d-none d-print-none">{{ diffEc ? diffEc.heuresEctsEc.sommeEcTotalPresDist|displayDiff : '' }}</span>
            <span class="show_current">{{ ec.heuresEctsEc.sommeEcTotalPresDist|filtreHeures }}</span>
        </td>
    {% endif %}
</tr>
