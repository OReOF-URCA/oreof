{% if typeMccc == 'cci' or  typeMccc == 'cc' or typeMccc == 'ct' or typeMccc == 'cc_ct' %}
    {{ include('typeDiplome/licence/mccc-non-editable/_show.html.twig') }}
{% else %}
    <twig:alerte type="danger" message="Le type de MCCC est inconnu"/>
{% endif %}

    {% if ec is defined %}
        {% if ec.quitus %}
            {% set quitusText = ec.quitusText %}
        {% endif %}
        {% if ec.ficheMatiere != null and ec.ficheMatiere.quitus and ec.isMcccSpecifiques() ?? false != true %}
            {% set quitusText = ec.ficheMatiere.quitusText %}
        {% endif %}

        {% if ec.quitus ?? false or (ec.ficheMatiere != null and ec.ficheMatiere.quitus ?? false and ec.isMcccSpecifiques() != true) %}
            <div class="mt-4 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-secondary-700">
                <p class="my-1">
                    <span class="font-semibold text-sky-700">Cet EC donne lieu à un quitus</span>
                </p>
                <p class="my-1">
                    {{ quitusText }}
                </p>
            </div>
        {% endif %}
    {% endif %}

    {% if (isFromVersioning is defined and isFromVersioning != 'true') %}
        <div class="mt-5 flex flex-wrap justify-start gap-3">
            {% if (isMcccFromVersion is not defined or isMcccFromVersion == false)
                and (lastVersion is defined and lastVersion != null) %}
                <div>
                    <a class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"
                       href="{{ path('app_element_constitutif_mccc_versioning', {
                           parcoursVersioning: lastVersion.id,
                           elementConstitutif: ec.id,
                           isFromVersioning: isFromVersioning
                       }) }}"
                       data-action="click->modalturbo#open"
                       data-turbo="true"
                    >
                        Comparaison avec la dernière version validée
                    </a>
                </div>
            {% elseif (ec.deserializedId is defined and ec.deserializedId != null) or (ec.id is defined and ec.id != null) %}
                <div>
                    <a class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"
                       href="{{ path('parcours_mccc_voir', {
                           id: ec.deserializedId ?? ec.id,
                           parcours: parcoursId
                       }) }}"
                       data-action="click->modalturbo#open"
                       data-turbo="true"
                    >
                        Version actuellement saisie
                    </a>
                </div>
            {% endif %}
        </div>
    {% endif %}

