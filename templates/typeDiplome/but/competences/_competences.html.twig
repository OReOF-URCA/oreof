<div class="space-y-4">
    {% if isVersioning is not defined or isVersioning == false %}
        {% if print is defined and print == false %}
            <div class="flex justify-end">
                <details class="relative inline-block">
                    <summary
                            class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg border border-secondary-300 bg-white px-3 py-2 text-xs font-semibold text-secondary-700 shadow-sm hover:bg-secondary-50 dark:border-secondary-600 dark:bg-secondary-800 dark:text-secondary-100">
                        <i class="{{ iconDownload }}"></i>
                        BCC
                    </summary>
                    <div class="absolute right-0 z-20 mt-2 w-72 rounded-lg border border-secondary-200 bg-white p-1 shadow-lg dark:border-secondary-700 dark:bg-secondary-900">
                        <a class="block rounded px-3 py-2 text-sm text-secondary-700 hover:bg-secondary-50 dark:text-secondary-200 dark:hover:bg-secondary-800"
                           href="{{ path('app_parcours_bcc', {parcours:parcours.id}) }}">Voir en ligne</a>
                        <a class="block rounded px-3 py-2 text-sm text-secondary-700 hover:bg-secondary-50 dark:text-secondary-200 dark:hover:bg-secondary-800"
                           href="{{ path('app_competence_export_bcc', {parcours:parcours.id}) }}">Export des BCC (pdf)</a>
                        <a class="block rounded px-3 py-2 text-sm text-secondary-700 hover:bg-secondary-50 dark:text-secondary-200 dark:hover:bg-secondary-800"
                           href="{{ path('app_competence_export_croise', {parcours:parcours.id}) }}">Export du tableau
                            croisé BCC/EC (pdf)</a>
                        <a class="block rounded px-3 py-2 text-sm text-secondary-700 hover:bg-secondary-50 dark:text-secondary-200 dark:hover:bg-secondary-800"
                           href="{{ path('app_competence_export_croise_global', {parcours:parcours.id}) }}">Export du
                            tableau croisé BCC/EC, global (xlsx)</a>
                    </div>
                </details>
            </div>
        {% endif %}
    {% endif %}

    <div>
        {% if isVersioning is not defined or isVersioning == false %}
            {{ render(controller(
                'App\\Controller\\BlocCompetenceController::afficheBUTReferentiel',
                { 'parcours': parcours }
            )) }}
        {% else %}
            {{ render(controller(
                'App\\Controller\\BlocCompetenceController::afficheBUTReferentielVersioning',
                { 'parcours': parcours, 'indexParcours': indexParcours ?? 1 }
            )) }}
        {% endif %}
    </div>
</div>
