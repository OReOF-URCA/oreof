<div class="but-ref-container">
    {# En-tête : Nom court, Libellé long, Composantes essentielles #}
    <div class="but-ref-header-row mt-4">
        <div class="but-ref-comp-court competencec{{ competence.numero }}">
            {{ competence.nomCourt }}
        </div>
        <div class="but-ref-comp-long competencelonguec{{ competence.numero }}">
            {{ competence.libelle }}
        </div>
        <div class="but-ref-comp-composantes composantesessentiellesc{{ competence.numero }}">
            <ul class="list-disc list-inside space-y-1.5 text-sm leading-relaxed">
                {% for composante in competence.composantes %}
                    <li>{{ composante }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {# Situations professionnelles #}
    <div class="but-ref-row mt-6">
        <div class="but-ref-col-left but-ref-situation-label situationc{{ competence.numero }}">
            Situations professionnelles
        </div>
        <div class="but-ref-col-right but-ref-situation-content situationlistec{{ competence.numero }}">
            <div class="space-y-1.5 text-sm leading-relaxed">
                {% for situation in competence.situations %}
                    <p>{{ situation }}</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Titres Niveaux & Apprentissages critiques #}
    <div class="but-ref-titles-row">
        <div class="but-ref-title-left text-secondary-700 dark:text-secondary-300">
            Niveaux
        </div>
        <div class="but-ref-title-right text-secondary-700 dark:text-secondary-300">
            Apprentissages critiques
        </div>
    </div>

    {# Lignes des Niveaux et Apprentissages critiques #}
    <div class="space-y-3">
        {% for niveau in competence.butNiveaux %}
            <div class="but-ref-row">
                <div class="but-ref-col-left but-ref-niveau-badge niveau{{ niveau.ordre }}c{{ competence.numero }}">
                    <div class="font-bold text-base">B.U.T. {{ niveau.ordre }}</div>
                    <div class="text-xs mt-1.5 font-medium leading-snug">{{ niveau.libelle }}</div>
                </div>
                <div class="but-ref-col-right but-ref-ac-content niveau{{ niveau.ordre }}c{{ competence.numero }}">
                    <ul class="list-disc list-inside space-y-1.5 text-sm leading-relaxed">
                        {% for ac in niveau.butApprentissageCritiques %}
                            <li><strong class="font-semibold">{{ ac.code }}</strong> | {{ ac.libelle }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
