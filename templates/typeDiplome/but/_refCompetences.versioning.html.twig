<div class="app-tabs" data-controller="tabs" data-tabs-active-tab-class="app-tab-active active" data-tabs-remember-hash-value="false">
    <div class="app-tabs-list flex-wrap gap-1.5" role="tablist" aria-label="Compétences du parcours">
        {% for competence in competences %}
            <button type="button"
                    class="app-tab {% if loop.first %}app-tab-active active{% endif %}"
                    role="tab"
                    data-tabs-target="tab"
                    data-action="tabs#change"
                    data-tab-id="competence_{{ loop.index }}_P{{ indexParcours ?? '' }}"
                    aria-selected="{{ loop.first ? 'true' : 'false' }}">
                {{ competence.nomCourt }}
            </button>
        {% endfor %}
    </div>

    <div class="mt-6">
        {% for competence in competences %}
            <div data-tabs-target="panel"
                 data-panel-id="competence_{{ loop.index }}_P{{ indexParcours ?? '' }}"
                 class="{% if not loop.first %}hidden{% endif %}">
                {{ include('typeDiplome/but/_competence.html.twig') }}
            </div>
        {% endfor %}
    </div>
</div>
